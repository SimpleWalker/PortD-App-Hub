   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-12 -24 224 224\">\n<path d=\"M40 104 Q34 42 100 36 Q166 42 160 104 Q160 124 150 130 L50 130 Q40 124 40 104Z\" fill=\"#6db868\"/>\n<path d=\"M82 146 h36 v18 h-36z\" fill=\"#ffe3d3\"/>\n<path d=\"M52 200 Q56 160 100 156 Q144 160 148 200Z\" fill=\"#7dc97a\"/><path d=\"M84 158 L100 176 L116 158 Q100 166 84 158Z\" fill=\"#fff\"/>\n<ellipse cx=\"100\" cy=\"106\" rx=\"56\" ry=\"50\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"46\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/><ellipse cx=\"154\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"76\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"76\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#3f9a5a\"/><ellipse cx=\"76\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"72\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"80\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/><ellipse cx=\"124\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"124\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#3f9a5a\"/><ellipse cx=\"124\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"120\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"128\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/>\n<ellipse cx=\"62\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/><ellipse cx=\"138\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/>\n<path d=\"M92 132 q8 12 16 0 z\" fill=\"#c8506a\"/>\n<path d=\"M38 100 Q36 44 100 40 Q164 44 162 100 Q150 76 136 70 Q130 88 112 92 Q116 76 108 66 Q96 86 72 90 Q80 78 78 68 Q58 80 38 100Z\" fill=\"#8fd48a\"/><path d=\"M70 52 Q100 42 130 52\" stroke=\"#fff\" stroke-width=\"4\" opacity=\".35\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M100 30 q4 -26 26 -30 q-2 24 -26 30z\" fill=\"#6fcf72\"/><path d=\"M100 30 q10 -14 22 -26\" stroke=\"#3f8f4f\" stroke-width=\"2\" fill=\"none\"/>\n</svg>"
  },
  "assets/chars/rin.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-12 -24 224 224\">\n<path d=\"M40 100 Q34 40 100 34 Q166 40 160 100Z\" fill=\"#1f1f36\"/><path d=\"M40 80 Q4 110 16 186 Q30 170 44 150Z M160 80 Q196 110 184 186 Q170 170 156 150Z\" fill=\"#1f1f36\"/>\n<path d=\"M82 146 h36 v18 h-36z\" fill=\"#ffe3d3\"/>\n<path d=\"M52 200 Q56 160 100 156 Q144 160 148 200Z\" fill=\"#3a3a5e\"/><path d=\"M84 158 L100 176 L116 158 Q100 166 84 158Z\" fill=\"#ff5c8a\"/>\n<ellipse cx=\"100\" cy=\"106\" rx=\"56\" ry=\"50\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"46\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/><ellipse cx=\"154\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"76\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"76\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#ff5c8a\"/><ellipse cx=\"76\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"72\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"80\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/><ellipse cx=\"124\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"124\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#ff5c8a\"/><ellipse cx=\"124\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"120\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"128\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/>\n<ellipse cx=\"62\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/><ellipse cx=\"138\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/>\n<path d=\"M92 132 q8 12 16 0 z\" fill=\"#c8506a\"/>\n<path d=\"M38 100 Q36 44 100 40 Q164 44 162 100 Q150 76 136 70 Q130 88 112 92 Q116 76 108 66 Q96 86 72 90 Q80 78 78 68 Q58 80 38 100Z\" fill=\"#2e2e48\"/><path d=\"M70 52 Q100 42 130 52\" stroke=\"#fff\" stroke-width=\"4\" opacity=\".35\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M142 38 l5 10 11 1.5-8 7.5 2 11-10-5.5-10 5.5 2-11-8-7.5 11-1.5z\" fill=\"#ffe27a\" stroke=\"#f0b73a\" stroke-width=\"1.5\"/>\n</svg>"
