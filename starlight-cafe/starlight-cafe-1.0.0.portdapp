  "assets/chars/sora.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-12 -24 224 224\">\n<g fill=\"#fff\" stroke=\"#a8dcff\" stroke-width=\"2\" opacity=\".95\"><path d=\"M40 150 Q-4 120 6 82 Q30 104 52 112 Q26 96 30 70 Q54 98 66 120Z\"/><path d=\"M160 150 Q204 120 194 82 Q170 104 148 112 Q174 96 170 70 Q146 98 134 120Z\"/></g><path d=\"M34 108 Q30 40 100 34 Q170 40 166 108 Q170 150 150 160 L50 160 Q30 150 34 108Z\" fill=\"#82c6f5\"/>\n<path d=\"M82 146 h36 v18 h-36z\" fill=\"#ffe3d3\"/>\n<path d=\"M52 200 Q56 160 100 156 Q144 160 148 200Z\" fill=\"#e8f6ff\"/><path d=\"M100 168 l-14 -8 v16z M100 168 l14 -8 v16z\" fill=\"#82c6f5\"/><circle cx=\"100\" cy=\"168\" r=\"4\" fill=\"#82c6f5\"/>\n<ellipse cx=\"100\" cy=\"106\" rx=\"56\" ry=\"50\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"46\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/><ellipse cx=\"154\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"76\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"76\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#3d8bd9\"/><ellipse cx=\"76\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"72\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"80\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/><ellipse cx=\"124\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"124\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#3d8bd9\"/><ellipse cx=\"124\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"120\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"128\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/>\n<ellipse cx=\"62\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/><ellipse cx=\"138\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/>\n<path d=\"M92 134 q8 8 16 0\" stroke=\"#b0485e\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n<path d=\"M38 100 Q36 44 100 40 Q164 44 162 100 Q150 76 136 70 Q130 88 112 92 Q116 76 108 66 Q96 86 72 90 Q80 78 78 68 Q58 80 38 100Z\" fill=\"#a8dcff\"/><path d=\"M70 52 Q100 42 130 52\" stroke=\"#fff\" stroke-width=\"4\" opacity=\".35\" fill=\"none\" stroke-linecap=\"round\"/><ellipse cx=\"100\" cy=\"14\" rx=\"34\" ry=\"9\" fill=\"none\" stroke=\"#ffe27a\" stroke-width=\"6\"/>\n</svg>"
  },
  "assets/chars/tofu.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-12 -24 224 224\">\n<path d=\"M34 108 Q30 40 100 34 Q170 40 166 108 Q170 150 150 160 L50 160 Q30 150 34 108Z\" fill=\"#e3e4f2\"/>\n<path d=\"M82 146 h36 v18 h-36z\" fill=\"#ffe3d3\"/>\n<path d=\"M52 200 Q56 160 100 156 Q144 160 148 200Z\" fill=\"#c9d4ff\"/><circle cx=\"100\" cy=\"170\" r=\"7\" fill=\"#ffd45c\" stroke=\"#d99a1a\" stroke-width=\"2\"/>\n<ellipse cx=\"100\" cy=\"106\" rx=\"56\" ry=\"50\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"46\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/><ellipse cx=\"154\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"76\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"76\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#6b8cff\"/><ellipse cx=\"76\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"72\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"80\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/><ellipse cx=\"124\" cy=\"110\" rx=\"11\" ry=\"14\" fill=\"#3a2433\"/><ellipse cx=\"124\" cy=\"112\" rx=\"9\" ry=\"11.5\" fill=\"#6b8cff\"/><ellipse cx=\"124\" cy=\"116\" rx=\"6\" ry=\"6.5\" fill=\"#2a1a28\" opacity=\".55\"/><circle cx=\"120\" cy=\"104\" r=\"4.2\" fill=\"#fff\"/><circle cx=\"128\" cy=\"118\" r=\"2\" fill=\"#fff\" opacity=\".9\"/>\n<ellipse cx=\"62\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/><ellipse cx=\"138\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/>\n<path d=\"M90 133 q5 5 10 0 q5 5 10 0\" stroke=\"#b0485e\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n<path d=\"M38 100 Q36 44 100 40 Q164 44 162 100 Q150 76 136 70 Q130 88 112 92 Q116 76 108 66 Q96 86 72 90 Q80 78 78 68 Q58 80 38 100Z\" fill=\"#fbfbff\"/><path d=\"M70 52 Q100 42 130 52\" stroke=\"#fff\" stroke-width=\"4\" opacity=\".35\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M50 62 L56 18 L88 46 Z M150 62 L144 18 L112 46 Z\" fill=\"#fbfbff\"/><path d=\"M58 52 L60 30 L78 46 Z M142 52 L140 30 L122 46 Z\" fill=\"#ffc4d6\"/>\n</svg>"
  },
  "assets/chars/yume.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-12 -24 224 224\">\n<path d=\"M34 108 Q30 40 100 34 Q170 40 166 108 Q170 150 150 160 L50 160 Q30 150 34 108Z\" fill=\"#cfc2f5\"/>\n<path d=\"M82 146 h36 v18 h-36z\" fill=\"#ffe3d3\"/>\n<path d=\"M52 200 Q56 160 100 156 Q144 160 148 200Z\" fill=\"#d9ccff\"/><circle cx=\"100\" cy=\"170\" r=\"7\" fill=\"#ffd45c\" stroke=\"#d99a1a\" stroke-width=\"2\"/>\n<ellipse cx=\"100\" cy=\"106\" rx=\"56\" ry=\"50\" fill=\"#ffe3d3\"/>\n<ellipse cx=\"46\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/><ellipse cx=\"154\" cy=\"112\" rx=\"8\" ry=\"10\" fill=\"#ffe3d3\"/>\n<path d=\"M65 112 q11 9 22 0\" stroke=\"#4a3040\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M113 112 q11 9 22 0\" stroke=\"#4a3040\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n<ellipse cx=\"62\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/><ellipse cx=\"138\" cy=\"128\" rx=\"10\" ry=\"6\" fill=\"#ff9fb2\" opacity=\".55\"/>\n<path d=\"M92 134 q8 8 16 0\" stroke=\"#b0485e\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n<path d=\"M38 100 Q36 44 100 40 Q164 44 162 100 Q150 76 136 70 Q130 88 112 92 Q116 76 108 66 Q96 86 72 90 Q80 78 78 68 Q58 80 38 100Z\" fill=\"#e9e0ff\"/><path d=\"M70 52 Q100 42 130 52\" stroke=\"#fff\" stroke-width=\"4\" opacity=\".35\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M48 70 q-22 -6 -18 -26 q6 -18 26 -10 q-14 6 -8 18 q4 8 14 6Z M152 70 q22 -6 18 -26 q-6 -18 -26 -10 q14 6 8 18 q-4 8 -14 6Z\" fill=\"#fff7e6\" stroke=\"#c9a26a\" stroke-width=\"2\"/>\n</svg>"
  },
  "assets/logo.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ffd1e8\"/><stop offset=\"1\" stop-color=\"#b9a4ff\"/></linearGradient></defs><circle cx=\"32\" cy=\"32\" r=\"30\" fill=\"url(#g)\"/><path d=\"M40 12a20 20 0 1 0 12 30 16 16 0 1 1-12-30z\" fill=\"#fff8d6\"/><path d=\"M22 20l2 5 5 .5-4 3.5 1 5-4-2.5-4 2.5 1-5-4-3.5 5-.5z\" fill=\"#fff\"/></svg>"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Starlight Café</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <header class=\"top\">\n    <img class=\"logo\" src=\"assets/logo.svg\" alt=\"\">\n    <div class=\"title\">Starlight Café</div>\n    <div class=\"pills\">\n      <div class=\"pill\" id=\"starPill\" role=\"status\" aria-live=\"off\" title=\"Stars – earned by your café friends, spent on levels and the gem shop\">✨ <b id=\"stars\">0</b><small id=\"income\">+0/s</small></div>\n      <div class=\"pill gem\" id=\"gemPill\" title=\"Gems – spent on wishes\">💎 <b id=\"gems\">0</b></div>\n    </div>\n    <button id=\"themeBtn\" class=\"iconBtn\" type=\"button\"></button>\n  </header>\n\n  <main>\n    <!-- Café -->\n    <section id=\"tab-cafe\" class=\"tab show\" role=\"tabpanel\" aria-labelledby=\"tb-cafe\">\n      <div class=\"moonbox\">\n        <button id=\"moon\" class=\"moon\" aria-label=\"Tap the moon for stars\">\n          <img src=\"assets/logo.svg\" alt=\"\">\n        </button>\n        <div class=\"hint\">Tap the moon! Your friends brew stars even while you're away.</div>\n      </div>\n      <h2>Your café friends</h2>\n      <div id=\"friends\" class=\"friends\"></div>\n    </section>\n\n    <!-- Wish -->\n    <section id=\"tab-wish\" class=\"tab\" role=\"tabpanel\" aria-labelledby=\"tb-wish\">\n      <div class=\"banner\">\n        <div class=\"bannerArt\"><img id=\"featuredArt\" alt=\"\"></div>\n        <div class=\"bannerText\">\n          <div class=\"bannerTag\">Limited wish</div>\n          <h2 id=\"bannerName\">Twinkle Tea Party</h2>\n          <p id=\"bannerDesc\"></p>\n          <p class=\"rates\">SSR 3% · SR 17% · R 80% · ×10 guarantees SR or better</p>\n          <p class=\"pity\">SSR guaranteed in <b id=\"pity\">60</b> wishes</p>\n        </div>\n      </div>\n      <div class=\"wishBtns\">\n        <button id=\"wish1\" class=\"btn big\">Wish ×1<small>💎 100</small></button>\n        <button id=\"wish10\" class=\"btn big pri\">Wish ×10<small>💎 1000</small></button>\n      </div>\n      <p class=\"muted center\">Duplicates raise a friend's bond: +25% stars each, up to 10. After that they turn into gems.</p>\n    </section>\n\n    <!-- Collection -->\n    <section id=\"tab-album\" class=\"tab\" role=\"tabpanel\" aria-labelledby=\"tb-album\">\n      <h2>Album <small id=\"albumCount\"></small></h2>\n      <div id=\"album\" class=\"album\"></div>\n    </section>\n\n    <!-- Quests & shop -->\n    <section id=\"tab-quests\" class=\"tab\" role=\"tabpanel\" aria-labelledby=\"tb-quests\">\n      <div class=\"row2\">\n        <div class=\"card\">\n          <h3>Daily gift</h3>\n          <p class=\"muted\">A gift of gems every day.</p>\n          <button id=\"daily\" class=\"btn pri\">Claim 💎 150</button>\n        </div>\n        <div class=\"card\">\n          <h3>Gem shop</h3>\n          <p class=\"muted\">Trade stars for gems. The price rises a little each time.</p>\n          <button id=\"shop\" class=\"btn\">💎 25 for ✨ <span id=\"shopPrice\">200</span></button>\n        </div>\n      </div>\n      <h2>Milestones</h2>\n      <div id=\"milestones\" class=\"milestones\"></div>\n      <h2>Stats</h2>\n      <div id=\"stats\" class=\"card stats\"></div>\n      <p class=\"center\"><button id=\"reset\" class=\"btn small danger\">Start over</button></p>\n    </section>\n  </main>\n\n  <nav class=\"tabs\" role=\"tablist\" aria-label=\"Sections\">\n    <button id=\"tb-cafe\" role=\"tab\" aria-selected=\"true\" data-tab=\"cafe\" class=\"on\" title=\"Café (1)\"><i aria-hidden=\"true\">☕</i><span>Café</span></button>\n    <button id=\"tb-wish\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-tab=\"wish\" title=\"Wish (2)\"><i aria-hidden=\"true\">🌟</i><span>Wish</span><i id=\"wishDot\" class=\"dot\"></i></button>\n    <button id=\"tb-album\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-tab=\"album\" title=\"Album (3)\"><i aria-hidden=\"true\">📖</i><span>Album</span></button>\n    <button id=\"tb-quests\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-tab=\"quests\" title=\"Quests (4)\"><i aria-hidden=\"true\">🎁</i><span>Quests</span><i id=\"questDot\" class=\"dot\"></i></button>\n  </nav>\n</div>\n\n<!-- Wish results -->\n<div id=\"results\" class=\"overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Wish results\">\n  <div class=\"resultsInner\">\n    <div id=\"resultCards\" class=\"resultCards\"></div>\n    <div class=\"resultsFoot\"><button id=\"resultsSkip\" class=\"btn\">Reveal all</button><button id=\"resultsClose\" class=\"btn pri\">OK</button></div>\n  </div>\n</div>\n\n<!-- Character details -->\n<div id=\"detail\" class=\"overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dName\">\n  <div class=\"detailCard\">\n    <img id=\"dArt\" alt=\"\">\n    <div class=\"dInfo\">\n      <div id=\"dRarity\" class=\"rarity\"></div>\n      <h2 id=\"dName\"></h2>\n      <div id=\"dTitle\" class=\"muted\"></div>\n      <p id=\"dQuote\" class=\"quote\"></p>\n      <div id=\"dStats\" class=\"dStats\"></div>\n    </div>\n    <button id=\"dClose\" class=\"btn\">Close</button>\n  </div>\n</div>\n\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/data.js\"></script>\n<script src=\"js/storage.js\"></script>\n<script src=\"js/game.js\"></script>\n<script src=\"js/ui.js\"></script>\n</body>\n</html>\n"
  },
  "js/data.js": {
   "enc": "text",
   "d": "// Starlight Café – game data: characters, rarities, banner rates, milestones.\n// Edit this file to add characters or rebalance the game.\nwindow.SC = window.SC || {};\n\nSC.RARITY = {\n  R:   { stars: 3, label: 'R',   color: '#8ec5ff', base: 1,  levelCost: 15,  weight: 80 },\n  SR:  { stars: 4, label: 'SR',  color: '#c79bff', base: 6,  levelCost: 80,  weight: 17 },\n  SSR: { stars: 5, label: 'SSR', color: '#ffc94d', base: 35, levelCost: 400, weight: 3 }\n};\n\n// art: path inside the program folder (resolved through PortD.assets at runtime)\nSC.CHARACTERS = [\n  { id: 'mochi',   name: 'Mochi',   rarity: 'R',   title: 'Bunny Barista',      quote: 'One strawberry latte, extra fluffy!' },\n  { id: 'pip',     name: 'Pip',     rarity: 'R',   title: 'Sprout Gardener',    quote: 'The herbs grow better when you sing to them.' },\n  { id: 'tofu',    name: 'Tofu',    rarity: 'R',   title: 'Sleepy Kitten',      quote: 'Nya… five more minutes…' },\n  { id: 'biscuit', name: 'Biscuit', rarity: 'R',   title: 'Pastry Chef',        quote: 'Fresh from the oven, mind the sparkles.' },\n  { id: 'nori',    name: 'Nori',    rarity: 'R',   title: 'Quiet Bookkeeper',   quote: '…the numbers add up. Probably.' },\n  { id: 'peach',   name: 'Peach',   rarity: 'R',   title: 'Flower Waitress',    quote: 'A daisy with every order!' },\n  { id: 'luna',    name: 'Luna',    rarity: 'SR',  title: 'Moonlight Witch',    quote: 'A pinch of moondust makes everything sweeter.' },\n  { id: 'kiko',    name: 'Kiko',    rarity: 'SR',  title: 'Trickster Fox',      quote: 'Did your cake just vanish? Hehe, no idea~' },\n  { id: 'sora',    name: 'Sora',    rarity: 'SR',  title: 'Cloud Courier',      quote: 'Deliveries by wing, always on time!' },\n  { id: 'rin',     name: 'Rin',     rarity: 'SR',  title: 'Star Idol',          quote: 'This next song is for the café!' },\n  { id: 'aurora',  name: 'Aurora',  rarity: 'SSR', title: 'Princess of Stars',  quote: 'The whole sky is on the menu tonight.' },\n  { id: 'celeste', name: 'Celeste', rarity: 'SSR', title: 'Gentle Dragon',      quote: 'I guard this café… and its cookies.' },\n  { id: 'yume',    name: 'Yume',    rarity: 'SSR', title: 'Dream Shepherd',     quote: 'Count with me… one sheep, two sheep…' }\n].map(c => ({ ...c, art: 'assets/chars/' + c.id + '.svg' }));\n\nSC.BANNER = {\n  name: 'Twinkle Tea Party',\n  singleCost: 100,      // gems\n  tenCost: 1000,        // gems, guarantees at least one SR or better\n  pity: 60,             // SSR guaranteed on this pull if none before\n  rateUp: 'aurora',     // half of SSR pulls are the featured character\n  featuredShare: 0.5\n};\n\nSC.BALANCE = {\n  startGems: 300,\n  levelGrowth: 1.15,        // star cost multiplier per level\n  bondBonus: 0.25,          // +25% production per duplicate (bond level)\n  maxBond: 10,              // duplicates beyond this become gems\n  overflowGems: 25,\n  tapBase: 1,\n  tapShareOfIncome: 0.1,    // a tap gives 10% of a second's income on top\n  offlineCapHours: 8,\n  offlineRate: 0.5,\n  shopGems: 25,             // gems per purchase in the shop\n  shopBasePrice: 200,       // stars\n  shopGrowth: 1.08,\n  dailyGems: 150\n};\n\nSC.MILESTONES = [\n  { id: 'stars1k',   text: 'Earn 1,000 stars',          test: s => s.lifetime >= 1e3,  gems: 100 },\n  { id: 'stars10k',  text: 'Earn 10,000 stars',         test: s => s.lifetime >= 1e4,  gems: 150 },\n  { id: 'stars100k', text: 'Earn 100,000 stars',        test: s => s.lifetime >= 1e5,  gems: 200 },\n  { id: 'stars1m',   text: 'Earn 1 million stars',      test: s => s.lifetime >= 1e6,  gems: 300 },\n  { id: 'stars10m',  text: 'Earn 10 million stars',     test: s => s.lifetime >= 1e7,  gems: 500 },\n  { id: 'pulls10',   text: 'Make 10 wishes',            test: s => s.pulls >= 10,      gems: 100 },\n  { id: 'pulls50',   text: 'Make 50 wishes',            test: s => s.pulls >= 50,      gems: 250 },\n  { id: 'own5',      text: 'Befriend 5 characters',     test: s => SC.ownedCount(s) >= 5,  gems: 150 },\n  { id: 'own10',     text: 'Befriend 10 characters',    test: s => SC.ownedCount(s) >= 10, gems: 300 },\n  { id: 'ownAll',    text: 'Befriend everyone',         test: s => SC.ownedCount(s) >= SC.CHARACTERS.length, gems: 1000 },\n  { id: 'firstSSR',  text: 'Meet an SSR friend',        test: s => SC.CHARACTERS.some(c => c.rarity === 'SSR' && s.owned[c.id]), gems: 100 },\n  { id: 'taps500',   text: 'Tap the moon 500 times',    test: s => s.taps >= 500,      gems: 100 },\n  { id: 'level25',   text: 'Raise anyone to level 25',  test: s => Object.values(s.owned).some(o => o.level >= 25), gems: 200 }\n];\n"
  },
  "js/game.js": {
   "enc": "text",
   "d": "// Starlight Café – game rules. No DOM code here; ui.js draws the state.\nwindow.SC = window.SC || {};\n\nSC.byId = Object.fromEntries(SC.CHARACTERS.map(c => [c.id, c]));\nSC.ownedCount = s => Object.keys(s.owned).length;\nSC.today = () => new Date().toISOString().slice(0, 10);\n\nSC.newState = function () {\n  return {\n    v: 1, created: Date.now(), lastSeen: Date.now(),\n    stars: 0, gems: SC.BALANCE.startGems, lifetime: 0,\n    taps: 0, pulls: 0, pity: 0, shopBought: 0,\n    lastDaily: null, claimed: {},\n    owned: { mochi: { level: 1, bond: 0, since: Date.now() } } // a starter friend\n  };\n};\n\n// Fill in anything missing from an older or hand-edited save.\nSC.repair = function (s) {\n  const d = SC.newState();\n  for (const k of Object.keys(d)) if (s[k] === undefined || s[k] === null && k !== 'lastDaily') s[k] = d[k];\n  for (const id of Object.keys(s.owned)) if (!SC.byId[id]) delete s.owned[id];\n  if (!Object.keys(s.owned).length) s.owned = d.owned;\n  for (const k of ['stars', 'gems', 'lifetime']) if (!isFinite(s[k]) || s[k] < 0) s[k] = 0;\n  return s;\n};\n\n// ---------- production\nSC.power = function (c, o) {\n  const r = SC.RARITY[c.rarity];\n  return r.base * o.level * (1 + SC.BALANCE.bondBonus * o.bond);\n};\nSC.income = s => Object.entries(s.owned).reduce((sum, [id, o]) => sum + SC.power(SC.byId[id], o), 0);\nSC.levelCost = (c, o) => Math.ceil(SC.RARITY[c.rarity].levelCost * Math.pow(SC.BALANCE.levelGrowth, o.level - 1));\n\nSC.earn = function (s, n) { s.stars += n; s.lifetime += n; };\n\nSC.tick = function (s, dt) { SC.earn(s, SC.income(s) * dt); s.lastSeen = Date.now(); };\n\nSC.tap = function (s) {\n  const n = SC.BALANCE.tapBase + SC.income(s) * SC.BALANCE.tapShareOfIncome;\n  SC.earn(s, n); s.taps++;\n  return n;\n};\n\nSC.levelUp = function (s, id) {\n  const o = s.owned[id]; if (!o) return false;\n  const cost = SC.levelCost(SC.byId[id], o);\n  if (s.stars < cost) return false;\n  s.stars -= cost; o.level++;\n  return true;\n};\n// Level up as many times as affordable; returns how many levels were bought.\nSC.levelMax = function (s, id) { let n = 0; while (n < 1000 && SC.levelUp(s, id)) n++; return n; };\n\n// ---------- offline earnings\nSC.offline = function (s, now = Date.now()) {\n  const secs = Math.max(0, Math.min((now - (s.lastSeen || now)) / 1000, SC.BALANCE.offlineCapHours * 3600));\n  if (secs < 60) return null;\n  const earned = SC.income(s) * secs * SC.BALANCE.offlineRate;\n  SC.earn(s, earned); s.lastSeen = now;\n  return { secs, earned };\n};\n\n// ---------- wishes (gacha)\nSC.rollRarity = function (s, guaranteeSR) {\n  if (s.pity >= SC.BANNER.pity - 1) return 'SSR';\n  const R = SC.RARITY, roll = Math.random() * (R.R.weight + R.SR.weight + R.SSR.weight);\n  let rarity = roll < R.SSR.weight ? 'SSR' : roll < R.SSR.weight + R.SR.weight ? 'SR' : 'R';\n  if (guaranteeSR && rarity === 'R') rarity = 'SR';\n  return rarity;\n};\nSC.rollCharacter = function (rarity) {\n  const pool = SC.CHARACTERS.filter(c => c.rarity === rarity);\n  if (rarity === 'SSR' && SC.BANNER.rateUp && Math.random() < SC.BANNER.featuredShare) return SC.byId[SC.BANNER.rateUp];\n  return pool[Math.floor(Math.random() * pool.length)];\n};\n\n// Returns an array of results, or null if not enough gems.\nSC.wish = function (s, count) {\n  const cost = count === 10 ? SC.BANNER.tenCost : SC.BANNER.singleCost * count;\n  if (s.gems < cost) return null;\n  s.gems -= cost;\n  const results = [];\n  for (let i = 0; i < count; i++) {\n    const lastOfTen = count === 10 && i === 9 && !results.some(r => r.char.rarity !== 'R');\n    const rarity = SC.rollRarity(s, lastOfTen);\n    const c = SC.rollCharacter(rarity);\n    s.pulls++;\n    s.pity = rarity === 'SSR' ? 0 : s.pity + 1;\n    const o = s.owned[c.id];\n    let kind, gems = 0;\n    if (!o) { s.owned[c.id] = { level: 1, bond: 0, since: Date.now() }; kind = 'new'; }\n    else if (o.bond < SC.BALANCE.maxBond) { o.bond++; kind = 'bond'; }\n    else { gems = SC.BALANCE.overflowGems * SC.RARITY[c.rarity].stars; s.gems += gems; kind = 'gems'; }\n    results.push({ char: c, kind, gems, bond: s.owned[c.id].bond });\n  }\n  return results;\n};\n\n// ---------- shop, daily gift, milestones\nSC.shopPrice = s => Math.ceil(SC.BALANCE.shopBasePrice * Math.pow(SC.BALANCE.shopGrowth, s.shopBought));\nSC.buyGems = function (s) {\n  const p = SC.shopPrice(s); if (s.stars < p) return false;\n  s.stars -= p; s.gems += SC.BALANCE.shopGems; s.shopBought++; return true;\n};\nSC.dailyReady = s => s.lastDaily !== SC.today();\nSC.claimDaily = function (s) { if (!SC.dailyReady(s)) return 0; s.lastDaily = SC.today(); s.gems += SC.BALANCE.dailyGems; return SC.BALANCE.dailyGems; };\n\nSC.milestoneState = s => SC.MILESTONES.map(m => ({ ...m, done: !!s.claimed[m.id], ready: !s.claimed[m.id] && m.test(s) }));\nSC.claimMilestone = function (s, id) {\n  const m = SC.MILESTONES.find(x => x.id === id);\n  if (!m || s.claimed[id] || !m.test(s)) return 0;\n  s.claimed[id] = Date.now(); s.gems += m.gems; return m.gems;\n};\n\n// ---------- number formatting\nSC.fmt = function (n) {\n  if (n < 1000) return n < 10 && n % 1 ? n.toFixed(1) : String(Math.floor(n));\n  const units = ['K', 'M', 'B', 'T', 'Qa', 'Qi'];\n  let u = -1; while (n >= 1000 && u < units.length - 1) { n /= 1000; u++; }\n  return (n < 100 ? n.toFixed(n < 10 ? 2 : 1) : Math.floor(n)) + units[u];\n};\nSC.fmtTime = function (secs) {\n  const h = Math.floor(secs / 3600), m = Math.floor(secs % 3600 / 60);\n  return h ? `${h}h ${m}m` : `${m}m`;\n};\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/storage.js": {
   "enc": "text",
   "d": "// Starlight Café – saving and loading, and asset lookup.\n// Inside PortD: saves to P:\\User\\Config\\<program id>\\save.json and loads art from PortD.assets.\n// Outside PortD (opened straight from disk): uses localStorage when the browser allows it.\nwindow.SC = window.SC || {};\n\nSC.inPortD = typeof window.PortD === 'object' && window.PortD !== null;\n\nSC.asset = function (path) {\n  if (SC.inPortD && PortD.assets && PortD.assets[path]) return PortD.assets[path];\n  return path; // relative path works when the folder is opened directly\n};\n\nSC.storage = {\n  key: 'starlight-cafe-save',\n  async load() {\n    try {\n      if (SC.inPortD) return (await PortD.fs.exists('save.json')) ? JSON.parse(Host.decode(await PortD.fs.read('save.json'))) : null;\n      const t = localStorage.getItem(this.key);\n      return t ? JSON.parse(t) : null;\n    } catch (e) { return null; }\n  },\n  async save(state) {\n    const text = JSON.stringify(state);\n    try {\n      if (SC.inPortD) await PortD.fs.write('save.json', text);\n      else localStorage.setItem(this.key, text);\n      return true;\n    } catch (e) { return false; }\n  },\n  async wipe() {\n    try {\n      if (SC.inPortD) await PortD.fs.remove('save.json');\n      else localStorage.removeItem(this.key);\n    } catch (e) {}\n  }\n};\n"
  },
  "js/ui.js": {
   "enc": "text",
   "d": "// Starlight Café – drawing the game and handling input.\n// Added in the PortD 1.0 port: light/dark theme (follows the system by default), keyboard use\n// (tabs, moon, dialogs), labels for screen readers. Game rules and the save format are unchanged.\n(function () {\n  const $ = id => document.getElementById(id);\n  let S = null;                 // game state\n  let lastTick = Date.now();\n  let dirty = true;             // friend list needs rebuilding\n  let friendRefs = new Map();   // id -> { lvl, cost, btn, max, prod }\n  let settings = { theme: 'auto' };\n\n  // ---------- helpers\n  function toast(text, ms = 2200) {\n    const t = $('toast'); t.textContent = text; t.classList.add('show');\n    clearTimeout(toast.h); toast.h = setTimeout(() => t.classList.remove('show'), ms);\n  }\n  const starsStr = n => '★'.repeat(n);\n  const hearts = b => b ? '♥'.repeat(Math.min(b, 10)) : '';\n  function el(tag, cls, html) { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }\n  function img(path, alt = '') { const i = new Image(); i.src = SC.asset(path); i.alt = alt; i.draggable = false; return i; }\n  function save() { S.lastSeen = Date.now(); return SC.storage.save(S); }\n\n  // ---------- tabs\n  const tabBtns = [...document.querySelectorAll('.tabs button')];\n  function selectTab(name, focus) {\n    const b = tabBtns.find(x => x.dataset.tab === name); if (!b) return;\n    tabBtns.forEach(x => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1; });\n    document.querySelectorAll('.tab').forEach(t => t.classList.toggle('show', t.id === 'tab-' + name));\n    if (name === 'album') renderAlbum();\n    if (name === 'quests') renderQuests();\n    if (name === 'wish') renderWish();\n    if (focus) b.focus();\n  }\n  tabBtns.forEach(b => b.addEventListener('click', () => selectTab(b.dataset.tab)));\n  // arrow keys move along the tab bar\n  document.querySelector('.tabs').addEventListener('keydown', e => {\n    const i = tabBtns.indexOf(document.activeElement); if (i < 0) return;\n    const n = { ArrowLeft: i - 1, ArrowRight: i + 1, Home: 0, End: tabBtns.length - 1 }[e.key];\n    if (n === undefined) return;\n    e.preventDefault(); selectTab(tabBtns[(n + tabBtns.length) % tabBtns.length].dataset.tab, true);\n  });\n\n  // ---------- header + per-tick updates\n  function renderTop() {\n    $('stars').textContent = SC.fmt(S.stars);\n    $('gems').textContent = SC.fmt(S.gems);\n    $('income').textContent = '+' + SC.fmt(SC.income(S)) + '/s';\n    $('wishDot').classList.toggle('show', S.gems >= SC.BANNER.singleCost);\n    $('questDot').classList.toggle('show', SC.dailyReady(S) || SC.milestoneState(S).some(m => m.ready));\n  }\n\n  // ---------- café\n  function renderFriends() {\n    const box = $('friends'); box.innerHTML = ''; friendRefs.clear();\n    const ids = Object.keys(S.owned).sort((a, b) => {\n      const ra = SC.RARITY[SC.byId[a].rarity].stars, rb = SC.RARITY[SC.byId[b].rarity].stars;\n      return rb - ra || S.owned[a].since - S.owned[b].since;\n    });\n    for (const id of ids) {\n      const c = SC.byId[id], r = SC.RARITY[c.rarity];\n      const card = el('div', 'friend'); card.style.setProperty('--rc', r.color);\n      const pic = el('button', 'pic'); pic.type = 'button'; pic.setAttribute('aria-label', 'About ' + c.name); pic.appendChild(img(c.art, '')); pic.onclick = () => showDetail(id);\n      const info = el('div', 'info');\n      info.innerHTML = `<div class=\"name\">${c.name} <span class=\"rarity\">${starsStr(r.stars)}</span></div>\n        <div class=\"meta\"><span data-k=\"lvl\"></span> · <span data-k=\"prod\"></span> <span class=\"hearts\" data-k=\"bond\"></span></div>`;\n      const acts = el('div', 'acts');\n      const up = el('button', 'btn pri'); up.onclick = () => { if (SC.levelUp(S, id)) { updateFriends(); renderTop(); } };\n      const max = el('button', 'btn', 'Max'); max.title = 'Buy as many levels as you can afford'; max.setAttribute('aria-label', 'Max levels for ' + c.name);\n      max.onclick = () => { const n = SC.levelMax(S, id); if (n) { toast(`${c.name} +${n} level${n > 1 ? 's' : ''}!`); updateFriends(); renderTop(); } };\n      acts.append(up, max); info.appendChild(acts);\n      card.append(pic, info); box.appendChild(card);\n      friendRefs.set(id, { lvl: info.querySelector('[data-k=lvl]'), prod: info.querySelector('[data-k=prod]'), bond: info.querySelector('[data-k=bond]'), up, max });\n    }\n    dirty = false; updateFriends();\n  }\n  function updateFriends() {\n    for (const [id, r] of friendRefs) {\n      const c = SC.byId[id], o = S.owned[id], cost = SC.levelCost(c, o);\n      r.lvl.textContent = 'Lv ' + o.level;\n      r.prod.textContent = '✨' + SC.fmt(SC.power(c, o)) + '/s';\n      r.bond.textContent = hearts(o.bond);\n      r.up.innerHTML = `Level up ✨${SC.fmt(cost)}`; r.up.setAttribute('aria-label', `Level up ${c.name} for ${SC.fmt(cost)} stars`);\n      r.up.disabled = S.stars < cost; r.max.disabled = S.stars < cost;\n    }\n  }\n\n  // moon tapping\n  function tapMoon(x, y) {\n    const n = SC.tap(S);\n    const f = el('div', 'floater', '+' + SC.fmt(n) + '✨'); f.setAttribute('aria-hidden', 'true');\n    f.style.left = (x - 20 + (Math.random() * 30 - 15)) + 'px'; f.style.top = (y - 20) + 'px';\n    document.body.appendChild(f); setTimeout(() => f.remove(), 900);\n    const m = $('moon'); m.classList.add('pop'); setTimeout(() => m.classList.remove('pop'), 80);\n    renderTop(); updateFriends();\n  }\n  $('moon').addEventListener('pointerdown', e => tapMoon(e.clientX, e.clientY));\n  // keyboard: Space or Enter on the focused moon (a held key does not repeat)\n  $('moon').addEventListener('keydown', e => { if (e.repeat && (e.key === 'Enter' || e.key === ' ')) e.preventDefault(); });\n  $('moon').addEventListener('click', e => {\n    if (e.detail !== 0) return; // mouse and touch already tapped on pointerdown\n    const r = $('moon').getBoundingClientRect(); tapMoon(r.left + r.width / 2, r.top + r.height / 3);\n  });\n\n  // ---------- dialogs: focus moves in, Tab stays inside, Escape closes, focus returns\n  let returnFocus = null;\n  function openOverlay(id, focusId) {\n    if (!document.querySelector('.overlay.show')) returnFocus = document.activeElement;\n    $(id).classList.add('show'); setTimeout(() => $(focusId).focus(), 0);\n  }\n  function closeOverlay(id) {\n    $(id).classList.remove('show');\n    if (!document.querySelector('.overlay.show') && returnFocus && document.contains(returnFocus)) returnFocus.focus();\n  }\n  document.addEventListener('keydown', e => {\n    const ov = document.querySelector('.overlay.show');\n    if (ov) {\n      if (e.key === 'Escape') { e.preventDefault(); ov.id === 'results' ? closeResults() : closeOverlay('detail'); }\n      else if (e.key === 'Tab') {\n        const f = [...ov.querySelectorAll('button')].filter(b => !b.disabled && b.offsetParent);\n        const i = f.indexOf(document.activeElement);\n        if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }\n        else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }\n        else if (i < 0) { e.preventDefault(); f[0].focus(); }\n      }\n      return;\n    }\n    // 1–4 switch tabs\n    if (!e.ctrlKey && !e.altKey && !e.metaKey && /^[1-4]$/.test(e.key)) { e.preventDefault(); selectTab(tabBtns[+e.key - 1].dataset.tab, true); }\n  });\n\n  // ---------- wish\n  function renderWish() {\n    const f = SC.byId[SC.BANNER.rateUp];\n    $('featuredArt').src = SC.asset(f.art);\n    $('bannerName').textContent = SC.BANNER.name;\n    $('bannerDesc').innerHTML = `Featured: <b>${f.name}</b>, ${f.title} ${starsStr(5)}<br>Half of all SSR wishes are ${f.name}!`;\n    $('pity').textContent = SC.BANNER.pity - S.pity;\n    $('wish1').disabled = S.gems < SC.BANNER.singleCost;\n    $('wish10').disabled = S.gems < SC.BANNER.tenCost;\n  }\n  function doWish(n) {\n    const res = SC.wish(S, n);\n    if (!res) { toast('Not enough gems – try the Quests tab!'); return; }\n    save(); dirty = true; renderTop(); renderWish();\n    showResults(res);\n  }\n  $('wish1').onclick = () => doWish(1);\n  $('wish10').onclick = () => doWish(10);\n\n  let revealTimers = [];\n  function showResults(res) {\n    const box = $('resultCards'); box.innerHTML = ''; box.classList.toggle('single', res.length === 1);\n    revealTimers.forEach(clearTimeout); revealTimers = [];\n    res.forEach((r, i) => {\n      const c = r.char, rc = SC.RARITY[c.rarity];\n      const card = el('button', 'rcard ' + c.rarity); card.type = 'button'; card.style.setProperty('--rc', rc.color);\n      const back = el('div', 'back'); const cap = img('assets/capsule.svg'); back.appendChild(cap);\n      const face = el('div', 'face');\n      face.appendChild(img(c.art, c.name));\n      face.appendChild(el('b', null, c.name));\n      face.appendChild(el('small', null, starsStr(rc.stars)));\n      const note = r.kind === 'new' ? 'NEW' : r.kind === 'bond' ? 'Bond ' + r.bond : '+' + r.gems + '💎';\n      const badge = el('span', 'badge', note); if (r.kind !== 'new') badge.style.background = r.kind === 'bond' ? '#ff9ec7' : '#6b8cff';\n      face.appendChild(badge);\n      card.setAttribute('aria-label', `${c.name}, ${rc.label}, ${r.kind === 'new' ? 'new friend' : r.kind === 'bond' ? 'bond ' + r.bond : r.gems + ' gems'}`);\n      card.append(back, face);\n      card.onclick = () => card.classList.add('open');\n      box.appendChild(card);\n      revealTimers.push(setTimeout(() => card.classList.add('open'), 450 + i * (res.length === 1 ? 0 : 260)));\n    });\n    openOverlay('results', 'resultsClose');\n    const best = res.find(r => r.char.rarity === 'SSR');\n    if (best) Host.notify(`✨ ${best.char.name} joined your café!`); // PortD puts the program name in front\n  }\n  function closeResults() { revealTimers.forEach(clearTimeout); closeOverlay('results'); if (dirty) renderFriends(); }\n  $('resultsSkip').onclick = () => document.querySelectorAll('.rcard').forEach(c => c.classList.add('open'));\n  $('resultsClose').onclick = closeResults;\n\n  // ---------- album + detail\n  function renderAlbum() {\n    const box = $('album'); box.innerHTML = '';\n    $('albumCount').textContent = `${SC.ownedCount(S)} / ${SC.CHARACTERS.length}`;\n    for (const c of SC.CHARACTERS) {\n      const own = S.owned[c.id], rc = SC.RARITY[c.rarity];\n      const a = el(own ? 'button' : 'div', 'acard' + (own ? '' : ' locked')); a.style.setProperty('--rc', rc.color);\n      if (own) { a.type = 'button'; a.setAttribute('aria-label', `${c.name}, ${rc.label}, level ${own.level}`); }\n      else { a.setAttribute('role', 'img'); a.setAttribute('aria-label', `Not met yet, ${rc.label}`); }\n      a.appendChild(img(c.art, ''));\n      a.appendChild(el('b', null, own ? c.name : '???'));\n      a.appendChild(el('span', 'rarity', starsStr(rc.stars)));\n      if (own) a.onclick = () => showDetail(c.id);\n      box.appendChild(a);\n    }\n  }\n  function showDetail(id) {\n    const c = SC.byId[id], o = S.owned[id], rc = SC.RARITY[c.rarity];\n    document.querySelector('.detailCard').style.setProperty('--rc', rc.color);\n    $('dArt').src = SC.asset(c.art);\n    $('dRarity').style.setProperty('--rc', rc.color);\n    $('dRarity').textContent = starsStr(rc.stars) + ' ' + rc.label;\n    $('dName').textContent = c.name; $('dTitle').textContent = c.title; $('dQuote').textContent = '“' + c.quote + '”';\n    const days = Math.max(0, Math.floor((Date.now() - o.since) / 864e5));\n    $('dStats').innerHTML = `<span>Level</span><span>${o.level}</span><span>Bond</span><span>${o.bond} / ${SC.BALANCE.maxBond} ${hearts(o.bond)}</span>\n      <span>Stars per second</span><span>${SC.fmt(SC.power(c, o))}</span><span>Friends for</span><span>${days} day${days === 1 ? '' : 's'}</span>`;\n    openOverlay('detail', 'dClose');\n  }\n  $('dClose').onclick = () => closeOverlay('detail');\n  $('detail').addEventListener('click', e => { if (e.target.id === 'detail') closeOverlay('detail'); });\n\n  // ---------- quests\n  function renderQuests() {\n    const ready = SC.dailyReady(S);\n    $('daily').disabled = !ready; $('daily').textContent = ready ? `Claim 💎 ${SC.BALANCE.dailyGems}` : 'Come back tomorrow ♥';\n    $('shopPrice').textContent = SC.fmt(SC.shopPrice(S)); $('shop').disabled = S.stars < SC.shopPrice(S);\n    const box = $('milestones'); box.innerHTML = '';\n    const list = SC.milestoneState(S).sort((a, b) => (b.ready - a.ready) || (a.done - b.done));\n    for (const m of list) {\n      const row = el('div', 'ms' + (m.done ? ' done' : ''));\n      row.appendChild(el('span', null, m.done ? '✅' : m.ready ? '🎀' : '⬜'));\n      row.appendChild(el('span', 'txt', m.text));\n      row.appendChild(el('span', 'reward', '💎 ' + m.gems));\n      if (m.ready) { const b = el('button', 'btn small pri', 'Claim'); b.onclick = () => { const g = SC.claimMilestone(S, m.id); toast(`+${g} 💎`); save(); renderQuests(); renderTop(); }; row.appendChild(b); }\n      box.appendChild(row);\n    }\n    const st = $('stats');\n    st.innerHTML = '';\n    [['Stars earned', SC.fmt(S.lifetime)], ['Wishes made', S.pulls], ['Moon taps', S.taps], ['Friends', `${SC.ownedCount(S)} / ${SC.CHARACTERS.length}`],\n     ['Café opened', new Date(S.created).toLocaleDateString()]].forEach(([a, b]) => { st.appendChild(el('span', null, a)); st.appendChild(el('span', null, String(b))); });\n  }\n  $('daily').onclick = () => { const g = SC.claimDaily(S); if (g) { toast(`Daily gift: +${g} 💎`); save(); renderQuests(); renderTop(); } };\n  $('shop').onclick = () => { if (SC.buyGems(S)) { toast(`+${SC.BALANCE.shopGems} 💎`); renderQuests(); renderTop(); updateFriends(); } };\n  let resetAt = 0;\n  $('reset').onclick = async () => {\n    if (Date.now() - resetAt > 3000) { resetAt = Date.now(); toast('Click again to erase your café and start over'); return; }\n    await SC.storage.wipe(); S = SC.newState(); save(); renderFriends(); renderTop(); renderQuests(); toast('A fresh start ♥');\n  };\n\n  // ---------- theme (added in the port; follows the system by default)\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1], 1500); };\n\n  // ---------- loop\n  function loop() {\n    const now = Date.now(), dt = (now - lastTick) / 1000; lastTick = now;\n    if (dt > 120) { const off = SC.offline(S, now); if (off) toast(`While you were away (${SC.fmtTime(off.secs)}): +${SC.fmt(off.earned)} ✨`, 4000); }\n    else if (dt > 0) SC.tick(S, dt);\n    if (dirty) renderFriends(); else updateFriends();\n    renderTop();\n    if ($('tab-quests').classList.contains('show')) { $('shop').disabled = S.stars < SC.shopPrice(S); }\n    if ($('tab-wish').classList.contains('show')) { $('wish1').disabled = S.gems < SC.BANNER.singleCost; $('wish10').disabled = S.gems < SC.BANNER.tenCost; }\n  }\n\n  // ---------- start\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    const loaded = await SC.storage.load();\n    S = loaded ? SC.repair(loaded) : SC.newState();\n    const off = loaded ? SC.offline(S) : null;\n    renderFriends(); renderTop(); renderWish();\n    if (!loaded) toast('Welcome to Starlight Café! Mochi is here to help ♥', 3500);\n    else if (off) toast(`Welcome back! Your friends earned ✨${SC.fmt(off.earned)} in ${SC.fmtTime(off.secs)}`, 4500);\n    lastTick = Date.now();\n    setInterval(loop, 200);\n    setInterval(save, 5000);\n    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') save(); });\n    window.addEventListener('pagehide', save);\n    Host.setTitle('Starlight Café');\n    window.__sc = { get S() { return S; }, set S(v) { S = v; dirty = true; }, showResults, renderQuests, selectTab, get settings() { return settings; }, ready: true };\n  })();\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Starlight Café – styles */\n:root {\n  --bg1: #ffe6f2; --bg2: #e9e1ff; --card: #ffffffcc; --text: #5a3d5c; --muted: #9a7f9c;\n  --pink: #ff7eb6; --purple: #a98bff; --gold: #ffc94d; --blue: #8ec5ff;\n  --R: #8ec5ff; --SR: #c79bff; --SSR: #ffc94d;\n  --radius: 16px;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; }\nbody {\n  font: 14px \"Nunito\", \"Varela Round\", \"Segoe UI\", system-ui, sans-serif;\n  color: var(--text);\n  background: url(assets/bg.svg), linear-gradient(160deg, var(--bg1), var(--bg2));\n  user-select: none; -webkit-user-select: none; overflow: hidden;\n}\n#app { display: flex; flex-direction: column; height: 100%; }\nh2 { margin: 16px 0 8px; font-size: 17px; }\nh2 small { font-weight: 400; color: var(--muted); }\nh3 { margin: 0 0 4px; font-size: 15px; }\n.muted { color: var(--muted); }\n.center { text-align: center; }\n\n/* header */\n.top { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #ffffff99; backdrop-filter: blur(6px); box-shadow: 0 2px 10px #c9a7d633; }\n.logo { width: 30px; height: 30px; }\n.title { font-weight: 800; font-size: 16px; letter-spacing: .3px; color: #c25a95; white-space: nowrap; }\n.pills { margin-left: auto; display: flex; gap: 6px; }\n.pill { background: #fff; border-radius: 999px; padding: 4px 10px; display: flex; align-items: baseline; gap: 4px; box-shadow: 0 1px 4px #c9a7d655; white-space: nowrap; }\n.pill b { font-variant-numeric: tabular-nums; }\n.pill small { color: var(--muted); font-size: 11px; }\n.pill.gem b { color: #6b8cff; }\n\nmain { flex: 1; overflow-y: auto; padding: 4px 14px 16px; }\n.tab { display: none; animation: fadeIn .25s; }\n.tab.show { display: block; }\n@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } }\n\n/* bottom tabs */\n.tabs { display: flex; background: #ffffffcc; backdrop-filter: blur(6px); box-shadow: 0 -2px 10px #c9a7d633; }\n.tabs button { flex: 1; border: 0; background: none; padding: 6px 0 8px; font-size: 20px; cursor: pointer; color: var(--muted); position: relative; font-family: inherit; }\n.tabs button span { display: block; font-size: 11px; font-weight: 700; }\n.tabs button.on { color: #c25a95; }\n.tabs button.on::before { content: ''; position: absolute; top: 0; left: 30%; right: 30%; height: 3px; border-radius: 3px; background: var(--pink); }\n.dot { position: absolute; top: 6px; right: calc(50% - 18px); width: 9px; height: 9px; border-radius: 50%; background: #ff4f8b; display: none; }\n.dot.show { display: block; }\n\n/* buttons */\n.btn { border: 0; border-radius: 12px; padding: 8px 14px; font-family: inherit; font-weight: 700; font-size: 13px; color: var(--text); background: #fff; cursor: pointer; box-shadow: 0 2px 0 #e2cbe8; transition: transform .08s; }\n.btn:hover:not(:disabled) { filter: brightness(1.04); }\n.btn:active:not(:disabled) { transform: translateY(2px); box-shadow: none; }\n.btn:disabled { opacity: .45; cursor: default; }\n.btn.pri { background: linear-gradient(135deg, var(--pink), var(--purple)); color: #fff; box-shadow: 0 2px 0 #b06bc2; }\n.btn.small { padding: 5px 10px; font-size: 12px; }\n.btn.danger { color: #d64a6b; }\n.btn.big { padding: 12px 22px; font-size: 16px; min-width: 150px; }\n.btn small { display: block; font-size: 12px; opacity: .9; }\n\n/* café */\n.moonbox { text-align: center; padding: 10px 0 0; }\n.moon { border: 0; background: none; cursor: pointer; width: 130px; height: 130px; padding: 0; border-radius: 50%; position: relative; animation: float 4s ease-in-out infinite; filter: drop-shadow(0 6px 14px #b98bff66); -webkit-tap-highlight-color: transparent; }\n.moon img { width: 100%; height: 100%; transition: transform .08s; pointer-events: none; }\n.moon.pop img { transform: scale(.92); }\n@keyframes float { 50% { transform: translateY(-6px); } }\n.hint { color: var(--muted); font-size: 12px; margin-top: 4px; }\n.floater { position: fixed; pointer-events: none; font-weight: 800; color: #c25a95; animation: up 0.9s ease-out forwards; text-shadow: 0 1px 0 #fff; z-index: 50; }\n@keyframes up { to { transform: translateY(-50px); opacity: 0; } }\n\n.friends { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }\n.friend { display: flex; gap: 10px; align-items: center; background: var(--card); border-radius: var(--radius); padding: 8px; box-shadow: 0 2px 8px #c9a7d633; border-left: 4px solid var(--rc); }\n.friend .pic { width: 64px; height: 64px; border-radius: 14px; background: radial-gradient(circle at 50% 60%, #fff, color-mix(in srgb, var(--rc) 35%, #fff)); cursor: pointer; flex: none; }\n.friend .pic img { width: 100%; height: 100%; animation: bob 3s ease-in-out infinite; }\n@keyframes bob { 50% { transform: translateY(-2px) rotate(-1.5deg); } }\n.friend .info { flex: 1; min-width: 0; }\n.friend .name { font-weight: 800; }\n.friend .meta { font-size: 12px; color: var(--muted); }\n.friend .acts { display: flex; gap: 4px; margin-top: 4px; }\n.friend .acts .btn { padding: 5px 8px; font-size: 12px; white-space: nowrap; }\n.hearts { color: #ff7eb6; font-size: 11px; letter-spacing: -1px; }\n.rarity { font-weight: 800; font-size: 11px; color: var(--rc); text-shadow: 0 0 1px #fff; }\n\n/* wish */\n.banner { display: flex; gap: 12px; align-items: center; margin-top: 10px; padding: 12px; border-radius: 20px; background: linear-gradient(135deg, #fff6d6, #ffe0f0 50%, #e6dcff); box-shadow: 0 4px 16px #c9a7d655; position: relative; overflow: hidden; }\n.banner::after { content: ''; position: absolute; inset: 0; background: url(assets/bg.svg); opacity: .8; pointer-events: none; }\n.bannerArt { width: 150px; height: 150px; flex: none; border-radius: 50%; background: radial-gradient(circle, #fff 30%, #ffe9a8); box-shadow: 0 0 0 4px #fff, 0 0 30px #ffc94daa; }\n.bannerArt img { width: 100%; height: 100%; animation: bob 3s ease-in-out infinite; }\n.bannerTag { display: inline-block; background: var(--gold); color: #7a4a00; font-weight: 800; font-size: 11px; padding: 2px 8px; border-radius: 999px; }\n.banner h2 { margin: 6px 0 4px; color: #c25a95; }\n.banner p { margin: 4px 0; }\n.rates { font-size: 12px; color: var(--muted); }\n.wishBtns { display: flex; gap: 12px; justify-content: center; margin: 18px 0 8px; flex-wrap: wrap; }\n\n/* results overlay */\n.overlay { position: fixed; inset: 0; background: #3b2350cc; display: none; align-items: center; justify-content: center; z-index: 100; padding: 12px; }\n.overlay.show { display: flex; animation: fadeIn .2s; }\n.resultsInner { width: 100%; max-width: 640px; }\n.resultCards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }\n.resultCards.single { grid-template-columns: 1fr; max-width: 220px; margin: 0 auto; }\n.rcard { aspect-ratio: 3/4; border-radius: 14px; position: relative; perspective: 600px; cursor: pointer; }\n.rcard .face, .rcard .back { position: absolute; inset: 0; border-radius: 14px; backface-visibility: hidden; transition: transform .5s; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n.rcard .back { background: linear-gradient(135deg, #fff, #f3e9ff); color: var(--rc); }\n.rcard .back img { width: 70%; animation: wobble .9s ease-in-out infinite; }\n@keyframes wobble { 25% { transform: rotate(-8deg); } 75% { transform: rotate(8deg); } }\n.rcard .face { transform: rotateY(180deg); background: radial-gradient(circle at 50% 40%, #fff, color-mix(in srgb, var(--rc) 45%, #fff)); box-shadow: 0 0 0 3px var(--rc), 0 0 18px var(--rc); padding: 4px; text-align: center; }\n.rcard.open .face { transform: rotateY(0); }\n.rcard.open .back { transform: rotateY(-180deg); }\n.rcard .face img { width: 92%; }\n.rcard .face b { font-size: 13px; }\n.rcard .face small { font-size: 10px; color: var(--text); }\n.rcard .badge { position: absolute; top: 4px; left: 4px; background: #ff4f8b; color: #fff; font-size: 10px; font-weight: 800; padding: 1px 6px; border-radius: 999px; }\n.rcard.SSR.open { animation: shine 1.2s ease-out; }\n@keyframes shine { 0% { filter: brightness(2.2); transform: scale(1.12); } 100% { filter: none; transform: none; } }\n.resultsFoot { display: flex; justify-content: center; gap: 10px; margin-top: 14px; }\n\n/* album */\n.album { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; }\n.acard { background: var(--card); border-radius: var(--radius); padding: 6px; text-align: center; cursor: pointer; box-shadow: 0 2px 8px #c9a7d633; border-bottom: 4px solid var(--rc); }\n.acard img { width: 100%; aspect-ratio: 1; border-radius: 12px; background: radial-gradient(circle at 50% 60%, #fff, color-mix(in srgb, var(--rc) 30%, #fff)); }\n.acard.locked img { background: none; filter: brightness(0) opacity(.22); }\n.acard.locked { background: linear-gradient(#ffffffaa, #f3ecff); }\n.acard.locked { cursor: default; }\n.acard b { display: block; font-size: 13px; }\n\n/* detail */\n.detailCard { background: #fff; border-radius: 22px; padding: 16px; max-width: 360px; width: 100%; text-align: center; box-shadow: 0 0 0 4px var(--rc); }\n.detailCard img { width: 190px; height: 190px; border-radius: 50%; background: radial-gradient(circle, #fff 30%, color-mix(in srgb, var(--rc) 40%, #fff)); }\n.detailCard h2 { margin: 4px 0 0; }\n.quote { font-style: italic; margin: 10px 0; }\n.dStats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; font-size: 13px; margin-bottom: 12px; text-align: left; }\n.dStats span:nth-child(odd) { color: var(--muted); }\n\n/* quests */\n.row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 10px; }\n.card { background: var(--card); border-radius: var(--radius); padding: 12px; box-shadow: 0 2px 8px #c9a7d633; }\n.card p { margin: 2px 0 8px; font-size: 12px; }\n.milestones { display: flex; flex-direction: column; gap: 6px; }\n.ms { display: flex; align-items: center; gap: 8px; background: var(--card); border-radius: 12px; padding: 8px 10px; }\n.ms .txt { flex: 1; }\n.ms.done { opacity: .55; }\n.ms .reward { color: #6b8cff; font-weight: 700; font-size: 12px; }\n.stats { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; font-size: 13px; }\n.stats span:nth-child(even) { font-weight: 700; text-align: right; }\n\n.toast { position: fixed; left: 50%; bottom: 76px; transform: translateX(-50%); background: #5a3d5cee; color: #fff; padding: 8px 14px; border-radius: 12px; font-weight: 700; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 200; text-align: center; max-width: 90%; }\n.toast.show { opacity: 1; }\n\n@media (max-width: 460px) {\n  .title { display: none; }\n  .resultCards { grid-template-columns: repeat(3, 1fr); }\n  .bannerArt { width: 100px; height: 100px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation: none !important; transition: none !important; }\n}\n\n/* ---------- added in the PortD 1.0 port: theme button, keyboard focus, dark theme ---------- */\n.iconBtn { border: 0; background: #fff; color: var(--text); width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; box-shadow: 0 1px 4px #c9a7d655; flex: none; padding: 0; }\n.tabs button i { font-style: normal; }\n.moon { touch-action: manipulation; }\n.friend .pic { border: 0; padding: 0; font: inherit; }\n.acard { border: 0; font: inherit; color: inherit; display: block; width: 100%; }\n.rcard { border: 0; padding: 0; font: inherit; color: inherit; background: none; }\n:focus { outline: none; }\n:focus-visible { outline: 3px solid #6b8cff; outline-offset: 2px; }\n.moon:focus-visible { outline-offset: 4px; }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n\n:root[data-theme=\"dark\"] {\n  --bg1: #2b1d3d; --bg2: #171a33; --card: #2f2547dd; --text: #f3e6f6; --muted: #b8a3c6;\n  --face: #3b2f55; --line: #120c1f;\n  color-scheme: dark;\n}\n[data-theme=\"dark\"] .top { background: #241a36cc; box-shadow: 0 2px 10px #0006; }\n[data-theme=\"dark\"] .title, [data-theme=\"dark\"] .tabs button.on, [data-theme=\"dark\"] .banner h2 { color: #ff9fd0; }\n[data-theme=\"dark\"] .pill, [data-theme=\"dark\"] .iconBtn { background: var(--face); box-shadow: 0 1px 4px #0006; }\n[data-theme=\"dark\"] .pill.gem b, [data-theme=\"dark\"] .ms .reward { color: #9fb4ff; }\n[data-theme=\"dark\"] .tabs { background: #241a36dd; box-shadow: 0 -2px 10px #0006; }\n[data-theme=\"dark\"] .btn { background: var(--face); color: var(--text); box-shadow: 0 2px 0 var(--line); }\n[data-theme=\"dark\"] .btn.pri { background: linear-gradient(135deg, #e0609e, #8a6ce6); color: #fff; box-shadow: 0 2px 0 #5b3a80; }\n[data-theme=\"dark\"] .btn.danger { color: #ff8fa8; }\n[data-theme=\"dark\"] .friend, [data-theme=\"dark\"] .acard, [data-theme=\"dark\"] .card { box-shadow: 0 2px 8px #0005; }\n[data-theme=\"dark\"] .friend .pic { background: radial-gradient(circle at 50% 60%, #f6eefa, color-mix(in srgb, var(--rc) 45%, #3b2f55)); }\n[data-theme=\"dark\"] .acard img { background: radial-gradient(circle at 50% 60%, #f6eefa, color-mix(in srgb, var(--rc) 40%, #3b2f55)); }\n[data-theme=\"dark\"] .acard.locked { background: linear-gradient(#2f2547, #221a36); }\n[data-theme=\"dark\"] .acard.locked img { background: none; filter: brightness(0) invert(1) opacity(.16); }\n[data-theme=\"dark\"] .banner { background: linear-gradient(135deg, #4a3a24, #4a2440 50%, #2d2555); box-shadow: 0 4px 16px #0006; }\n[data-theme=\"dark\"] .bannerArt { box-shadow: 0 0 0 4px #f6eefa, 0 0 30px #ffc94d66; }\n[data-theme=\"dark\"] .rcard .back { background: linear-gradient(135deg, #3b2f55, #2a2140); }\n[data-theme=\"dark\"] .rcard .face { background: radial-gradient(circle at 50% 40%, #f6eefa, color-mix(in srgb, var(--rc) 50%, #3b2f55)); color: #3d2a44; }\n[data-theme=\"dark\"] .rcard .face small { color: #3d2a44; }\n[data-theme=\"dark\"] .detailCard { background: #2a2140; }\n[data-theme=\"dark\"] .detailCard img { background: radial-gradient(circle, #f6eefa 30%, color-mix(in srgb, var(--rc) 45%, #3b2f55)); }\n[data-theme=\"dark\"] .floater { color: #ff9fd0; text-shadow: 0 1px 0 #000; }\n[data-theme=\"dark\"] .rarity { text-shadow: 0 0 1px #000; }\n[data-theme=\"dark\"] .overlay { background: #0d0818d9; }\n[data-theme=\"dark\"] .toast { background: #f3e6f6ee; color: #3d2a44; }\n[data-theme=\"dark\"] :focus-visible { outline-color: #9fb4ff; }\n"
  }
 }
}