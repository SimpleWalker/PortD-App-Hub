{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "zip-viewer",
 "name": "Zip Viewer",
 "version": "1.0.0",
 "description": "Look inside .zip files (and .docx, .xlsx, .pptx, .jar): browse, preview text and pictures, and extract.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 980,
 "height": 620,
 "singleInstance": false,
 "fileTypes": [
  {
   "ext": ".zip",
   "name": "Zip archive",
   "icon": "glyph:folder"
  },
  {
   "ext": ".docx",
   "name": "Word document",
   "icon": "glyph:text"
  },
  {
   "ext": ".xlsx",
   "name": "Excel workbook",
   "icon": "glyph:table"
  },
  {
   "ext": ".pptx",
   "name": "PowerPoint presentation",
   "icon": "glyph:chart"
  },
  {
   "ext": ".jar",
   "name": "Java archive",
   "icon": "glyph:code"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M6 14a4 4 0 0 1 4-4h14l5 5h25a4 4 0 0 1 4 4v31a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4z\" fill=\"#e0a526\"/><path d=\"M6 22h52v28a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4z\" fill=\"#f5c34b\"/><path d=\"M30 22v4h4v4h-4v4h4v4h-4v4h4v4\" stroke=\"#7a5200\" stroke-width=\"2.5\" fill=\"none\"/><rect x=\"28\" y=\"44\" width=\"8\" height=\"7\" rx=\"1.5\" fill=\"#7a5200\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"zip-viewer\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Zip Viewer</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Zip Viewer\">\n    <button id=\"openBtn\" class=\"btn\" title=\"Open a zip archive (Ctrl+O)\">Open…</button>\n    <span class=\"sep\"></span>\n    <button id=\"saveBtn\" class=\"btn primary\" title=\"Save the chosen file with the Save dialog (Ctrl+S)\" disabled>Save file…</button>\n    <button id=\"extractBtn\" class=\"btn\" title=\"Extract the ticked files\" disabled>Extract ticked…</button>\n    <button id=\"allBtn\" class=\"btn\" title=\"Extract every file\" disabled>Extract all…</button>\n    <span class=\"grow\"></span>\n    <input id=\"search\" class=\"field\" type=\"search\" placeholder=\"Search names\" aria-label=\"Search file names\" title=\"Search the names in the archive (Ctrl+F)\" autocomplete=\"off\" disabled>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n  </div>\n  <div id=\"info\" class=\"info\" role=\"status\"></div>\n  <div class=\"main\">\n    <section class=\"left\" aria-label=\"Contents\">\n      <div class=\"thead\" aria-hidden=\"true\"><span></span><span class=\"c-name\">Name</span><span class=\"c-size\">Size</span><span class=\"c-pack\">Packed</span><span class=\"c-date\">Modified</span></div>\n      <div id=\"tree\" class=\"tree\" role=\"tree\" aria-label=\"Contents of the archive\" aria-multiselectable=\"false\" tabindex=\"0\"></div>\n    </section>\n    <section id=\"side\" class=\"side\" aria-label=\"Details and preview\">\n      <div id=\"empty\" class=\"empty\">\n        <div>\n          <img src=\"icon.svg\" alt=\"\" width=\"72\" height=\"72\">\n          <h1>Zip Viewer</h1>\n          <p>Open a .zip file, or a .docx, .xlsx, .pptx or .jar (they are zip files too), to see what is inside.</p>\n          <button id=\"openBtn2\" class=\"btn primary\">Open…</button>\n        </div>\n      </div>\n      <div id=\"details\" hidden></div>\n    </section>\n  </div>\n</div>\n\n<div id=\"exDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"exTitle\" aria-describedby=\"exMsg\">\n    <h2 id=\"exTitle\">Extract</h2>\n    <p id=\"exMsg\"></p>\n    <div class=\"choices\">\n      <button id=\"exAll\" class=\"choice\" data-act=\"folder\"><b>All at once</b><span id=\"exAllMsg\"></span></button>\n      <button id=\"exOne\" class=\"choice\" data-act=\"one\"><b>One by one</b><span>A Save dialog for each file, so you choose where each one goes.</span></button>\n    </div>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button></div>\n  </div>\n</div>\n\n<div id=\"progDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"progTitle\">\n    <h2 id=\"progTitle\">Extracting</h2>\n    <progress id=\"progBar\" max=\"1\" value=\"0\"></progress>\n    <p id=\"progMsg\" aria-live=\"polite\"></p>\n    <div class=\"dacts\"><button id=\"progStop\" class=\"btn\" data-act=\"stop\">Stop</button></div>\n  </div>\n</div>\n\n<div id=\"doneDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"doneTitle\">\n    <h2 id=\"doneTitle\">Done</h2>\n    <p id=\"doneMsg\"></p>\n    <div id=\"donePath\" class=\"pathbox mono\" tabindex=\"0\"></div>\n    <ul id=\"doneList\" class=\"problems\"></ul>\n    <div class=\"dacts\"><button id=\"doneCopy\" class=\"btn\">Copy the folder path</button><button class=\"btn primary\" data-act=\"close\">OK</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/zip.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Zip Viewer: the window. A folder tree of the archive, details and a preview of the chosen entry, and extracting:\n   one file through the Save dialog, or several either one by one or all at once into Zip Viewer's own folder\n   (a program can only write to its own folder or to a file the user picks: PortD has no folder picker). */\n(function () {\n  'use strict';\n  const Z = window.Zip, $ = id => document.getElementById(id);\n  const treeEl = $('tree');\n  const num = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => num(n) + ' ' + (n === 1 ? w : ws || w + 's');\n  const ONE_BY_ONE_MAX = 30;\n\n  let settings = { theme: 'auto' };\n  let arc = null;                // { name, bytes, entries, tree, comment }\n  let expanded = new Set(), ticked = new Set(), cur = null, rows = [], q = '';\n  let preview = { seq: 0, url: null };\n\n  /* ---------- helpers ---------- */\n  function h(tag, attrs, ...kids) {\n    const e = document.createElement(tag);\n    for (const k in attrs || {}) { const v = attrs[k]; if (v == null || v === false) continue; if (k === 'class') e.className = v; else if (k === 'text') e.textContent = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v === true ? '' : v); }\n    for (const k of kids.flat()) if (k != null) e.append(k);\n    return e;\n  }\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2600); }\n  const fmtDate = d => d ? d.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '';\n  const base = p => p.split('/').pop();\n  function b64(bytes) { let s = ''; for (let i = 0; i < bytes.length; i += 32768) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 32768)); return btoa(s); }\n  function fromDataUrl(d) {\n    const i = d.indexOf(','), head = d.slice(0, i);\n    if (!/;base64$/i.test(head)) return new TextEncoder().encode(decodeURIComponent(d.slice(i + 1)));\n    const s = atob(d.slice(i + 1)), out = new Uint8Array(s.length);\n    for (let k = 0; k < s.length; k++) out[k] = s.charCodeAt(k);\n    return out;\n  }\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, [tabindex=\"0\"]')].filter(e => !e.disabled && e.offsetParent);\n    const f = first ? ov.querySelector(first) : focusables()[0]; if (f) f.focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus && document.contains(back)) back.focus(); else treeEl.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b && ov.contains(b) && !b.disabled) done(b.dataset.act); else if (e.target === ov && id !== 'progDlg') done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done(id === 'progDlg' ? 'stop' : 'cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n      ov.done = done;\n    });\n  }\n\n  /* ---------- opening an archive ---------- */\n  function show(name, bytes) {\n    let r;\n    try { r = Z.read(bytes); }\n    catch (e) { showError(name, e.message); return; }\n    arc = { name, bytes, entries: r.entries, tree: Z.tree(r.entries), comment: r.comment, zip64: r.zip64 };\n    expanded = new Set(); ticked = new Set(); cur = null; q = ''; $('search').value = '';\n    if (r.entries.length <= 300) for (const [k] of arc.tree.dirs) expanded.add(k);\n    for (const id of ['saveBtn', 'extractBtn', 'allBtn', 'search']) $(id).disabled = false;\n    Host.setTitle(name + ' - Zip Viewer');\n    drawInfo(); drawTree();\n    if (rows.length) choose(0);\n    treeEl.focus();\n  }\n  function showError(name, msg) {\n    arc = null; rows = []; treeEl.textContent = ''; $('info').textContent = '';\n    for (const id of ['saveBtn', 'extractBtn', 'allBtn', 'search']) $(id).disabled = true;\n    $('details').hidden = true; $('empty').hidden = false;\n    $('empty').querySelector('h1').textContent = 'Could not open ' + name;\n    $('empty').querySelector('p').textContent = msg;\n    Host.setTitle('Zip Viewer');\n    $('openBtn2').focus();\n  }\n  async function openFile() {\n    try {\n      if (Host.inPortD) {\n        const r = await PortD.ui.openFile({ title: 'Open an archive', types: ['.zip', '.docx', '.xlsx', '.pptx', '.jar'] });\n        if (r) await openPath(r);\n      } else {\n        const i = h('input', { type: 'file', accept: '.zip,.docx,.xlsx,.pptx,.jar' });\n        i.onchange = async () => { const f = i.files[0]; if (f) show(f.name, new Uint8Array(await f.arrayBuffer())); };\n        i.click();\n      }\n    } catch (e) { toast('Could not open the file: ' + e.message, 5000); }\n  }\n  async function openPath(o) {\n    try {\n      const d = await PortD.fs.read(o.path);\n      if (typeof d !== 'string' || !/^data:/.test(d)) { showError(o.name, 'PortD holds this file as text, so it is not a zip archive (or it was changed into text).'); return; }\n      show(o.name, fromDataUrl(d));\n    } catch (e) { showError(o.name, e.message); }\n  }\n  $('openBtn').onclick = $('openBtn2').onclick = openFile;\n\n  /* ---------- the summary line ---------- */\n  function drawInfo() {\n    const t = arc.tree, info = $('info'); info.textContent = '';\n    const folders = (function count(n) { let c = 0; for (const d of n.dirs.values()) c += 1 + count(d); return c; })(t);\n    info.append(h('b', null, arc.name), ' · ' + plural(t.count, 'file') + (folders ? ' in ' + plural(folders, 'folder') : '') + ' · ' + Z.size(t.size) + ', packed ' + Z.size(t.csize));\n    const bad = arc.entries.filter(e => Z.problem(e)).length, unsafe = arc.entries.filter(e => e.unsafe).length, renamed = arc.entries.filter(e => e.renamed && !e.unsafe).length;\n    if (bad) info.append(h('span', { class: 'warn' }, ' ⚠ ' + plural(bad, 'file') + ' cannot be opened here'));\n    if (unsafe) info.append(h('span', { class: 'warn' }, ' ⚠ ' + plural(unsafe, 'name') + ' tried to reach outside the archive\\'s folder and ' + (unsafe === 1 ? 'was' : 'were') + ' made safe'));\n    if (renamed) info.append(h('span', { class: 'note' }, ' · ' + plural(renamed, 'name') + ' had characters PortD does not allow, replaced with _'));\n    if (arc.comment) info.append(h('div', { class: 'comment' }, 'Comment: ' + arc.comment));\n  }\n\n  /* ---------- the tree ---------- */\n  const sortName = (a, b) => a.localeCompare(b, 'en', { sensitivity: 'base', numeric: true });\n  function buildRows() {\n    rows = [];\n    if (!arc) return;\n    if (q) {\n      const ql = q.toLowerCase();\n      for (const e of arc.entries) if (!e.dir && e.path.toLowerCase().includes(ql)) rows.push({ key: 'f' + e.index, kind: 'f', level: 1, e, label: e.path });\n      rows.sort((a, b) => sortName(a.label, b.label));\n      return;\n    }\n    (function walk(node, level) {\n      for (const name of [...node.dirs.keys()].sort(sortName)) {\n        const d = node.dirs.get(name);\n        rows.push({ key: 'd' + d.path, kind: 'd', level, d, label: name });\n        if (expanded.has(d.path)) walk(d, level + 1);\n      }\n      for (const e of node.files.slice().sort((a, b) => sortName(base(a.path), base(b.path)))) rows.push({ key: 'f' + e.index, kind: 'f', level, e, label: base(e.path) });\n    })(arc.tree, 1);\n  }\n  const filesUnder = d => { const out = []; (function w(n) { out.push(...n.files); for (const c of n.dirs.values()) w(c); })(d); return out; };\n  function tickState(r) {\n    if (r.kind === 'f') return ticked.has(r.e.index) ? 'true' : 'false';\n    const fs = filesUnder(r.d); if (!fs.length) return 'false';\n    const n = fs.filter(e => ticked.has(e.index)).length;\n    return n === 0 ? 'false' : n === fs.length ? 'true' : 'mixed';\n  }\n  function marked(text) {\n    if (!q) return text;\n    const i = text.toLowerCase().indexOf(q.toLowerCase()); if (i < 0) return text;\n    return [text.slice(0, i), h('mark', null, text.slice(i, i + q.length)), text.slice(i + q.length)];\n  }\n  function drawTree() {\n    buildRows();\n    const frag = document.createDocumentFragment();\n    rows.forEach((r, i) => {\n      const st = tickState(r), isCur = r.key === cur;\n      const prob = r.kind === 'f' && Z.problem(r.e), unsafe = r.kind === 'f' && r.e.unsafe;\n      const label = r.label + (r.kind === 'd' ? ', folder, ' + plural(r.d.count, 'file') : ', ' + Z.size(r.e.usize)) + (prob ? ', cannot be opened here' : '') + (unsafe ? ', unsafe name made safe' : '') + (st === 'true' ? ', ticked' : st === 'mixed' ? ', partly ticked' : '');\n      const row = h('div', { class: 'row' + (isCur ? ' cur' : '') + (prob ? ' bad' : ''), id: 'r-' + i, role: 'treeitem', 'aria-level': String(r.level), 'aria-selected': String(isCur), 'aria-checked': st, 'aria-label': label, 'data-i': String(i), style: '--lv:' + (r.level - 1) },\n        h('span', { class: 'chk ' + st, 'aria-hidden': 'true', title: 'Tick to extract' }),\n        h('span', { class: 'cell' },\n          h('span', { class: 'tw', 'aria-hidden': 'true' }, r.kind === 'd' ? (expanded.has(r.d.path) ? '▾' : '▸') : ''),\n          h('span', { class: 'ic', 'aria-hidden': 'true' }, r.kind === 'd' ? '📁' : prob ? '⛔' : unsafe ? '⚠' : Z.IMAGE[Z.ext(r.e.path)] ? '🖼' : '📄'),\n          h('span', { class: 'c-name' }, marked(r.label))),\n        h('span', { class: 'c-size' }, r.kind === 'd' ? Z.size(r.d.size) : Z.size(r.e.usize)),\n        h('span', { class: 'c-pack' }, r.kind === 'd' ? Z.size(r.d.csize) : Z.size(r.e.csize)),\n        h('span', { class: 'c-date' }, r.kind === 'f' ? fmtDate(r.e.date) : ''));\n      if (r.kind === 'd') row.setAttribute('aria-expanded', String(expanded.has(r.d.path)));\n      frag.append(row);\n    });\n    treeEl.textContent = '';\n    if (!rows.length && arc) treeEl.append(h('div', { class: 'none muted' }, q ? 'No names contain \"' + q + '\".' : 'This archive is empty.'));\n    treeEl.append(frag);\n    const ci = rows.findIndex(r => r.key === cur);\n    if (ci >= 0) treeEl.setAttribute('aria-activedescendant', 'r-' + ci); else treeEl.removeAttribute('aria-activedescendant');\n    const n = ticked.size;\n    $('extractBtn').textContent = n ? 'Extract ticked (' + n + ')…' : 'Extract ticked…';\n    $('extractBtn').disabled = !arc || !n;\n  }\n  function choose(i, keepFocus) {\n    const r = rows[i]; if (!r) return;\n    cur = r.key;\n    for (const el of treeEl.querySelectorAll('.row.cur')) { el.classList.remove('cur'); el.setAttribute('aria-selected', 'false'); }\n    const el = $('r-' + i); el.classList.add('cur'); el.setAttribute('aria-selected', 'true'); el.scrollIntoView({ block: 'nearest' });\n    treeEl.setAttribute('aria-activedescendant', el.id);\n    $('saveBtn').disabled = r.kind !== 'f' || !!Z.problem(r.e);\n    drawDetails(r);\n  }\n  const curIndex = () => rows.findIndex(r => r.key === cur);\n  function toggleDir(r, open) {\n    if (r.kind !== 'd') return;\n    if (open === undefined) open = !expanded.has(r.d.path);\n    if (open) expanded.add(r.d.path); else expanded.delete(r.d.path);\n    drawTree();\n  }\n  function toggleTick(r) {\n    const files = r.kind === 'f' ? [r.e] : filesUnder(r.d);\n    const on = tickState(r) !== 'true';\n    for (const e of files) on ? ticked.add(e.index) : ticked.delete(e.index);\n    const i = curIndex(); drawTree(); if (i >= 0) treeEl.setAttribute('aria-activedescendant', 'r-' + i);\n  }\n  treeEl.addEventListener('click', e => {\n    const row = e.target.closest('.row'); if (!row) return;\n    const i = +row.dataset.i, r = rows[i];\n    if (e.target.closest('.chk')) { choose(i); toggleTick(r); return; }\n    if (e.target.closest('.tw') && r.kind === 'd') { choose(i); toggleDir(r); return; }\n    choose(i);\n  });\n  treeEl.addEventListener('dblclick', e => {\n    const row = e.target.closest('.row'); if (!row || e.target.closest('.chk')) return;\n    const r = rows[+row.dataset.i];\n    if (r.kind === 'd') toggleDir(r); else if (!Z.problem(r.e)) saveOne(r.e);\n  });\n  treeEl.addEventListener('keydown', e => {\n    if (!rows.length) return;\n    let i = curIndex(); const r = rows[i], page = Math.max(1, Math.floor(treeEl.clientHeight / 26) - 1);\n    const k = e.key;\n    const to = { ArrowDown: i + 1, ArrowUp: i < 0 ? 0 : i - 1, Home: 0, End: rows.length - 1, PageDown: i + page, PageUp: i - page }[k];\n    if (to !== undefined) { e.preventDefault(); choose(Math.max(0, Math.min(rows.length - 1, to))); return; }\n    if (!r) { if (k === ' ' || k === 'Enter') { e.preventDefault(); choose(0); } return; }\n    if (k === 'ArrowRight') { e.preventDefault(); if (r.kind === 'd' && !expanded.has(r.d.path)) { toggleDir(r, true); choose(curIndex()); } else if (r.kind === 'd' && rows[i + 1] && rows[i + 1].level > r.level) choose(i + 1); }\n    else if (k === 'ArrowLeft') {\n      e.preventDefault();\n      if (r.kind === 'd' && expanded.has(r.d.path)) { toggleDir(r, false); choose(curIndex()); }\n      else for (let j = i - 1; j >= 0; j--) if (rows[j].level < r.level) { choose(j); break; }\n    }\n    else if (k === ' ') { e.preventDefault(); toggleTick(r); }\n    else if (k === 'Enter') { e.preventDefault(); if (r.kind === 'd') { toggleDir(r); choose(curIndex()); } else if (!Z.problem(r.e)) saveOne(r.e); }\n    else if ((e.ctrlKey || e.metaKey) && k.toLowerCase() === 'a') { e.preventDefault(); const all = arc.entries.filter(x => !x.dir); const on = ticked.size !== all.length; ticked = new Set(on ? all.map(x => x.index) : []); drawTree(); toast(on ? 'Ticked all ' + plural(all.length, 'file') : 'Nothing ticked'); }\n  });\n  treeEl.addEventListener('focus', () => { if (!cur && rows.length) choose(0); });\n\n  /* ---------- details and preview ---------- */\n  function drawDetails(r) {\n    const box = $('details'); box.textContent = ''; box.hidden = false; $('empty').hidden = true;\n    if (preview.url) { URL.revokeObjectURL(preview.url); preview.url = null; }\n    const my = ++preview.seq;\n    if (r.kind === 'd') {\n      const fs = filesUnder(r.d);\n      box.append(h('h2', null, '📁 ' + r.d.name), h('div', { class: 'path mono' }, r.d.path + '/'),\n        h('table', { class: 'facts' }, h('tr', null, h('th', null, 'Files'), h('td', null, num(fs.length))), h('tr', null, h('th', null, 'Size'), h('td', null, Z.size(r.d.size))), h('tr', null, h('th', null, 'Packed'), h('td', null, Z.size(r.d.csize)))),\n        h('div', { class: 'acts' }, h('button', { class: 'btn', disabled: !fs.length || null, onclick: () => extractList(fs, 'the folder \"' + r.d.name + '\"') }, 'Extract this folder…')));\n      return;\n    }\n    const e = r.e, prob = Z.problem(e), ratio = e.usize ? Math.round(100 - e.csize / e.usize * 100) : 0;\n    box.append(h('h2', null, base(e.path)), h('div', { class: 'path mono' }, e.name));\n    if (e.unsafe) box.append(h('div', { class: 'warnbox' }, '⚠ This name tries to reach outside the archive\\'s folder (\"' + e.name + '\"). When extracted it is saved as \"' + e.path + '\" instead.'));\n    else if (e.renamed) box.append(h('div', { class: 'notebox' }, 'This name has characters PortD does not allow. When extracted it is saved as \"' + e.path + '\".'));\n    if (prob) box.append(h('div', { class: 'warnbox' }, '⛔ ' + prob));\n    const facts = [['Size', Z.size(e.usize) + (e.usize >= 1024 ? ' (' + num(e.usize) + ' bytes)' : '')], ['Packed', Z.size(e.csize) + (e.usize ? (ratio > 0 ? ' (' + ratio + '% smaller)' : ratio === 0 ? ' (no smaller)' : ' (a little bigger: it was already compact)') : '')], ['Compression', Z.methodName(e.method) + (e.encrypted ? ', encrypted' : '')], ['Modified', fmtDate(e.date) || 'not recorded'], ['CRC-32', e.crc.toString(16).padStart(8, '0').toUpperCase()]];\n    if (e.comment) facts.push(['Comment', e.comment]);\n    box.append(h('table', { class: 'facts' }, facts.map(([k, v]) => h('tr', null, h('th', null, k), h('td', null, v)))));\n    box.append(h('div', { class: 'acts' }, h('button', { class: 'btn primary', disabled: prob ? true : null, onclick: () => saveOne(e) }, 'Save file…'), h('span', { id: 'crcNote', class: 'muted small', role: 'status' })));\n    const pv = h('div', { class: 'preview', id: 'preview', 'aria-label': 'Preview' });\n    box.append(pv);\n    if (prob) return;\n    const ext = Z.ext(e.path), mime = Z.IMAGE[ext];\n    if (mime) {\n      if (e.usize > Z.LIMIT.image) { pv.append(h('p', { class: 'muted' }, 'Too big to preview (over ' + Z.size(Z.LIMIT.image) + ').')); return; }\n      pv.append(h('p', { class: 'muted' }, 'Loading…'));\n      Z.extract(arc.bytes, e).then(x => {\n        if (my !== preview.seq) return;\n        pv.textContent = '';\n        preview.url = URL.createObjectURL(new Blob([x.bytes], { type: mime }));\n        const img = h('img', { src: preview.url, alt: base(e.path), class: 'pimg' });\n        img.onerror = () => { pv.textContent = ''; pv.append(h('p', { class: 'muted' }, 'This picture could not be shown.')); };\n        pv.append(img); crcNote(x);\n      }).catch(err => { if (my === preview.seq) { pv.textContent = ''; pv.append(h('div', { class: 'warnbox' }, err.message)); } });\n      return;\n    }\n    pv.append(h('p', { class: 'muted' }, 'Loading…'));\n    Z.extract(arc.bytes, e, Z.LIMIT.preview).then(x => {\n      if (my !== preview.seq) return;\n      pv.textContent = '';\n      const head = x.bytes.subarray(0, 4096), nul = head.indexOf(0) >= 0;\n      if (!Z.TEXT.has(ext) && nul) {\n        pv.append(h('p', { class: 'muted' }, 'No preview: this is not a text or picture file. The first bytes, in hex:'), h('pre', { class: 'hex mono', tabindex: '0' }, Array.from(x.bytes.subarray(0, 256), b => b.toString(16).padStart(2, '0')).join(' ').replace(/((?:\\S+ ){16})/g, '$1\\n')));\n      } else {\n        pv.append(h('pre', { class: 'text mono', tabindex: '0', 'aria-label': 'Text of ' + base(e.path) }, new TextDecoder('utf-8').decode(x.bytes) || '(empty file)'));\n        if (x.cut) pv.append(h('p', { class: 'muted small' }, 'The first ' + Z.size(Z.LIMIT.preview) + ' is shown. Save the file to see all of it.'));\n      }\n      crcNote(x);\n    }).catch(err => { if (my === preview.seq) { pv.textContent = ''; pv.append(h('div', { class: 'warnbox' }, err.message)); } });\n  }\n  function crcNote(x) {\n    const n = $('crcNote'); if (!n || x.crcOk === null) return;\n    n.textContent = x.crcOk ? '✓ Checksum matches' : '⚠ Checksum does not match: this file is damaged in the archive';\n    n.className = x.crcOk ? 'muted small' : 'bad small';\n  }\n\n  /* ---------- writing files out ---------- */\n  function isUtf8(b) { try { new TextDecoder('utf-8', { fatal: true }).decode(b); return true; } catch (e) { return false; } }\n  /* writes bytes to a path PortD allows (the picked file, or a path in our data folder): text files as text, the rest as binary */\n  async function writeBytes(path, name, bytes) {\n    const ext = Z.ext(name);\n    if (Z.PORTD_TEXT.has(ext) && isUtf8(bytes)) await PortD.fs.write(path, new TextDecoder().decode(bytes).replace(/^\\uFEFF/, ''));\n    else await PortD.fs.write(path, 'data:' + (Z.IMAGE[ext] || 'application/octet-stream') + ';base64,' + b64(bytes), 'dataurl');\n  }\n  function download(name, bytes) {\n    const url = URL.createObjectURL(new Blob([bytes])), a = h('a', { href: url, download: name });\n    document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 10000);\n  }\n  /* one file through the Save dialog. Returns 'saved', 'cancel' or an error message */\n  async function saveOne(e, quiet) {\n    let x;\n    try { x = await Z.extract(arc.bytes, e); } catch (err) { if (!quiet) toast(err.message, 6000); return err.message; }\n    const name = base(e.path) || 'file', ext = Z.ext(name);\n    try {\n      if (!Host.inPortD) { download(name, x.bytes); if (!quiet) toast('Downloaded ' + name); return 'saved'; }\n      const r = await PortD.ui.saveFile({ title: 'Save ' + name, name, types: ext ? ['.' + ext] : [] });\n      if (!r) return 'cancel';\n      await writeBytes(r.path, name, x.bytes);\n      if (!quiet) toast('Saved ' + r.name + (x.crcOk === false ? ' (⚠ its checksum did not match: it may be damaged)' : ''), 4000);\n      return x.crcOk === false ? 'saved, but its checksum did not match (the file may be damaged)' : 'saved';\n    } catch (err) { if (!quiet) toast('Could not save ' + name + ': ' + err.message, 6000); return err.message; }\n  }\n  $('saveBtn').onclick = () => { const r = rows[curIndex()]; if (r && r.kind === 'f') saveOne(r.e); };\n\n  async function extractList(list, what) {\n    list = list.filter(e => !e.dir);\n    if (!list.length) return;\n    if (list.length === 1) { await saveOne(list[0]); return; }\n    const total = list.reduce((s, e) => s + e.usize, 0);\n    const stem = arc.name.replace(/\\.[^.]+$/, '').replace(/[\\\\/:*?\"<>|]/g, '_').trim() || 'archive';\n    $('exTitle').textContent = 'Extract ' + plural(list.length, 'file');\n    $('exMsg').textContent = 'Extract ' + what + ': ' + plural(list.length, 'file') + ', ' + Z.size(total) + ' in all. PortD has no way for a program to save into a folder you choose, so pick one of these:';\n    $('exAllMsg').textContent = Host.inPortD ? 'Into Zip Viewer\\'s own folder, keeping the folders inside: ' + (PortD.app.dataDir || 'P:\\\\User\\\\Config\\\\zip-viewer') + '\\\\Extracted\\\\' + stem + '. From there, move them with Files.' : 'Not available outside PortD: use One by one (each file is downloaded).';\n    $('exAll').disabled = !Host.inPortD;\n    $('exOne').disabled = list.length > ONE_BY_ONE_MAX;\n    $('exOne').querySelector('span').textContent = list.length > ONE_BY_ONE_MAX ? 'Up to ' + ONE_BY_ONE_MAX + ' files at a time: this is ' + list.length + '.' : 'A Save dialog for each file, so you choose where each one goes.';\n    const act = await dialog('exDlg', Host.inPortD ? '#exAll' : '#exOne');\n    if (act === 'folder') await toFolder(list, stem);\n    else if (act === 'one') await oneByOne(list);\n  }\n  async function oneByOne(list) {\n    const problems = []; let n = 0;\n    for (let i = 0; i < list.length; i++) {\n      const r = await saveOne(list[i], true);\n      if (r === 'cancel') { toast('Stopped: ' + plural(n, 'file') + ' saved, ' + (list.length - i) + ' not.', 4000); break; }\n      if (r === 'saved') n++; else { if (/^saved/.test(r)) n++; problems.push([list[i].path, r]); }\n    }\n    if (problems.length) done('Saved ' + n + ' of ' + plural(list.length, 'file'), '', problems);\n    else if (n === list.length) toast('Saved all ' + plural(n, 'file'));\n  }\n  async function toFolder(list, stem) {\n    let dir = 'Extracted/' + stem, k = 2;\n    while (await PortD.fs.exists(dir)) dir = 'Extracted/' + stem + ' (' + k++ + ')';\n    let stop = false;\n    $('progBar').max = list.length; $('progBar').value = 0;\n    const prog = dialog('progDlg', '#progStop'); prog.then(() => { stop = true; });\n    const used = new Set(), problems = []; let n = 0;\n    for (let i = 0; i < list.length && !stop; i++) {\n      const e = list[i];\n      $('progMsg').textContent = (i + 1) + ' of ' + list.length + ': ' + e.path; $('progBar').value = i;\n      let rel = e.path, c = 2;\n      while (used.has(rel.toLowerCase())) rel = e.path.replace(/(\\.[^./]+)?$/, ' (' + c++ + ')$1');\n      used.add(rel.toLowerCase());\n      try {\n        const x = await Z.extract(arc.bytes, e);\n        await writeBytes(dir + '/' + rel, rel, x.bytes);\n        n++;\n        if (x.crcOk === false) problems.push([e.path, 'Saved, but its checksum did not match: it may be damaged.']);\n        if (rel !== e.path) problems.push([e.path, 'Another file had the same name, so this one was saved as \"' + rel + '\".']);\n        if (e.unsafe) problems.push([e.name, 'This name tried to reach outside the folder; saved as \"' + rel + '\".']);\n      } catch (err) { problems.push([e.path, err.message]); }\n    }\n    if (!$('progDlg').hidden) $('progDlg').done('finished');\n    const full = (PortD.app.dataDir || 'P:\\\\User\\\\Config\\\\zip-viewer') + '\\\\' + dir.replace(/\\//g, '\\\\');\n    done((stop && n < list.length ? 'Stopped. ' : '') + 'Extracted ' + n + ' of ' + plural(list.length, 'file') + ' into:', n ? full : '', problems);\n  }\n  async function done(msg, path, problems) {\n    $('doneTitle').textContent = problems.some(p => !/^Saved, but|same name|reach outside/.test(p[1])) ? 'Done, with problems' : 'Done';\n    $('doneMsg').textContent = msg; $('donePath').textContent = path; $('donePath').hidden = !path;\n    $('doneCopy').hidden = !path;\n    $('doneCopy').onclick = async () => { if (await Host.copy(path)) toast('Copied the folder path'); };\n    const ul = $('doneList'); ul.textContent = '';\n    for (const [n, m] of problems) ul.append(h('li', null, h('b', null, n), ': ' + m));\n    if (path) $('doneMsg').append(' ', h('span', { class: 'muted' }, 'Open Files and go there to move them where you want.'));\n    await dialog('doneDlg', '[data-act=close]');\n  }\n  $('extractBtn').onclick = () => extractList(arc.entries.filter(e => ticked.has(e.index)), 'the ticked files');\n  $('allBtn').onclick = () => extractList(arc.entries, 'everything in ' + arc.name);\n\n  /* ---------- search ---------- */\n  let st = 0;\n  $('search').addEventListener('input', () => { clearTimeout(st); st = setTimeout(() => { q = $('search').value.trim(); drawTree(); if (rows.length && curIndex() < 0) choose(0); }, 120); });\n  $('search').addEventListener('keydown', e => {\n    if (e.key === 'Escape' && $('search').value) { e.preventDefault(); $('search').value = ''; q = ''; drawTree(); }\n    else if (e.key === 'ArrowDown' || e.key === 'Enter') { e.preventDefault(); treeEl.focus(); if (curIndex() < 0 && rows.length) choose(0); }\n  });\n\n  /* ---------- keys ---------- */\n  document.addEventListener('keydown', e => {\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    if (!ctrl || e.altKey || e.shiftKey) return;\n    if (k === 'o') { e.preventDefault(); openFile(); }\n    else if (k === 's' && arc) { e.preventDefault(); $('saveBtn').click(); }\n    else if (k === 'f' && arc) { e.preventDefault(); $('search').focus(); $('search').select(); }\n  });\n\n  /* ---------- theme ---------- */\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    Host.setTitle('Zip Viewer');\n    const start = Host.startFile();\n    if (start) await openPath(start); else $('openBtn2').focus();\n    window.__zv = { get arc() { return arc; }, get rows() { return rows; }, get cur() { return cur; }, get ticked() { return ticked; }, ready: true };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/zip.js": {
   "enc": "text",
   "d": "/* Zip Viewer: reading archives. The central directory is parsed here (with ZIP64 fields); entries are read with\n   stored (0) or deflate (8), deflate through the browser's DecompressionStream('deflate-raw'). Nothing is ever written\n   to the archive. No drawing here; app.js draws. Everything hangs off window.Zip. Errors are plain-language Errors. */\n(function () {\n  'use strict';\n  const Z = window.Zip = {};\n  Z.LIMIT = { entry: 64 * 1048576, preview: 1048576, image: 16 * 1048576 };\n  const METHODS = { 0: 'stored', 1: 'Shrink', 6: 'Implode', 8: 'deflate', 9: 'Deflate64', 12: 'BZIP2', 14: 'LZMA', 93: 'Zstandard', 95: 'XZ', 96: 'JPEG', 97: 'WavPack', 98: 'PPMd', 99: 'AES encryption' };\n  Z.methodName = m => METHODS[m] || 'method ' + m;\n\n  /* old zip tools wrote names in the DOS code page 437 */\n  const CP437 = 'ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜ¢£¥₧ƒáíóúñÑªº¿⌐¬½¼¡«»░▒▓│┤╡╢╖╕╣║╗╝╜╛┐└┴┬├─┼╞╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌█▄▌▐▀αßΓπΣσµτΦΘΩδ∞φε∩≡±≥≤⌠⌡÷≈°∙·√ⁿ²■ ';\n  const cp437 = b => { let s = ''; for (const x of b) s += x < 128 ? String.fromCharCode(x) : CP437[x - 128]; return s; };\n  const utf8 = new TextDecoder('utf-8', { fatal: true });\n  const nameOf = (b, flagUtf8) => { if (flagUtf8) try { return utf8.decode(b); } catch (e) { /* fall through */ } try { return /[\\x80-\\xff]/.test(String.fromCharCode(...b.subarray(0, 4096))) ? utf8.decode(b) : cp437(b); } catch (e) { return cp437(b); } };\n\n  /* MS-DOS date and time to a Date (local time, as zip tools write it); null if unset */\n  function dosDate(d, t) {\n    if (!d) return null;\n    const dt = new Date(1980 + (d >> 9), ((d >> 5) & 15) - 1, d & 31, t >> 11, (t >> 5) & 63, (t & 31) * 2);\n    return isNaN(dt) ? null : dt;\n  }\n\n  /* a safe relative path for writing: forward slashes, no drive, no leading slash, no \".\" or \"..\" parts,\n     and each part a name PortD accepts. Returns { path, changed, unsafe } */\n  Z.safePath = function (name) {\n    let unsafe = false;\n    let p = name.replace(/\\\\/g, '/');\n    if (/^[a-zA-Z]:/.test(p)) { p = p.slice(2); unsafe = true; }\n    if (p.startsWith('/')) unsafe = true;\n    const parts = [];\n    for (let seg of p.split('/')) {\n      if (seg === '' || seg === '.') continue;\n      if (seg === '..') { unsafe = true; continue; }\n      seg = seg.replace(/[:*?\"<>|\\x00-\\x1f]/g, '_').replace(/^ +/, '_').replace(/[ .]+$/, m => '_'.repeat(m.length)).slice(0, 120);\n      if (seg === '__proto__') seg = '_proto_';\n      parts.push(seg);\n    }\n    const path = parts.join('/');\n    return { path, unsafe, changed: unsafe || path !== p.replace(/^\\/+|\\/+$/g, '').replace(/\\/{2,}/g, '/') };\n  };\n\n  /* reads the list of entries. bytes: Uint8Array of the whole archive.\n     Returns { entries: [...], comment, zip64 } */\n  Z.read = function (bytes) {\n    const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength), n = bytes.length;\n    const u16 = o => dv.getUint16(o, true), u32 = o => dv.getUint32(o, true), u64 = o => dv.getUint32(o, true) + dv.getUint32(o + 4, true) * 4294967296;\n    if (n < 22) throw new Error('This file is too small to be a zip archive.');\n    let eocd = -1;\n    for (let i = n - 22; i >= Math.max(0, n - 22 - 65535); i--) if (u32(i) === 0x06054b50) { eocd = i; break; }\n    if (eocd < 0) throw new Error(u32(0) === 0x04034b50 ? 'This zip archive is cut short or damaged: its list of contents is missing.' : 'This is not a zip archive.');\n    let count = u16(eocd + 10), cdSize = u32(eocd + 12), cdOff = u32(eocd + 16), zip64 = false;\n    const comment = nameOf(bytes.subarray(eocd + 22, eocd + 22 + u16(eocd + 20)), true);\n    if (count === 0xffff || cdSize === 0xffffffff || cdOff === 0xffffffff) {\n      const loc = eocd - 20;\n      if (loc < 0 || u32(loc) !== 0x07064b50) throw new Error('This is a ZIP64 archive whose extra directory is missing, so Zip Viewer cannot read it.');\n      const z = u64(loc + 8);\n      if (z + 56 > n || u32(z) !== 0x06064b50) throw new Error('This ZIP64 archive is damaged: its extra directory cannot be found.');\n      count = u64(z + 32); cdSize = u64(z + 40); cdOff = u64(z + 48); zip64 = true;\n    }\n    if (u16(eocd + 4) !== 0 || u16(eocd + 6) !== 0) throw new Error('This archive is one part of a split (multi-part) zip. Zip Viewer can only read whole archives.');\n    if (cdOff + cdSize > n) throw new Error('This zip archive is cut short or damaged: its list of contents points past the end of the file.');\n    const entries = [];\n    let p = cdOff;\n    for (let k = 0; k < count; k++) {\n      if (p + 46 > n || u32(p) !== 0x02014b50) throw new Error('This zip archive is damaged: entry ' + (k + 1) + ' of ' + count + ' in its list of contents is not readable.');\n      const flags = u16(p + 8), method = u16(p + 10), nl = u16(p + 28), xl = u16(p + 30), cl = u16(p + 32);\n      let csize = u32(p + 20), usize = u32(p + 24), off = u32(p + 42);\n      const raw = nameOf(bytes.subarray(p + 46, p + 46 + nl), flags & 0x800);\n      /* the ZIP64 extra field holds the real values of those set to 0xffffffff, in this order */\n      for (let x = p + 46 + nl, end = x + xl; x + 4 <= end;) {\n        const id = u16(x), len = u16(x + 2);\n        if (id === 0x0001) { let q = x + 4; if (usize === 0xffffffff) { usize = u64(q); q += 8; } if (csize === 0xffffffff) { csize = u64(q); q += 8; } if (off === 0xffffffff) { off = u64(q); } zip64 = true; }\n        x += 4 + len;\n      }\n      const isDir = raw.endsWith('/') || raw.endsWith('\\\\');\n      const safe = Z.safePath(raw);\n      entries.push({\n        index: k, name: raw, path: safe.path, unsafe: safe.unsafe, renamed: safe.changed, dir: isDir,\n        method, encrypted: !!(flags & 1), csize, usize, offset: off, crc: u32(p + 16),\n        date: dosDate(u16(p + 14), u16(p + 12)), comment: nameOf(bytes.subarray(p + 46 + nl + xl, p + 46 + nl + xl + cl), flags & 0x800)\n      });\n      p += 46 + nl + xl + cl;\n    }\n    return { entries, comment, zip64 };\n  };\n\n  /* why an entry cannot be opened, or '' */\n  Z.problem = function (e) {\n    if (e.dir) return '';\n    if (e.encrypted || e.method === 99) return 'It is encrypted (protected by a password), which Zip Viewer cannot open.';\n    if (e.method !== 0 && e.method !== 8) return 'It is compressed with ' + Z.methodName(e.method) + ', which Zip Viewer cannot open (only stored and deflate).';\n    return '';\n  };\n\n  /* CRC-32, to check what comes out */\n  const T = new Uint32Array(256);\n  for (let i = 0; i < 256; i++) { let c = i; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; T[i] = c >>> 0; }\n  Z.crc32 = function (b) { let c = 0xffffffff; for (let i = 0; i < b.length; i++) c = T[(c ^ b[i]) & 255] ^ (c >>> 8); return (c ^ 0xffffffff) >>> 0; };\n\n  /* the bytes of one entry. limit: stop after this many bytes (for previews).\n     Returns { bytes, cut: true if stopped at the limit, crcOk: true/false/null (null when cut) }.\n     Throws if the entry claims one size and grows past it, or grows past Z.LIMIT.entry. */\n  Z.extract = async function (bytes, e, limit) {\n    const why = Z.problem(e); if (why) throw new Error(why);\n    const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n    if (e.offset + 30 > bytes.length || dv.getUint32(e.offset, true) !== 0x04034b50) throw new Error('The archive is damaged: the data for \"' + e.name + '\" is not where its list says.');\n    const start = e.offset + 30 + dv.getUint16(e.offset + 26, true) + dv.getUint16(e.offset + 28, true);\n    if (start + e.csize > bytes.length) throw new Error('The archive is cut short: \"' + e.name + '\" runs past the end of the file.');\n    const packed = bytes.subarray(start, start + e.csize);\n    const cap = Math.min(limit || Infinity, Z.LIMIT.entry);\n    if (!limit && e.usize > Z.LIMIT.entry) throw new Error('\"' + e.name + '\" would be ' + Z.size(e.usize) + ' when unpacked; files in PortD can be at most ' + Z.size(Z.LIMIT.entry) + '.');\n    if (e.method === 0) {\n      const out = packed.subarray(0, Math.min(packed.length, cap));\n      const cut = out.length < packed.length;\n      return { bytes: out, cut, crcOk: cut ? null : Z.crc32(out) === e.crc };\n    }\n    /* deflate: read the stream in pieces, so a small entry that grows enormous is stopped early */\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('deflate-raw')).getReader();\n    const parts = []; let got = 0, cut = false;\n    try {\n      for (;;) {\n        const { value, done } = await reader.read();\n        if (done) break;\n        if (got + value.length > e.usize && !limit) { reader.cancel().catch(() => {}); throw new Error('\"' + e.name + '\" grows bigger than the ' + Z.size(e.usize) + ' its list says, so it was stopped. The archive may be damaged or made to fill up memory (a \"zip bomb\").'); }\n        if (got + value.length >= cap) { parts.push(value.subarray(0, cap - got)); got = cap; cut = e.usize > got; reader.cancel().catch(() => {}); break; }\n        parts.push(value); got += value.length;\n      }\n    } catch (err) {\n      if (/grows bigger/.test(err.message)) throw err;\n      throw new Error('\"' + e.name + '\" could not be unpacked: its compressed data is damaged.');\n    }\n    const out = new Uint8Array(got); let o = 0;\n    for (const p of parts) { out.set(p, o); o += p.length; }\n    return { bytes: out, cut, crcOk: cut ? null : Z.crc32(out) === e.crc };\n  };\n\n  /* the folder tree: { name, path, dirs: Map, files: [entries], size, csize, count } */\n  Z.tree = function (entries) {\n    const root = { name: '', path: '', dirs: new Map(), files: [], size: 0, csize: 0, count: 0 };\n    for (const e of entries) {\n      const parts = e.path.split('/').filter(Boolean);\n      if (!parts.length) continue;\n      let node = root;\n      const last = e.dir ? parts.length : parts.length - 1;\n      for (let i = 0; i < last; i++) {\n        if (!node.dirs.has(parts[i])) node.dirs.set(parts[i], { name: parts[i], path: parts.slice(0, i + 1).join('/'), dirs: new Map(), files: [], size: 0, csize: 0, count: 0, entry: null });\n        node = node.dirs.get(parts[i]);\n        if (!e.dir) { node.size += e.usize; node.csize += e.csize; node.count++; }\n      }\n      if (e.dir) node.entry = e; else { node.files.push(e); }\n    }\n    root.size = entries.reduce((s, e) => s + (e.dir ? 0 : e.usize), 0); root.csize = entries.reduce((s, e) => s + (e.dir ? 0 : e.csize), 0); root.count = entries.filter(e => !e.dir).length;\n    return root;\n  };\n  Z.size = function (n) {\n    if (n < 1024) return n + ' B';\n    const u = ['KB', 'MB', 'GB', 'TB']; let i = -1;\n    do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);\n    return (n < 10 ? n.toFixed(1) : Math.round(n)) + ' ' + u[i];\n  };\n  Z.ext = name => { const m = /\\.([^./]+)$/.exec(name); return m ? m[1].toLowerCase() : ''; };\n  Z.TEXT = new Set(['txt', 'md', 'log', 'json', 'js', 'mjs', 'cjs', 'ts', 'css', 'html', 'htm', 'xml', 'svg', 'csv', 'tsv', 'ini', 'cfg', 'conf', 'yml', 'yaml', 'ps1', 'psm1', 'psd1', 'bat', 'cmd', 'sh', 'py', 'tf', 'toml', 'sql', 'rels', 'java', 'mf', 'properties', 'c', 'h', 'cpp', 'cs', 'go', 'rs', 'rb', 'php', 'vbs', 'reg', 'inf', 'gitignore', 'editorconfig', 'xsd', 'xsl', 'plist', 'vtt', 'srt', 'tex', 'rtf']);\n  Z.IMAGE = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', ico: 'image/x-icon', svg: 'image/svg+xml', avif: 'image/avif' };\n  /* PortD keeps these as text files (so Notepad can open them); everything else is written as binary */\n  Z.PORTD_TEXT = new Set(['txt', 'md', 'log', 'json', 'js', 'mjs', 'css', 'html', 'htm', 'xml', 'svg', 'csv', 'tsv', 'ini', 'cfg', 'conf', 'yml', 'yaml', 'ps1', 'psm1', 'psd1', 'bat', 'cmd', 'sh', 'py', 'tf', 'toml', 'sql']);\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Zip Viewer */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #9a6400; --onaccent: #ffffff; --sel: #fbecc8; --cur: #f6d88c; --hit: #ffe680;\n  --err: #b42318; --errbg: #fde8e8; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00; --ok: #1e6b37;\n  --mono: ui-monospace, \"Cascadia Mono\", Consolas, \"Courier New\", monospace;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #f5c34b; --onaccent: #241800; --sel: #3a321c; --cur: #5a4a1e; --hit: #6b5a12;\n  --err: #ff9b94; --errbg: #4a2a2e; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00; --ok: #8fe0a8;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .mono { font-family: var(--mono); } .grow { flex: 1; } .bad { color: var(--err); }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .5; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n#search { width: 190px; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n.info { padding: 5px 10px; border-bottom: 1px solid var(--line); font-size: 12.5px; min-height: 26px; }\n.info:empty { display: none; }\n.info .warn { color: var(--warnfg); background: var(--warnbg); border-radius: 4px; padding: 0 5px; margin-left: 6px; }\n.info .note { color: var(--muted); }\n.info .comment { color: var(--muted); margin-top: 2px; white-space: pre-wrap; }\n\n.main { flex: 1; min-height: 0; display: flex; }\n.left { flex: 1.25; min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--line); }\n.thead, .row { display: grid; grid-template-columns: 22px minmax(140px, 1fr) 76px 76px 128px; align-items: center; gap: 6px; }\n.cell { display: flex; align-items: center; gap: 4px; min-width: 0; padding-left: calc(var(--lv, 0) * 16px); }\n.cell .tw { flex: 0 0 14px; } .cell .ic { flex: 0 0 18px; } .cell .c-name { flex: 1; min-width: 0; }\n.thead { padding: 4px 8px; font-size: 12px; font-weight: 600; color: var(--muted); background: var(--panel); border-bottom: 1px solid var(--line); }\n.tree { flex: 1; overflow: auto; outline-offset: -2px; }\n.row { padding: 2px 8px; min-height: 26px; cursor: default; border-bottom: 1px solid transparent; }\n.row:hover { background: color-mix(in srgb, var(--sel) 60%, transparent); }\n.row.cur { background: var(--cur); }\n.tree:focus-visible .row.cur { outline: 2px solid var(--accent); outline-offset: -2px; }\n.row.bad .c-name { color: var(--muted); text-decoration: line-through; }\n.chk { width: 16px; height: 16px; border: 1.5px solid var(--edge); border-radius: 3px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; line-height: 1; background: var(--bg); }\n.chk.true { background: var(--accent); border-color: var(--accent); }\n.chk.true::after { content: \"✓\"; color: var(--onaccent); font-weight: 700; }\n.chk.mixed::after { content: \"–\"; color: var(--accent); font-weight: 700; }\n.tw { color: var(--muted); cursor: pointer; text-align: center; }\n.c-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.c-size, .c-pack { text-align: right; font-size: 12px; color: var(--muted); }\n.c-date { font-size: 12px; color: var(--muted); white-space: nowrap; }\n.row mark { background: var(--hit); color: inherit; border-radius: 2px; }\n.none { padding: 14px; }\n@media (pointer: coarse) { .row { min-height: 40px; } .chk { width: 24px; height: 24px; } .thead, .row { grid-template-columns: 30px minmax(120px, 1fr) 70px 70px 120px; } }\n@media (max-width: 700px) { .thead, .row { grid-template-columns: 22px minmax(100px, 1fr) 70px; } .c-pack, .c-date { display: none; } }\n\n.side { flex: 1; min-width: 260px; display: flex; flex-direction: column; overflow: auto; background: var(--bg); }\n.empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; }\n.empty h1 { font-size: 18px; margin: 8px 0 6px; }\n.empty p { max-width: 340px; margin: 0 auto 12px; }\n#details { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; min-height: 0; flex: 1; }\n#details h2 { margin: 0; font-size: 16px; overflow-wrap: anywhere; }\n.path { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }\n.facts { border-collapse: collapse; font-size: 12.5px; }\n.facts th { text-align: left; color: var(--muted); font-weight: 600; padding: 2px 12px 2px 0; white-space: nowrap; vertical-align: top; }\n.facts td { padding: 2px 0; overflow-wrap: anywhere; }\n.acts { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.warnbox { padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.notebox { padding: 6px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }\n.preview { flex: 1; min-height: 120px; display: flex; flex-direction: column; }\n.preview pre { flex: 1; margin: 0; padding: 8px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow: auto; font-size: 12px; white-space: pre; }\n.preview pre.hex { white-space: pre-wrap; }\n.pimg { max-width: 100%; max-height: 360px; object-fit: contain; align-self: flex-start; background: repeating-conic-gradient(#ccc 0 25%, #fff 0 50%) 0 0 / 16px 16px; border: 1px solid var(--line); image-rendering: auto; }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); display: flex; flex-direction: column; gap: 8px; }\n.dlg.wide { width: 600px; max-width: 100%; }\n.dlg h2 { margin: 0; font-size: 16px; }\n.dlg p { margin: 0; }\n.choices { display: flex; flex-direction: column; gap: 8px; }\n.choice { font: inherit; color: var(--text); text-align: left; background: var(--panel); border: 1px solid var(--edge); border-radius: 8px; padding: 8px 12px; cursor: pointer; display: flex; flex-direction: column; gap: 2px; }\n.choice:hover:not(:disabled) { border-color: var(--accent); background: var(--sel); }\n.choice:disabled { opacity: .55; cursor: default; }\n.choice span { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }\nprogress { width: 100%; height: 14px; accent-color: var(--accent); }\n.pathbox { padding: 6px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow-wrap: anywhere; user-select: all; }\n.problems { margin: 0; padding-left: 18px; max-height: 200px; overflow: auto; font-size: 12.5px; }\n.problems:empty { display: none; }\n.dacts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; }\n.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (forced-colors: active) { .row.cur { outline: 2px solid Highlight; } .chk.true { forced-color-adjust: none; } }\n"
  }
 }
}