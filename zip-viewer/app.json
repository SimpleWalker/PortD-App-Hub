{
  "id": "zip-viewer",
  "name": "Zip Viewer",
  "version": "1.0.0",
  "portdEarliest": "1.0.0",
  "description": "Look inside .zip files (and .docx, .xlsx, .pptx, .jar): browse, preview text and pictures, and extract.",
  "icon": "icon.svg",
  "entry": "index.html",
  "width": 980,
  "height": 620,
  "singleInstance": false,
  "fileTypes": [
    {
      "ext": ".zip",
      "name": "Zip archive",
      "icon": "glyph:folder"
    },
    {
      "ext": ".docx",
      "name": "Word document",
      "icon": "glyph:text"
    },
    {
      "ext": ".xlsx",
      "name": "Excel workbook",
      "icon": "glyph:table"
    },
    {
      "ext": ".pptx",
      "name": "PowerPoint presentation",
      "icon": "glyph:chart"
    },
    {
      "ext": ".jar",
      "name": "Java archive",
      "icon": "glyph:code"
    }
  ]
}
