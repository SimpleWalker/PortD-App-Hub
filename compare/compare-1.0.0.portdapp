{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "compare",
 "name": "Compare",
 "version": "1.0.0",
 "description": "See the differences between two files or pasted texts, line by line and word by word, and copy them as a unified diff.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 980,
 "height": 600,
 "singleInstance": true,
 "fileTypes": [],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect x=\"2\" y=\"4\" width=\"13\" height=\"24\" rx=\"2.5\" fill=\"#e5484d\"/><rect x=\"17\" y=\"4\" width=\"13\" height=\"24\" rx=\"2.5\" fill=\"#2f9e58\"/><path d=\"M5 10h7M5 14h7M5 18h4M20 10h7M20 14h7M20 18h7M20 22h5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"compare\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Compare</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Compare\">\n    <span class=\"seg\" role=\"tablist\" aria-label=\"Show\">\n      <button id=\"tabTexts\" class=\"btn\" role=\"tab\" aria-selected=\"true\" aria-controls=\"texts\">Texts</button><button id=\"tabDiff\" class=\"btn\" role=\"tab\" aria-selected=\"false\" aria-controls=\"diff\" title=\"Compare (Ctrl+Enter)\">Differences</button>\n    </span>\n    <span class=\"sep\"></span>\n    <span class=\"seg\" role=\"group\" aria-label=\"Layout\">\n      <button id=\"sideBtn\" class=\"btn\" aria-pressed=\"true\">Side by side</button><button id=\"uniBtn\" class=\"btn\" aria-pressed=\"false\">Unified</button>\n    </span>\n    <select id=\"space\" class=\"field\" aria-label=\"White space\" title=\"White space\">\n      <option value=\"none\">Spaces count</option>\n      <option value=\"change\">Ignore space changes</option>\n      <option value=\"all\">Ignore all spaces</option>\n    </select>\n    <label class=\"chk\"><input type=\"checkbox\" id=\"caseless\"> Ignore case</label>\n    <label class=\"chk\"><input type=\"checkbox\" id=\"words\" checked> Show changed words</label>\n    <select id=\"context\" class=\"field\" aria-label=\"Unchanged lines shown around changes\" title=\"Unchanged lines shown around changes\">\n      <option value=\"3\">3 lines around changes</option>\n      <option value=\"10\">10 lines around changes</option>\n      <option value=\"all\">All lines</option>\n    </select>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Help and shortcuts (F1)\" aria-label=\"Help\">?</button>\n  </div>\n\n  <div id=\"texts\" class=\"texts\" role=\"tabpanel\" aria-labelledby=\"tabTexts\">\n    <div class=\"side\" data-side=\"a\">\n      <div class=\"shead\"><b class=\"sname\" id=\"nameA\">Left</b>\n        <button class=\"btn\" data-open=\"a\" title=\"Open a file for the left side\">Open…</button>\n        <button class=\"btn\" data-clear=\"a\">Clear</button></div>\n      <textarea id=\"textA\" spellcheck=\"false\" wrap=\"off\" aria-label=\"Left text\" placeholder=\"Open a file, or paste the first text here\"></textarea>\n    </div>\n    <div class=\"side\" data-side=\"b\">\n      <div class=\"shead\"><b class=\"sname\" id=\"nameB\">Right</b>\n        <button class=\"btn\" data-open=\"b\" title=\"Open a file for the right side\">Open…</button>\n        <button class=\"btn\" data-clear=\"b\">Clear</button></div>\n      <textarea id=\"textB\" spellcheck=\"false\" wrap=\"off\" aria-label=\"Right text\" placeholder=\"Open a file, or paste the second text here\"></textarea>\n    </div>\n    <div class=\"actions\">\n      <button id=\"compareBtn\" class=\"btn primary\" title=\"Ctrl+Enter\">Compare</button>\n      <button id=\"swapBtn\" class=\"btn\">Swap sides</button>\n    </div>\n  </div>\n\n  <div id=\"diff\" class=\"diffpane\" role=\"tabpanel\" aria-labelledby=\"tabDiff\" hidden>\n    <div class=\"dbar\">\n      <span id=\"summary\" class=\"summary\" role=\"status\"></span>\n      <span class=\"grow\"></span>\n      <button id=\"prevBtn\" class=\"btn\" title=\"Previous change (Shift+F7)\">↑ Previous</button>\n      <button id=\"nextBtn\" class=\"btn\" title=\"Next change (F7)\">↓ Next</button>\n      <button id=\"copyBtn\" class=\"btn\" title=\"Copy the differences as a unified diff\">Copy unified diff</button>\n      <button id=\"saveBtn\" class=\"btn\" title=\"Save the unified diff as a file (Ctrl+S)\">Save diff…</button>\n    </div>\n    <div id=\"notes\" class=\"notes\" hidden></div>\n    <div id=\"out\" class=\"out\" tabindex=\"0\" aria-label=\"Differences\"></div>\n  </div>\n  <div class=\"status\" aria-live=\"polite\"><span id=\"stA\"></span><span id=\"stB\"></span></div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"10\"></textarea>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Compare</h2>\n    <p>Put a text on each side, from a file or pasted in, then press <b>Compare</b>. Removed lines are red on the left, added lines green on the right, and inside a changed line the words that changed are marked.</p>\n    <table class=\"keys\">\n      <tr><td>Ctrl+Enter</td><td>Compare</td></tr>\n      <tr><td>F7 / Shift+F7</td><td>Next / previous change</td></tr>\n      <tr><td>Ctrl+S</td><td>Save the unified diff</td></tr>\n      <tr><td>Ctrl+Shift+C</td><td>Copy the unified diff</td></tr>\n      <tr><td>Ctrl+O</td><td>Open a file for the left side (then the right)</td></tr>\n      <tr><td>Esc</td><td>Back to the texts</td></tr>\n      <tr><td>F1</td><td>This help</td></tr>\n    </table>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/diff.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Compare: the window. Two texts, from files or pasted; their differences side by side or unified, with changed\n   words marked; and the differences as a unified diff to copy or save. */\n(function () {\n  'use strict';\n  const $ = id => document.getElementById(id);\n  const out = $('out');\n  const fmt = n => n.toLocaleString('en-GB');\n  const plural = (n, w) => fmt(n) + ' ' + w + (n === 1 ? '' : 's');\n  const stem = n => n.replace(/\\.[^.]+$/, '');\n\n  let settings = { theme: 'auto', layout: 'side', space: 'none', caseless: false, words: true, context: '3' };\n  const sides = { a: { name: 'Left', path: null, loaded: null }, b: { name: 'Right', path: null, loaded: null } };\n  const area = s => $(s === 'a' ? 'textA' : 'textB');\n  let result = null, blocks = [], open = new Set(), at = -1;\n\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2400); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false; (first ? ov.querySelector(first) : ov.querySelector('button')).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); };\n      const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); done('cancel'); } else if (e.key === 'Tab') { e.preventDefault(); const f = [...ov.querySelectorAll('button, textarea')]; f[(f.indexOf(document.activeElement) + (e.shiftKey ? f.length - 1 : 1)) % f.length].focus(); } e.stopPropagation(); };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n    });\n  }\n\n  /* ---------- the two sides ---------- */\n  /* a text box turns \\r\\n into \\n; the file's own text is used for comparing while the box still shows it unchanged */\n  const norm = t => t.replace(/^\\uFEFF/, '').replace(/\\r\\n?/g, '\\n');\n  const textOf = s => sides[s].loaded !== null && area(s).value === norm(sides[s].loaded) ? sides[s].loaded.replace(/^\\uFEFF/, '') : area(s).value;\n  function setSide(s, f) {\n    sides[s] = { name: f.name, path: f.path || null, loaded: f.text };\n    area(s).value = f.text.replace(/^\\uFEFF/, '');\n    if (/\\u0000/.test(f.text)) toast('\"' + f.name + '\" looks like a binary file, not text: the comparison may not mean much.', 4500);\n    names();\n  }\n  function names() {\n    for (const s of ['a', 'b']) {\n      const x = sides[s], edited = x.loaded !== null && area(s).value !== norm(x.loaded);\n      $(s === 'a' ? 'nameA' : 'nameB').textContent = (x.loaded === null ? (s === 'a' ? 'Left' : 'Right') : x.name) + (edited ? ' (edited)' : '');\n      $(s === 'a' ? 'nameA' : 'nameB').title = x.path || '';\n      const n = Diff.lines(area(s).value).lines.length;\n      $(s === 'a' ? 'stA' : 'stB').textContent = (s === 'a' ? 'Left: ' : 'Right: ') + (x.loaded === null ? (n ? 'pasted text' : 'empty') : x.path || x.name) + (n ? ' · ' + plural(n, 'line') : '');\n    }\n  }\n  const label = s => sides[s].loaded === null ? (s === 'a' ? 'Left text' : 'Right text') : sides[s].name;\n  async function openSide(s) {\n    try {\n      const f = await Host.openFile({ title: 'Open for the ' + (s === 'a' ? 'left' : 'right') + ' side' });\n      if (!f) return;\n      setSide(s, f);\n      if (area('a').value && area('b').value) run(); else area(s === 'a' ? 'b' : 'a').focus();\n    } catch (e) { toast(e.message, 4000); }\n  }\n  for (const b of document.querySelectorAll('[data-open]')) b.onclick = () => openSide(b.dataset.open);\n  for (const b of document.querySelectorAll('[data-clear]')) b.onclick = () => { const s = b.dataset.clear; sides[s] = { name: s === 'a' ? 'Left' : 'Right', path: null, loaded: null }; area(s).value = ''; names(); area(s).focus(); };\n  $('textA').addEventListener('input', names); $('textB').addEventListener('input', names);\n  $('swapBtn').onclick = () => { const t = sides.a; sides.a = sides.b; sides.b = t; const v = area('a').value; area('a').value = area('b').value; area('b').value = v; names(); if (!$('diff').hidden) run(); };\n  for (const s of ['a', 'b']) {\n    const el = document.querySelector('.side[data-side=' + s + ']');\n    el.addEventListener('dragover', e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) { e.preventDefault(); el.classList.add('drop'); } });\n    el.addEventListener('dragleave', () => el.classList.remove('drop'));\n    el.addEventListener('drop', async e => { el.classList.remove('drop'); const f = e.dataTransfer && e.dataTransfer.files[0]; if (!f) return; e.preventDefault(); setSide(s, await Host.readDropped(f)); });\n  }\n\n  /* ---------- comparing ---------- */\n  function tab(which) {\n    $('texts').hidden = which !== 'texts'; $('diff').hidden = which !== 'diff';\n    $('tabTexts').setAttribute('aria-selected', String(which === 'texts')); $('tabDiff').setAttribute('aria-selected', String(which === 'diff'));\n  }\n  function run() {\n    const a = textOf('a'), b = textOf('b');\n    if (!a && !b) { toast('Put a text on each side first: open a file or paste it in.'); tab('texts'); area('a').focus(); return; }\n    result = Diff.compare(a, b, { space: settings.space, caseless: settings.caseless });\n    blocks = Diff.blocks(result); open = new Set(); at = -1;\n    $('toast').classList.remove('show');\n    tab('diff'); draw(); out.focus({ preventScroll: true }); out.scrollTop = 0;\n    Host.setTitle(sides.a.loaded !== null || sides.b.loaded !== null ? label('a') + ' ↔ ' + label('b') + ' - Compare' : 'Compare');\n  }\n  function draw() {\n    if (!result) return;\n    const ctx = settings.context === 'all' ? Infinity : +settings.context, side = settings.layout === 'side';\n    const A = result.a.lines, B = result.b.lines, changes = blocks.filter(x => !x.same);\n    out.className = 'out ' + (side ? 'side' : 'uni');\n    out.textContent = '';\n    /* summary and notes */\n    const removed = changes.reduce((n, c) => n + c.del.length, 0), added = changes.reduce((n, c) => n + c.ins.length, 0);\n    const sum = $('summary'); sum.textContent = '';\n    if (!changes.length) sum.append('No differences');\n    else sum.append(plural(changes.length, 'change') + ': ', h('b', 'del', '−' + fmt(removed)), ' ', plural(removed, 'line').replace(/^\\S+ /, '') + ' removed, ', h('b', 'ins', '+' + fmt(added)), ' added');\n    const notes = [];\n    if (result.a.crlf !== result.b.crlf && A.length && B.length) notes.push('The two use different line endings (' + (result.a.crlf ? 'Windows' : 'Unix') + ' on the left, ' + (result.b.crlf ? 'Windows' : 'Unix') + ' on the right); that is not counted as a difference.');\n    if (result.a.eol !== result.b.eol && A.length && B.length) notes.push('Only one of them ends with a line break, so their last lines count as different.');\n    if (settings.space !== 'none' || settings.caseless) notes.push('Ignoring ' + [settings.space === 'all' ? 'all spaces' : settings.space === 'change' ? 'changes in spacing' : '', settings.caseless ? 'upper and lower case' : ''].filter(Boolean).join(' and ') + '.');\n    if (result.rough) notes.push('These texts differ in so many places that the middle part is shown as one block rather than lined up line by line.');\n    $('notes').textContent = notes.join(' '); $('notes').hidden = !notes.length;\n    for (const id of ['prevBtn', 'nextBtn', 'copyBtn', 'saveBtn']) $(id).disabled = !changes.length;\n    if (!changes.length) {\n      out.append(h('div', 'same-msg', A.length || B.length ? (notes.length && /Ignoring/.test(notes.join()) ? 'The two texts are the same, ignoring what is set above.' : 'The two texts are the same.') : 'Both sides are empty.'));\n      return;\n    }\n    const frag = document.createDocumentFragment();\n    let ci = 0;\n    const text = (cls, content, words) => {\n      const t = h('div', 'tx ' + cls);\n      if (words) for (const w of words) { if (w.c) t.append(h('span', 'w', w.t)); else t.append(w.t); }\n      else if (content !== null) t.textContent = content;\n      return t;\n    };\n    const row = cells => { const r = h('div', 'row'); r.append(...cells); return r; };\n    const sameRow = (i, j) => side ? row([h('div', 'ln', String(i + 1)), text('a', A[i]), h('div', 'ln', String(j + 1)), text('b', B[j])])\n      : row([h('div', 'ln', String(i + 1)), h('div', 'ln', String(j + 1)), h('div', 'sg', ' '), text('', A[i])]);\n    blocks.forEach((bl, bi) => {\n      if (bl.same) {\n        const first = bi === 0, last = bi === blocks.length - 1, keep = open.has(bi) ? Infinity : ctx;\n        const head = first ? 0 : keep, tail = last ? 0 : keep;\n        if (bl.n <= head + tail + 1) { for (let k = 0; k < bl.n; k++) frag.append(sameRow(bl.a + k, bl.b + k)); return; }\n        for (let k = 0; k < head; k++) frag.append(sameRow(bl.a + k, bl.b + k));\n        const hidden = bl.n - head - tail, f = h('div', 'fold');\n        f.append(h('span', null, '⋯ ' + plural(hidden, 'unchanged line') + ' (' + (bl.a + head + 1) + '–' + (bl.a + head + hidden) + ')'));\n        const b = h('button', 'btn', 'Show'); b.onclick = () => { open.add(bi); const y = out.scrollTop; draw(); out.scrollTop = y; }; f.append(b);\n        frag.append(f);\n        for (let k = bl.n - tail; k < bl.n; k++) frag.append(sameRow(bl.a + k, bl.b + k));\n        return;\n      }\n      const box = h('div', 'change'); box.dataset.i = ci++;\n      const pairs = Math.max(bl.del.length, bl.ins.length), wd = [];\n      for (let k = 0; k < pairs; k++) wd.push(settings.words && k < bl.del.length && k < bl.ins.length ? Diff.words(A[bl.del[k]], B[bl.ins[k]], { space: settings.space, caseless: settings.caseless }) : null);\n      if (side) {\n        for (let k = 0; k < pairs; k++) {\n          const i = bl.del[k], j = bl.ins[k], w = wd[k];\n          box.append(row([h('div', 'ln', i === undefined ? '' : String(i + 1)), i === undefined ? text('a gap', null) : text('a del', A[i], w && w.a),\n            h('div', 'ln', j === undefined ? '' : String(j + 1)), j === undefined ? text('b gap', null) : text('b ins', B[j], w && w.b)]));\n        }\n      } else {\n        bl.del.forEach((i, k) => box.append(row([h('div', 'ln del', String(i + 1)), h('div', 'ln del', ''), h('div', 'sg del', '−'), text('del', A[i], wd[k] && wd[k].a)])));\n        bl.ins.forEach((j, k) => box.append(row([h('div', 'ln ins', ''), h('div', 'ln ins', String(j + 1)), h('div', 'sg ins', '+'), text('ins', B[j], wd[k] && wd[k].b)])));\n      }\n      frag.append(box);\n    });\n    out.append(frag);\n    if (at >= 0) mark(at, false);\n  }\n  function mark(i, scroll) {\n    const list = out.querySelectorAll('.change');\n    if (!list.length) return;\n    at = (i + list.length) % list.length;\n    list.forEach(c => c.classList.remove('cur'));\n    list[at].classList.add('cur');\n    if (scroll) list[at].scrollIntoView({ block: 'start' });\n    $('summary').title = 'Change ' + (at + 1) + ' of ' + list.length;\n    if (scroll) toast('Change ' + (at + 1) + ' of ' + list.length, 1200);\n  }\n\n  /* ---------- the unified diff ---------- */\n  function unified() {\n    let a = label('a'), b = label('b');\n    if (a === b) { a = 'a/' + a; b = 'b/' + b; }\n    return Diff.unified(result, a, b, 3);\n  }\n  async function copyDiff() {\n    if (!result || !blocks.some(x => !x.same)) return;\n    const t = unified();\n    if (await Host.copy(t)) toast('Copied the unified diff (' + plural(t.split('\\n').length - 1, 'line') + ')');\n    else { $('copyText').value = t; const p = dialog('copyDlg', '#copyText'); $('copyText').select(); await p; }\n  }\n  async function saveDiff() {\n    if (!result || !blocks.some(x => !x.same)) return;\n    try {\n      const f = await Host.saveFile({ title: 'Save the differences', name: stem(label('a')) + ' vs ' + stem(label('b')) + '.diff', types: ['.diff', '.patch'], text: unified(), mime: 'text/x-diff' });\n      if (f) toast('Saved ' + f.name);\n    } catch (e) { toast('Could not save: ' + e.message, 4500); }\n  }\n\n  /* ---------- controls ---------- */\n  $('compareBtn').onclick = run;\n  $('tabDiff').onclick = run;\n  $('tabTexts').onclick = () => { tab('texts'); area('a').focus(); };\n  const setLayout = l => { settings.layout = l; $('sideBtn').setAttribute('aria-pressed', String(l === 'side')); $('uniBtn').setAttribute('aria-pressed', String(l === 'uni')); Host.saveSettings(settings); draw(); };\n  $('sideBtn').onclick = () => setLayout('side'); $('uniBtn').onclick = () => setLayout('uni');\n  $('space').onchange = () => { settings.space = $('space').value; Host.saveSettings(settings); if (!$('diff').hidden) run(); };\n  $('caseless').onchange = () => { settings.caseless = $('caseless').checked; Host.saveSettings(settings); if (!$('diff').hidden) run(); };\n  $('words').onchange = () => { settings.words = $('words').checked; Host.saveSettings(settings); draw(); };\n  $('context').onchange = () => { settings.context = $('context').value; Host.saveSettings(settings); draw(); };\n  $('prevBtn').onclick = () => mark(at - 1, true);\n  $('nextBtn').onclick = () => mark(at + 1, true);\n  $('copyBtn').onclick = copyDiff; $('saveBtn').onclick = saveDiff;\n  $('helpBtn').onclick = () => dialog('helpDlg');\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n  document.addEventListener('keydown', e => {\n    if (document.querySelector('.ov:not([hidden])')) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    let fn = null;\n    if (ctrl && e.key === 'Enter') fn = run;\n    else if (e.key === 'F7') fn = () => { if (!$('diff').hidden) mark(at + (e.shiftKey ? -1 : 1), true); };\n    else if (ctrl && !e.shiftKey && k === 's') fn = () => { if (!$('diff').hidden) saveDiff(); else toast('Compare first, then save the differences.'); };\n    else if (ctrl && e.shiftKey && k === 'c' && !$('diff').hidden) fn = copyDiff;\n    else if (ctrl && !e.shiftKey && k === 'o') fn = () => openSide(area('a').value ? 'b' : 'a');\n    else if (e.key === 'Escape' && !$('diff').hidden) fn = () => { tab('texts'); area('a').focus(); };\n    else if (e.key === 'F1') fn = () => dialog('helpDlg');\n    if (!fn) return;\n    e.preventDefault(); fn();\n  });\n\n  /* a file opened with Compare goes to the empty side; when both are full, the right one moves left */\n  async function arrive(f) {\n    try {\n      const file = await Host.readPath(f.path, f.name);\n      if (!area('a').value) setSide('a', file);\n      else if (!area('b').value) setSide('b', file);\n      else { sides.a = sides.b; area('a').value = area('b').value; setSide('b', file); }\n      if (area('a').value && area('b').value) run();\n      else { tab('texts'); toast(file.name + ' is on the left. Now open or paste the text to compare it with.', 4000); area('b').focus(); }\n    } catch (e) { toast(e.message, 4000); }\n  }\n\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    $('space').value = settings.space; $('caseless').checked = !!settings.caseless; $('words').checked = settings.words !== false; $('context').value = String(settings.context);\n    $('sideBtn').setAttribute('aria-pressed', String(settings.layout !== 'uni')); $('uniBtn').setAttribute('aria-pressed', String(settings.layout === 'uni'));\n    names();\n    const start = Host.startFile();\n    if (start) await arrive(start); else area('a').focus();\n    Host.onOpenFile(arrive);\n    window.__cmp = { get result() { return result; }, get blocks() { return blocks; }, get at() { return at; }, unified: () => result && unified() };\n  })();\n})();\n"
  },
  "js/diff.js": {
   "enc": "text",
   "d": "/* Compare: finding differences. Myers' algorithm on lines (and on words inside changed lines), and writing a\n   unified diff. No DOM code here. */\n(function () {\n  'use strict';\n  const D = window.Diff = {};\n  const MAX_EDITS = 3000;           /* past this many line edits in one place, the rest is shown as one block */\n\n  /* the shortest edit script between two int arrays; [[op, ai, bi], …] with op 0 same, 1 removed, 2 added; null past max */\n  D.myers = function (A, B, max) {\n    const n = A.length, m = B.length, off = max + 1, V = new Int32Array(2 * max + 3), trace = [];\n    for (let d = 0; d <= max; d++) {\n      const lo = Math.max(0, off - d - 1);\n      trace.push({ lo, v: V.slice(lo, off + d + 2) });\n      for (let k = -d; k <= d; k += 2) {\n        let x = k === -d || (k !== d && V[off + k - 1] < V[off + k + 1]) ? V[off + k + 1] : V[off + k - 1] + 1, y = x - k;\n        while (x < n && y < m && A[x] === B[y]) { x++; y++; }\n        V[off + k] = x;\n        if (x >= n && y >= m) return back(trace, n, m, off);\n      }\n    }\n    return null;\n  };\n  function back(trace, n, m, off) {\n    const ops = [];\n    let x = n, y = m;\n    for (let d = trace.length - 1; d >= 0; d--) {\n      const t = trace[d], v = k => t.v[off + k - t.lo], k = x - y;\n      const pk = k === -d || (k !== d && v(k - 1) < v(k + 1)) ? k + 1 : k - 1, px = v(pk), py = px - pk;\n      while (x > px && y > py) { x--; y--; ops.push([0, x, y]); }\n      if (d > 0) { if (x === px) { y--; ops.push([2, x, y]); } else { x--; ops.push([1, x, y]); } }\n      x = px; y = py;\n    }\n    return ops.reverse();\n  }\n\n  /* splits text into lines; eol says whether the text ends with a line break, crlf whether it uses Windows endings */\n  D.lines = function (text) {\n    const crlf = /\\r\\n/.test(text), t = text.replace(/\\r\\n?/g, '\\n'), eol = t.endsWith('\\n');\n    const lines = t === '' ? [] : (eol ? t.slice(0, -1) : t).split('\\n');\n    return { lines, eol, crlf };\n  };\n\n  /* line differences between two texts. o: { space: 'all' | 'change' | 'none' (which white space to ignore), caseless } */\n  D.compare = function (aText, bText, o) {\n    o = o || {};\n    const A = D.lines(aText), B = D.lines(bText), ids = new Map();\n    const key = s => {\n      if (o.space === 'all') s = s.replace(/\\s+/g, '');\n      else if (o.space === 'change') s = s.replace(/\\s+/g, ' ').trim();\n      if (o.caseless) s = s.toLowerCase();\n      let id = ids.get(s); if (id === undefined) ids.set(s, id = ids.size); return id;\n    };\n    const ka = A.lines.map(key), kb = B.lines.map(key);\n    /* a last line without a line break differs from one with it */\n    if (A.eol !== B.eol && ka.length && kb.length) { if (!A.eol) ka[ka.length - 1] = -1; if (!B.eol) kb[kb.length - 1] = -2; }\n    /* the common start and end are taken off first */\n    let s = 0; while (s < ka.length && s < kb.length && ka[s] === kb[s]) s++;\n    let e = 0; while (e < ka.length - s && e < kb.length - s && ka[ka.length - 1 - e] === kb[kb.length - 1 - e]) e++;\n    const ma = ka.slice(s, ka.length - e), mb = kb.slice(s, kb.length - e);\n    let mid = D.myers(ma, mb, Math.min(MAX_EDITS, ma.length + mb.length)), rough = false;\n    if (!mid) { rough = true; mid = []; for (let i = 0; i < ma.length; i++) mid.push([1, i, 0]); for (let j = 0; j < mb.length; j++) mid.push([2, ma.length, j]); }\n    const ops = [];\n    for (let i = 0; i < s; i++) ops.push([0, i, i]);\n    for (const [op, x, y] of mid) ops.push([op, x + s, y + s]);\n    for (let i = 0; i < e; i++) ops.push([0, ka.length - e + i, kb.length - e + i]);\n    return { a: A, b: B, ops, rough };\n  };\n\n  /* the result as blocks: { same: true, a, b, n } or { same: false, del: [a lines], ins: [b lines] } */\n  D.blocks = function (r) {\n    const out = [];\n    let cur = null;\n    for (const op of r.ops) {\n      if (op[0] === 0) { if (cur && cur.same) cur.n++; else out.push(cur = { same: true, a: op[1], b: op[2], n: 1 }); }\n      else {\n        if (!cur || cur.same) out.push(cur = { same: false, del: [], ins: [] });\n        (op[0] === 1 ? cur.del : cur.ins).push(op[0] === 1 ? op[1] : op[2]);\n      }\n    }\n    return out;\n  };\n\n  /* word differences inside a changed line: [{ t: text, c: changed }] for each side, or null when they share too little */\n  const TOK = /\\s+|[\\p{L}\\p{N}_]+|[^\\s\\p{L}\\p{N}_]/gu;\n  D.words = function (a, b, o) {\n    if (a.length + b.length > 4000) return null;\n    const ta = a.match(TOK) || [], tb = b.match(TOK) || [], ids = new Map();\n    const k = t => { if (o && o.caseless) t = t.toLowerCase(); if (o && o.space !== 'none' && /^\\s+$/.test(t)) t = ' '; let id = ids.get(t); if (id === undefined) ids.set(t, id = ids.size); return id; };\n    const ops = D.myers(ta.map(k), tb.map(k), 400);\n    if (!ops) return null;\n    const ra = [], rb = [];\n    let same = 0;\n    const add = (r, t, c) => { const last = r[r.length - 1]; if (last && last.c === c) last.t += t; else r.push({ t, c }); };\n    for (const [op, x, y] of ops) {\n      if (op === 0) { add(ra, ta[x], false); add(rb, tb[y], false); if (/\\S/.test(ta[x])) same += ta[x].length; }\n      else if (op === 1) add(ra, ta[x], true);\n      else add(rb, tb[y], true);\n    }\n    if (same < 0.3 * Math.max(a.replace(/\\s/g, '').length, b.replace(/\\s/g, '').length)) return null;      /* mostly different: mark the whole line */\n    return { a: ra, b: rb };\n  };\n\n  /* a unified diff, with ctx lines of context */\n  D.unified = function (r, aName, bName, ctx) {\n    ctx = ctx === undefined ? 3 : ctx;\n    const A = r.a, B = r.b, ops = r.ops, out = ['--- ' + aName, '+++ ' + bName];\n    const changes = [];\n    ops.forEach((op, i) => { if (op[0] !== 0) changes.push(i); });\n    if (!changes.length) return '';\n    let i = 0;\n    while (i < changes.length) {\n      let from = Math.max(0, changes[i] - ctx), to = Math.min(ops.length - 1, changes[i] + ctx), j = i;\n      while (j + 1 < changes.length && changes[j + 1] - ctx <= to + 1) { j++; to = Math.min(ops.length - 1, changes[j] + ctx); }\n      const body = [];\n      let aStart = null, bStart = null, aLen = 0, bLen = 0;\n      for (let k = from; k <= to; k++) {\n        const [op, x, y] = ops[k];\n        if (aStart === null) { aStart = x; bStart = y; }\n        if (op === 0) { body.push(' ' + A.lines[x]); aLen++; bLen++; if (x === A.lines.length - 1 && !A.eol) body.push('\\\\ No newline at end of file'); }\n        else if (op === 1) { body.push('-' + A.lines[x]); aLen++; if (x === A.lines.length - 1 && !A.eol) body.push('\\\\ No newline at end of file'); }\n        else { body.push('+' + B.lines[y]); bLen++; if (y === B.lines.length - 1 && !B.eol) body.push('\\\\ No newline at end of file'); }\n      }\n      const range = (start, len) => (len === 0 ? start : start + 1) + (len === 1 ? '' : ',' + len);\n      out.push('@@ -' + range(aStart, aLen) + ' +' + range(bStart, bLen) + ' @@', ...body);\n      i = j + 1;\n    }\n    return out.join('\\n') + '\\n';\n  };\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Compare */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2563c9; --onaccent: #ffffff; --sel: #d6e4fb;\n  --delbg: #fde7e9; --delword: #f5a3ab; --insbg: #dff5e4; --insword: #8fd6a2; --gap: #eef0f3; --foldbg: #eaf0fa;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #7aa7ff; --onaccent: #0b1220; --sel: #2c3f63;\n  --delbg: #45242a; --delword: #7c2f3a; --insbg: #1e3d29; --insword: #2e6b40; --gap: #20252f; --foldbg: #22304a;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.grow { flex: 1; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .55; cursor: default; }\n.btn.primary, .btn[aria-pressed=\"true\"], .btn[aria-selected=\"true\"] { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.seg { display: inline-flex; }\n.seg .btn { border-radius: 0; margin-left: -1px; }\n.seg .btn:first-child { border-radius: 6px 0 0 6px; margin-left: 0; }\n.seg .btn:last-child { border-radius: 0 6px 6px 0; }\n.chk { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n/* the two texts */\n.texts { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; min-height: 0; }\n.side { display: flex; flex-direction: column; min-width: 0; min-height: 0; border-right: 1px solid var(--line); }\n.side:nth-child(2) { border-right: 0; }\n.shead { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-bottom: 1px solid var(--line); }\n.sname { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.side textarea { flex: 1; border: 0; resize: none; padding: 8px; font: 13px/1.45 ui-monospace, \"Cascadia Mono\", Consolas, monospace; background: var(--bg); color: var(--text); outline-offset: -2px; tab-size: 4; }\n.side.drop textarea { outline: 3px dashed var(--accent); outline-offset: -6px; }\n.actions { grid-column: 1 / 3; display: flex; gap: 8px; justify-content: center; padding: 8px; border-top: 1px solid var(--line); background: var(--panel); }\n@media (max-width: 560px) { .texts { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr auto; } .actions { grid-column: 1; } .side { border-right: 0; border-bottom: 1px solid var(--line); } }\n\n/* the differences */\n.diffpane { flex: 1; display: flex; flex-direction: column; min-height: 0; }\n.dbar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; border-bottom: 1px solid var(--line); }\n.summary b.del { color: inherit; background: var(--delbg); padding: 0 4px; border-radius: 3px; }\n.summary b.ins { color: inherit; background: var(--insbg); padding: 0 4px; border-radius: 3px; }\n.notes { padding: 5px 10px; color: var(--muted); border-bottom: 1px solid var(--line); background: var(--panel); }\n.out { flex: 1; overflow: auto; font: 12.5px/1.45 ui-monospace, \"Cascadia Mono\", Consolas, monospace; outline-offset: -2px; }\n.out .same-msg { font: 15px \"Segoe UI\", system-ui, sans-serif; padding: 30px; text-align: center; color: var(--muted); }\n.row { display: grid; }\n.out.side .row { grid-template-columns: 3.6em minmax(0, 1fr) 3.6em minmax(0, 1fr); }\n.out.uni .row { grid-template-columns: 3.6em 3.6em 1.4em minmax(0, 1fr); }\n.ln { color: var(--muted); text-align: right; padding: 0 6px; user-select: none; background: var(--panel); border-right: 1px solid var(--line); }\n.tx { white-space: pre-wrap; overflow-wrap: anywhere; padding: 0 8px; tab-size: 4; min-height: 1.45em; }\n.out.side .tx.a { border-right: 1px solid var(--line); }\n.sg { text-align: center; user-select: none; color: var(--muted); }\n.del { background: var(--delbg); }\n.ins { background: var(--insbg); }\n.gap { background: repeating-linear-gradient(135deg, var(--gap) 0 6px, var(--bg) 6px 12px); }\n.tx .w { border-radius: 2px; }\n.tx.del .w { background: var(--delword); }\n.tx.ins .w { background: var(--insword); }\n.change { scroll-margin-top: 30px; }\n.change.cur { outline: 2px solid var(--accent); outline-offset: -1px; }\n.fold { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--foldbg); color: var(--muted); padding: 2px; font: 12px \"Segoe UI\", system-ui, sans-serif; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n.fold .btn { min-height: 22px; padding: 1px 8px; font-size: 12px; }\n@media (forced-colors: active) { .del, .ins { border-left: 3px solid CanvasText; } .tx .w { text-decoration: underline; } }\n\n.status { display: flex; gap: 16px; padding: 3px 10px; border-top: 1px solid var(--line); background: var(--panel); color: var(--muted); white-space: nowrap; overflow: hidden; min-height: 24px; }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 540px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg textarea { width: 100%; font: 12px ui-monospace, Consolas, monospace; background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; }\n.dlg .acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.keys { border-collapse: collapse; }\n.keys td { padding: 2px 10px 2px 0; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n.toast { position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n"
  }
 }
}