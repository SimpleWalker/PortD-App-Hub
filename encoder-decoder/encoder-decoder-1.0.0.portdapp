{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "encoder-decoder",
 "name": "Encoder-Decoder",
 "version": "1.0.0",
 "description": "Base64, URL, hex and HTML entities both ways, a JWT reader, hashes, GUIDs, passwords and passphrases.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 960,
 "height": 620,
 "singleInstance": false,
 "fileTypes": [],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"4\" y=\"8\" width=\"56\" height=\"48\" rx=\"7\" fill=\"#0f7a6c\"/><path d=\"M14 24h12M14 32h8M14 40h12\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M30 32h6m0 0-4-4m4 4-4 4\" stroke=\"#ffd34d\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/><text x=\"49\" y=\"38\" font-family=\"Consolas, monospace\" font-size=\"16\" font-weight=\"700\" fill=\"#fff\" text-anchor=\"middle\">01</text></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"encoder-decoder\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Encoder-Decoder</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\">\n    <div id=\"tabs\" class=\"tabs\" role=\"tablist\" aria-label=\"Tools\"></div>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n  </div>\n  <div id=\"panels\" class=\"panels\"></div>\n  <div class=\"foot muted\">Nothing you type here is saved or sent anywhere. Alt+1 to Alt+7 switch tools · Alt+S swap · Alt+C copy · Alt+X clear</div>\n</div>\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"close\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n<script src=\"js/host.js\"></script>\n<script src=\"js/codec.js\"></script>\n<script src=\"js/words.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Encoder-Decoder: the window. Seven tools on tabs; each converts live as you type. Only the open tab, each tool's\n   options and the theme are saved: what you type (tokens, passwords) is never kept. */\n(function () {\n  'use strict';\n  const C = window.Codec, $ = id => document.getElementById(id);\n  const num = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => num(n) + ' ' + (n === 1 ? w : ws || w + 's');\n  const DEFAULTS = {\n    b64: { dir: 'enc', url: false, cs: 'utf8', wrap: false },\n    url: { dir: 'enc', whole: false, plus: true },\n    hex: { dir: 'enc', sep: ' ', upper: false },\n    html: { dir: 'enc', all: false },\n    hash: { upper: false },\n    gen: { kind: 'uuid', count: 1, gupper: false, braces: false, length: 20, upper: true, lower: true, digits: true, symbols: true, clear: true, words: 5, sep: '-', capital: true, digit: true }\n  };\n  let settings = { theme: 'auto', tab: 'b64', opts: JSON.parse(JSON.stringify(DEFAULTS)) };\n  const tools = {}, order = [];\n\n  /* ---------- helpers ---------- */\n  function h(tag, attrs, ...kids) {\n    const e = document.createElement(tag);\n    for (const k in attrs || {}) { const v = attrs[k]; if (v == null || v === false) continue; if (k === 'class') e.className = v; else if (k === 'text') e.textContent = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v === true ? '' : v); }\n    for (const k of kids.flat()) if (k != null) e.append(k);\n    return e;\n  }\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2200); }\n  const saveSettings = () => Host.saveSettings(settings);\n  async function copy(text, what) {\n    if (!text) { toast('There is nothing to copy yet.'); return; }\n    if (await Host.copy(text)) { toast('Copied ' + (what || plural(text.length, 'character'))); return; }\n    const ov = $('copyDlg'), back = document.activeElement;\n    $('copyText').value = text; ov.hidden = false; $('copyText').focus(); $('copyText').select();\n    const close = () => { ov.hidden = true; ov.removeEventListener('keydown', key); if (back) back.focus(); };\n    const key = e => { if (e.key === 'Escape') { e.preventDefault(); close(); } else if (e.key === 'Tab') { e.preventDefault(); (document.activeElement === $('copyText') ? ov.querySelector('[data-act]') : $('copyText')).focus(); } e.stopPropagation(); };\n    ov.querySelector('[data-act]').onclick = close; ov.addEventListener('keydown', key);\n  }\n  /* a text box whose whole text can be replaced (Clear, Swap) with Ctrl+Z bringing the old text back */\n  function undoable(ta, changed) {\n    let undo = null;\n    ta.replaceAll = t => { undo = ta.value !== t ? { before: ta.value, after: t } : null; ta.value = t; changed(); };\n    ta.addEventListener('keydown', e => {\n      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z' && undo && ta.value === undo.after) { e.preventDefault(); const b = undo.before; undo = null; ta.value = b; changed(); toast('The earlier text is back.'); }\n    });\n    ta.addEventListener('input', changed);\n  }\n  function seg(label, value, choices, onPick) {   /* a row of buttons, one pressed */\n    const box = h('div', { class: 'seg', role: 'group', 'aria-label': label });\n    for (const [v, text] of choices) box.append(h('button', { class: 'sbtn', 'data-v': v, 'aria-pressed': String(v === value), onclick: () => { for (const b of box.children) b.setAttribute('aria-pressed', String(b.dataset.v === v)); onPick(v); } }, text));\n    box.set = v => { for (const b of box.children) b.setAttribute('aria-pressed', String(b.dataset.v === v)); };\n    return box;\n  }\n  function check(label, on, onChange, title) {\n    const i = h('input', { type: 'checkbox' }); i.checked = !!on; i.onchange = () => onChange(i.checked);\n    return h('label', { class: 'chk', title }, i, ' ' + label);\n  }\n  function select(label, value, choices, onChange) {\n    const s = h('select', { class: 'field', 'aria-label': label });\n    for (const [v, t] of choices) s.append(new Option(t, v));\n    s.value = value; s.onchange = () => onChange(s.value);\n    return h('label', { class: 'sel' }, label + ' ', s);\n  }\n\n  /* ---------- the four converters share one layout: input left, output right ---------- */\n  function converter(id, name, cfg) {\n    const o = settings.opts[id];\n    const inLabel = h('label', { class: 'colhead', for: id + '-in' }), outLabel = h('label', { class: 'colhead', for: id + '-out' });\n    const input = h('textarea', { id: id + '-in', class: 'ta mono', spellcheck: 'false', placeholder: '' });\n    const output = h('textarea', { id: id + '-out', class: 'ta mono out', readonly: true, spellcheck: 'false' });\n    const msg = h('div', { class: 'msg', role: 'status' }), info = h('span', { class: 'muted small' });\n    const dirSeg = seg('Direction', o.dir, [['enc', 'Encode'], ['dec', 'Decode']], v => { o.dir = v; saveSettings(); update(); });\n    const swapBtn = h('button', { class: 'btn', title: 'Turn the result into the input and change direction (Alt+S)', onclick: swap }, '⇄ Swap');\n    const copyBtn = h('button', { class: 'btn primary', title: 'Copy the result (Alt+C)', onclick: () => copy(output.value) }, 'Copy');\n    const clearBtn = h('button', { class: 'btn', title: 'Clear the input (Alt+X); Ctrl+Z in the box brings it back', onclick: clear }, 'Clear');\n    const opts = h('div', { class: 'opts' }, cfg.options(o, () => { saveSettings(); update(); }));\n    const panel = h('section', { class: 'panel conv', id: 'p-' + id, role: 'tabpanel', 'aria-labelledby': 't-' + id },\n      h('div', { class: 'ctrl' }, dirSeg, opts, h('span', { class: 'grow' }), swapBtn),\n      h('div', { class: 'cols' },\n        h('div', { class: 'col' }, inLabel, input, h('div', { class: 'acts' }, info, h('span', { class: 'grow' }), clearBtn)),\n        h('div', { class: 'col' }, outLabel, output, h('div', { class: 'acts' }, msg, h('span', { class: 'grow' }), copyBtn))));\n    function update() {\n      const [a, b] = cfg.labels(o);\n      inLabel.textContent = a; outLabel.textContent = b;\n      input.placeholder = o.dir === 'enc' ? 'Type or paste the text to encode' : 'Paste the ' + a + ' to decode';\n      info.textContent = input.value ? plural(input.value.length, 'character') : '';\n      if (!input.value) { output.value = ''; msg.textContent = ''; msg.className = 'msg'; return; }\n      try {\n        const r = cfg.run(input.value, o);\n        output.value = r.out; msg.textContent = r.note || plural(r.out.length, 'character'); msg.className = 'msg' + (r.note ? ' note' : '');\n      } catch (e) { output.value = ''; msg.textContent = e.message; msg.className = 'msg err'; }\n    }\n    function swap() {\n      if (msg.classList.contains('err')) { toast('Fix the input first: there is nothing to swap.'); return; }\n      const out = output.value;\n      o.dir = o.dir === 'enc' ? 'dec' : 'enc'; dirSeg.set(o.dir); saveSettings();\n      input.replaceAll(out); input.focus();\n    }\n    function clear() { if (!input.value) return; input.replaceAll(''); input.focus(); toast('Cleared. Ctrl+Z in the box brings it back.'); }\n    undoable(input, update);\n    update();\n    return { panel, name, swap, clear, copyOut: () => copy(output.value), focus: () => input.focus(), input, output, msg };\n  }\n  /* bytes that should be text: UTF-8 if they are, else shown as Latin-1 with a note */\n  function bytesToText(bytes, cs) {\n    if (cs === 'latin1') return { out: C.fromLatin1(bytes) };\n    try { return { out: C.fromUtf8(bytes) }; }\n    catch (e) { return { out: C.fromLatin1(bytes), note: 'These ' + plural(bytes.length, 'byte') + ' are not UTF-8 text, so they are shown one character per byte (Latin-1). In hex they start ' + C.hexOf(bytes.subarray(0, 24), ' ') + (bytes.length > 24 ? ' …' : '') }; }\n  }\n\n  function build() {\n  tools.b64 = converter('b64', 'Base64', {\n    labels: o => o.dir === 'enc' ? ['Text', o.url ? 'Base64URL' : 'Base64'] : [o.url ? 'Base64URL' : 'Base64', 'Text'],\n    options: (o, ch) => [\n      seg('Alphabet', o.url ? 'url' : 'std', [['std', 'Base64'], ['url', 'Base64URL']], v => { o.url = v === 'url'; ch(); }),\n      select('Text is', o.cs, [['utf8', 'UTF-8'], ['latin1', 'Latin-1']], v => { o.cs = v; ch(); }),\n      check('Lines of 76', o.wrap, v => { o.wrap = v; ch(); }, 'When encoding, break the result into lines of 76 characters (as in email)')],\n    run: (s, o) => {\n      if (o.dir === 'enc') { let out = C.b64encode(o.cs === 'latin1' ? C.latin1(s) : C.utf8(s), o.url); if (o.wrap) out = out.replace(/.{76}(?=.)/g, '$&\\n'); return { out }; }\n      return bytesToText(C.b64decode(s, o.url), o.cs);\n    }\n  });\n  tools.url = converter('url', 'URL', {\n    labels: o => o.dir === 'enc' ? ['Text', 'URL-encoded'] : ['URL-encoded', 'Text'],\n    options: (o, ch) => [\n      check('Whole address', o.whole, v => { o.whole = v; ch(); }, 'When encoding, keep : / ? # & = as they are, for a full web address'),\n      check('+ means space', o.plus, v => { o.plus = v; ch(); }, 'When decoding, turn + into a space (as in web forms)')],\n    run: (s, o) => ({ out: o.dir === 'enc' ? C.urlEncode(s, o.whole) : C.urlDecode(s, o.plus) })\n  });\n  tools.hex = converter('hex', 'Hex', {\n    labels: o => o.dir === 'enc' ? ['Text', 'Hex (UTF-8 bytes)'] : ['Hex', 'Text'],\n    options: (o, ch) => [\n      select('Between bytes', o.sep, [[' ', 'space'], ['', 'nothing'], [':', 'colon'], ['-', 'dash']], v => { o.sep = v; ch(); }),\n      check('Upper case', o.upper, v => { o.upper = v; ch(); })],\n    run: (s, o) => {\n      if (o.dir === 'enc') { const x = C.hexOf(C.utf8(s), o.sep); return { out: o.upper ? x.toUpperCase() : x, note: plural(C.utf8(s).length, 'byte') }; }\n      const b = C.hexDecode(s), r = bytesToText(b, 'utf8');\n      if (!r.note) r.note = plural(b.length, 'byte');\n      return r;\n    }\n  });\n  tools.html = converter('html', 'HTML', {\n    labels: o => o.dir === 'enc' ? ['Text', 'HTML entities'] : ['HTML entities', 'Text'],\n    options: (o, ch) => [check('Also non-ASCII', o.all, v => { o.all = v; ch(); }, 'When encoding, also write letters such as é and emoji as &#…; numbers')],\n    run: (s, o) => {\n      if (o.dir === 'enc') return { out: C.htmlEncode(s, o.all) };\n      const r = C.htmlDecode(s);\n      return { out: r.text, note: r.unknown.length ? 'Not recognised, so left as they are: ' + r.unknown.map(u => '&' + u + ';').join(' ') : '' };\n    }\n  });\n\n  /* ---------- JWT ---------- */\n  tools.jwt = (function () {\n    const input = h('textarea', { id: 'jwt-in', class: 'ta mono', spellcheck: 'false', placeholder: 'Paste a token (eyJ…), with or without \"Bearer \"' });\n    const out = h('div', { class: 'jwtout', id: 'jwt-out', 'aria-live': 'polite' });\n    const clearBtn = h('button', { class: 'btn', title: 'Clear (Alt+X); Ctrl+Z in the box brings it back', onclick: clear }, 'Clear');\n    const panel = h('section', { class: 'panel', id: 'p-jwt', role: 'tabpanel', 'aria-labelledby': 't-jwt' },\n      h('div', { class: 'ctrl' }, h('div', { class: 'warnline' }, h('b', null, 'Decoding only.'), ' The signature is not checked, so this does not tell you the token is genuine.')),\n      h('div', { class: 'cols' },\n        h('div', { class: 'col' }, h('label', { class: 'colhead', for: 'jwt-in' }, 'Token'), input, h('div', { class: 'acts' }, h('span', { class: 'grow' }), clearBtn)),\n        h('div', { class: 'col' }, h('div', { class: 'colhead' }, 'What it says'), out)));\n    let header = '', payload = '';\n    const fmt = d => ({ local: d.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'medium' }), utc: d.toISOString().replace('T', ' ').replace(/\\.\\d+Z$/, ' UTC') });\n    function ago(ms) {\n      const a = Math.abs(ms), u = [[86400000, 'day'], [3600000, 'hour'], [60000, 'minute'], [1000, 'second']].find(x => a >= x[0]) || [1000, 'second'];\n      const t = plural(Math.floor(a / u[0]), u[1]);\n      return ms > 0 ? 'in ' + t : t + ' ago';\n    }\n    function update() {\n      out.textContent = ''; header = payload = '';\n      if (!input.value.trim()) { out.append(h('p', { class: 'muted' }, 'The header, the claims and the times appear here.')); return; }\n      let t;\n      try { t = C.jwt(input.value); } catch (e) { out.append(h('div', { class: 'msg err' }, e.message)); return; }\n      header = JSON.stringify(t.header, null, 2); payload = JSON.stringify(t.payload, null, 2);\n      const now = Date.now(), times = C.jwtTimes(t.payload), chips = h('div', { class: 'chips' });\n      const exp = times.find(x => x.name === 'exp'), nbf = times.find(x => x.name === 'nbf');\n      if (exp) chips.append(exp.date.getTime() < now ? h('span', { class: 'chip bad' }, 'Expired ' + ago(exp.date - now)) : h('span', { class: 'chip ok' }, 'Not expired: ends ' + ago(exp.date - now)));\n      else chips.append(h('span', { class: 'chip' }, 'No expiry (exp)'));\n      if (nbf && nbf.date.getTime() > now) chips.append(h('span', { class: 'chip bad' }, 'Not valid yet: starts ' + ago(nbf.date - now)));\n      chips.append(h('span', { class: 'chip' }, 'Algorithm: ' + (t.header.alg || '?')));\n      if (!t.signed || t.header.alg === 'none') chips.append(h('span', { class: 'chip bad' }, 'Not signed'));\n      out.append(chips);\n      if (times.length) {\n        const NAMES = { iat: 'Issued (iat)', nbf: 'Valid from (nbf)', exp: 'Expires (exp)', auth_time: 'Signed in (auth_time)' };\n        const tb = h('table', { class: 'times' }, h('tr', null, h('th', null, ''), h('th', null, 'Your time'), h('th', null, 'UTC')));\n        for (const x of times) { const f = fmt(x.date); tb.append(h('tr', { class: x.name === 'exp' && x.date.getTime() < now ? 'expired' : '' }, h('td', null, NAMES[x.name]), h('td', null, f.local), h('td', null, f.utc))); }\n        out.append(tb);\n      }\n      const block = (title, text) => h('div', { class: 'jblock' }, h('div', { class: 'jhead' }, h('b', null, title), h('span', { class: 'grow' }), h('button', { class: 'btn small', onclick: () => copy(text, title.toLowerCase()) }, 'Copy')), h('pre', { class: 'mono', tabindex: '0', 'aria-label': title }, text));\n      out.append(block('Header', header), block('Payload', payload));\n    }\n    function clear() { if (!input.value) return; input.replaceAll(''); input.focus(); toast('Cleared. Ctrl+Z in the box brings it back.'); }\n    undoable(input, update);\n    update();\n    return { panel, name: 'JWT', clear, copyOut: () => copy(payload, 'payload'), focus: () => input.focus(), swap: () => toast('Swap is for the converters.'), input };\n  })();\n\n  /* ---------- Hash ---------- */\n  tools.hash = (function () {\n    const o = settings.opts.hash;\n    const input = h('textarea', { id: 'hash-in', class: 'ta mono', spellcheck: 'false', placeholder: 'Type text to hash, or press Open file…' });\n    const fileBox = h('div', { class: 'filebox', hidden: true });\n    const openBtn = h('button', { class: 'btn', title: 'Hash a file instead of text', onclick: openFile }, 'Open file…');\n    const clearBtn = h('button', { class: 'btn', title: 'Clear (Alt+X)', onclick: clear }, 'Clear');\n    const rows = h('div', { class: 'hrows', id: 'hash-out' });\n    const expect = h('input', { class: 'field mono', id: 'hash-expect', spellcheck: 'false', autocomplete: 'off', placeholder: 'Paste the hash you expect, to compare' });\n    const verdict = h('div', { class: 'msg', role: 'status', id: 'hash-verdict' });\n    const info = h('span', { class: 'muted small' });\n    const panel = h('section', { class: 'panel', id: 'p-hash', role: 'tabpanel', 'aria-labelledby': 't-hash' },\n      h('div', { class: 'ctrl' }, openBtn, check('Upper case', o.upper, v => { o.upper = v; saveSettings(); draw(); })),\n      h('div', { class: 'cols' },\n        h('div', { class: 'col' }, h('label', { class: 'colhead', for: 'hash-in' }, 'Text'), fileBox, input, h('div', { class: 'acts' }, info, h('span', { class: 'grow' }), clearBtn)),\n        h('div', { class: 'col' }, h('div', { class: 'colhead' }, 'Hashes'), rows, h('label', { class: 'colhead', for: 'hash-expect' }, 'Compare'), expect, verdict)));\n    let file = null, results = {}, seq = 0;\n    async function compute() {\n      const my = ++seq;\n      const bytes = file ? file.bytes : C.utf8(input.value);\n      info.textContent = file ? '' : plural(bytes.length, 'byte') + ' as UTF-8';\n      const r = {};\n      for (const a of C.HASHES) r[a] = C.hexOf(await C.hash(a, bytes));\n      if (my !== seq) return;\n      results = r; draw();\n    }\n    function draw() {\n      rows.textContent = '';\n      for (const a of C.HASHES) {\n        const v = results[a] ? (o.upper ? results[a].toUpperCase() : results[a]) : '';\n        rows.append(h('div', { class: 'hrow' + (a === 'MD5' ? ' weak' : ''), 'data-alg': a },\n          h('div', { class: 'hname' }, a, a === 'MD5' ? h('span', { class: 'tag' }, 'not secure') : null),\n          h('div', { class: 'hval mono', tabindex: '0', 'aria-label': a + ' ' + v }, v),\n          h('button', { class: 'btn small', 'aria-label': 'Copy ' + a, onclick: () => copy(v, 'the ' + a + ' hash') }, 'Copy')));\n      }\n      compare();\n    }\n    function compare() {\n      const want = expect.value.trim().toLowerCase().replace(/^(sha-?\\d+|md5)\\s*[:=]\\s*/, '').replace(/[\\s:]/g, '');\n      for (const r of rows.children) r.classList.remove('match');\n      if (!want) { verdict.textContent = ''; verdict.className = 'msg'; return; }\n      const hit = C.HASHES.find(a => results[a] === want);\n      if (hit) { rows.querySelector('[data-alg=\"' + hit + '\"]').classList.add('match'); verdict.textContent = '✓ Matches the ' + hit + ' hash.'; verdict.className = 'msg ok'; }\n      else { verdict.textContent = '✗ Does not match any of these hashes.'; verdict.className = 'msg err'; }\n    }\n    expect.addEventListener('input', compare);\n    function setFile(f) {\n      file = f; input.hidden = !f ? false : true; fileBox.hidden = !f; fileBox.textContent = '';\n      if (f) fileBox.append(h('div', null, h('b', null, f.name), h('div', { class: 'muted small' }, plural(f.bytes.length, 'byte') + (f.asText ? ' (stored by PortD as text, hashed as UTF-8)' : ''))), h('button', { class: 'btn', onclick: () => { setFile(null); input.focus(); } }, 'Back to text'));\n      compute();\n    }\n    async function openFile() {\n      try {\n        if (Host.inPortD) {\n          const r = await PortD.ui.openFile({ title: 'Hash a file' });\n          if (!r) return;\n          const d = await PortD.fs.read(r.path), m = typeof d === 'string' && /^data:[^,]*;base64,/.exec(d);\n          if (m) setFile({ name: r.name, bytes: C.b64decode(d.slice(m[0].length)) });\n          else setFile({ name: r.name, bytes: C.utf8(String(d)), asText: true });\n        } else {\n          const i = h('input', { type: 'file' });\n          i.onchange = async () => { const f = i.files[0]; if (f) setFile({ name: f.name, bytes: new Uint8Array(await f.arrayBuffer()) }); };\n          i.click();\n        }\n      } catch (e) { toast('Could not read the file: ' + e.message, 5000); }\n    }\n    let t = 0;\n    undoable(input, () => { clearTimeout(t); t = setTimeout(compute, 150); });\n    function clear() { if (file) { setFile(null); return; } if (!input.value) return; input.replaceAll(''); input.focus(); toast('Cleared. Ctrl+Z in the box brings it back.'); }\n    compute();\n    return { panel, name: 'Hash', clear, copyOut: () => copy(results['SHA-256'] && (o.upper ? results['SHA-256'].toUpperCase() : results['SHA-256']), 'the SHA-256 hash'), focus: () => input.hidden ? openBtn.focus() : input.focus(), swap: () => toast('Swap is for the converters.'), input, compute, get results() { return results; } };\n  })();\n\n  /* ---------- Generate ---------- */\n  tools.gen = (function () {\n    const o = settings.opts.gen;\n    const output = h('textarea', { id: 'gen-out', class: 'ta mono out', readonly: true, spellcheck: 'false' });\n    const note = h('div', { class: 'msg', role: 'status' });\n    const genBtn = h('button', { class: 'btn primary', id: 'genBtn', title: 'Make new ones (Alt+G)', onclick: () => make(true) }, 'Generate');\n    const copyBtn = h('button', { class: 'btn', title: 'Copy (Alt+C)', onclick: () => copy(output.value) }, 'Copy');\n    const optBox = h('div', { class: 'gopts' });\n    const kindSeg = seg('What to make', o.kind, [['uuid', 'GUID'], ['password', 'Password'], ['phrase', 'Passphrase']], v => { o.kind = v; saveSettings(); drawOpts(); make(); });\n    const numIn = (label, key, min, max) => {\n      const i = h('input', { type: 'number', class: 'field num', min, max, value: o[key], 'aria-label': label });\n      i.oninput = () => { const v = Math.max(min, Math.min(max, parseInt(i.value, 10) || min)); if (String(v) === i.value) { o[key] = v; saveSettings(); make(); } };\n      i.onchange = () => { const v = Math.max(min, Math.min(max, parseInt(i.value, 10) || min)); i.value = v; if (o[key] !== v) { o[key] = v; saveSettings(); make(); } };\n      return h('label', { class: 'sel' }, label + ' ', i);\n    };\n    const tick = (label, key, title) => check(label, o[key], v => { o[key] = v; saveSettings(); make(); }, title);\n    function drawOpts() {\n      optBox.textContent = '';\n      if (o.kind === 'uuid') optBox.append(numIn('How many', 'count', 1, 1000), tick('Upper case', 'gupper'), tick('With { }', 'braces', 'As in the Windows registry'));\n      else if (o.kind === 'password') optBox.append(numIn('Length', 'length', 4, 128), tick('A–Z', 'upper'), tick('a–z', 'lower'), tick('0–9', 'digits'), tick('Symbols', 'symbols', C.SETS.symbols), tick('Avoid look-alikes', 'clear', 'Leave out I l 1 O 0 o'));\n      else optBox.append(numIn('Words', 'words', 3, 12), select('Between words', o.sep, [['-', 'dash'], [' ', 'space'], ['.', 'dot'], ['_', 'underscore'], ['', 'nothing']], v => { o.sep = v; saveSettings(); make(); }), tick('Capitals', 'capital'), tick('Add a digit', 'digit'));\n    }\n    const panel = h('section', { class: 'panel', id: 'p-gen', role: 'tabpanel', 'aria-labelledby': 't-gen' },\n      h('div', { class: 'ctrl' }, kindSeg, h('span', { class: 'grow' }), genBtn),\n      h('div', { class: 'cols' },\n        h('div', { class: 'col narrow' }, h('div', { class: 'colhead' }, 'Options'), optBox, h('p', { class: 'muted small' }, 'Made with the browser\\'s secure random numbers (crypto.getRandomValues). Nothing is kept: copy what you need.')),\n        h('div', { class: 'col' }, h('label', { class: 'colhead', for: 'gen-out' }, 'Result'), output, h('div', { class: 'acts' }, note, h('span', { class: 'grow' }), copyBtn))));\n    function make(announce) {\n      try {\n        if (o.kind === 'uuid') {\n          const list = []; for (let i = 0; i < o.count; i++) { let u = C.uuid(); if (o.gupper) u = u.toUpperCase(); if (o.braces) u = '{' + u + '}'; list.push(u); }\n          output.value = list.join('\\n'); note.textContent = plural(o.count, 'GUID') + ' (version 4, random)'; note.className = 'msg';\n        } else {\n          const r = o.kind === 'password' ? C.password(o) : C.passphrase(o);\n          output.value = r.text; note.textContent = 'About ' + r.bits + ' bits: ' + C.strength(r.bits) + '.' + (o.kind === 'phrase' ? ' From ' + num(C.WORDS.length) + ' words.' : '');\n          note.className = 'msg ' + (r.bits < 40 ? 'err' : r.bits < 60 ? 'note' : 'ok');\n        }\n      } catch (e) { output.value = ''; note.textContent = e.message; note.className = 'msg err'; }\n      if (announce) toast('Made new ' + (o.kind === 'uuid' ? (o.count > 1 ? 'GUIDs' : 'GUID') : o.kind === 'password' ? 'password' : 'passphrase'), 1200);\n    }\n    drawOpts(); make();\n    return { panel, name: 'Generate', clear: () => {}, copyOut: () => copy(output.value), focus: () => genBtn.focus(), swap: () => toast('Swap is for the converters.'), make, output };\n  })();\n\n  }\n\n  /* ---------- tabs ---------- */\n  const TABS = [['b64', 'Base64'], ['url', 'URL'], ['hex', 'Hex'], ['html', 'HTML'], ['jwt', 'JWT'], ['hash', 'Hash'], ['gen', 'Generate']];\n  function drawTabs() { TABS.forEach(([id, name], i) => {\n    order.push(id);\n    $('tabs').append(h('button', { class: 'tab', id: 't-' + id, role: 'tab', 'aria-controls': 'p-' + id, title: name + ' (Alt+' + (i + 1) + ')', onclick: () => setTab(id, false) }, name));\n    $('panels').append(tools[id].panel);\n  }); }\n  function setTab(id, focusTab) {\n    if (!tools[id]) id = 'b64';\n    settings.tab = id;\n    for (const t of order) { const on = t === id, b = $('t-' + t); b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; tools[t].panel.hidden = !on; }\n    if (focusTab) $('t-' + id).focus();\n    saveSettings();\n  }\n  $('tabs').addEventListener('keydown', e => {\n    const i = order.indexOf(settings.tab), to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: order.length - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); setTab(order[(to + order.length) % order.length], true);\n  });\n  document.addEventListener('keydown', e => {\n    if (!$('copyDlg').hidden || !e.altKey || e.ctrlKey || e.metaKey) return;\n    const k = e.key.toLowerCase(), t = tools[settings.tab];\n    let go = null;\n    if (/^[1-7]$/.test(k)) go = () => { setTab(order[+k - 1]); tools[order[+k - 1]].focus(); };\n    else go = { s: () => t.swap(), c: () => t.copyOut(), x: () => t.clear(), g: () => { if (settings.tab === 'gen') tools.gen.make(true); } }[k];\n    if (go) { e.preventDefault(); go(); }\n  });\n\n  /* ---------- theme ---------- */\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); saveSettings(); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- start: settings are read first, then the tools are drawn with them ---------- */\n  (async () => {\n    const s = await Host.loadSettings({});\n    if (s && typeof s === 'object') {\n      if (['auto', 'light', 'dark'].includes(s.theme)) settings.theme = s.theme;\n      if (s.opts && typeof s.opts === 'object') for (const k in DEFAULTS) if (s.opts[k] && typeof s.opts[k] === 'object') for (const p in DEFAULTS[k]) if (typeof s.opts[k][p] === typeof DEFAULTS[k][p]) settings.opts[k][p] = s.opts[k][p];\n      if (typeof s.tab === 'string') settings.tab = s.tab;\n    }\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    Host.setTitle('Encoder-Decoder');\n    build(); drawTabs();\n    setTab(settings.tab); tools[settings.tab].focus();\n    window.__ed = { tools, get settings() { return settings; }, ready: true };\n  })();\n})();\n"
  },
  "js/codec.js": {
   "enc": "text",
   "d": "/* Encoder-Decoder: the conversions, hashing and generators. No drawing here; app.js draws.\n   Everything hangs off window.Codec. Functions throw an Error with a plain message when the input is wrong. */\n(function () {\n  'use strict';\n  const C = window.Codec = {};\n  const enc = new TextEncoder();\n  C.utf8 = s => enc.encode(s);\n  /* bytes to text: UTF-8, strictly; throws if the bytes are not valid UTF-8 */\n  C.fromUtf8 = b => new TextDecoder('utf-8', { fatal: true }).decode(b);\n  C.latin1 = s => { const b = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) { const c = s.charCodeAt(i); if (c > 255) throw new Error('\"' + s[i] + '\" (position ' + (i + 1) + ') is not a Latin-1 character. Choose UTF-8.'); b[i] = c; } return b; };\n  C.fromLatin1 = b => { let s = ''; for (let i = 0; i < b.length; i += 8192) s += String.fromCharCode.apply(null, b.subarray(i, i + 8192)); return s; };\n  C.hexOf = (b, sep) => Array.from(b, x => x.toString(16).padStart(2, '0')).join(sep || '');\n\n  /* ---------- Base64 and Base64URL ---------- */\n  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\n  C.b64encode = function (bytes, url) {\n    let s = '';\n    for (let i = 0; i < bytes.length; i += 3) {\n      const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);\n      s += B64[n >> 18 & 63] + B64[n >> 12 & 63] + (i + 1 < bytes.length ? B64[n >> 6 & 63] : '=') + (i + 2 < bytes.length ? B64[n & 63] : '=');\n    }\n    return url ? s.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '') : s;\n  };\n  /* decodes standard or URL-safe Base64; spaces and line breaks are ignored, '=' padding is optional */\n  C.b64decode = function (text, url) {\n    const s = text.replace(/[\\s]/g, '');\n    const bad = url ? /[^A-Za-z0-9\\-_=]/ : /[^A-Za-z0-9+/=]/, m = bad.exec(s);\n    if (m) {\n      const hint = url && /[+/]/.test(m[0]) ? ' That looks like standard Base64: choose Base64 instead of Base64URL.' : !url && /[-_]/.test(m[0]) ? ' That looks like Base64URL: choose Base64URL.' : '';\n      throw new Error('This is not valid ' + (url ? 'Base64URL' : 'Base64') + ': \"' + m[0] + '\" at position ' + (text.indexOf(m[0]) + 1) + ' is not allowed.' + hint);\n    }\n    const body = s.replace(/=+$/, '');\n    if (body.includes('=')) throw new Error('This is not valid Base64: \"=\" can only come at the end.');\n    if (body.length % 4 === 1) throw new Error('This is not valid Base64: it is one character too long or too short.');\n    const out = new Uint8Array(Math.floor(body.length * 3 / 4));\n    let o = 0, acc = 0, bits = 0;\n    for (const ch of body) {\n      acc = (acc << 6) | B64.indexOf(url ? (ch === '-' ? '+' : ch === '_' ? '/' : ch) : ch); bits += 6;\n      if (bits >= 8) { bits -= 8; out[o++] = (acc >> bits) & 255; }\n    }\n    return out.subarray(0, o);\n  };\n\n  /* ---------- URL ---------- */\n  C.urlEncode = (s, whole) => whole ? encodeURI(s) : encodeURIComponent(s);\n  C.urlDecode = function (s, plus) {\n    if (plus) s = s.replace(/\\+/g, ' ');\n    try { return decodeURIComponent(s); }\n    catch (e) {\n      const m = /%(?![0-9A-Fa-f]{2})|(%[0-9A-Fa-f]{2})+/.exec(s);\n      throw new Error('This is not valid URL encoding' + (m ? ' near \"' + s.slice(m.index, m.index + 9) + '\"' : '') + ': every % must be followed by two hex digits that spell out UTF-8.');\n    }\n  };\n\n  /* ---------- hex ---------- */\n  C.hexDecode = function (text) {\n    const s = text.replace(/0x/gi, '').replace(/[\\s,:;-]/g, '');\n    const m = /[^0-9a-fA-F]/.exec(s);\n    if (m) throw new Error('This is not hex: \"' + m[0] + '\" is not 0-9 or a-f.');\n    if (s.length % 2) throw new Error('This hex has an odd number of digits (' + s.length + '): each byte needs two.');\n    const b = new Uint8Array(s.length / 2);\n    for (let i = 0; i < b.length; i++) b[i] = parseInt(s.substr(i * 2, 2), 16);\n    return b;\n  };\n\n  /* ---------- HTML entities ---------- */\n  const NAMED = { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\", nbsp: ' ', copy: '©', reg: '®', trade: '™', hellip: '…', mdash: '—', ndash: '–',\n    lsquo: '‘', rsquo: '’', ldquo: '“', rdquo: '”', sbquo: '‚', bdquo: '„', laquo: '«', raquo: '»', bull: '•', middot: '·', para: '¶', sect: '§',\n    euro: '€', pound: '£', yen: '¥', cent: '¢', curren: '¤', deg: '°', plusmn: '±', times: '×', divide: '÷', micro: 'µ', frac12: '½', frac14: '¼',\n    frac34: '¾', sup1: '¹', sup2: '²', sup3: '³', iexcl: '¡', iquest: '¿', shy: '­', ensp: ' ', emsp: ' ', thinsp: ' ',\n    larr: '←', rarr: '→', uarr: '↑', darr: '↓', harr: '↔', check: '✓', hearts: '♥', ne: '≠', le: '≤', ge: '≥', infin: '∞', minus: '−', prime: '′',\n    dagger: '†', Dagger: '‡', permil: '‰', zwj: '‍', zwnj: '‌', szlig: 'ß', aacute: 'á', eacute: 'é', iacute: 'í', oacute: 'ó', uacute: 'ú',\n    agrave: 'à', egrave: 'è', ograve: 'ò', acirc: 'â', ecirc: 'ê', ocirc: 'ô', auml: 'ä', euml: 'ë', iuml: 'ï', ouml: 'ö', uuml: 'ü', yuml: 'ÿ',\n    ntilde: 'ñ', ccedil: 'ç', aring: 'å', aelig: 'æ', oslash: 'ø', Auml: 'Ä', Ouml: 'Ö', Uuml: 'Ü', Eacute: 'É', Ntilde: 'Ñ', Ccedil: 'Ç' };\n  C.htmlEncode = function (s, all) {\n    let out = s.replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\n    if (all) out = out.replace(/[^\\x00-\\x7f]/gu, c => '&#' + c.codePointAt(0) + ';');\n    return out;\n  };\n  /* returns { text, unknown: [names not recognised, left as they were] } */\n  C.htmlDecode = function (s) {\n    const unknown = [];\n    const text = s.replace(/&(#[xX][0-9a-fA-F]+|#\\d+|[A-Za-z][A-Za-z0-9]*);/g, (all, e) => {\n      if (e[0] === '#') {\n        const n = e[1] === 'x' || e[1] === 'X' ? parseInt(e.slice(2), 16) : parseInt(e.slice(1), 10);\n        return n > 0 && n <= 0x10ffff && !(n >= 0xd800 && n <= 0xdfff) ? String.fromCodePoint(n) : all;\n      }\n      if (Object.prototype.hasOwnProperty.call(NAMED, e)) return NAMED[e];\n      if (!unknown.includes(e)) unknown.push(e);\n      return all;\n    });\n    return { text, unknown };\n  };\n\n  /* ---------- JWT (read only: the signature is not checked) ---------- */\n  C.jwt = function (token) {\n    const t = token.trim().replace(/^Bearer\\s+/i, '');\n    const parts = t.split('.');\n    if (parts.length === 5) throw new Error('This token has 5 parts, so it is encrypted (JWE). Only signed tokens (3 parts) can be read here.');\n    if (parts.length !== 3) throw new Error('A JWT has 3 parts separated by dots; this has ' + parts.length + '.');\n    const part = (p, what) => {\n      let bytes, text;\n      try { bytes = C.b64decode(p, true); } catch (e) { throw new Error('The ' + what + ' is not valid Base64URL.'); }\n      try { text = C.fromUtf8(bytes); } catch (e) { throw new Error('The ' + what + ' is not UTF-8 text.'); }\n      try { return JSON.parse(text); } catch (e) { throw new Error('The ' + what + ' is not valid JSON.'); }\n    };\n    const header = part(parts[0], 'header'), payload = part(parts[1], 'payload');\n    return { header, payload, signature: parts[2], signed: parts[2].length > 0 };\n  };\n  /* the time claims, as { name, seconds, date } */\n  C.jwtTimes = p => ['iat', 'nbf', 'exp', 'auth_time'].filter(k => typeof p[k] === 'number' && isFinite(p[k])).map(k => ({ name: k, seconds: p[k], date: new Date(p[k] * 1000) }));\n\n  /* ---------- MD5 (plain JavaScript; not secure, offered only to check old checksums) ---------- */\n  C.md5 = function (bytes) {\n    const K = new Uint32Array(64), S = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];\n    for (let i = 0; i < 64; i++) K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 4294967296);\n    const n = bytes.length, words = ((n + 8) >>> 6) + 1, M = new Uint32Array(words * 16);\n    for (let i = 0; i < n; i++) M[i >> 2] |= bytes[i] << ((i % 4) * 8);\n    M[n >> 2] |= 0x80 << ((n % 4) * 8);\n    M[words * 16 - 2] = (n * 8) >>> 0; M[words * 16 - 1] = Math.floor(n / 0x20000000);\n    let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;\n    for (let w = 0; w < words * 16; w += 16) {\n      let A = a0, B = b0, Cc = c0, D = d0;\n      for (let i = 0; i < 64; i++) {\n        let F, g;\n        if (i < 16) { F = (B & Cc) | (~B & D); g = i; }\n        else if (i < 32) { F = (D & B) | (~D & Cc); g = (5 * i + 1) % 16; }\n        else if (i < 48) { F = B ^ Cc ^ D; g = (3 * i + 5) % 16; }\n        else { F = Cc ^ (B | ~D); g = (7 * i) % 16; }\n        F = (F + A + K[i] + M[w + g]) >>> 0;\n        A = D; D = Cc; Cc = B;\n        const s = S[(i >> 4) * 4 + (i % 4)];\n        B = (B + ((F << s) | (F >>> (32 - s)))) >>> 0;\n      }\n      a0 = (a0 + A) >>> 0; b0 = (b0 + B) >>> 0; c0 = (c0 + Cc) >>> 0; d0 = (d0 + D) >>> 0;\n    }\n    const out = new Uint8Array(16), dv = new DataView(out.buffer);\n    [a0, b0, c0, d0].forEach((v, i) => dv.setUint32(i * 4, v, true));\n    return out;\n  };\n  C.HASHES = ['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512', 'MD5'];\n  C.hash = async (alg, bytes) => alg === 'MD5' ? C.md5(bytes) : new Uint8Array(await crypto.subtle.digest(alg, bytes));\n\n  /* ---------- random: crypto.getRandomValues only, with no bias ---------- */\n  C.randomBelow = function (n) {\n    const max = Math.floor(0x100000000 / n) * n, buf = new Uint32Array(1);\n    for (;;) { crypto.getRandomValues(buf); if (buf[0] < max) return buf[0] % n; }\n  };\n  C.uuid = function () {\n    const b = crypto.getRandomValues(new Uint8Array(16));\n    b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;\n    const h = C.hexOf(b);\n    return h.slice(0, 8) + '-' + h.slice(8, 12) + '-' + h.slice(12, 16) + '-' + h.slice(16, 20) + '-' + h.slice(20);\n  };\n  C.SETS = { upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', lower: 'abcdefghijklmnopqrstuvwxyz', digits: '0123456789', symbols: '!#$%&*+-=?@^_~.,:;()[]{}' };\n  const LOOKALIKE = /[Il1O0o]/g;\n  /* a password with at least one character from each chosen set; returns { text, bits } */\n  C.password = function (o) {\n    const sets = Object.keys(C.SETS).filter(k => o[k]).map(k => o.clear ? C.SETS[k].replace(LOOKALIKE, '') : C.SETS[k]);\n    if (!sets.length) throw new Error('Choose at least one kind of character.');\n    const len = Math.max(sets.length, Math.min(256, o.length | 0)), all = sets.join('');\n    const chars = sets.map(s => s[C.randomBelow(s.length)]);\n    while (chars.length < len) chars.push(all[C.randomBelow(all.length)]);\n    for (let i = chars.length - 1; i > 0; i--) { const j = C.randomBelow(i + 1); [chars[i], chars[j]] = [chars[j], chars[i]]; }\n    return { text: chars.join(''), bits: Math.round(len * Math.log2(all.length)) };\n  };\n  /* a passphrase from the word list; returns { text, bits } */\n  C.passphrase = function (o) {\n    const W = C.WORDS, n = Math.max(2, Math.min(20, o.words | 0));\n    let words = [];\n    for (let i = 0; i < n; i++) { let w = W[C.randomBelow(W.length)]; if (o.capital) w = w[0].toUpperCase() + w.slice(1); words.push(w); }\n    let bits = n * Math.log2(W.length);\n    if (o.digit) { const i = C.randomBelow(n); words[i] += C.randomBelow(10); bits += Math.log2(10 * n); }\n    return { text: words.join(o.sep == null ? '-' : o.sep), bits: Math.round(bits) };\n  };\n  C.strength = bits => bits < 40 ? 'weak' : bits < 60 ? 'fair' : bits < 80 ? 'strong' : 'very strong';\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/words.js": {
   "enc": "text",
   "d": "/* Encoder-Decoder: the passphrase word list. 687 plain English words, written for this program (no licence attached). */\nwindow.Codec.WORDS = [\n    'able', 'acid', 'acorn', 'actor', 'adult', 'advice', 'aerial', 'afraid', 'after', 'again', 'agent', 'airport', 'alarm', 'album',\n    'alert', 'alley', 'almond', 'alpine', 'amber', 'amount', 'anchor', 'angle', 'animal', 'ankle', 'answer', 'apple', 'april', 'apron',\n    'arch', 'arena', 'armor', 'arrow', 'artist', 'ash', 'atlas', 'atom', 'attic', 'august', 'autumn', 'avocado', 'award', 'awake',\n    'axis', 'baby', 'bacon', 'badge', 'bagel', 'baker', 'balance', 'ballet', 'bamboo', 'banana', 'band', 'banjo', 'barn', 'barrel',\n    'basil', 'basket', 'batch', 'beach', 'beacon', 'beam', 'bean', 'bear', 'beaver', 'bedroom', 'bee', 'beetle', 'bell', 'belt',\n    'bench', 'berry', 'bicycle', 'bingo', 'birch', 'bird', 'biscuit', 'blanket', 'blaze', 'blend', 'blossom', 'blue', 'blush', 'board',\n    'boat', 'bonus', 'book', 'boot', 'border', 'bottle', 'boulder', 'bowl', 'box', 'branch', 'brass', 'bread', 'breeze', 'brick',\n    'bridge', 'bright', 'brook', 'broom', 'brush', 'bucket', 'buffalo', 'bugle', 'bundle', 'burger', 'butter', 'button', 'buzz', 'cabin',\n    'cable', 'cactus', 'cake', 'calm', 'camel', 'camera', 'camp', 'canal', 'candle', 'candy', 'canoe', 'canvas', 'canyon', 'captain',\n    'carbon', 'card', 'cargo', 'carpet', 'carrot', 'castle', 'cat', 'cedar', 'cellar', 'cement', 'chalk', 'chapter', 'charm', 'cheese',\n    'cherry', 'chess', 'chicken', 'chimney', 'chorus', 'cider', 'cinema', 'circle', 'citrus', 'city', 'clay', 'cliff', 'climb', 'clock',\n    'cloud', 'clover', 'coach', 'coast', 'cobalt', 'cocoa', 'coconut', 'coffee', 'comet', 'comic', 'compass', 'copper', 'coral', 'corner',\n    'cotton', 'couch', 'cousin', 'cradle', 'crane', 'crater', 'crayon', 'cream', 'credit', 'cricket', 'crown', 'crystal', 'cube', 'cupboard',\n    'curtain', 'cushion', 'cycle', 'daisy', 'dance', 'dawn', 'deck', 'delta', 'denim', 'desert', 'desk', 'dial', 'diary', 'dice',\n    'dinner', 'dock', 'dolphin', 'domain', 'donkey', 'door', 'dragon', 'drawer', 'dream', 'drum', 'duck', 'dune', 'dust', 'eagle',\n    'early', 'earth', 'easel', 'echo', 'eclipse', 'eight', 'elbow', 'elder', 'electric', 'elephant', 'elm', 'ember', 'empty', 'engine',\n    'envelope', 'equal', 'escape', 'evening', 'exact', 'exit', 'fabric', 'falcon', 'family', 'fancy', 'farm', 'feather', 'fence', 'fern',\n    'ferry', 'festival', 'fiber', 'field', 'fig', 'filter', 'finch', 'fire', 'fish', 'flag', 'flame', 'flannel', 'flask', 'fleet',\n    'flint', 'flower', 'flute', 'focus', 'fog', 'folder', 'forest', 'fork', 'fossil', 'fountain', 'fox', 'frame', 'fresh', 'frog',\n    'frost', 'fruit', 'funnel', 'galaxy', 'garden', 'garlic', 'gate', 'gecko', 'gem', 'giant', 'ginger', 'giraffe', 'glacier', 'glass',\n    'globe', 'glove', 'goat', 'gold', 'golf', 'goose', 'grain', 'granite', 'grape', 'graph', 'grass', 'gravel', 'green', 'grid',\n    'guitar', 'gull', 'habit', 'hammer', 'hamster', 'harbor', 'harvest', 'hat', 'hazel', 'heart', 'hedge', 'helmet', 'herb', 'heron',\n    'hill', 'hobby', 'honey', 'hood', 'hook', 'horizon', 'horse', 'hotel', 'house', 'humble', 'hut', 'ice', 'icon', 'igloo',\n    'index', 'ink', 'input', 'insect', 'island', 'ivory', 'ivy', 'jacket', 'jaguar', 'jam', 'jar', 'jazz', 'jelly', 'jewel',\n    'jigsaw', 'journey', 'judge', 'juice', 'jumbo', 'jungle', 'kayak', 'kettle', 'key', 'kidney', 'kind', 'king', 'kite', 'kitten',\n    'kiwi', 'knee', 'knot', 'koala', 'label', 'ladder', 'lake', 'lamp', 'lantern', 'laptop', 'large', 'latch', 'lava', 'lawn',\n    'layer', 'leaf', 'lemon', 'lens', 'letter', 'lettuce', 'level', 'lily', 'lime', 'linen', 'lion', 'liquid', 'lizard', 'llama',\n    'lobster', 'locket', 'lodge', 'lotus', 'lunar', 'lunch', 'machine', 'magnet', 'mango', 'maple', 'marble', 'market', 'mask', 'meadow',\n    'medal', 'melon', 'menu', 'metal', 'meteor', 'middle', 'mint', 'mirror', 'mitten', 'model', 'monkey', 'moon', 'morning', 'mosaic',\n    'moss', 'motor', 'mountain', 'mouse', 'muffin', 'museum', 'music', 'napkin', 'narrow', 'nature', 'navy', 'nectar', 'needle', 'nest',\n    'net', 'nickel', 'night', 'ninja', 'noble', 'noodle', 'north', 'notebook', 'number', 'nutmeg', 'oak', 'oasis', 'ocean', 'octave',\n    'office', 'olive', 'omelet', 'onion', 'opal', 'orange', 'orbit', 'orchard', 'organ', 'otter', 'outdoor', 'owl', 'oxygen', 'oyster',\n    'paddle', 'page', 'paint', 'palace', 'palm', 'panda', 'paper', 'parade', 'parcel', 'park', 'parrot', 'pasta', 'path', 'peach',\n    'peanut', 'pearl', 'pebble', 'pelican', 'pencil', 'pepper', 'piano', 'picnic', 'pigeon', 'pillow', 'pilot', 'pine', 'pirate', 'pixel',\n    'pizza', 'planet', 'plaster', 'plum', 'pocket', 'poem', 'polar', 'pond', 'popcorn', 'poppy', 'portal', 'potato', 'pottery', 'powder',\n    'prairie', 'prism', 'puddle', 'pumpkin', 'puppet', 'puzzle', 'quail', 'quarter', 'quartz', 'queen', 'quest', 'quick', 'quiet', 'quilt',\n    'quiz', 'rabbit', 'radar', 'radio', 'rain', 'rainbow', 'raven', 'razor', 'recipe', 'record', 'reef', 'river', 'road', 'robin',\n    'robot', 'rocket', 'roof', 'rose', 'rotor', 'rubber', 'ruby', 'rug', 'ruler', 'saddle', 'safari', 'saffron', 'sail', 'salad',\n    'salmon', 'salt', 'sand', 'sandal', 'saturn', 'scarf', 'school', 'scooter', 'scout', 'season', 'seed', 'shadow', 'shell', 'shelf',\n    'ship', 'shore', 'signal', 'silk', 'silver', 'singer', 'sketch', 'ski', 'sky', 'slate', 'sled', 'slipper', 'smile', 'snail',\n    'snow', 'soap', 'socket', 'sofa', 'solar', 'sonar', 'soup', 'spark', 'sparrow', 'spice', 'spider', 'spinach', 'sponge', 'spoon',\n    'spring', 'square', 'squid', 'stable', 'stamp', 'star', 'station', 'statue', 'steam', 'steel', 'stone', 'storm', 'story', 'straw',\n    'stream', 'street', 'studio', 'sugar', 'summer', 'sun', 'sunset', 'swan', 'sweater', 'table', 'tablet', 'taco', 'tailor', 'tango',\n    'teacup', 'teapot', 'temple', 'tennis', 'tent', 'thistle', 'thunder', 'ticket', 'tiger', 'timber', 'toast', 'token', 'tomato', 'topaz',\n    'torch', 'tortoise', 'towel', 'tower', 'tractor', 'trail', 'train', 'travel', 'tree', 'triangle', 'trophy', 'trumpet', 'tulip', 'tunnel',\n    'turtle', 'tuxedo', 'twig', 'umbrella', 'uncle', 'unicorn', 'union', 'unit', 'upper', 'urban', 'useful', 'valley', 'vanilla', 'velvet',\n    'vessel', 'violet', 'violin', 'visit', 'voice', 'volcano', 'voyage', 'waffle', 'wagon', 'walnut', 'walrus', 'wander', 'wasabi', 'water',\n    'wave', 'wax', 'weather', 'whale', 'wheat', 'wheel', 'whisper', 'willow', 'window', 'winter', 'wizard', 'wolf', 'wood', 'wool',\n    'word', 'world', 'yacht', 'yard', 'yarn', 'year', 'yellow', 'yogurt', 'young', 'zebra', 'zero', 'zigzag', 'zinc', 'zipper',\n    'zone'\n];\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Encoder-Decoder */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #0b6e61; --onaccent: #ffffff; --sel: #d5efe9;\n  --ok: #1e6b37; --okbg: #e3f4e8; --err: #b42318; --errbg: #fde8e8; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00;\n  --mono: ui-monospace, \"Cascadia Mono\", Consolas, \"Courier New\", monospace;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #5fd3bf; --onaccent: #06231e; --sel: #1d3f3a;\n  --ok: #8fe0a8; --okbg: #183524; --err: #ff9b94; --errbg: #4a2a2e; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .mono { font-family: var(--mono); }\n.grow { flex: 1; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.bar { display: flex; align-items: flex-end; gap: 6px; padding: 6px 8px 0; background: var(--panel); border-bottom: 1px solid var(--line); }\n.bar .btn.icon { margin-bottom: 5px; }\n.tabs { display: flex; flex-wrap: wrap; gap: 2px; }\n.tab { font: inherit; color: var(--text); background: transparent; border: 1px solid transparent; border-bottom: 0; border-radius: 6px 6px 0 0; padding: 6px 12px; cursor: pointer; margin-bottom: -1px; }\n.tab:hover { background: var(--sel); }\n.tab.on { background: var(--bg); border-color: var(--line); font-weight: 600; }\n@media (pointer: coarse) { .tab { padding: 10px 14px; } }\n\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover { background: var(--sel); }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.small { min-height: 24px; padding: 2px 8px; font-size: 12px; }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.field.num { width: 76px; }\n@media (pointer: coarse) { .btn, .field, .sbtn { min-height: 40px; } .btn.small { min-height: 36px; } }\n\n.panels { flex: 1; min-height: 0; display: flex; }\n.panel { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 8px 10px; border-bottom: 1px solid var(--line); }\n.opts, .gopts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }\n.gopts { flex-direction: column; align-items: flex-start; }\n.seg { display: inline-flex; border: 1px solid var(--edge); border-radius: 6px; overflow: hidden; }\n.sbtn { font: inherit; color: var(--text); background: var(--bg); border: 0; border-right: 1px solid var(--edge); padding: 4px 12px; min-height: 28px; cursor: pointer; }\n.sbtn:last-child { border-right: 0; }\n.sbtn[aria-pressed=\"true\"] { background: var(--accent); color: var(--onaccent); }\n.chk, .sel { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n.chk input { width: 16px; height: 16px; accent-color: var(--accent); }\n@media (pointer: coarse) { .chk input { width: 22px; height: 22px; } }\n\n.cols { flex: 1; min-height: 0; display: flex; gap: 10px; padding: 8px 10px 10px; }\n.col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }\n.col.narrow { flex: 0 0 280px; }\n.colhead { font-weight: 600; font-size: 12px; margin-top: 2px; }\n.ta { flex: 1; min-height: 80px; resize: none; padding: 8px 10px; font: 13px/1.5 var(--mono); color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; overflow-wrap: anywhere; }\n.ta.out { background: var(--panel); }\n.acts { display: flex; align-items: center; gap: 8px; min-height: 30px; }\n.msg { font-size: 12px; color: var(--muted); }\n.msg.err { color: var(--err); }\n.msg.ok { color: var(--ok); }\n.msg.note { color: var(--warnfg); }\n.acts .msg { flex: 1 1 auto; min-width: 0; }\n\n.warnline { padding: 4px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.jwtout { flex: 1; min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 8px; }\n.chips { display: flex; flex-wrap: wrap; gap: 6px; }\n.chip { font-size: 12px; padding: 2px 10px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); }\n.chip.ok { background: var(--okbg); color: var(--ok); border-color: var(--ok); }\n.chip.bad { background: var(--errbg); color: var(--err); border-color: var(--err); font-weight: 600; }\n.times { border-collapse: collapse; font-size: 12.5px; }\n.times th { text-align: left; font-weight: 600; color: var(--muted); padding: 2px 10px 2px 0; }\n.times td { padding: 3px 10px 3px 0; border-top: 1px solid var(--line); white-space: nowrap; }\n.times tr.expired td { color: var(--err); }\n.jblock { border: 1px solid var(--line); border-radius: 6px; }\n.jhead { display: flex; align-items: center; padding: 4px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.jblock pre { margin: 0; padding: 8px 10px; font-size: 12.5px; white-space: pre-wrap; overflow-wrap: anywhere; }\n\n.filebox { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px; border: 1px dashed var(--edge); border-radius: 6px; background: var(--panel); }\n.hrows { display: flex; flex-direction: column; gap: 6px; }\n.hrow { display: grid; grid-template-columns: 92px 1fr auto; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; }\n.hrow.match { border-color: var(--ok); background: var(--okbg); }\n.hname { font-weight: 600; font-size: 12px; display: flex; flex-direction: column; }\n.hname .tag { font-weight: 400; font-size: 11px; color: var(--err); }\n.hval { font-size: 12px; overflow-wrap: anywhere; user-select: all; }\n#hash-expect { margin-bottom: 2px; }\n\n.foot { padding: 3px 10px; font-size: 11.5px; border-top: 1px solid var(--line); background: var(--panel); }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg textarea { width: 100%; font: 12px var(--mono); background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; padding: 6px; }\n.dacts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.toast { position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (max-width: 720px) { .cols { flex-direction: column; } .col.narrow { flex: none; } }\n@media (forced-colors: active) { .sbtn[aria-pressed=\"true\"], .tab.on { outline: 2px solid Highlight; } }\n"
  }
 }
}