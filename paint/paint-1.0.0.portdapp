{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "paint",
 "name": "Paint",
 "version": "1.0.0",
 "description": "A simple sketchpad: pencil, shapes, fill, eraser and colours, with undo, zoom, and PNG or JPG files.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 1000,
 "height": 680,
 "singleInstance": true,
 "fileTypes": [
  {
   "ext": ".png",
   "name": "PNG picture",
   "icon": "glyph:image"
  },
  {
   "ext": ".jpg",
   "name": "JPEG picture",
   "icon": "glyph:image"
  },
  {
   "ext": ".jpeg",
   "name": "JPEG picture",
   "icon": "glyph:image"
  },
  {
   "ext": ".gif",
   "name": "GIF picture",
   "icon": "glyph:image"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M32 6C17 6 5 17 5 31c0 10 7 14 13 14 4 0 6 2 6 6 0 5 4 7 9 7 15 0 26-12 26-27S47 6 32 6z\" fill=\"#f2e6d0\" stroke=\"#8a6a3a\" stroke-width=\"2.5\"/><circle cx=\"19\" cy=\"25\" r=\"5\" fill=\"#d64541\"/><circle cx=\"31\" cy=\"17\" r=\"5\" fill=\"#f2b33d\"/><circle cx=\"44\" cy=\"22\" r=\"5\" fill=\"#3fb37a\"/><circle cx=\"47\" cy=\"36\" r=\"5\" fill=\"#3474d6\"/><circle cx=\"35\" cy=\"45\" r=\"4.5\" fill=\"#fff\" stroke=\"#8a6a3a\" stroke-width=\"2\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"paint\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Paint</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Picture\">\n    <button id=\"newBtn\" class=\"btn\" title=\"New picture (Alt+N)\">New…</button>\n    <button id=\"openBtn\" class=\"btn\" title=\"Open a PNG, JPG or GIF (Ctrl+O)\">Open…</button>\n    <button id=\"saveBtn\" class=\"btn primary\" title=\"Save (Ctrl+S)\">Save</button>\n    <button id=\"saveAsBtn\" class=\"btn\" title=\"Save as PNG or JPG (Ctrl+Shift+S)\">Save as…</button>\n    <span class=\"sep\"></span>\n    <button id=\"undoBtn\" class=\"btn icon\" title=\"Undo (Ctrl+Z)\" aria-label=\"Undo\" disabled>↶</button>\n    <button id=\"redoBtn\" class=\"btn icon\" title=\"Redo (Ctrl+Y)\" aria-label=\"Redo\" disabled>↷</button>\n    <button id=\"clearBtn\" class=\"btn\" title=\"Clear the whole picture\">Clear…</button>\n    <span class=\"sep\"></span>\n    <button id=\"zoomOut\" class=\"btn icon\" title=\"Zoom out (−)\" aria-label=\"Zoom out\">−</button>\n    <select id=\"zoomSel\" class=\"field\" aria-label=\"Zoom\"></select>\n    <button id=\"zoomIn\" class=\"btn icon\" title=\"Zoom in (+)\" aria-label=\"Zoom in\">+</button>\n    <button id=\"fitBtn\" class=\"btn\" title=\"Fit the window (0)\">Fit</button>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Keys (F1)\" aria-label=\"Help\">?</button>\n  </div>\n  <div class=\"main\">\n    <div class=\"rail\">\n      <div id=\"tools\" class=\"tools\" role=\"radiogroup\" aria-label=\"Tools\"></div>\n      <label class=\"small lbl\" for=\"size\">Size <output id=\"sizeOut\">4</output></label>\n      <input id=\"size\" type=\"range\" min=\"1\" max=\"64\" value=\"4\" aria-label=\"Brush size\">\n      <label class=\"chk small\" title=\"Fill rectangles and ellipses instead of drawing their outline\"><input id=\"filled\" type=\"checkbox\"> Filled</label>\n    </div>\n    <div id=\"stage\" class=\"stage\">\n      <div id=\"wrap\" class=\"wrap\">\n        <canvas id=\"cv\" width=\"800\" height=\"600\"></canvas>\n        <canvas id=\"ov\" width=\"800\" height=\"600\" tabindex=\"0\" role=\"application\" aria-label=\"Drawing area. Arrow keys move a cursor, Shift plus arrows move it faster, Enter puts the pen down and lifts it, Escape cancels.\"></canvas>\n      </div>\n    </div>\n  </div>\n  <div class=\"foot\">\n    <div class=\"colors\">\n      <button id=\"c1\" class=\"cur c1\" title=\"Colour for the left button (click to choose)\" aria-label=\"Main colour\"></button>\n      <button id=\"c2\" class=\"cur c2\" title=\"Colour for the right button (click to choose)\" aria-label=\"Second colour\"></button>\n      <button id=\"swapBtn\" class=\"btn icon small\" title=\"Swap the two colours (X)\" aria-label=\"Swap colours\">⇄</button>\n      <input id=\"picker\" type=\"color\" class=\"hiddenpick\" tabindex=\"-1\" aria-hidden=\"true\">\n      <div id=\"palette\" class=\"palette\" role=\"group\" aria-label=\"Palette: Enter for the main colour, Shift+Enter for the second\"></div>\n    </div>\n    <span class=\"grow\"></span>\n    <span id=\"pos\" class=\"muted small\" aria-hidden=\"true\"></span>\n    <span id=\"dims\" class=\"muted small\"></span>\n    <span id=\"docName\" class=\"small\"></span>\n  </div>\n</div>\n<div id=\"say\" class=\"sr\" aria-live=\"polite\"></div>\n\n<div id=\"newDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"newTitle\">\n    <h2 id=\"newTitle\">New picture</h2>\n    <label class=\"lbl\">Size <select id=\"newPreset\" class=\"field\">\n      <option value=\"800x600\">800 × 600</option><option value=\"1024x768\">1024 × 768</option><option value=\"1280x720\">1280 × 720 (HD)</option>\n      <option value=\"1920x1080\">1920 × 1080 (Full HD)</option><option value=\"1080x1080\">1080 × 1080 (square)</option><option value=\"595x842\">595 × 842 (A4 at 72 dpi)</option><option value=\"custom\">Custom…</option>\n    </select></label>\n    <div class=\"row\"><label class=\"lbl\">Width <input id=\"newW\" class=\"field num\" type=\"number\" min=\"1\" max=\"8192\" value=\"800\"></label><label class=\"lbl\">Height <input id=\"newH\" class=\"field num\" type=\"number\" min=\"1\" max=\"8192\" value=\"600\"></label></div>\n    <div class=\"row\" role=\"radiogroup\" aria-label=\"Background\">\n      <label class=\"chk\"><input type=\"radio\" name=\"bg\" value=\"white\" checked> White background</label>\n      <label class=\"chk\"><input type=\"radio\" name=\"bg\" value=\"transparent\"> Transparent</label>\n    </div>\n    <p id=\"newWarn\" class=\"warn\" hidden></p>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button id=\"newOk\" class=\"btn primary\" data-act=\"ok\">Make it</button></div>\n  </div>\n</div>\n\n<div id=\"fmtDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"fmtTitle\">\n    <h2 id=\"fmtTitle\">Save as</h2>\n    <div class=\"choices\">\n      <button class=\"choice\" data-act=\"png\"><b>PNG</b><span>Exact, keeps transparency. Best for drawings and screenshots.</span></button>\n      <button class=\"choice\" data-act=\"jpg\"><b>JPG</b><span>Smaller for photos. No transparency: see-through parts become white.</span></button>\n    </div>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button></div>\n  </div>\n</div>\n\n<div id=\"confirmDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"confTitle\" aria-describedby=\"confMsg\">\n    <h2 id=\"confTitle\"></h2>\n    <p id=\"confMsg\"></p>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button id=\"confOk\" class=\"btn danger\" data-act=\"ok\">OK</button></div>\n  </div>\n</div>\n\n<div id=\"restoreDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"resTitle\" aria-describedby=\"resMsg\">\n    <h2 id=\"resTitle\">Unsaved picture</h2>\n    <p id=\"resMsg\"></p>\n    <img id=\"resImg\" class=\"thumb\" alt=\"The unsaved picture\">\n    <div class=\"dacts\"><button id=\"resDiscard\" class=\"btn danger\">Throw it away</button><button class=\"btn primary\" data-act=\"restore\">Restore it</button></div>\n  </div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Keys</h2>\n    <table class=\"keys\">\n      <tr><td>B, L, R, O, F, E, I, H</td><td>Pencil, Line, Rectangle, Ellipse, Fill, Eraser, Eyedropper, Hand</td></tr>\n      <tr><td>[ and ]</td><td>Smaller or bigger brush</td></tr>\n      <tr><td>X</td><td>Swap the two colours</td></tr>\n      <tr><td>Ctrl+Z, Ctrl+Y (or Ctrl+Shift+Z)</td><td>Undo, redo</td></tr>\n      <tr><td>+ and −, 0, 1</td><td>Zoom in and out, fit the window, 100%</td></tr>\n      <tr><td>Ctrl+O, Ctrl+S, Ctrl+Shift+S, Alt+N</td><td>Open, save, save as, new</td></tr>\n      <tr><td>Space + drag, middle button</td><td>Move around the picture (or use the Hand)</td></tr>\n      <tr><td>Shift while drawing</td><td>Straight lines at 45°, squares and circles</td></tr>\n      <tr><td>Right button</td><td>Draw with the second colour</td></tr>\n      <tr><th colspan=\"2\">Drawing from the keyboard (Tab to the picture first)</th></tr>\n      <tr><td>Arrow keys (Shift: 10 at a time)</td><td>Move the cursor</td></tr>\n      <tr><td>Enter</td><td>Put the pen down; Enter again lifts it (pencil, eraser) or finishes the line or shape. Fill and Eyedropper act at once.</td></tr>\n      <tr><td>Esc</td><td>Cancel a line or shape in progress</td></tr>\n    </table>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"close\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/paint.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Paint: the window. Tools, colours, drawing with pointer events (mouse, pen with pressure, touch) and from the\n   keyboard, zoom and pan, undo and redo, files, and the working copy kept in the data folder so unsaved work\n   survives the window being closed. */\n(function () {\n  'use strict';\n  const P = window.Paint, $ = id => document.getElementById(id);\n  const cv = $('cv'), ov = $('ov'), wrap = $('wrap'), stage = $('stage');\n  let ctx = cv.getContext('2d', { willReadFrequently: true }), octx = ov.getContext('2d');\n  const hist = new P.History(ctx, 50);\n  const ZOOMS = [0.1, 0.25, 0.33, 0.5, 0.67, 0.75, 1, 1.5, 2, 3, 4, 6, 8];\n  const TOOLS = [\n    ['pencil', 'b', 'Pencil', '<path d=\"M3 13l1-4 7-7 3 3-7 7z M9 4l3 3\"/>'],\n    ['line', 'l', 'Line', '<path d=\"M3 13L13 3\"/>'],\n    ['rect', 'r', 'Rectangle', '<rect x=\"2.5\" y=\"4\" width=\"11\" height=\"8\"/>'],\n    ['ellipse', 'o', 'Ellipse', '<ellipse cx=\"8\" cy=\"8\" rx=\"5.5\" ry=\"4\"/>'],\n    ['fill', 'f', 'Fill', '<path d=\"M3 8l5-5 5 5-5 5z M13 10c0 1.5 1 2 1 3a1 1 0 0 1-2 0c0-1 1-1.5 1-3z\"/>'],\n    ['eraser', 'e', 'Eraser', '<path d=\"M2 11l6-6 5 5-3 3H5z M5.5 7.5l5 5\"/>'],\n    ['picker', 'i', 'Eyedropper', '<path d=\"M10 2l4 4-2 2-4-4z M9 5l-6 6v2h2l6-6\"/>'],\n    ['hand', 'h', 'Hand (move around)', '<path d=\"M5 8V4a1 1 0 0 1 2 0v3V3a1 1 0 0 1 2 0v4V4a1 1 0 0 1 2 0v5c0 3-2 5-4 5S4 13 3 10l-1-2a1 1 0 0 1 2-1z\"/>']\n  ];\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\">';\n\n  let settings = { theme: 'auto', tool: 'pencil', size: 4, filled: false, c1: '#000000', c2: '#ffffff' };\n  let doc = { w: 800, h: 600, name: 'Untitled.png', path: null, fmt: 'png', bg: 'white', dirty: false, granted: false };\n  let zoom = 1, act = null, kc = { x: 0, y: 0, shown: false }, spaceDown = false, pan = null;\n\n  /* ---------- helpers ---------- */\n  function h(tag, attrs, ...kids) {\n    const e = document.createElement(tag);\n    for (const k in attrs || {}) { const v = attrs[k]; if (v == null || v === false) continue; if (k === 'class') e.className = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v === true ? '' : v); }\n    for (const k of kids.flat()) if (k != null) e.append(k);\n    return e;\n  }\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2400); }\n  const say = t => { $('say').textContent = ''; setTimeout(() => { $('say').textContent = t; }, 30); };\n  const saveSettings = () => Host.saveSettings(settings);\n  function dialog(id, first) {\n    const ov2 = $(id), back = document.activeElement;\n    ov2.hidden = false;\n    const focusables = () => [...ov2.querySelectorAll('button, input, select')].filter(e => !e.disabled && e.offsetParent && !(e.type === 'radio' && !e.checked));\n    const f = first ? ov2.querySelector(first) : focusables()[0]; if (f) f.focus();\n    return new Promise(resolve => {\n      const done = act => { ov2.hidden = true; ov2.removeEventListener('click', onClick); ov2.removeEventListener('keydown', onKey); if (back && back.focus && document.contains(back)) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b && ov2.contains(b)) done(b.dataset.act); else if (e.target === ov2 && id !== 'restoreDlg') done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done(id === 'restoreDlg' ? 'restore' : 'cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        e.stopPropagation();\n      };\n      ov2.addEventListener('click', onClick); ov2.addEventListener('keydown', onKey);\n      ov2.done = done;\n    });\n  }\n  async function confirmIt(title, msg, okLabel) {\n    $('confTitle').textContent = title; $('confMsg').textContent = msg; $('confOk').textContent = okLabel;\n    return (await dialog('confirmDlg', '[data-act=cancel]')) === 'ok';\n  }\n\n  /* ---------- the document ---------- */\n  function drawStatus() {\n    $('dims').textContent = doc.w + ' × ' + doc.h;\n    $('docName').textContent = (doc.dirty ? '● ' : '') + doc.name;\n    $('docName').title = doc.dirty ? 'Changed since it was last saved (a working copy is kept)' : '';\n    Host.setTitle((doc.dirty ? '• ' : '') + doc.name + ' - Paint');\n    $('undoBtn').disabled = !hist.undoList.length; $('redoBtn').disabled = !hist.redoList.length;\n  }\n  function changed() { doc.dirty = true; drawStatus(); scheduleWork(); }\n  function setSize(w, h) { cv.width = ov.width = w; cv.height = ov.height = h; doc.w = w; doc.h = h; ctx = cv.getContext('2d', { willReadFrequently: true }); octx = ov.getContext('2d'); hist.ctx = ctx; }\n  const fileFmt = name => /\\.jpe?g$/i.test(name) ? 'jpg' : /\\.png$/i.test(name) ? 'png' : /\\.gif$/i.test(name) ? 'gif' : 'png';\n\n  /* ---------- zoom and pan ---------- */\n  function setZoom(z, cx, cy) {\n    z = Math.max(0.05, Math.min(8, z));\n    const r = stage.getBoundingClientRect();\n    if (cx == null) { cx = r.left + stage.clientWidth / 2; cy = r.top + stage.clientHeight / 2; }\n    const ix = (stage.scrollLeft + cx - r.left - wrap.offsetLeft) / zoom, iy = (stage.scrollTop + cy - r.top - wrap.offsetTop) / zoom;\n    zoom = z;\n    const W = Math.round(doc.w * z) + 'px', H = Math.round(doc.h * z) + 'px';\n    for (const c of [cv, ov]) { c.style.width = W; c.style.height = H; }\n    wrap.style.width = W; wrap.style.height = H;\n    wrap.classList.toggle('pixels', z >= 2);\n    stage.scrollLeft = ix * z + wrap.offsetLeft - (cx - r.left); stage.scrollTop = iy * z + wrap.offsetTop - (cy - r.top);\n    const sel = $('zoomSel');\n    if (![...sel.options].some(o => +o.value === z)) { for (const o of [...sel.options]) if (o.dataset.fit) o.remove(); sel.prepend(h('option', { value: z, 'data-fit': '1' }, Math.round(z * 100) + '%')); }\n    sel.value = String(z);\n    drawCursor();\n  }\n  function fit() { const z = Math.min((stage.clientWidth - 24) / doc.w, (stage.clientHeight - 24) / doc.h, 8); setZoom(Math.max(0.05, Math.floor(z * 100) / 100)); }\n  function zoomStep(dir) { const i = ZOOMS.findIndex(z => z >= zoom - 1e-6); const next = dir > 0 ? ZOOMS.find(z => z > zoom + 1e-6) : [...ZOOMS].reverse().find(z => z < zoom - 1e-6); if (next) setZoom(next); else if (i < 0 && dir < 0) setZoom(ZOOMS[ZOOMS.length - 1]); }\n  for (const z of ZOOMS) $('zoomSel').append(h('option', { value: z }, Math.round(z * 100) + '%'));\n  $('zoomSel').onchange = () => setZoom(+$('zoomSel').value);\n  $('zoomIn').onclick = () => zoomStep(1); $('zoomOut').onclick = () => zoomStep(-1); $('fitBtn').onclick = fit;\n  stage.addEventListener('wheel', e => { if (!e.ctrlKey) return; e.preventDefault(); setZoom(zoom * (e.deltaY < 0 ? 1.25 : 0.8), e.clientX, e.clientY); }, { passive: false });\n\n  /* ---------- drawing ---------- */\n  const at = e => { const r = ov.getBoundingClientRect(); return [(e.clientX - r.left) / zoom, (e.clientY - r.top) / zoom]; };\n  function eraseStyle(g) { if (doc.bg === 'transparent') { g.globalCompositeOperation = 'destination-out'; g.strokeStyle = g.fillStyle = '#000'; } else { g.globalCompositeOperation = 'source-over'; g.strokeStyle = g.fillStyle = '#ffffff'; } }\n  /* a pencil or eraser segment: small sizes are stamped pixel by pixel (crisp), bigger ones are round strokes */\n  function segment(x0, y0, x1, y1, w) {\n    ctx.save();\n    if (act.tool === 'eraser') eraseStyle(ctx); else { ctx.strokeStyle = ctx.fillStyle = act.color; }\n    if (w <= 2) {\n      let ax = Math.floor(x0), ay = Math.floor(y0); const bx = Math.floor(x1), by = Math.floor(y1);\n      const dx = Math.abs(bx - ax), dy = -Math.abs(by - ay), sx = ax < bx ? 1 : -1, sy = ay < by ? 1 : -1; let err = dx + dy;\n      for (;;) { ctx.fillRect(ax - (w > 1 ? 1 : 0), ay - (w > 1 ? 1 : 0), w, w); if (ax === bx && ay === by) break; const e2 = 2 * err; if (e2 >= dy) { err += dy; ax += sx; } if (e2 <= dx) { err += dx; ay += sy; } }\n    } else {\n      ctx.lineWidth = w; ctx.lineCap = 'round'; ctx.lineJoin = 'round';\n      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1 + (x0 === x1 && y0 === y1 ? 0.01 : 0), y1); ctx.stroke();\n    }\n    ctx.restore();\n    const b = act.box, m = w / 2 + 2;\n    b[0] = Math.min(b[0], x0 - m, x1 - m); b[1] = Math.min(b[1], y0 - m, y1 - m); b[2] = Math.max(b[2], x0 + m, x1 + m); b[3] = Math.max(b[3], y0 + m, y1 + m);\n  }\n  function shape(g, a, x1, y1) {\n    let x0 = a.x0, y0 = a.y0;\n    if (a.shift) [x1, y1] = a.tool === 'line' ? P.snapLine(x0, y0, x1, y1) : P.snapSquare(x0, y0, x1, y1);\n    const w = settings.size, odd = w % 2 ? 0.5 : 0;\n    g.save(); g.strokeStyle = g.fillStyle = a.color; g.lineWidth = w; g.lineCap = 'round'; g.lineJoin = 'miter';\n    g.beginPath();\n    if (a.tool === 'line') { g.moveTo(Math.floor(x0) + odd, Math.floor(y0) + odd); g.lineTo(Math.floor(x1) + odd, Math.floor(y1) + odd); g.stroke(); }\n    else {\n      const l = Math.floor(Math.min(x0, x1)), t = Math.floor(Math.min(y0, y1)), W = Math.floor(Math.abs(x1 - x0)) + 1, H = Math.floor(Math.abs(y1 - y0)) + 1;\n      if (a.tool === 'rect') { if (settings.filled) g.fillRect(l, t, W, H); else g.strokeRect(l + w / 2, t + w / 2, Math.max(0, W - w), Math.max(0, H - w)); }\n      else { g.ellipse(l + W / 2, t + H / 2, Math.max(0.5, W / 2 - (settings.filled ? 0 : w / 2)), Math.max(0.5, H / 2 - (settings.filled ? 0 : w / 2)), 0, 0, Math.PI * 2); settings.filled ? g.fill() : g.stroke(); }\n    }\n    g.restore();\n    return P.clip(x0, y0, x1, y1, w + 2, doc.w, doc.h);\n  }\n  function begin(x, y, btn, pressure, shift) {\n    const tool = settings.tool, color = btn === 2 ? settings.c2 : settings.c1;\n    if (tool === 'fill') {\n      const img = ctx.getImageData(0, 0, doc.w, doc.h), r = P.fill(img, x, y, P.toRgba(color), 32);\n      if (r) { ctx.putImageData(img, 0, 0, r.x, r.y, r.w, r.h); if (hist.record(r)) { changed(); say('Filled'); } }\n      return;\n    }\n    if (tool === 'picker') {\n      const xi = Math.floor(x), yi = Math.floor(y); if (xi < 0 || yi < 0 || xi >= doc.w || yi >= doc.h) return;\n      const d = ctx.getImageData(xi, yi, 1, 1).data, hex = d[3] === 0 ? (doc.bg === 'transparent' ? '#ffffff' : '#ffffff') : P.toHex(d[0], d[1], d[2]);\n      setColor(btn === 2 ? 'c2' : 'c1', hex); toast('Picked ' + hex.toUpperCase()); say('Picked ' + hex);\n      setTool(settings.prevTool && settings.prevTool !== 'picker' ? settings.prevTool : 'pencil');\n      return;\n    }\n    act = { tool, color, x0: x, y0: y, lx: x, ly: y, box: [x, y, x, y], shift, pressure };\n    if (tool === 'pencil' || tool === 'eraser') segment(x, y, x, y, width(pressure));\n    else preview(x, y);\n  }\n  const width = p => p && p !== 0.5 ? Math.max(1, Math.round(settings.size * (0.25 + 0.75 * p))) : settings.size;\n  function preview(x, y) { octx.clearRect(0, 0, ov.width, ov.height); act.last = [x, y]; shape(octx, act, x, y); }\n  function move(x, y, pressure, shift) {\n    if (!act) return;\n    act.shift = shift;\n    if (act.tool === 'pencil' || act.tool === 'eraser') { segment(act.lx, act.ly, x, y, width(pressure)); act.lx = x; act.ly = y; }\n    else preview(x, y);\n  }\n  function end(x, y) {\n    if (!act) return;\n    const a = act; act = null;\n    let r;\n    if (a.tool === 'pencil' || a.tool === 'eraser') r = P.clip(a.box[0], a.box[1], a.box[2], a.box[3], 1, doc.w, doc.h);\n    else { octx.clearRect(0, 0, ov.width, ov.height); r = shape(ctx, a, x, y); }\n    if (hist.record(r)) changed();\n    drawCursor();\n  }\n  function cancel() {\n    if (!act) return;\n    const a = act; act = null;\n    if (a.tool === 'pencil' || a.tool === 'eraser') hist.revert(P.clip(a.box[0], a.box[1], a.box[2], a.box[3], 1, doc.w, doc.h));\n    octx.clearRect(0, 0, ov.width, ov.height); drawCursor();\n    say('Cancelled');\n  }\n\n  /* pointer: left and right buttons draw (right uses the second colour); middle, Space+drag and the Hand move around */\n  ov.addEventListener('contextmenu', e => e.preventDefault());\n  ov.addEventListener('pointerdown', e => {\n    ov.focus({ preventScroll: true }); kc.shown = false; drawCursor();\n    if (e.button === 1 || spaceDown || settings.tool === 'hand') { pan = { x: e.clientX, y: e.clientY, sl: stage.scrollLeft, st: stage.scrollTop, id: e.pointerId }; ov.setPointerCapture(e.pointerId); ov.classList.add('panning'); e.preventDefault(); return; }\n    if (e.button !== 0 && e.button !== 2) return;\n    if (act) { cancel(); return; }\n    ov.setPointerCapture(e.pointerId);\n    const [x, y] = at(e);\n    begin(x, y, e.button, e.pointerType === 'pen' ? e.pressure : 0, e.shiftKey);\n    if (act) act.pid = e.pointerId;\n    e.preventDefault();\n  });\n  ov.addEventListener('pointermove', e => {\n    const [x, y] = at(e);\n    $('pos').textContent = x >= 0 && y >= 0 && x < doc.w && y < doc.h ? Math.floor(x) + ', ' + Math.floor(y) : '';\n    if (pan && e.pointerId === pan.id) { stage.scrollLeft = pan.sl - (e.clientX - pan.x); stage.scrollTop = pan.st - (e.clientY - pan.y); return; }\n    if (!act || e.pointerId !== act.pid) return;\n    const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];\n    for (const c of (evs.length ? evs : [e])) { const [cx, cy] = at(c); move(cx, cy, c.pointerType === 'pen' ? c.pressure : 0, e.shiftKey); }\n  });\n  const up = e => {\n    if (pan && e.pointerId === pan.id) { pan = null; ov.classList.remove('panning'); return; }\n    if (act && e.pointerId === act.pid) { const [x, y] = at(e); act.shift = e.shiftKey; end(x, y); }\n  };\n  ov.addEventListener('pointerup', up);\n  ov.addEventListener('pointercancel', e => { if (pan && e.pointerId === pan.id) { pan = null; ov.classList.remove('panning'); } else if (act && e.pointerId === act.pid) cancel(); });\n  ov.addEventListener('pointerleave', () => { $('pos').textContent = ''; });\n\n  /* the keyboard: arrows move a cursor, Enter puts the pen down and lifts it */\n  const kcur = h('div', { class: 'kcursor', 'aria-hidden': 'true' }); wrap.append(kcur);\n  function drawCursor() {\n    kcur.hidden = !kc.shown;\n    if (!kc.shown) return;\n    kcur.style.left = (kc.x + 0.5) * zoom + 'px'; kcur.style.top = (kc.y + 0.5) * zoom + 'px';\n    $('pos').textContent = kc.x + ', ' + kc.y;\n  }\n  ov.addEventListener('keydown', e => {\n    const k = e.key, d = e.shiftKey ? 10 : 1;\n    const dir = { ArrowLeft: [-d, 0], ArrowRight: [d, 0], ArrowUp: [0, -d], ArrowDown: [0, d] }[k];\n    if (dir && !e.ctrlKey && !e.altKey) {\n      e.preventDefault();\n      if (!kc.shown) { kc.shown = true; if (!kc.placed) { kc.x = Math.floor(doc.w / 2); kc.y = Math.floor(doc.h / 2); kc.placed = true; } }\n      kc.x = Math.max(0, Math.min(doc.w - 1, kc.x + dir[0])); kc.y = Math.max(0, Math.min(doc.h - 1, kc.y + dir[1]));\n      move(kc.x, kc.y, 0, false); drawCursor();\n      const r = stage.getBoundingClientRect(), px = wrap.offsetLeft + (kc.x + 0.5) * zoom, py = wrap.offsetTop + (kc.y + 0.5) * zoom;\n      if (px < stage.scrollLeft + 20 || px > stage.scrollLeft + r.width - 20) stage.scrollLeft = px - r.width / 2;\n      if (py < stage.scrollTop + 20 || py > stage.scrollTop + r.height - 20) stage.scrollTop = py - r.height / 2;\n      return;\n    }\n    if (k === 'Enter') {\n      e.preventDefault();\n      if (!kc.shown) { kc.shown = true; if (!kc.placed) { kc.x = Math.floor(doc.w / 2); kc.y = Math.floor(doc.h / 2); kc.placed = true; } drawCursor(); return; }\n      if (act) { end(kc.x, kc.y); say((settings.tool === 'pencil' || settings.tool === 'eraser' ? 'Pen up' : 'Done') + ' at ' + kc.x + ', ' + kc.y); }\n      else { begin(kc.x, kc.y, e.shiftKey ? 2 : 0, 0, false); if (act) say('Pen down at ' + kc.x + ', ' + kc.y + '. Move with the arrows, Enter to finish.'); }\n      return;\n    }\n    if (k === 'Escape' && act) { e.preventDefault(); e.stopPropagation(); cancel(); }\n  });\n  ov.addEventListener('blur', () => { if (act && act.pid == null) end(kc.x, kc.y); kc.shown = false; drawCursor(); });\n\n  /* ---------- tools, size, colours ---------- */\n  function setTool(t) {\n    if (!TOOLS.some(x => x[0] === t)) t = 'pencil';\n    if (act) cancel();\n    if (t === 'picker' && settings.tool !== 'picker') settings.prevTool = settings.tool;\n    settings.tool = t; saveSettings();\n    for (const b of $('tools').children) { const on = b.dataset.t === t; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; }\n    ov.dataset.tool = t;\n    $('filled').closest('label').classList.toggle('dim', !(t === 'rect' || t === 'ellipse'));\n  }\n  for (const [id, key, label, path] of TOOLS) {\n    const b = h('button', { class: 'tool', role: 'radio', 'data-t': id, 'aria-label': label, title: label + ' (' + key.toUpperCase() + ')' });\n    b.innerHTML = SVG + path + '</svg>';\n    b.onclick = () => setTool(id);\n    $('tools').append(b);\n  }\n  $('tools').addEventListener('keydown', e => {\n    const all = [...$('tools').children], i = all.findIndex(b => b.dataset.t === settings.tool);\n    const to = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); const n = all[(to + all.length) % all.length]; setTool(n.dataset.t); n.focus();\n  });\n  function setSizeVal(v) { settings.size = Math.max(1, Math.min(64, v | 0)); $('size').value = settings.size; $('sizeOut').textContent = settings.size; saveSettings(); }\n  $('size').oninput = () => setSizeVal(+$('size').value);\n  $('filled').onchange = () => { settings.filled = $('filled').checked; saveSettings(); };\n  function setColor(slot, hex) { settings[slot] = hex; $(slot).style.background = hex; $(slot).setAttribute('aria-label', (slot === 'c1' ? 'Main colour ' : 'Second colour ') + hex.toUpperCase()); saveSettings(); }\n  let pickSlot = 'c1';\n  for (const slot of ['c1', 'c2']) $(slot).onclick = () => { pickSlot = slot; $('picker').value = settings[slot]; $('picker').click(); };\n  $('picker').oninput = () => setColor(pickSlot, $('picker').value);\n  $('swapBtn').onclick = swapColors;\n  function swapColors() { const a = settings.c1; setColor('c1', settings.c2); setColor('c2', a); say('Colours swapped'); }\n  P.PALETTE.forEach((hex, i) => {\n    const b = h('button', { class: 'sw', style: 'background:' + hex, title: P.PALETTE_NAMES[i] + ' (right-click for the second colour)', 'aria-label': P.PALETTE_NAMES[i], tabindex: i ? '-1' : '0' });\n    b.onclick = e => { setColor(e.shiftKey ? 'c2' : 'c1', hex); say(P.PALETTE_NAMES[i] + (e.shiftKey ? ' as the second colour' : ' as the main colour')); };\n    b.oncontextmenu = e => { e.preventDefault(); setColor('c2', hex); say(P.PALETTE_NAMES[i] + ' as the second colour'); };\n    $('palette').append(b);\n  });\n  $('palette').addEventListener('keydown', e => {\n    const all = [...$('palette').children], i = all.indexOf(document.activeElement);\n    const to = { ArrowRight: i + 1, ArrowLeft: i - 1, ArrowDown: i + 8, ArrowUp: i - 8, Home: 0, End: all.length - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); all[i].tabIndex = -1; const n = all[(to + all.length) % all.length]; n.tabIndex = 0; n.focus();\n  });\n\n  /* ---------- undo, redo, clear ---------- */\n  function undo() { if (act) cancel(); const s = hist.undo(); if (!s) return; if (s.full) syncSize(); changed(); say('Undone'); }\n  function redo() { const s = hist.redo(); if (!s) return; if (s.full) syncSize(); changed(); say('Redone'); }\n  function syncSize() { if (ov.width !== cv.width || ov.height !== cv.height) { ov.width = cv.width; ov.height = cv.height; doc.w = cv.width; doc.h = cv.height; setZoom(zoom); } }\n  $('undoBtn').onclick = undo; $('redoBtn').onclick = redo;\n  async function clearAll() {\n    if (!await confirmIt('Clear the picture', 'Clear the whole picture to ' + (doc.bg === 'transparent' ? 'transparent' : 'white') + '? You can bring it back with Undo.', 'Clear')) return;\n    ctx.save(); ctx.globalCompositeOperation = 'source-over';\n    if (doc.bg === 'transparent') ctx.clearRect(0, 0, doc.w, doc.h); else { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, doc.w, doc.h); }\n    ctx.restore(); hist.recordAll(); changed(); toast('Cleared. Ctrl+Z brings it back.');\n  }\n  $('clearBtn').onclick = clearAll;\n\n  /* ---------- the working copy: unsaved work kept in the data folder ---------- */\n  let workT = 0;\n  function scheduleWork() { clearTimeout(workT); workT = setTimeout(writeWork, 1500); }\n  async function writeWork() {\n    clearTimeout(workT); workT = 0;\n    if (!doc.dirty) return;\n    const url = cv.toDataURL('image/png'), meta = JSON.stringify({ v: 1, name: doc.name, fmt: doc.fmt, bg: doc.bg, w: doc.w, h: doc.h, time: Date.now() }, null, 1);\n    try {\n      if (Host.inPortD) await PortD.fs.write('work.png', url, 'dataurl'); else if (!await Host.saveData('work.png', url)) return;\n      await Host.saveData('work.json', meta);\n    } catch (e) { toast('Could not keep a working copy: ' + e.message, 5000); }\n  }\n  async function dropWork() { clearTimeout(workT); workT = 0; await Host.removeData('work.json'); await Host.removeData('work.png'); }\n  addEventListener('visibilitychange', () => { if (document.hidden && doc.dirty) writeWork(); });\n  addEventListener('pagehide', () => { if (doc.dirty) writeWork(); });\n\n  /* ---------- new, open, save ---------- */\n  async function loadUrl(name, url, path) {\n    const img = new Image();\n    try { img.src = url; await img.decode(); }\n    catch (e) { toast('\"' + name + '\" could not be opened: it is not a picture this browser can read.', 6000); return false; }\n    if (img.naturalWidth > P.MAX_SIDE || img.naturalHeight > P.MAX_SIDE) { toast('\"' + name + '\" is ' + img.naturalWidth + ' × ' + img.naturalHeight + '; Paint can open pictures up to ' + P.MAX_SIDE + ' on each side.', 6000); return false; }\n    if (act) cancel();\n    setSize(img.naturalWidth, img.naturalHeight);\n    ctx.clearRect(0, 0, doc.w, doc.h); ctx.drawImage(img, 0, 0);\n    const fmt = fileFmt(name);\n    let clear = false;\n    if (fmt !== 'jpg') { const d = ctx.getImageData(0, 0, doc.w, doc.h).data; for (let i = 3; i < d.length; i += 4) if (d[i] < 255) { clear = true; break; } }\n    doc = { w: doc.w, h: doc.h, name: fmt === 'gif' ? name.replace(/\\.gif$/i, '.png') : name, path: fmt === 'gif' ? null : path, fmt: fmt === 'gif' ? 'png' : fmt, bg: clear ? 'transparent' : 'white', dirty: false, granted: !!path && fmt !== 'gif' };\n    hist.reset(); kc.placed = false; octx.clearRect(0, 0, ov.width, ov.height);\n    fit(); drawStatus();\n    return true;\n  }\n  async function guard(what) {\n    if (!doc.dirty) return true;\n    return confirmIt(what, 'Your changes to \"' + doc.name + '\" have not been saved, and will be lost. Save first if you want to keep them.', what === 'Open a picture' ? 'Open without saving' : 'Continue without saving');\n  }\n  async function openPath(o) {\n    if (!await guard('Open a picture')) return;\n    try {\n      const d = await PortD.fs.read(o.path);\n      if (typeof d !== 'string' || !/^data:image\\//.test(d)) { toast('\"' + o.name + '\" is not stored as a picture, so it cannot be opened.', 6000); return; }\n      if (await loadUrl(o.name, d, o.path)) { await dropWork(); toast('Opened ' + o.name + (/\\.gif$/i.test(o.name) ? ' (the first frame; it will be saved as PNG)' : '')); }\n    } catch (e) { toast('Could not open \"' + o.name + '\": ' + e.message, 6000); }\n  }\n  async function openFile() {\n    if (Host.inPortD) {\n      if (!await guard('Open a picture')) return;\n      const was = doc.dirty; doc.dirty = false;\n      let r = null; try { r = await PortD.ui.openFile({ title: 'Open a picture', types: ['.png', '.jpg', '.jpeg', '.gif'] }); } finally { doc.dirty = was; }\n      if (r) { doc.dirty = false; await openPath(r); }\n      return;\n    }\n    if (!await guard('Open a picture')) return;\n    const i = h('input', { type: 'file', accept: '.png,.jpg,.jpeg,.gif,image/png,image/jpeg,image/gif' });\n    i.onchange = () => { const f = i.files[0]; if (!f) return; const rd = new FileReader(); rd.onload = async () => { if (await loadUrl(f.name, rd.result, null)) { await dropWork(); toast('Opened ' + f.name); } }; rd.readAsDataURL(f); };\n    i.click();\n  }\n  function flat() {\n    const c = document.createElement('canvas'); c.width = doc.w; c.height = doc.h;\n    const g = c.getContext('2d'); g.fillStyle = '#ffffff'; g.fillRect(0, 0, doc.w, doc.h); g.drawImage(cv, 0, 0);\n    return c.toDataURL('image/jpeg', 0.92);\n  }\n  async function writeTo(path, name, fmt) {\n    if (act) end(act.lx, act.ly);\n    const url = fmt === 'jpg' ? flat() : cv.toDataURL('image/png');\n    await PortD.fs.write(path, url, 'dataurl');\n    doc.path = path; doc.name = name; doc.fmt = fmt; doc.granted = true; doc.dirty = false;\n    await dropWork(); drawStatus();\n    toast('Saved ' + name);\n  }\n  async function save() {\n    if (Host.inPortD && doc.path && doc.granted) { try { await writeTo(doc.path, doc.name, doc.fmt); } catch (e) { toast('Could not save: ' + e.message, 6000); } return; }\n    return saveAs();\n  }\n  async function saveAs() {\n    const fmt = await dialog('fmtDlg', '[data-act=' + doc.fmt + ']');\n    if (fmt !== 'png' && fmt !== 'jpg') return;\n    const stem = doc.name.replace(/\\.[^.]+$/, '') || 'Untitled', name = stem + '.' + fmt;\n    try {\n      if (!Host.inPortD) {\n        const url = fmt === 'jpg' ? flat() : cv.toDataURL('image/png'), a = h('a', { href: url, download: name });\n        document.body.append(a); a.click(); a.remove(); doc.name = name; doc.fmt = fmt; doc.dirty = false; await dropWork(); drawStatus(); toast('Downloaded ' + name); return;\n      }\n      const r = await PortD.ui.saveFile({ title: 'Save picture', name, types: fmt === 'png' ? ['.png'] : ['.jpg', '.jpeg'] });\n      if (r) await writeTo(r.path, r.name, fmt);\n    } catch (e) { toast('Could not save: ' + e.message, 6000); }\n  }\n  $('openBtn').onclick = openFile; $('saveBtn').onclick = save; $('saveAsBtn').onclick = saveAs;\n\n  /* New picture */\n  $('newPreset').onchange = () => { const v = $('newPreset').value; if (v !== 'custom') { const [w, hh] = v.split('x'); $('newW').value = w; $('newH').value = hh; } else $('newW').focus(); };\n  for (const id of ['newW', 'newH']) $(id).oninput = () => { $('newPreset').value = [...$('newPreset').options].some(o => o.value === $('newW').value + 'x' + $('newH').value) ? $('newW').value + 'x' + $('newH').value : 'custom'; };\n  async function newPicture() {\n    $('newWarn').hidden = !doc.dirty;\n    $('newWarn').textContent = doc.dirty ? 'Your changes to \"' + doc.name + '\" have not been saved, and will be lost.' : '';\n    $('newOk').textContent = doc.dirty ? 'Make it without saving' : 'Make it';\n    if (await dialog('newDlg', '#newPreset') !== 'ok') return;\n    const w = Math.round(+$('newW').value), hh = Math.round(+$('newH').value);\n    if (!(w >= 1 && w <= P.MAX_SIDE && hh >= 1 && hh <= P.MAX_SIDE)) { toast('The width and height must be 1 to ' + P.MAX_SIDE + '.', 4000); return; }\n    const bg = document.querySelector('input[name=bg]:checked').value;\n    if (act) cancel();\n    setSize(w, hh);\n    if (bg === 'white') { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, w, hh); }\n    doc = { w, h: hh, name: 'Untitled.png', path: null, fmt: 'png', bg, dirty: false, granted: false };\n    hist.reset(); kc.placed = false; await dropWork(); fit(); drawStatus();\n    toast('New ' + w + ' × ' + hh + ' picture');\n  }\n  $('newBtn').onclick = newPicture;\n  $('helpBtn').onclick = () => dialog('helpDlg');\n\n  /* ---------- keys ---------- */\n  addEventListener('keyup', e => { if (e.key === ' ') { spaceDown = false; ov.classList.remove('grab'); } });\n  document.addEventListener('keydown', e => {\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    const t = e.target, typing = t.matches && t.matches('input:not([type=range]):not([type=checkbox]):not([type=radio]), select, textarea');\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    let go = null;\n    if (ctrl && !e.altKey) go = { z: e.shiftKey ? redo : undo, y: redo, o: e.shiftKey ? null : openFile, s: e.shiftKey ? saveAs : save }[k];\n    else if (e.altKey && !ctrl && k === 'n') go = newPicture;\n    else if (e.key === 'F1') go = () => $('helpBtn').click();\n    else if (!typing && !e.altKey) {\n      const tool = TOOLS.find(x => x[1] === k);\n      if (tool) go = () => { setTool(tool[0]); say(tool[2]); };\n      else go = { '[': () => setSizeVal(settings.size - (settings.size > 10 ? 2 : 1)), ']': () => setSizeVal(settings.size + (settings.size >= 10 ? 2 : 1)), x: swapColors, '+': () => zoomStep(1), '=': () => zoomStep(1), '-': () => zoomStep(-1), '0': fit, '1': () => setZoom(1) }[e.key === 'X' ? 'x' : e.key];\n      if (e.key === ' ' && t !== ov && !(t.matches && t.matches('button'))) { e.preventDefault(); spaceDown = true; ov.classList.add('grab'); return; }\n    }\n    if (go) { e.preventDefault(); go(); }\n  });\n\n  /* ---------- theme ---------- */\n  const TSVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [TSVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [TSVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [TSVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); saveSettings(); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    if (!/^#[0-9a-f]{6}$/i.test(settings.c1)) settings.c1 = '#000000';\n    if (!/^#[0-9a-f]{6}$/i.test(settings.c2)) settings.c2 = '#ffffff';\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    setTool(settings.tool); setSizeVal(settings.size); $('filled').checked = !!settings.filled; setColor('c1', settings.c1); setColor('c2', settings.c2);\n    setSize(800, 600); ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, 800, 600); hist.reset();\n    fit(); drawStatus();\n    window.__pt = { get doc() { return doc; }, get settings() { return settings; }, get zoom() { return zoom; }, hist, get kc() { return kc; }, writeWork, pixel: (x, y) => [...ctx.getImageData(x, y, 1, 1).data], ready: false };\n    /* unsaved work from last time? */\n    let meta = null, url = null;\n    try { meta = JSON.parse(await Host.loadData('work.json') || 'null'); } catch (e) { meta = null; }\n    if (meta) { try { url = Host.inPortD ? await PortD.fs.read('work.png') : await Host.loadData('work.png'); } catch (e) { url = null; } }\n    if (meta && typeof url === 'string' && /^data:image\\/png/.test(url)) {\n      $('resMsg').textContent = 'Paint kept a copy of a picture that was not saved: \"' + (meta.name || 'Untitled.png') + '\", ' + meta.w + ' × ' + meta.h + ', from ' + new Date(meta.time || Date.now()).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) + '.';\n      $('resImg').src = url;\n      let armed = 0;\n      $('resDiscard').textContent = 'Throw it away';\n      $('resDiscard').onclick = () => { if (!armed) { $('resDiscard').textContent = 'Click again to throw it away'; armed = setTimeout(() => { armed = 0; $('resDiscard').textContent = 'Throw it away'; }, 3000); return; } clearTimeout(armed); $('restoreDlg').done('discard'); };\n      const choice = await dialog('restoreDlg', '[data-act=restore]');\n      if (choice === 'restore' && await loadUrl(String(meta.name || 'Untitled.png'), url, null)) {\n        doc.fmt = meta.fmt === 'jpg' ? 'jpg' : 'png'; doc.bg = meta.bg === 'transparent' ? 'transparent' : doc.bg; doc.dirty = true; drawStatus();\n        toast('Restored. Save it to keep it.', 3500);\n      } else if (choice === 'discard') { await dropWork(); toast('The unsaved picture was thrown away.'); }\n    } else if (meta) await dropWork();\n    Host.onOpenFile(openPath);\n    const start = Host.startFile();\n    if (start) await openPath(start);\n    ov.focus({ preventScroll: true });\n    window.__pt.ready = true;\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/paint.js": {
   "enc": "text",
   "d": "/* Paint: the drawing engine. Flood fill, the undo history (only the changed area of each step is kept), colours\n   and shape helpers. No buttons here; app.js draws the window. Everything hangs off window.Paint. */\n(function () {\n  'use strict';\n  const P = window.Paint = {};\n  P.MAX_SIDE = 8192;\n  P.PALETTE = ['#000000', '#7f7f7f', '#c3c3c3', '#ffffff', '#880015', '#ed1c24', '#ff7f27', '#fff200',\n    '#22b14c', '#b5e61d', '#00a2e8', '#99d9ea', '#3f48cc', '#7092be', '#a349a4', '#ffaec9'];\n  P.PALETTE_NAMES = ['Black', 'Grey', 'Light grey', 'White', 'Dark red', 'Red', 'Orange', 'Yellow', 'Green', 'Lime', 'Blue', 'Light blue', 'Indigo', 'Steel blue', 'Purple', 'Pink'];\n\n  P.toRgba = function (hex, a) { const n = parseInt(hex.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255, a == null ? 255 : a]; };\n  P.toHex = (r, g, b) => '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');\n\n  /* a rectangle grown by m and clipped to the picture; null if empty */\n  P.clip = function (x0, y0, x1, y1, m, w, h) {\n    const x = Math.max(0, Math.floor(Math.min(x0, x1) - m)), y = Math.max(0, Math.floor(Math.min(y0, y1) - m));\n    const X = Math.min(w, Math.ceil(Math.max(x0, x1) + m)), Y = Math.min(h, Math.ceil(Math.max(y0, y1) + m));\n    return X > x && Y > y ? { x, y, w: X - x, h: Y - y } : null;\n  };\n  /* Shift: lines snap to 45°, boxes become squares */\n  P.snapLine = function (x0, y0, x, y) {\n    const dx = x - x0, dy = y - y0, a = Math.round(Math.atan2(dy, dx) / (Math.PI / 4)) * (Math.PI / 4), len = Math.hypot(dx, dy);\n    return [Math.round(x0 + Math.cos(a) * len), Math.round(y0 + Math.sin(a) * len)];\n  };\n  P.snapSquare = function (x0, y0, x, y) { const s = Math.max(Math.abs(x - x0), Math.abs(y - y0)); return [x0 + Math.sign(x - x0 || 1) * s, y0 + Math.sign(y - y0 || 1) * s]; };\n\n  /* fills the area of similar colour around (x, y). tolerance: 0 to 255. Returns the changed rectangle or null */\n  P.fill = function (img, x, y, rgba, tolerance) {\n    const { width: w, height: h, data: d } = img;\n    x = Math.floor(x); y = Math.floor(y);\n    if (x < 0 || y < 0 || x >= w || y >= h) return null;\n    const i0 = (y * w + x) * 4, t = [d[i0], d[i0 + 1], d[i0 + 2], d[i0 + 3]], tol = tolerance || 0;\n    if (Math.abs(t[0] - rgba[0]) + Math.abs(t[1] - rgba[1]) + Math.abs(t[2] - rgba[2]) + Math.abs(t[3] - rgba[3]) === 0) return null;\n    const near = i => Math.abs(d[i] - t[0]) <= tol && Math.abs(d[i + 1] - t[1]) <= tol && Math.abs(d[i + 2] - t[2]) <= tol && Math.abs(d[i + 3] - t[3]) <= tol;\n    const seen = new Uint8Array(w * h), stack = [x, y];\n    let minX = x, maxX = x, minY = y, maxY = y;\n    while (stack.length) {\n      const sy = stack.pop(); let sx = stack.pop();\n      let p = sy * w + sx;\n      while (sx >= 0 && !seen[p] && near(p * 4)) { sx--; p--; }\n      sx++; p++;\n      let up = false, down = false;\n      while (sx < w && !seen[p] && near(p * 4)) {\n        seen[p] = 1; const i = p * 4; d[i] = rgba[0]; d[i + 1] = rgba[1]; d[i + 2] = rgba[2]; d[i + 3] = rgba[3];\n        if (sx < minX) minX = sx; if (sx > maxX) maxX = sx; if (sy < minY) minY = sy; if (sy > maxY) maxY = sy;\n        if (sy > 0) { const q = p - w; if (!seen[q] && near(q * 4)) { if (!up) { stack.push(sx, sy - 1); up = true; } } else up = false; }\n        if (sy < h - 1) { const q = p + w; if (!seen[q] && near(q * 4)) { if (!down) { stack.push(sx, sy + 1); down = true; } } else down = false; }\n        sx++; p++;\n      }\n    }\n    return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };\n  };\n\n  /* ---------- undo history ----------\n     The history keeps a copy of the whole picture as it is now (\"base\"). Each step stores only the rectangle that\n     changed, as it was before and after. Steps that change the size (or everything) store the whole picture. */\n  P.History = function (ctx, max) {\n    this.ctx = ctx; this.max = max || 50; this.maxBytes = 400 * 1048576;\n    this.undoList = []; this.redoList = []; this.reset();\n  };\n  P.History.prototype.reset = function () {\n    const c = this.ctx.canvas;\n    this.base = this.ctx.getImageData(0, 0, c.width, c.height);\n    this.undoList = []; this.redoList = [];\n  };\n  function crop(img, r) {\n    const out = new ImageData(r.w, r.h), w = img.width;\n    for (let row = 0; row < r.h; row++) out.data.set(img.data.subarray(((r.y + row) * w + r.x) * 4, ((r.y + row) * w + r.x + r.w) * 4), row * r.w * 4);\n    return out;\n  }\n  function paste(img, part, x, y) {\n    const w = img.width;\n    for (let row = 0; row < part.height; row++) img.data.set(part.data.subarray(row * part.width * 4, (row + 1) * part.width * 4), ((y + row) * w + x) * 4);\n  }\n  const bytes = s => s.full ? s.before.data.length + s.after.data.length : s.before.data.length * 2;\n  P.History.prototype.push = function (step) {\n    this.undoList.push(step); this.redoList = [];\n    let total = this.undoList.reduce((n, s) => n + bytes(s), 0);\n    while (this.undoList.length > this.max || (total > this.maxBytes && this.undoList.length > 1)) total -= bytes(this.undoList.shift());\n  };\n  /* after drawing inside rectangle r: remember what was there before */\n  P.History.prototype.record = function (r) {\n    if (!r) return false;\n    const after = this.ctx.getImageData(r.x, r.y, r.w, r.h), before = crop(this.base, r);\n    const a = after.data, b = before.data; let same = true;\n    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) { same = false; break; }\n    if (same) return false;\n    this.push({ r, before, after });\n    paste(this.base, after, r.x, r.y);\n    return true;\n  };\n  /* after changing everything (clear, resize): the whole picture before and after */\n  P.History.prototype.recordAll = function () {\n    const c = this.ctx.canvas, after = this.ctx.getImageData(0, 0, c.width, c.height);\n    this.push({ full: true, before: this.base, after });\n    this.base = new ImageData(new Uint8ClampedArray(after.data), after.width, after.height);\n  };\n  P.History.prototype.apply = function (s, img) {\n    const c = this.ctx.canvas;\n    if (s.full) {\n      if (c.width !== img.width || c.height !== img.height) { c.width = img.width; c.height = img.height; }\n      this.ctx.putImageData(img, 0, 0);\n      this.base = new ImageData(new Uint8ClampedArray(img.data), img.width, img.height);\n    } else { this.ctx.putImageData(img, s.r.x, s.r.y); paste(this.base, img, s.r.x, s.r.y); }\n  };\n  P.History.prototype.undo = function () { const s = this.undoList.pop(); if (!s) return null; this.apply(s, s.before); this.redoList.push(s); return s; };\n  P.History.prototype.redo = function () { const s = this.redoList.pop(); if (!s) return null; this.apply(s, s.after); this.undoList.push(s); return s; };\n  /* puts back the picture as it was after the last step (for cancelling a stroke in progress) */\n  P.History.prototype.revert = function (r) { if (r) this.ctx.putImageData(crop(this.base, r), r.x, r.y); };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Paint */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495; --stage: #c9ced8;\n  --accent: #2f5fb3; --onaccent: #ffffff; --sel: #dbe5f7; --danger: #b42318; --dangerbg: #fde8e8; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698; --stage: #0f1218;\n  --accent: #86b0ff; --onaccent: #0b1a33; --sel: #2c3f63; --danger: #ff9b94; --dangerbg: #4a2a2e; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .grow { flex: 1; }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.bar, .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); }\n.bar { border-bottom: 1px solid var(--line); }\n.foot { border-top: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .45; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.danger { color: var(--danger); border-color: var(--danger); }\n.btn.danger:hover { background: var(--dangerbg); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; }\n.btn.small { min-height: 24px; }\n.field.num { width: 90px; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n\n.main { flex: 1; min-height: 0; display: flex; }\n.rail { width: 74px; flex: none; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 8px 4px; background: var(--panel); border-right: 1px solid var(--line); }\n.tools { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }\n.tool { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--text); cursor: pointer; padding: 0; }\n.tool:hover { background: var(--sel); }\n.tool[aria-checked=\"true\"] { background: var(--accent); color: var(--onaccent); }\n@media (pointer: coarse) { .rail { width: 96px; } .tool { width: 40px; height: 40px; } }\n.lbl { display: flex; flex-direction: column; gap: 3px; font-weight: 600; font-size: 12px; }\n.rail .lbl { flex-direction: row; gap: 4px; }\n#size { width: 64px; accent-color: var(--accent); }\n.chk { display: inline-flex; align-items: center; gap: 4px; }\n.chk input { accent-color: var(--accent); }\n.chk.dim { opacity: .5; }\n\n.stage { flex: 1; min-width: 0; overflow: auto; background: var(--stage); display: flex; padding: 12px; position: relative; }\n.wrap { position: relative; background: repeating-conic-gradient(#d6d6d6 0 25%, #fff 0 50%) 0 0 / 16px 16px; box-shadow: 0 2px 10px rgba(0,0,0,.25); flex: none; margin: auto; }\n.wrap canvas { position: absolute; left: 0; top: 0; display: block; }\n.wrap.pixels canvas { image-rendering: pixelated; }\n#ov { touch-action: none; cursor: crosshair; outline-offset: 3px; }\n#ov[data-tool=\"hand\"], #ov.grab { cursor: grab; }\n#ov.panning { cursor: grabbing; }\n#ov[data-tool=\"fill\"] { cursor: cell; }\n.kcursor { position: absolute; width: 0; height: 0; pointer-events: none; z-index: 2; }\n.kcursor::before, .kcursor::after { content: \"\"; position: absolute; background: #ff2d6f; box-shadow: 0 0 0 1px #fff; }\n.kcursor::before { left: -10px; top: -1px; width: 21px; height: 2px; }\n.kcursor::after { left: -1px; top: -10px; width: 2px; height: 21px; }\n\n.colors { display: flex; align-items: center; gap: 6px; }\n.cur { width: 28px; height: 28px; border-radius: 6px; border: 2px solid var(--edge); cursor: pointer; padding: 0; }\n.cur.c2 { width: 22px; height: 22px; margin-left: -12px; margin-top: 14px; }\n.hiddenpick { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n.palette { display: grid; grid-template-columns: repeat(8, 20px); gap: 3px; margin-left: 6px; }\n.sw { width: 20px; height: 20px; border-radius: 4px; border: 1px solid var(--edge); padding: 0; cursor: pointer; }\n@media (pointer: coarse) { .palette { grid-template-columns: repeat(8, 30px); } .sw { width: 30px; height: 30px; } .cur { width: 36px; height: 36px; } }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); display: flex; flex-direction: column; gap: 10px; }\n.dlg.wide { width: 620px; max-width: 100%; }\n.dlg h2 { margin: 0; font-size: 16px; }\n.dlg p { margin: 0; }\n.row { display: flex; flex-wrap: wrap; gap: 12px; }\n.warn { padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.choices { display: flex; flex-direction: column; gap: 8px; }\n.choice { font: inherit; color: var(--text); text-align: left; background: var(--panel); border: 1px solid var(--edge); border-radius: 8px; padding: 8px 12px; cursor: pointer; display: flex; flex-direction: column; gap: 2px; }\n.choice:hover { border-color: var(--accent); background: var(--sel); }\n.choice span { font-size: 12px; color: var(--muted); }\n.thumb { max-width: 100%; max-height: 220px; object-fit: contain; align-self: center; border: 1px solid var(--line); background: repeating-conic-gradient(#d6d6d6 0 25%, #fff 0 50%) 0 0 / 12px 12px; }\n.keys { border-collapse: collapse; font-size: 12.5px; }\n.keys td, .keys th { padding: 3px 10px 3px 0; vertical-align: top; text-align: left; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n.keys th { padding-top: 10px; }\n.dacts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }\n.toast { position: fixed; left: 50%; bottom: 52px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (forced-colors: active) { .tool[aria-checked=\"true\"] { outline: 2px solid Highlight; } .cur, .sw { forced-color-adjust: none; } }\n"
  }
 }
}