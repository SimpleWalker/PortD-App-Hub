{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "snippets",
 "name": "Snippets",
 "version": "1.0.0",
 "description": "A searchable library of text you reuse: scripts, queries, email replies. Copy with one click.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 900,
 "height": 560,
 "singleInstance": true,
 "fileTypes": [
  {
   "ext": ".json",
   "name": "Snippets library",
   "icon": "glyph:code"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"10\" y=\"6\" width=\"38\" height=\"48\" rx=\"5\" fill=\"#2563c9\"/><rect x=\"16\" y=\"12\" width=\"38\" height=\"48\" rx=\"5\" fill=\"#ffffff\" stroke=\"#2563c9\" stroke-width=\"3\"/><path d=\"M24 26l-5 5 5 5M38 26l5 5-5 5M33 23l-4 16\" fill=\"none\" stroke=\"#2563c9\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"22\" y=\"45\" width=\"26\" height=\"4\" rx=\"2\" fill=\"#9cb9ea\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"snippets\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Snippets</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Snippets\">\n    <button id=\"newBtn\" class=\"btn primary\" title=\"New snippet (Alt+N)\">New</button>\n    <span class=\"sep\"></span>\n    <button id=\"importBtn\" class=\"btn\" title=\"Add snippets from a library file\">Import…</button>\n    <button id=\"exportBtn\" class=\"btn\" title=\"Save the whole library as one file\">Export…</button>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Keyboard shortcuts (F1)\" aria-label=\"Help\">?</button>\n  </div>\n  <div class=\"main\">\n    <aside class=\"side\">\n      <div class=\"filters\">\n        <input id=\"search\" class=\"field\" type=\"search\" placeholder=\"Search\" title=\"Search titles, tags and text (Ctrl+F)\" aria-label=\"Search titles, tags and text\" autocomplete=\"off\">\n        <div class=\"row2\">\n          <select id=\"tagSel\" class=\"field\" aria-label=\"Show tag\"><option value=\"\">All tags</option></select>\n          <select id=\"sortSel\" class=\"field\" aria-label=\"Sort by\"><option value=\"title\">By title</option><option value=\"used\">Last used</option></select>\n        </div>\n      </div>\n      <div id=\"list\" class=\"list\" role=\"listbox\" aria-label=\"Snippets\" tabindex=\"0\"></div>\n      <div id=\"count\" class=\"count muted\" aria-live=\"polite\"></div>\n    </aside>\n    <section id=\"detail\" class=\"detail\" aria-label=\"Snippet\">\n      <div id=\"view\" class=\"view\" hidden>\n        <div class=\"vhead\">\n          <h1 id=\"vTitle\"></h1>\n          <div id=\"vMeta\" class=\"meta\"></div>\n        </div>\n        <div class=\"acts\" role=\"toolbar\" aria-label=\"This snippet\">\n          <button id=\"copyBtn\" class=\"btn primary\" title=\"Copy the text (Enter in the list, or Ctrl+Enter)\">Copy</button>\n          <button id=\"editBtn\" class=\"btn\" title=\"Edit (F2)\">Edit</button>\n          <button id=\"dupBtn\" class=\"btn\" title=\"Make a copy (Ctrl+D)\">Duplicate</button>\n          <button id=\"pinBtn\" class=\"btn\" aria-pressed=\"false\" title=\"Keep at the top of the list (P in the list)\">Pin</button>\n          <button id=\"delBtn\" class=\"btn danger\" title=\"Delete (Delete in the list, twice)\">Delete</button>\n        </div>\n        <pre id=\"vBody\" class=\"body\" tabindex=\"0\" aria-label=\"Text\"></pre>\n      </div>\n      <div id=\"edit\" class=\"edit\" hidden>\n        <label>Title <input id=\"eTitle\" class=\"field\" maxlength=\"200\" autocomplete=\"off\"></label>\n        <div class=\"row2\">\n          <label>Tags <input id=\"eTags\" class=\"field\" placeholder=\"for example: powershell, files\" autocomplete=\"off\" title=\"Separate tags with commas\"></label>\n          <label>Language <input id=\"eLang\" class=\"field\" placeholder=\"for example: PowerShell\" maxlength=\"40\" autocomplete=\"off\" list=\"langs\"></label>\n        </div>\n        <datalist id=\"langs\"></datalist>\n        <label class=\"grow\">Text <textarea id=\"eBody\" class=\"field body\" spellcheck=\"false\" wrap=\"off\"></textarea></label>\n        <div class=\"acts\"><span class=\"muted small\" id=\"eState\">Changes are saved as you type.</span><span class=\"grow\"></span><button id=\"doneBtn\" class=\"btn primary\" title=\"Finish editing (Esc)\">Done</button></div>\n      </div>\n      <div id=\"empty\" class=\"empty\">\n        <div>\n          <img src=\"icon.svg\" alt=\"\" width=\"64\" height=\"64\">\n          <h2 id=\"emptyTitle\">No snippet chosen</h2>\n          <p id=\"emptyMsg\">Pick one from the list, or press New.</p>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>\n\n<div id=\"importDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"impTitle\">\n    <h2 id=\"impTitle\">Import snippets</h2>\n    <p id=\"impMsg\"></p>\n    <div id=\"impWarn\" class=\"warn\" hidden></div>\n    <div class=\"dacts\">\n      <button class=\"btn\" data-act=\"cancel\">Cancel</button>\n      <button id=\"impReplace\" class=\"btn danger\" data-act=\"replace\">Replace my library</button>\n      <button class=\"btn primary\" data-act=\"add\">Add to my library</button>\n    </div>\n  </div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Keyboard shortcuts</h2>\n    <table class=\"keys\">\n      <tr><td>Ctrl+F</td><td>Search (Esc clears it)</td></tr>\n      <tr><td>Up / Down, Home / End</td><td>Move through the list</td></tr>\n      <tr><td>Enter (in the list), Ctrl+Enter</td><td>Copy the snippet's text</td></tr>\n      <tr><td>Alt+N</td><td>New snippet</td></tr>\n      <tr><td>F2</td><td>Edit; Esc or Done when finished</td></tr>\n      <tr><td>Ctrl+D</td><td>Duplicate</td></tr>\n      <tr><td>P (in the list)</td><td>Pin or unpin</td></tr>\n      <tr><td>Delete (in the list)</td><td>Delete: press it twice</td></tr>\n      <tr><td>F1</td><td>This list</td></tr>\n    </table>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/store.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Snippets: the window. The list with search, tag filter and sort; the chosen snippet with Copy, Edit, Duplicate,\n   Pin and Delete; editing that saves as you type; Import and Export of the whole library. */\n(function () {\n  'use strict';\n  const S = window.Snippets, $ = id => document.getElementById(id);\n  const listEl = $('list');\n  const plural = (n, w, ws) => n.toLocaleString('en-GB') + ' ' + (n === 1 ? w : ws || w + 's');\n\n  let settings = { theme: 'auto', sort: 'title', tag: '' };\n  let lib = [];               // every snippet\n  let shown = [];             // the ones in the list, in order\n  let sel = null;             // id of the chosen snippet\n  let editing = false;\n\n  /* ---------- helpers ---------- */\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2200); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  const byId = id => lib.find(s => s.id === id) || null;\n  const short = t => '\"' + (t.length > 40 ? t.slice(0, 40) + '…' : t) + '\"';\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea, select')].filter(e => !e.disabled && e.offsetParent);\n    (first ? ov.querySelector(first) : focusables()[0]).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus && document.contains(back)) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); else if (e.target === ov) done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n      dialog.done = done;\n    });\n  }\n  /* a button that must be pressed twice within 3 seconds; returns true on the second press */\n  const armed = new Map();\n  function second(key, btn, label, idle) {\n    if (armed.get(key)) { clearTimeout(armed.get(key)); armed.delete(key); if (btn) btn.textContent = idle; return true; }\n    if (btn) btn.textContent = label;\n    armed.set(key, setTimeout(() => { armed.delete(key); if (btn) btn.textContent = idle; }, 3000));\n    return false;\n  }\n  function disarm(key, btn, idle) { if (armed.has(key)) { clearTimeout(armed.get(key)); armed.delete(key); if (btn) btn.textContent = idle; } }\n\n  /* ---------- saving: the library is written soon after every change ---------- */\n  let saveT = 0, savePending = false;\n  function saveSoon(now) { savePending = true; clearTimeout(saveT); saveT = setTimeout(saveNow, now ? 0 : 400); }\n  async function saveNow() {\n    clearTimeout(saveT); if (!savePending) return;\n    savePending = false;\n    if (!await Host.saveData('library.json', S.toJSON(lib))) toast('Could not save the library.', 4000);\n  }\n  addEventListener('pagehide', () => { if (savePending) saveNow(); });\n  addEventListener('visibilitychange', () => { if (document.hidden && savePending) saveNow(); });\n\n  /* ---------- the list ---------- */\n  function marked(text, words) {\n    const span = h('span');\n    if (!words.length) { span.textContent = text; return span; }\n    const low = text.toLowerCase(), marks = [];\n    for (const w of words) { let i = 0, j; while ((j = low.indexOf(w, i)) >= 0) { marks.push([j, j + w.length]); i = j + w.length; } }\n    marks.sort((a, b) => a[0] - b[0]);\n    let at = 0;\n    for (const [a, b] of marks) { if (a < at) continue; span.append(text.slice(at, a), h('mark', null, text.slice(a, b))); at = b; }\n    span.append(text.slice(at));\n    return span;\n  }\n  function when(t) {\n    if (!t) return 'never used';\n    const d = Date.now() - t, m = 60000, hr = 60 * m, day = 24 * hr;\n    if (d < m) return 'used just now';\n    if (d < hr) return 'used ' + plural(Math.floor(d / m), 'minute') + ' ago';\n    if (d < day) return 'used ' + plural(Math.floor(d / hr), 'hour') + ' ago';\n    if (d < 30 * day) return 'used ' + plural(Math.floor(d / day), 'day') + ' ago';\n    return 'used ' + new Date(t).toLocaleDateString('en-GB', { dateStyle: 'medium' });\n  }\n  function renderList(keepScroll) {\n    const q = $('search').value.trim(), words = S.words(q);\n    shown = S.view(lib, { q, tag: settings.tag, sort: settings.sort });\n    const top = listEl.scrollTop, frag = document.createDocumentFragment();\n    for (const s of shown) {\n      const it = h('div', 'item' + (s.id === sel ? ' on' : '')); it.id = 'opt-' + s.id; it.dataset.id = s.id;\n      it.setAttribute('role', 'option'); it.setAttribute('aria-selected', String(s.id === sel));\n      const t = h('div', 't'); if (s.pinned) t.append(h('span', 'pin', '★ ')); t.append(marked(s.title, words)); it.append(t);\n      const sub = h('div', 'sub muted');\n      const bits = [s.lang, s.tags.map(x => '#' + x).join(' ')].filter(Boolean);\n      sub.textContent = bits.join(' · ') || ' ';\n      it.append(sub);\n      const hit = S.hitLine(s, words);\n      if (hit) { const m = marked(hit, words); m.className = 'hit'; it.append(m); }\n      if (s.pinned) it.setAttribute('aria-label', s.title + ', pinned');\n      frag.append(it);\n    }\n    listEl.textContent = ''; listEl.append(frag);\n    if (keepScroll) listEl.scrollTop = top;\n    listEl.setAttribute('aria-activedescendant', sel && shown.some(s => s.id === sel) ? 'opt-' + sel : '');\n    $('count').textContent = shown.length === lib.length ? plural(lib.length, 'snippet') : shown.length + ' of ' + plural(lib.length, 'snippet');\n  }\n  function renderTags() {\n    const sel0 = settings.tag, tags = S.tagCounts(lib), box = $('tagSel');\n    box.textContent = '';\n    box.append(new Option('All tags', ''));\n    for (const t of tags) box.append(new Option('#' + t.name + ' (' + t.n + ')', t.name));\n    if (sel0 && !tags.some(t => t.name.toLowerCase() === sel0.toLowerCase())) settings.tag = '';\n    const cur = tags.find(t => t.name.toLowerCase() === settings.tag.toLowerCase());\n    box.value = cur ? cur.name : '';\n    const langs = $('langs'); langs.textContent = '';\n    for (const l of [...new Set(lib.map(s => s.lang).filter(Boolean))].sort()) langs.append(new Option(l));\n  }\n  function scrollToSel() { const el = sel && document.getElementById('opt-' + sel); if (el) el.scrollIntoView({ block: 'nearest' }); }\n\n  /* ---------- the chosen snippet ---------- */\n  function renderDetail() {\n    const s = byId(sel);\n    $('view').hidden = !s || editing; $('edit').hidden = !s || !editing; $('empty').hidden = !!s;\n    if (!s) {\n      $('emptyTitle').textContent = lib.length ? 'No snippet chosen' : 'Your library is empty';\n      $('emptyMsg').textContent = lib.length ? (shown.length ? 'Pick one from the list, or press New.' : 'Nothing matches. Clear the search or the tag to see everything.') : 'Press New to add your first snippet, or Import to bring in a library.';\n      return;\n    }\n    if (editing) return;\n    $('vTitle').textContent = s.title;\n    const meta = $('vMeta'); meta.textContent = '';\n    if (s.lang) meta.append(h('span', 'lang', s.lang));\n    for (const t of s.tags) { const b = h('button', 'tag', '#' + t); b.title = 'Show only #' + t; b.onclick = () => setTag(t); meta.append(b); }\n    meta.append(h('span', 'muted', when(s.used) + ' · ' + plural(s.body.split('\\n').length, 'line')));\n    $('vBody').textContent = s.body;\n    $('pinBtn').setAttribute('aria-pressed', String(s.pinned)); $('pinBtn').textContent = s.pinned ? 'Unpin' : 'Pin';\n    disarm('del', $('delBtn'), 'Delete');\n  }\n  function select(id, focusList) {\n    if (editing && id !== sel) stopEdit();\n    sel = id;\n    for (const el of listEl.querySelectorAll('.item.on')) { el.classList.remove('on'); el.setAttribute('aria-selected', 'false'); }\n    const el = id && document.getElementById('opt-' + id);\n    if (el) { el.classList.add('on'); el.setAttribute('aria-selected', 'true'); listEl.setAttribute('aria-activedescendant', el.id); el.scrollIntoView({ block: 'nearest' }); }\n    renderDetail();\n    if (focusList) listEl.focus({ preventScroll: true });\n  }\n  function refresh() { renderTags(); renderList(true); renderDetail(); scrollToSel(); }\n\n  /* ---------- actions ---------- */\n  async function copy(s) {\n    s = s || byId(sel); if (!s) return;\n    s.used = Date.now(); saveSoon();\n    if (await Host.copy(s.body)) toast('Copied ' + short(s.title));\n    else { $('copyText').value = s.body; const p = dialog('copyDlg', '#copyText'); $('copyText').select(); await p; }\n    renderList(true); renderDetail();\n  }\n  function clearFilters() { $('search').value = ''; setTag('', true); }\n  function add(s) { lib.push(s); saveSoon(true); }\n  function newSnippet() {\n    const s = S.clean({ title: 'New snippet' });\n    clearFilters(); add(s); sel = s.id; refresh(); startEdit(true);\n  }\n  function duplicate() {\n    const s = byId(sel); if (!s) return;\n    const c = S.clean(Object.assign({}, s, { id: S.newId(), title: s.title + ' (copy)', pinned: false, used: 0, created: Date.now(), updated: Date.now() }));\n    add(c); sel = c.id; refresh();\n    toast('Made a copy: ' + short(c.title));\n  }\n  function togglePin() {\n    const s = byId(sel); if (!s) return;\n    s.pinned = !s.pinned; s.updated = Date.now(); saveSoon(true); refresh();\n    toast(s.pinned ? 'Pinned to the top' : 'Unpinned');\n  }\n  function del(fromKey) {\n    const s = byId(sel); if (!s) return;\n    if (!second('del', $('delBtn'), 'Click again to delete', 'Delete')) { if (fromKey) toast('Press Delete again to delete ' + short(s.title), 3000); return; }\n    const i = shown.findIndex(x => x.id === s.id);\n    lib = lib.filter(x => x !== s); saveSoon(true);\n    const next = shown[i + 1] || shown[i - 1];\n    sel = next && next.id !== s.id ? next.id : null;\n    editing = false; refresh(); listEl.focus({ preventScroll: true });\n    toast('Deleted ' + short(s.title));\n  }\n  function setTag(t, quiet) { settings.tag = t || ''; $('tagSel').value = t || ''; Host.saveSettings(settings); if (!quiet) filtered(); }\n\n  /* ---------- editing: every change is saved as you type ---------- */\n  function startEdit(isNew) {\n    const s = byId(sel); if (!s) return;\n    editing = true; renderDetail();\n    $('eTitle').value = s.title; $('eTags').value = s.tags.join(', '); $('eLang').value = s.lang; $('eBody').value = s.body;\n    $('eState').textContent = 'Changes are saved as you type.';\n    $('eTitle').focus(); if (isNew) $('eTitle').select();\n  }\n  function stopEdit() {\n    if (!editing) return;\n    const s = byId(sel);\n    if (s) { s.title = $('eTitle').value.trim() || 'Untitled'; s.tags = S.cleanTags($('eTags').value); }\n    editing = false; saveSoon(true); refresh();\n  }\n  function edited() {\n    const s = byId(sel); if (!s) return;\n    s.title = $('eTitle').value.trim().slice(0, 200) || 'Untitled';\n    s.tags = S.cleanTags($('eTags').value);\n    s.lang = $('eLang').value.trim().slice(0, 40);\n    s.body = $('eBody').value;\n    s.updated = Date.now();\n    saveSoon(); renderList(true);\n    $('eState').textContent = 'Saved.';\n  }\n  for (const id of ['eTitle', 'eTags', 'eLang', 'eBody']) $(id).addEventListener('input', edited);\n  $('eTags').addEventListener('change', () => renderTags());\n  $('edit').addEventListener('keydown', e => {\n    if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); stopEdit(); $('editBtn').focus(); }\n    else if (e.key === 'Tab') {\n      if (e.target.id === 'eBody' && !e.shiftKey && !e.ctrlKey && !tabOut) { e.preventDefault(); $('eBody').setRangeText('\\t', $('eBody').selectionStart, $('eBody').selectionEnd, 'end'); edited(); }\n      tabOut = false;\n    }\n  });\n  /* Tab types a tab in the text; Ctrl+M first lets the next Tab move on (as in Windows text boxes) */\n  let tabOut = false;\n  $('eBody').addEventListener('keydown', e => { if (e.ctrlKey && e.key.toLowerCase() === 'm') { e.preventDefault(); tabOut = true; toast('Next Tab moves on'); } }, true);\n  $('doneBtn').onclick = () => { stopEdit(); $('editBtn').focus(); };\n\n  /* ---------- import and export ---------- */\n  async function offerImport(name, text) {\n    let got;\n    try { got = S.readExport(text); }\n    catch (e) { toast(name + ': ' + e.message, 6000); return; }\n    const n = got.snippets.length;\n    $('impMsg').textContent = name + ' holds ' + plural(n, 'snippet') + '. Your library has ' + plural(lib.length, 'snippet') + '.';\n    $('impWarn').hidden = true;\n    const rep = $('impReplace'); rep.textContent = 'Replace my library'; rep.disabled = !n;\n    let armedRep = false;\n    rep.onclick = e => {\n      if (!armedRep && lib.length) { e.stopPropagation(); armedRep = true; rep.textContent = 'Click again to replace'; $('impWarn').hidden = false; $('impWarn').textContent = 'Replacing deletes the ' + plural(lib.length, 'snippet') + ' in your library now. Export it first if you may want them back.'; setTimeout(() => { armedRep = false; rep.textContent = 'Replace my library'; }, 3000); }\n    };\n    const act = await dialog('importDlg', '.dlg [data-act=add]');\n    if (act === 'add') {\n      const added = S.merge(lib, got.snippets); saveSoon(true); refresh();\n      toast('Added ' + plural(added, 'snippet') + (n - added ? ' (' + (n - added) + ' already there)' : ''), 3500);\n    } else if (act === 'replace') {\n      lib = got.snippets; sel = null; editing = false; clearFilters(); saveSoon(true); refresh();\n      toast('Your library now has the ' + plural(n, 'snippet') + ' from ' + name, 3500);\n    }\n  }\n  async function importFile() {\n    try { const f = await Host.openFile({ title: 'Import snippets', types: ['.json'] }); if (f) await offerImport(f.name, f.text); }\n    catch (e) { toast(e.message, 4000); }\n  }\n  async function exportFile() {\n    if (editing) stopEdit();\n    try {\n      const f = await Host.saveFile({ title: 'Export snippets', name: 'snippets.json', types: ['.json'], text: S.exportText(lib), mime: 'application/json' });\n      if (f) toast('Exported ' + plural(lib.length, 'snippet') + ' to ' + f.name, 3000);\n    } catch (e) { toast('Could not export: ' + e.message, 5000); }\n  }\n  async function openGiven(o) {\n    try { const f = await Host.readPath(o.path, o.name); await offerImport(f.name, f.text); }\n    catch (e) { toast('Could not open \"' + o.name + '\": ' + e.message, 5000); }\n  }\n\n  /* ---------- wiring ---------- */\n  listEl.addEventListener('click', e => { const it = e.target.closest('.item'); if (it) select(it.dataset.id, true); });\n  listEl.addEventListener('dblclick', e => { const it = e.target.closest('.item'); if (it) copy(byId(it.dataset.id)); });\n  listEl.addEventListener('keydown', e => {\n    if (!shown.length) return;\n    const i = shown.findIndex(s => s.id === sel), page = Math.max(1, Math.floor(listEl.clientHeight / 52) - 1);\n    const to = { ArrowDown: i + 1, ArrowUp: i < 0 ? 0 : i - 1, Home: 0, End: shown.length - 1, PageDown: i + page, PageUp: i - page }[e.key];\n    if (to !== undefined) { e.preventDefault(); select(shown[Math.max(0, Math.min(shown.length - 1, to))].id, true); return; }\n    if (e.ctrlKey || e.altKey || e.metaKey) return;\n    if (e.key === 'Enter' && sel) { e.preventDefault(); copy(); }\n    else if (e.key === 'Delete' && sel) { e.preventDefault(); del(true); }\n    else if (e.key.toLowerCase() === 'p' && sel) { e.preventDefault(); togglePin(); }\n  });\n  listEl.addEventListener('focus', () => { if (!sel && shown.length) select(shown[0].id); });\n  let st = 0;\n  /* a search that hides the chosen snippet chooses its first result instead */\n  function filtered() { renderList(); if (!shown.some(s => s.id === sel)) select(shown.length ? shown[0].id : null); else renderDetail(); }\n  $('search').addEventListener('input', () => { clearTimeout(st); st = setTimeout(filtered, 120); });\n  $('search').addEventListener('keydown', e => {\n    if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); if ($('search').value) { $('search').value = ''; filtered(); } else listEl.focus(); }\n    else if (e.key === 'ArrowDown' || e.key === 'Enter') { e.preventDefault(); clearTimeout(st); renderList(); if (shown.length) select((shown.find(s => s.id === sel) || shown[0]).id, true); }\n  });\n  $('tagSel').addEventListener('change', () => setTag($('tagSel').value));\n  $('sortSel').addEventListener('change', () => { settings.sort = $('sortSel').value; Host.saveSettings(settings); renderList(); scrollToSel(); });\n  $('newBtn').onclick = newSnippet;\n  $('copyBtn').onclick = () => copy();\n  $('editBtn').onclick = () => startEdit();\n  $('dupBtn').onclick = duplicate;\n  $('pinBtn').onclick = togglePin;\n  $('delBtn').onclick = () => del(false);\n  $('importBtn').onclick = importFile;\n  $('exportBtn').onclick = exportFile;\n  $('helpBtn').onclick = () => dialog('helpDlg');\n\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n\n  document.addEventListener('keydown', e => {\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    let run = null;\n    if (ctrl && !e.shiftKey && !e.altKey) run = { f: () => { if (editing) stopEdit(); $('search').focus(); $('search').select(); }, d: () => { if (editing) stopEdit(); duplicate(); }, enter: () => { if (editing) stopEdit(); copy(); } }[k];\n    else if (e.altKey && !ctrl && k === 'n') run = newSnippet;\n    else if (e.key === 'F2' && sel && !editing) run = () => startEdit();\n    else if (e.key === 'F1') run = () => dialog('helpDlg');\n    if (!run) return;\n    e.preventDefault(); run();\n  });\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    if (settings.sort !== 'used') settings.sort = 'title';\n    if (typeof settings.tag !== 'string') settings.tag = '';\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    $('sortSel').value = settings.sort;\n    const saved = await Host.loadData('library.json');\n    if (saved === null) { lib = S.seeds(); saveSoon(true); }\n    else {\n      try { lib = S.cleanLibrary(JSON.parse(saved)); }\n      catch (e) {\n        lib = [];\n        await Host.saveData('library-unreadable-' + Date.now() + '.json', saved);   /* keep what was there; never overwrite it silently */\n        toast('The library file could not be read. It was kept as library-unreadable-….json and a new one started.', 7000);\n      }\n    }\n    Host.setTitle('Snippets');\n    refresh();\n    if (shown.length) select(shown[0].id);\n    listEl.focus({ preventScroll: true });\n    Host.onOpenFile(openGiven);\n    const start = Host.startFile();\n    if (start) openGiven(start);\n    window.__sn = { get lib() { return lib; }, get sel() { return sel; }, get shown() { return shown; }, get editing() { return editing; }, saveNow, ready: true };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/store.js": {
   "enc": "text",
   "d": "/* Snippets: the library. Cleaning up what is loaded, searching, sorting, and the export file.\n   No drawing here; app.js draws. Everything hangs off window.Snippets. */\n(function () {\n  'use strict';\n  const S = window.Snippets = {};\n  const LIMIT = { title: 200, lang: 40, tag: 40, tags: 20, body: 200000, count: 5000 };\n\n  S.newId = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\n  const str = (v, max) => (typeof v === 'string' ? v : v == null ? '' : String(v)).slice(0, max);\n  const time = v => (typeof v === 'number' && isFinite(v) && v > 0 ? Math.round(v) : 0);\n\n  /* tags: trimmed, without '#', no empties or repeats (case ignored), kept in the order given */\n  S.cleanTags = function (v) {\n    const list = Array.isArray(v) ? v : typeof v === 'string' ? v.split(',') : [];\n    const out = [], seen = new Set();\n    for (const t of list) {\n      const x = str(t, LIMIT.tag).trim().replace(/^#+/, '').trim();\n      if (x && !seen.has(x.toLowerCase())) { seen.add(x.toLowerCase()); out.push(x); }\n      if (out.length >= LIMIT.tags) break;\n    }\n    return out;\n  };\n\n  /* one snippet, whatever was read: anything missing or the wrong type is filled in */\n  S.clean = function (o, now) {\n    o = o && typeof o === 'object' ? o : {};\n    now = now || Date.now();\n    return {\n      id: str(o.id, 40) || S.newId(),\n      title: str(o.title, LIMIT.title).trim() || 'Untitled',\n      tags: S.cleanTags(o.tags),\n      lang: str(o.lang, LIMIT.lang).trim(),\n      body: str(o.body, LIMIT.body),\n      pinned: o.pinned === true,\n      created: time(o.created) || now,\n      updated: time(o.updated) || time(o.created) || now,\n      used: time(o.used)\n    };\n  };\n\n  /* the library as saved: { v: 1, snippets: [...] }. Ids are made unique. */\n  S.cleanLibrary = function (o) {\n    const list = o && Array.isArray(o.snippets) ? o.snippets : Array.isArray(o) ? o : [];\n    const out = [], ids = new Set();\n    for (const x of list.slice(0, LIMIT.count)) {\n      const s = S.clean(x);\n      while (ids.has(s.id)) s.id = S.newId();\n      ids.add(s.id); out.push(s);\n    }\n    return out;\n  };\n  S.toJSON = list => JSON.stringify({ v: 1, snippets: list }, null, 1);\n\n  /* the file Export writes, and the only kind Import accepts */\n  S.exportText = list => JSON.stringify({ format: 'portd-snippets', v: 1, exported: new Date().toISOString(), snippets: list }, null, 2);\n  /* returns { snippets } or throws an Error with a plain message */\n  S.readExport = function (text) {\n    let o;\n    try { o = JSON.parse(text); } catch (e) { throw new Error('This file is not valid JSON, so it is not a Snippets library.'); }\n    if (!o || o.format !== 'portd-snippets' || !Array.isArray(o.snippets)) throw new Error('This JSON file is not a Snippets library. Only files made with Export can be imported.');\n    if (typeof o.v === 'number' && o.v > 1) throw new Error('This library was made by a newer version of Snippets.');\n    return { snippets: S.cleanLibrary(o) };\n  };\n  /* adds imported snippets, skipping ones already there with the same title and text; returns how many were added */\n  S.merge = function (list, incoming) {\n    const have = new Set(list.map(s => s.title + '\\u0000' + s.body)), ids = new Set(list.map(s => s.id));\n    let added = 0;\n    for (const s of incoming) {\n      if (have.has(s.title + '\\u0000' + s.body)) continue;\n      const c = Object.assign({}, s);\n      while (ids.has(c.id)) c.id = S.newId();\n      ids.add(c.id); have.add(c.title + '\\u0000' + c.body); list.push(c); added++;\n    }\n    return added;\n  };\n\n  /* search: every word must appear somewhere in the title, tags, language or text (case ignored) */\n  S.words = q => q.toLowerCase().split(/\\s+/).filter(Boolean);\n  S.matches = function (s, words) {\n    if (!words.length) return true;\n    const hay = (s.title + '\\n' + s.tags.join(' ') + '\\n' + s.lang + '\\n' + s.body).toLowerCase();\n    return words.every(w => hay.includes(w));\n  };\n  /* the snippets to list: filtered by tag and search, pinned first, then by title or by last used */\n  S.view = function (list, o) {\n    const words = S.words(o.q || ''), tag = (o.tag || '').toLowerCase();\n    const by = o.sort === 'used'\n      ? (a, b) => (b.used - a.used) || a.title.localeCompare(b.title, 'en', { sensitivity: 'base' })\n      : (a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base', numeric: true }) || a.created - b.created;\n    return list.filter(s => (!tag || s.tags.some(t => t.toLowerCase() === tag)) && S.matches(s, words))\n      .sort((a, b) => (b.pinned - a.pinned) || by(a, b));\n  };\n  /* every tag with how many snippets carry it, A to Z */\n  S.tagCounts = function (list) {\n    const m = new Map();\n    for (const s of list) for (const t of s.tags) { const k = t.toLowerCase(), e = m.get(k); if (e) e.n++; else m.set(k, { name: t, n: 1 }); }\n    return [...m.values()].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));\n  };\n  /* the first line of the text that holds a search word, for the list */\n  S.hitLine = function (s, words) {\n    if (!words.length) return '';\n    const lines = s.body.split('\\n');\n    for (const l of lines) { const low = l.toLowerCase(); if (words.some(w => low.includes(w))) return l.trim().slice(0, 140); }\n    return '';\n  };\n\n  /* a few harmless examples for a new library; the user can delete them */\n  S.seeds = function () {\n    const now = Date.now();\n    return [\n      { title: 'Largest files in a folder', tags: ['powershell', 'files'], lang: 'PowerShell',\n        body: \"Get-ChildItem -Path . -File -Recurse |\\n  Sort-Object Length -Descending |\\n  Select-Object -First 10 FullName, @{ n = 'MB'; e = { [math]::Round($_.Length / 1MB, 1) } }\" },\n      { title: 'Count events by hour', tags: ['kql', 'logs'], lang: 'KQL',\n        body: 'MyTable\\n| where TimeGenerated > ago(1d)\\n| summarize Count = count() by bin(TimeGenerated, 1h)\\n| order by TimeGenerated asc' },\n      { title: 'My profile (Graph)', tags: ['graph'], lang: 'HTTP',\n        body: 'GET /v1.0/me?$select=displayName,mail,jobTitle' },\n      { title: 'Thanks, will follow up', tags: ['email'], lang: '',\n        body: 'Hi,\\n\\nThanks for getting in touch. I have picked this up and will come back to you by the end of the day.\\n\\nKind regards' },\n      { title: 'Welcome: how Snippets works', tags: ['example'], lang: '', pinned: true,\n        body: 'Pick a snippet and press Copy (or Enter) to put its text on the clipboard.\\nPress New to add your own, and Edit to change one.\\nThese examples are only here to show you around: delete them whenever you like.' }\n    ].map((s, i) => S.clean(Object.assign({ created: now + i, updated: now + i }, s), now));\n  };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Snippets */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2563c9; --onaccent: #ffffff; --sel: #d6e4fb; --hit: #ffe680; --danger: #b42318; --dangerbg: #fde8e8;\n  --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00; --pin: #b07400;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #7aa7ff; --onaccent: #0b1220; --sel: #2c3f63; --hit: #6b5a12; --danger: #ff9b94; --dangerbg: #4a2a2e;\n  --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00; --pin: #ffc861;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; }\n.grow { flex: 1; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .55; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.danger { color: var(--danger); border-color: var(--danger); }\n.btn.danger:hover:not(:disabled) { background: var(--dangerbg); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.btn[aria-pressed=\"true\"] { background: var(--sel); }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.main { flex: 1; display: flex; min-height: 0; }\n.side { width: 310px; min-width: 220px; display: flex; flex-direction: column; border-right: 1px solid var(--line); background: var(--panel); }\n.filters { padding: 8px; display: flex; flex-direction: column; gap: 6px; border-bottom: 1px solid var(--line); }\n.row2 { display: flex; gap: 6px; }\n.row2 > * { flex: 1; min-width: 0; }\n.list { flex: 1; overflow: auto; outline-offset: -2px; }\n.item { padding: 7px 10px; border-bottom: 1px solid var(--line); cursor: pointer; }\n.item:hover { background: color-mix(in srgb, var(--sel) 50%, transparent); }\n.item.on { background: var(--sel); box-shadow: inset 3px 0 0 var(--accent); }\n.item .t { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.item .sub, .item .hit { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }\n.item .hit { font-family: ui-monospace, \"Cascadia Mono\", Consolas, monospace; color: var(--muted); }\n.item .pin { color: var(--pin); }\n.item mark { background: var(--hit); color: inherit; border-radius: 2px; }\n@media (pointer: coarse) { .item { padding: 11px 12px; } }\n.count { padding: 4px 10px; border-top: 1px solid var(--line); font-size: 12px; }\n\n.detail { flex: 1; min-width: 0; display: flex; }\n.view, .edit { flex: 1; display: flex; flex-direction: column; min-width: 0; padding: 12px 14px; gap: 10px; }\n.vhead h1 { font-size: 18px; margin: 0 0 4px; overflow-wrap: anywhere; }\n.meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }\n.meta .lang { font-size: 12px; padding: 1px 8px; border-radius: 10px; background: var(--accent); color: var(--onaccent); }\n.meta .tag { font: 12px \"Segoe UI\", system-ui, sans-serif; padding: 1px 8px; border-radius: 10px; background: var(--panel); color: var(--text); border: 1px solid var(--line); cursor: pointer; }\n.meta .tag:hover { border-color: var(--accent); }\n.acts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }\n.body { font: 12.5px/1.5 ui-monospace, \"Cascadia Mono\", Consolas, monospace; tab-size: 4; }\npre.body { flex: 1; margin: 0; overflow: auto; padding: 10px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; white-space: pre-wrap; overflow-wrap: anywhere; }\n.edit label { display: flex; flex-direction: column; gap: 3px; font-weight: 600; font-size: 12px; }\n.edit label .field { font-weight: 400; font-size: 13px; }\n.edit label.grow { flex: 1; min-height: 0; }\n.edit textarea.body { flex: 1; resize: none; min-height: 120px; padding: 8px 10px; }\n\n.empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; }\n.empty h2 { font-size: 18px; margin: 8px 0 4px; }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 280px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg textarea { width: 100%; font: 12px ui-monospace, Consolas, monospace; background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; padding: 6px; }\n.dacts { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8px; margin-top: 12px; }\n.warn { padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.keys { border-collapse: collapse; }\n.keys td { padding: 3px 8px 3px 0; vertical-align: top; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n\n.toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (max-width: 620px) { .side { width: 44%; } }\n@media (forced-colors: active) { .item.on { outline: 2px solid Highlight; } .item mark { background: Mark; color: MarkText; } }\n"
  }
 }
}