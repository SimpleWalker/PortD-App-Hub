{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "minesweeper",
 "name": "Minesweeper",
 "version": "1.0.0",
 "description": "Classic mine-clearing puzzle: three levels plus custom, best times",
 "icon": "emoji:💣",
 "entry": "index.html",
 "width": 520,
 "height": 500,
 "singleInstance": false,
 "fileTypes": [],
 "files": {
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"minesweeper\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Minesweeper</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\">\n    <select id=\"level\" title=\"Difficulty\" aria-label=\"Difficulty\">\n      <option value=\"beginner\">Beginner (9×9, 10)</option>\n      <option value=\"intermediate\">Intermediate (16×16, 40)</option>\n      <option value=\"expert\">Expert (30×16, 99)</option>\n      <option value=\"custom\">Custom…</option>\n    </select>\n    <button id=\"flagMode\" aria-pressed=\"false\" title=\"Tap to place flags instead of revealing (for touch screens)\">🚩 Flag mode</button>\n    <span class=\"spacer\"></span>\n    <button id=\"bestBtn\">Best times</button>\n    <button id=\"themeBtn\" class=\"icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"icon\" title=\"How to play (F1)\" aria-label=\"How to play\">?</button>\n  </div>\n  <div class=\"status\">\n    <div class=\"lcd\" id=\"mines\" title=\"Mines left\" aria-label=\"Mines left\">010</div>\n    <button id=\"face\" title=\"New game (F2)\" aria-label=\"New game\">🙂</button>\n    <div class=\"lcd\" id=\"time\" title=\"Seconds\" aria-label=\"Seconds\">000</div>\n  </div>\n  <div id=\"wrap\"><div id=\"board\" role=\"grid\" tabindex=\"0\" aria-label=\"Minefield. Arrow keys move, Space reveals, F flags.\"></div></div>\n</div>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\"></div>\n\n<div class=\"dlg\" id=\"customDlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"customTitle\"><div>\n  <h3 id=\"customTitle\">Custom field</h3>\n  <label>Width (5–40) <input id=\"cw\" type=\"number\" min=\"5\" max=\"40\" value=\"20\"></label>\n  <label>Height (5–30) <input id=\"ch\" type=\"number\" min=\"5\" max=\"30\" value=\"12\"></label>\n  <label>Mines <input id=\"cm\" type=\"number\" min=\"1\" value=\"35\"></label>\n  <div class=\"row\"><button id=\"cCancel\">Cancel</button><button class=\"pri\" id=\"cOk\">Start</button></div>\n</div></div>\n\n<div class=\"dlg\" id=\"bestDlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"bestTitle\"><div>\n  <h3 id=\"bestTitle\">Best times</h3>\n  <table id=\"bestTbl\"></table>\n  <div class=\"row\"><button id=\"bestReset\">Reset</button><button class=\"pri\" id=\"bestClose\">Close</button></div>\n</div></div>\n\n<div class=\"dlg\" id=\"helpDlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\"><div style=\"max-width:360px\">\n  <h3 id=\"helpTitle\">How to play</h3>\n  <p>Reveal every square that isn't a mine. Numbers show how many mines touch that square.</p>\n  <p><b>Left-click</b> reveal · <b>Right-click</b> flag / question mark · <b>Click a number</b> whose flags are all placed to reveal its neighbours.<br>\n  Touch: <b>long-press</b> to flag, or switch on Flag mode.<br><b>F2</b> or the face starts a new game. Your first click is always safe.</p>\n  <p><b>Keyboard:</b> arrow keys move, <b>Space</b> or <b>Enter</b> reveals (on a number: its neighbours), <b>F</b> flags.</p>\n  <div class=\"row\"><button class=\"pri\" id=\"helpClose\">Close</button></div>\n</div></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/minesweeper.js\"></script>\n</body>\n</html>\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/minesweeper.js": {
   "enc": "text",
   "d": "/* Minesweeper, ported from the 0.x package to PortD 1.0 (package format 3). The game rules are unchanged from 0.x;\n   added in the port: keyboard play, light and dark colours following the system (or chosen), Reset asking for a\n   second click, and saving outside PortD in the browser's localStorage (through host.js). */\n(() => {\n  const LEVELS = { beginner:[9,9,10], intermediate:[16,16,40], expert:[30,16,99] };\n  const $ = id => document.getElementById(id);\n  const boardEl = $('board'), wrap = $('wrap');\n\n  let W, H, M, level = 'beginner', custom = [20,12,35];\n  let mine, open, flag, adj, cells, started, over, revealed, timer = null, t0 = 0, secs = 0, flagMode = false;\n  let best = {}, settings = { level: 'beginner', custom: [20,12,35], theme: 'auto' }, kc = 0;\n\n  // ---- storage: P:\\User\\Config\\minesweeper\\settings.json and best.json (localStorage outside PortD)\n  async function loadBest() { try { const t = await Host.loadData('best.json'); const b = t ? JSON.parse(t) : {}; return b && typeof b === 'object' ? b : {}; } catch { return {}; } }\n  function saveBest() { Host.saveData('best.json', JSON.stringify(best)); }\n  function saveSettings() { settings.level = level; settings.custom = custom; Host.saveSettings(settings); }\n\n  function msg(t, ms = 2500) { const m = $('msg'); m.innerHTML = '<span></span>'; m.firstChild.textContent = t; clearTimeout(msg.h); msg.h = setTimeout(() => m.innerHTML = '', ms); }\n  const pad3 = n => n < 0 ? '-' + String(Math.min(99, -n)).padStart(2, '0') : String(Math.min(999, n)).padStart(3, '0');\n  const cap = s => s[0].toUpperCase() + s.slice(1);\n\n  function newGame() {\n    [W, H, M] = level === 'custom' ? custom : LEVELS[level];\n    const N = W * H;\n    mine = new Uint8Array(N); open = new Uint8Array(N); flag = new Uint8Array(N); adj = new Uint8Array(N);\n    started = false; over = false; revealed = 0; secs = 0; kc = Math.min(kc, N - 1);\n    clearInterval(timer); timer = null;\n    $('face').textContent = '🙂';\n    boardEl.innerHTML = '';\n    boardEl.style.gridTemplateColumns = `repeat(${W}, var(--s))`;\n    boardEl.style.gridTemplateRows = `repeat(${H}, var(--s))`;\n    boardEl.setAttribute('aria-rowcount', H); boardEl.setAttribute('aria-colcount', W);\n    cells = [];\n    const frag = document.createDocumentFragment();\n    for (let i = 0; i < N; i++) { const d = document.createElement('div'); d.className = 'c'; d.dataset.i = i; d.id = 'c' + i; d.setAttribute('role', 'gridcell'); frag.appendChild(d); cells.push(d); }\n    boardEl.appendChild(frag);\n    for (let i = 0; i < N; i++) draw(i);\n    fit(); updCounters(); cursor(kc);\n    Host.setTitle(`Minesweeper – ${cap(level)}`);\n  }\n\n  function fit() {\n    if (!W) return;\n    const s = Math.max(14, Math.min(40, Math.floor(Math.min((wrap.clientWidth - 16) / W, (wrap.clientHeight - 16) / H)) - 1));\n    boardEl.style.setProperty('--s', s + 'px');\n    boardEl.style.fontSize = Math.round(s * 0.58) + 'px';\n  }\n  new ResizeObserver(fit).observe(wrap);\n\n  const nb = i => { const x = i % W, y = (i / W) | 0, r = []; for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) { if (!dx && !dy) continue; const nx = x + dx, ny = y + dy; if (nx >= 0 && ny >= 0 && nx < W && ny < H) r.push(ny * W + nx); } return r; };\n\n  function plant(safe) {\n    const N = W * H, banned = new Set([safe]);\n    if (N - 9 >= M) nb(safe).forEach(j => banned.add(j)); // keep first click an opening when there is room\n    const pool = []; for (let i = 0; i < N; i++) if (!banned.has(i)) pool.push(i);\n    for (let k = 0; k < M && pool.length; k++) { const r = k + Math.floor(Math.random() * (pool.length - k)); [pool[k], pool[r]] = [pool[r], pool[k]]; mine[pool[k]] = 1; }\n    for (let i = 0; i < N; i++) adj[i] = nb(i).reduce((a, j) => a + mine[j], 0);\n    started = true; t0 = Date.now();\n    timer = setInterval(() => { secs = Math.floor((Date.now() - t0) / 1000); $('time').textContent = pad3(secs); }, 250);\n  }\n\n  function reveal(i) {\n    if (open[i] || flag[i] === 1) return;\n    if (mine[i]) { lose(i); return; }\n    const stack = [i];\n    while (stack.length) {\n      const k = stack.pop();\n      if (open[k] || flag[k] === 1) continue;\n      open[k] = 1; flag[k] = 0; revealed++; draw(k);\n      if (adj[k] === 0) nb(k).forEach(j => { if (!open[j] && !mine[j]) stack.push(j); });\n    }\n    if (revealed === W * H - M) win();\n  }\n\n  function chord(i) {\n    const n = nb(i), f = n.filter(j => flag[j] === 1).length;\n    if (f === adj[i]) n.forEach(j => { if (!over) reveal(j); });\n  }\n\n  function draw(i) {\n    const d = cells[i];\n    d.className = 'c' + (i === kc ? ' kc' : ''); d.textContent = '';\n    let label;\n    if (open[i]) { d.classList.add('o'); if (adj[i]) { d.textContent = adj[i]; d.classList.add('n' + adj[i]); } label = adj[i] ? String(adj[i]) : 'empty'; }\n    else if (flag[i] === 1) { d.textContent = '🚩'; label = 'flagged'; }\n    else if (flag[i] === 2) { d.textContent = '❓'; label = 'question mark'; }\n    else label = 'hidden';\n    d.setAttribute('aria-label', 'Row ' + ((i / W | 0) + 1) + ', column ' + (i % W + 1) + ': ' + label);\n  }\n\n  function updCounters() {\n    let f = 0; for (let i = 0; i < flag.length; i++) if (flag[i] === 1) f++;\n    $('mines').textContent = pad3(M - f);\n    $('time').textContent = pad3(secs);\n  }\n\n  function lose(i) {\n    over = true; clearInterval(timer);\n    $('face').textContent = '😵';\n    for (let k = 0; k < W * H; k++) {\n      if (mine[k] && flag[k] !== 1) { cells[k].textContent = '💣'; cells[k].className = 'c o'; cells[k].setAttribute('aria-label', 'mine'); }\n      else if (!mine[k] && flag[k] === 1) { cells[k].textContent = '❌'; cells[k].className = 'c o wrong'; cells[k].setAttribute('aria-label', 'wrong flag'); }\n    }\n    cells[i].classList.add('boom');\n    msg('Boom! Press the face to try again.');\n  }\n\n  function win() {\n    over = true; clearInterval(timer);\n    secs = Math.max(1, Math.round((Date.now() - t0) / 1000));\n    $('face').textContent = '😎';\n    for (let k = 0; k < W * H; k++) if (mine[k]) { flag[k] = 1; draw(k); }\n    updCounters();\n    if (level !== 'custom') {\n      const prev = best[level];\n      if (!prev || secs < prev.t) { best[level] = { t: secs, d: new Date().toISOString().slice(0, 10) }; saveBest(); msg(`New best time: ${secs}s!`, 4000); Host.notify(`new ${level} record, ${secs}s`); return; }\n    }\n    msg(`You win! ${secs}s`, 4000);\n  }\n\n  function toggleFlag(i) {\n    if (open[i] || over) return;\n    flag[i] = (flag[i] + 1) % 3; draw(i); updCounters();\n  }\n\n  function act(i, button) {\n    if (over) return;\n    if (button === 2 || (flagMode && button === 0 && !open[i])) { toggleFlag(i); return; }\n    if (open[i]) { if (adj[i]) chord(i); return; }\n    if (flag[i] === 1) return;\n    if (!started) plant(i);\n    reveal(i);\n  }\n\n  // ---- input: mouse + touch with long-press\n  let press = null;\n  boardEl.addEventListener('contextmenu', e => e.preventDefault());\n  boardEl.addEventListener('pointerdown', e => {\n    const c = e.target.closest('.c'); if (!c || over) return;\n    const i = +c.dataset.i;\n    cursor(i);\n    if (!over) $('face').textContent = '😮';\n    if (e.pointerType === 'touch') {\n      press = { i, long: false, h: setTimeout(() => { press.long = true; toggleFlag(i); if (navigator.vibrate) navigator.vibrate(30); }, 420) };\n    } else press = { i, button: e.button };\n  });\n  boardEl.addEventListener('pointerup', e => {\n    if (!over) $('face').textContent = '🙂';\n    if (!press) return;\n    const p = press; press = null;\n    const c = e.target.closest('.c');\n    if (e.pointerType === 'touch') { clearTimeout(p.h); if (!p.long && c && +c.dataset.i === p.i) act(p.i, 0); return; }\n    if (c && +c.dataset.i === p.i) act(p.i, p.button);\n  });\n  boardEl.addEventListener('pointercancel', () => { if (press && press.h) clearTimeout(press.h); press = null; if (!over) $('face').textContent = '🙂'; });\n\n  // ---- keyboard (added in the port): a cursor on the board\n  function cursor(i) {\n    const old = cells[kc]; if (old) old.classList.remove('kc');\n    kc = Math.max(0, Math.min(W * H - 1, i));\n    cells[kc].classList.add('kc');\n    boardEl.setAttribute('aria-activedescendant', 'c' + kc);\n  }\n  boardEl.addEventListener('keydown', e => {\n    const x = kc % W, y = kc / W | 0;\n    const mv = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];\n    if (mv) { e.preventDefault(); cursor(Math.max(0, Math.min(H - 1, y + mv[1])) * W + Math.max(0, Math.min(W - 1, x + mv[0]))); }\n    else if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); act(kc, 0); }\n    else if (e.key === 'f' || e.key === 'F') { e.preventDefault(); if (!over) toggleFlag(kc); }\n    else if (e.key === 'Home') { e.preventDefault(); cursor(y * W); }\n    else if (e.key === 'End') { e.preventDefault(); cursor(y * W + W - 1); }\n  });\n\n  $('face').onclick = newGame;\n  document.addEventListener('keydown', e => {\n    if (e.key === 'F2') { e.preventDefault(); closeDialogs(); newGame(); boardEl.focus(); }\n    else if (e.key === 'F1') { e.preventDefault(); showDlg('helpDlg'); }\n    else if (e.key === 'Escape') { const open = document.querySelector('.dlg.show'); if (open) { e.preventDefault(); (open.id === 'customDlg' ? $('cCancel') : open.querySelector('.pri')).click(); } }\n  });\n  $('flagMode').onclick = () => { flagMode = !flagMode; $('flagMode').classList.toggle('on', flagMode); $('flagMode').setAttribute('aria-pressed', String(flagMode)); };\n\n  // ---- dialogs: focus goes in, Tab stays in, Esc closes, focus comes back\n  let back = null;\n  function showDlg(id) { back = document.activeElement; $(id).classList.add('show'); ($(id).querySelector('input') || $(id).querySelector('.pri')).focus(); }\n  function hideDlg(id) { $(id).classList.remove('show'); if (back && back.focus) back.focus(); }\n  function closeDialogs() { document.querySelectorAll('.dlg.show').forEach(d => d.classList.remove('show')); }\n  document.querySelectorAll('.dlg').forEach(d => d.addEventListener('keydown', e => {\n    if (e.key !== 'Tab') return;\n    const f = [...d.querySelectorAll('input, button')], i = f.indexOf(document.activeElement);\n    if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }\n  }));\n\n  $('level').onchange = () => {\n    const v = $('level').value;\n    if (v === 'custom') { $('cw').value = custom[0]; $('ch').value = custom[1]; $('cm').value = custom[2]; showDlg('customDlg'); return; }\n    level = v; saveSettings(); newGame();\n  };\n  $('cCancel').onclick = () => { hideDlg('customDlg'); $('level').value = level; };\n  $('cOk').onclick = () => {\n    const w = Math.max(5, Math.min(40, +$('cw').value | 0)), h = Math.max(5, Math.min(30, +$('ch').value | 0));\n    const m = Math.max(1, Math.min(w * h - 1, +$('cm').value | 0));\n    custom = [w, h, m]; level = 'custom'; hideDlg('customDlg');\n    saveSettings(); newGame();\n  };\n  $('customDlg').addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.tagName === 'INPUT') { e.preventDefault(); $('cOk').click(); } });\n\n  let resetArmed = 0;\n  function showBest() {\n    const t = $('bestTbl'); t.innerHTML = '';\n    for (const k of Object.keys(LEVELS)) {\n      const r = t.insertRow(), b = best[k];\n      r.insertCell().textContent = cap(k);\n      r.insertCell().textContent = b ? b.t + ' s' : '—';\n      r.insertCell().textContent = b ? b.d : '';\n    }\n    resetArmed = 0; $('bestReset').textContent = 'Reset'; $('bestReset').classList.remove('danger');\n    if (!$('bestDlg').classList.contains('show')) showDlg('bestDlg');\n  }\n  $('bestBtn').onclick = showBest;\n  $('bestClose').onclick = () => hideDlg('bestDlg');\n  /* destructive: the first click asks, a second click within 3 seconds resets */\n  $('bestReset').onclick = () => {\n    if (Date.now() - resetArmed > 3000) { resetArmed = Date.now(); $('bestReset').textContent = 'Click again to reset'; $('bestReset').classList.add('danger'); return; }\n    best = {}; saveBest(); showBest(); msg('Best times reset');\n  };\n  $('helpBtn').onclick = () => showDlg('helpDlg');\n  $('helpClose').onclick = () => hideDlg('helpDlg');\n\n  // ---- theme (added in the port)\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); saveSettings(); msg(THEMES[settings.theme][1], 1500); };\n\n  // expose for testing\n  window.__ms = { get state() { return { W, H, M, over, revealed, mine, open, flag, adj, started, level, kc }; }, act, newGame };\n\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    if (Array.isArray(settings.custom) && settings.custom.length === 3) custom = settings.custom.map(n => +n | 0);\n    if (LEVELS[settings.level] || settings.level === 'custom') level = settings.level;\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    $('level').value = level;\n    best = await loadBest();\n    newGame();\n    boardEl.focus();\n  })();\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Minesweeper. The dark colours are the 0.x game's own; the light theme is new in 1.0. */\n:root { --bg:#eef1f6; --panel:#dde3ec; --cell:#b9c3d3; --cellHi:#c9d2e0; --open:#f7f9fc; --edge:#7d889b; --text:#1d2330; --accent:#2563c9; --onaccent:#fff; --grid:#8f9aad; --lcdbg:#111; color-scheme: light; }\n:root[data-theme=\"dark\"] { --bg:#1e2430; --panel:#2a3242; --cell:#3b4559; --cellHi:#4a5670; --open:#d9dee8; --edge:#556; --text:#e8ecf3; --accent:#4f8cff; --onaccent:#fff; --grid:#1a1f29; color-scheme: dark; }\n* { box-sizing:border-box; }\nhtml,body { margin:0; height:100%; background:var(--bg); color:var(--text); font:14px system-ui,Segoe UI,Arial,sans-serif; user-select:none; -webkit-user-select:none; overflow:hidden; }\n#app { display:flex; flex-direction:column; height:100%; }\n.bar { display:flex; align-items:center; gap:6px; padding:6px 8px; background:var(--panel); flex-wrap:wrap; }\n.bar button, .bar select { background:var(--cell); color:var(--text); border:1px solid var(--edge); border-radius:6px; padding:4px 8px; font:inherit; cursor:pointer; min-height:28px; }\n.bar button.icon { min-width:30px; display:inline-flex; align-items:center; justify-content:center; }\n.bar button:hover { background:var(--cellHi); }\n.bar button.on { background:var(--accent); border-color:var(--accent); color:var(--onaccent); }\n.spacer { flex:1; }\n.status { display:flex; align-items:center; justify-content:center; gap:14px; padding:6px; }\n.lcd { font:bold 20px ui-monospace,Consolas,monospace; background:var(--lcdbg); color:#ff5050; padding:2px 8px; border-radius:4px; min-width:58px; text-align:center; }\n#face { font-size:24px; width:42px; height:38px; border-radius:8px; border:1px solid var(--edge); background:var(--cell); cursor:pointer; line-height:1; }\n#wrap { flex:1; display:flex; align-items:center; justify-content:center; overflow:hidden; padding:6px; }\n#board { display:grid; gap:1px; background:var(--grid); border:2px solid var(--grid); border-radius:4px; touch-action:none; outline-offset:3px; }\n.c { background:var(--cell); display:flex; align-items:center; justify-content:center; font-weight:800; cursor:pointer; border-radius:2px; }\n.c:hover { background:var(--cellHi); }\n.c.o { background:var(--open); cursor:default; }\n.c.boom { background:#ff4d4d; }\n.c.wrong { background:#f2b0b0; }\n#board:focus-visible .c.kc { box-shadow: inset 0 0 0 3px var(--accent); }\n.n1{color:#1f5bd6}.n2{color:#1b8a2e}.n3{color:#d32626}.n4{color:#1d2f8a}.n5{color:#8a1d1d}.n6{color:#138a8a}.n7{color:#222}.n8{color:#666}\n#msg { position:fixed; inset:auto 0 12px 0; text-align:center; pointer-events:none; }\n#msg span { background:rgba(0,0,0,.75); color:#fff; padding:8px 14px; border-radius:8px; display:inline-block; }\n.dlg { position:fixed; inset:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center; }\n.dlg.show { display:flex; }\n.dlg > div { background:var(--panel); color:var(--text); padding:16px; border-radius:10px; min-width:240px; border:1px solid var(--edge); }\n.dlg h3 { margin:0 0 10px; }\n.dlg table { width:100%; border-collapse:collapse; }\n.dlg td { padding:4px 6px; border-bottom:1px solid var(--edge); }\n.dlg label { display:block; margin:6px 0; }\n.dlg input { width:70px; background:var(--cell); color:var(--text); border:1px solid var(--edge); border-radius:4px; padding:3px; }\n.dlg .row { display:flex; gap:8px; justify-content:flex-end; margin-top:12px; }\n.dlg button { background:var(--cell); color:var(--text); border:1px solid var(--edge); border-radius:6px; padding:5px 12px; cursor:pointer; font:inherit; }\n.dlg button.pri { background:var(--accent); border-color:var(--accent); color:var(--onaccent); }\n.dlg button.danger { background:#c62828; border-color:#c62828; color:#fff; }\n:focus-visible { outline:2px solid var(--accent); outline-offset:1px; }\n@media (pointer: coarse) { .bar button, .bar select, .dlg button { min-height:40px; } }\n"
  }
 }
}