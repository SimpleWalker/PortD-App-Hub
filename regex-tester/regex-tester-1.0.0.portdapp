{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "regex-tester",
 "name": "Regex Tester",
 "version": "1.0.0",
 "description": "Try regular expressions on your own text: live highlighting, groups, replace, a cheat sheet and saved patterns.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 980,
 "height": 640,
 "singleInstance": false,
 "fileTypes": [
  {
   "ext": ".txt",
   "name": "Text file",
   "icon": "glyph:text"
  },
  {
   "ext": ".log",
   "name": "Log file",
   "icon": "glyph:text"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"4\" y=\"10\" width=\"56\" height=\"44\" rx=\"7\" fill=\"#6d3fc0\"/><text x=\"32\" y=\"41\" font-family=\"Consolas, monospace\" font-size=\"22\" font-weight=\"700\" fill=\"#fff\" text-anchor=\"middle\">.*</text><path d=\"M14 46h36\" stroke=\"#ffd34d\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"regex-tester\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Regex Tester</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Regex Tester\">\n    <button id=\"openBtn\" class=\"btn\" title=\"Open a text or log file as the test text (Ctrl+O)\">Open…</button>\n    <button id=\"saveBtn\" class=\"btn\" title=\"Save this pattern with a name (Ctrl+S)\">Save pattern…</button>\n    <button id=\"savedBtn\" class=\"btn\" title=\"Your saved patterns (Alt+P)\">Saved patterns…</button>\n    <span class=\"grow\"></span>\n    <button id=\"liveBtn\" class=\"btn\" aria-pressed=\"true\" title=\"Match as you type\">Live</button>\n    <button id=\"runBtn\" class=\"btn primary\" title=\"Run the pattern now (Ctrl+Enter)\">Run</button>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n  </div>\n\n  <div class=\"pat\">\n    <label class=\"plabel\" for=\"pattern\">Pattern</label>\n    <div class=\"pbox\">\n      <span class=\"slash\" aria-hidden=\"true\">/</span>\n      <input id=\"pattern\" class=\"pin\" spellcheck=\"false\" autocomplete=\"off\" aria-describedby=\"status\" placeholder=\"for example: (?<year>\\d{4})-(\\d\\d)\">\n      <span class=\"slash\" aria-hidden=\"true\">/</span>\n      <span id=\"flagText\" class=\"ftext\" aria-hidden=\"true\"></span>\n    </div>\n    <div class=\"flags\" role=\"group\" aria-label=\"Flags\">\n      <button class=\"flag\" data-f=\"g\" aria-pressed=\"true\" title=\"g: find all matches, not just the first\">g</button>\n      <button class=\"flag\" data-f=\"i\" aria-pressed=\"false\" title=\"i: ignore upper and lower case\">i</button>\n      <button class=\"flag\" data-f=\"m\" aria-pressed=\"false\" title=\"m: ^ and $ match at the start and end of each line\">m</button>\n      <button class=\"flag\" data-f=\"s\" aria-pressed=\"false\" title=\"s: . also matches line breaks\">s</button>\n      <button class=\"flag\" data-f=\"u\" aria-pressed=\"false\" title=\"u: Unicode, for \\u{…} and \\p{…}\">u</button>\n      <button class=\"flag\" data-f=\"y\" aria-pressed=\"false\" title=\"y: sticky, each match must start where the last one ended\">y</button>\n    </div>\n  </div>\n  <div id=\"status\" class=\"status\" role=\"status\"></div>\n\n  <div class=\"main\">\n    <section class=\"left\" aria-label=\"Test text\">\n      <div class=\"lhead\"><span class=\"ltitle\">Test text</span><span id=\"textInfo\" class=\"muted small\"></span></div>\n      <div class=\"tbox\">\n        <div id=\"hl\" class=\"hl\" aria-hidden=\"true\"></div>\n        <textarea id=\"text\" class=\"ta\" spellcheck=\"false\" wrap=\"off\" aria-label=\"Test text\" placeholder=\"Type or paste the text to test, or press Open…\"></textarea>\n      </div>\n    </section>\n    <section class=\"right\">\n      <div class=\"tabs\" role=\"tablist\" aria-label=\"Panels\">\n        <button id=\"tab-matches\" class=\"tab on\" role=\"tab\" aria-selected=\"true\" aria-controls=\"p-matches\" title=\"Matches (Alt+1)\">Matches <span id=\"mCount\" class=\"pill\"></span></button>\n        <button id=\"tab-replace\" class=\"tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"p-replace\" tabindex=\"-1\" title=\"Replace (Alt+2)\">Replace</button>\n        <button id=\"tab-cheat\" class=\"tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"p-cheat\" tabindex=\"-1\" title=\"Cheat sheet (Alt+3 or F1)\">Cheat sheet</button>\n      </div>\n      <div id=\"p-matches\" class=\"panel\" role=\"tabpanel\" aria-labelledby=\"tab-matches\">\n        <div id=\"mList\" class=\"mlist\" role=\"listbox\" aria-label=\"Matches\" tabindex=\"0\"></div>\n      </div>\n      <div id=\"p-replace\" class=\"panel\" role=\"tabpanel\" aria-labelledby=\"tab-replace\" hidden>\n        <label class=\"rl\">Replace with <input id=\"repl\" class=\"field mono\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"for example: $<year>/$2\" title=\"$1 group 1, $<name> a named group, $&amp; the whole match, $$ a dollar sign\"></label>\n        <div class=\"rhead\"><span class=\"muted small\" id=\"rInfo\"></span><span class=\"grow\"></span><button id=\"copyBtn\" class=\"btn\" title=\"Copy the result\">Copy result</button></div>\n        <pre id=\"rOut\" class=\"rout mono\" tabindex=\"0\" aria-label=\"Result\"></pre>\n      </div>\n      <div id=\"p-cheat\" class=\"panel cheat\" role=\"tabpanel\" aria-labelledby=\"tab-cheat\" hidden tabindex=\"0\">\n        <table>\n          <tr><th colspan=\"2\">Characters</th></tr>\n          <tr><td>.</td><td>any character except a line break (any at all with the s flag)</td></tr>\n          <tr><td>\\d \\w \\s</td><td>a digit · a letter, digit or _ · a space, tab or line break</td></tr>\n          <tr><td>\\D \\W \\S</td><td>anything except those</td></tr>\n          <tr><td>[abc] [^abc] [a-z]</td><td>one of a, b, c · anything but a, b, c · a to z</td></tr>\n          <tr><td>\\. \\\\ \\( \\[</td><td>a real dot, backslash, bracket: put \\ before . * + ? ( ) [ ] { } | ^ $ \\</td></tr>\n          <tr><td>\\t \\n \\r</td><td>tab · new line · carriage return</td></tr>\n          <tr><td>\\p{L} \\p{Lu}</td><td>any letter · an upper-case letter (needs the u flag)</td></tr>\n          <tr><th colspan=\"2\">How many</th></tr>\n          <tr><td>* + ?</td><td>0 or more · 1 or more · 0 or 1</td></tr>\n          <tr><td>{3} {2,} {2,5}</td><td>exactly 3 · 2 or more · 2 to 5</td></tr>\n          <tr><td>*? +? ??</td><td>as few as possible (lazy)</td></tr>\n          <tr><th colspan=\"2\">Where</th></tr>\n          <tr><td>^ $</td><td>start · end of the text (of each line with the m flag)</td></tr>\n          <tr><td>\\b \\B</td><td>a word edge · not a word edge</td></tr>\n          <tr><td>(?=x) (?!x)</td><td>followed by x · not followed by x</td></tr>\n          <tr><td>(?&lt;=x) (?&lt;!x)</td><td>after x · not after x</td></tr>\n          <tr><th colspan=\"2\">Groups</th></tr>\n          <tr><td>(abc)</td><td>a group: kept as $1, $2…</td></tr>\n          <tr><td>(?&lt;name&gt;abc)</td><td>a named group: kept as $&lt;name&gt;</td></tr>\n          <tr><td>(?:abc)</td><td>a group that is not kept</td></tr>\n          <tr><td>a|b</td><td>a or b</td></tr>\n          <tr><td>\\1 \\k&lt;name&gt;</td><td>the same text as group 1 · as the named group</td></tr>\n          <tr><th colspan=\"2\">In Replace</th></tr>\n          <tr><td>$1 $&lt;name&gt;</td><td>a group's text</td></tr>\n          <tr><td>$&amp;</td><td>the whole match</td></tr>\n          <tr><td>$` $'</td><td>the text before · after the match</td></tr>\n          <tr><td>$$</td><td>a dollar sign</td></tr>\n          <tr><th colspan=\"2\">Examples</th></tr>\n          <tr><td>^\\s*$</td><td>an empty line (with m)</td></tr>\n          <tr><td>\\b\\d{1,3}(\\.\\d{1,3}){3}\\b</td><td>something shaped like an IPv4 address</td></tr>\n          <tr><td>(?&lt;user&gt;[\\w.-]+)@(?&lt;domain&gt;[\\w-]+(\\.[\\w-]+)+)</td><td>something shaped like an email address</td></tr>\n          <tr><td>\\[(ERROR|WARN)\\]</td><td>[ERROR] or [WARN] in a log</td></tr>\n        </table>\n      </div>\n    </section>\n  </div>\n</div>\n\n<div id=\"saveDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"saveTitle\">\n    <h2 id=\"saveTitle\">Save pattern</h2>\n    <p class=\"small muted\">Saves the pattern, its flags, the replacement and the test text (up to 100,000 characters).</p>\n    <label class=\"rl\">Name <input id=\"saveName\" class=\"field\" maxlength=\"80\" autocomplete=\"off\"></label>\n    <div id=\"saveWarn\" class=\"warn\" hidden></div>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button id=\"saveOk\" class=\"btn primary\">Save</button></div>\n  </div>\n</div>\n\n<div id=\"savedDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"savedTitle\">\n    <h2 id=\"savedTitle\">Saved patterns</h2>\n    <div id=\"savedList\" class=\"slist\"></div>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/engine.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Regex Tester: the window. Pattern and flags, test text with highlighted matches, the Matches, Replace and\n   Cheat sheet panels, saved patterns, opening text files, and the last session kept as you type. */\n(function () {\n  'use strict';\n  const $ = id => document.getElementById(id);\n  const ta = $('text'), hl = $('hl'), patEl = $('pattern'), mList = $('mList');\n  const num = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => num(n) + ' ' + (n === 1 ? w : ws || w + 's');\n  const TEXT_MAX = 5e6, SESSION_TEXT_MAX = 1e6;\n\n  let settings = { theme: 'auto', live: true };\n  let flags = 'g', tab = 'matches', saved = [];\n  let res = null, cur = -1, names = [];\n\n  /* ---------- helpers ---------- */\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2400); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  const visible = s => s.replace(/\\n/g, '↵').replace(/\\r/g, '␍').replace(/\\t/g, '→');\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea')].filter(e => !e.disabled && e.offsetParent);\n    (first ? ov.querySelector(first) : focusables()[0]).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus && document.contains(back)) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); else if (e.target === ov) done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n      ov.done = done;\n    });\n  }\n  /* replaces the whole test text (Open, Load). Ctrl+Z in the text brings back what was there, as long as the new text\n     has not been changed since. Kept by the program, because after PortD's Open dialog the browser's own undo\n     does not see the change. */\n  let undo = null;\n  function setText(t) {\n    undo = ta.value !== t ? { before: ta.value, after: t } : null;\n    ta.value = t;\n    ta.setSelectionRange(0, 0); ta.scrollTop = 0; ta.scrollLeft = 0;\n    textChanged();\n  }\n  ta.addEventListener('keydown', e => {\n    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z' && undo && ta.value === undo.after) {\n      e.preventDefault(); const b = undo.before; undo = null; ta.value = b; textChanged(); toast('The earlier text is back.');\n    }\n  });\n\n  /* ---------- the session: kept as you type ---------- */\n  let sessT = 0;\n  function saveSession() { clearTimeout(sessT); sessT = setTimeout(writeSession, 500); }\n  function writeSession() {\n    clearTimeout(sessT); sessT = 0;\n    const big = ta.value.length > SESSION_TEXT_MAX;\n    Host.saveData('session.json', JSON.stringify({ v: 1, pattern: patEl.value, flags, text: big ? '' : ta.value, textTooBig: big, replacement: $('repl').value, tab }, null, 1));\n  }\n  addEventListener('pagehide', () => { if (sessT) writeSession(); });\n  addEventListener('visibilitychange', () => { if (document.hidden && sessT) writeSession(); });\n\n  /* ---------- status line ---------- */\n  function status(kind, text) { const s = $('status'); s.className = 'status' + (kind ? ' ' + kind : ''); s.textContent = text; }\n\n  /* ---------- running ---------- */\n  let runT = 0;\n  function schedule() { clearTimeout(runT); runT = setTimeout(() => run(false), 180); }\n  function clearResults() { res = null; cur = -1; drawMarks(); drawList(); drawReplace(); $('mCount').textContent = ''; }\n  function run(manual) {\n    clearTimeout(runT);\n    const p = patEl.value;\n    const b = Rx.build(p, flags);\n    patEl.classList.toggle('bad', !!b.error);\n    if (!p) { clearResults(); status('', 'Type a pattern to see what it matches.'); return; }\n    if (b.error) { clearResults(); status('err', 'This pattern has a mistake: ' + b.error); return; }\n    Rx._flags = flags;\n    const why = Rx.risky(p);\n    if (!manual && !settings.live) { status('', 'Live is off. Press Run (Ctrl+Enter) to match.'); return; }\n    if (why && !manual) { clearResults(); status('warn', 'Not run as you type: this pattern has ' + why + ', which can take so long on some text that PortD stops responding. Press Run (Ctrl+Enter) to try it anyway.'); return; }\n    names = Rx.groupNames(p);\n    res = Rx.run(b.re, ta.value, names);\n    res.re = b.re;\n    cur = -1;\n    let note = '';\n    if (res.stopped) note = 'Stopped after ' + (res.ms / 1000).toFixed(1) + ' s: ' + plural(res.count, 'match', 'matches') + ' found so far. ';\n    else note = res.count ? plural(res.count, 'match', 'matches') + '. ' : 'No match. ';\n    if (res.matches.length < res.count) note += 'The first ' + num(res.matches.length) + ' are shown. ';\n    if (!flags.includes('g') && res.count) note += 'Turn on g to find them all. ';\n    if (settings.live && res.ms > Rx.LIMIT.slow && !manual) { setLive(false); note += 'That took ' + (res.ms / 1000).toFixed(1) + ' s, so Live is now off: press Run (Ctrl+Enter) after changes.'; }\n    status(res.stopped ? 'warn' : res.count ? 'ok' : '', note.trim());\n    $('mCount').textContent = res.count ? (res.stopped ? num(res.count) + '+' : num(res.count)) : '0';\n    drawMarks(); drawList(); drawReplace();\n  }\n\n  /* ---------- the highlight behind the text ---------- */\n  function drawMarks() {\n    const text = ta.value, frag = document.createDocumentFragment();\n    let at = 0;\n    if (res) res.matches.forEach((m, i) => {\n      if (m.index < at) return;\n      frag.append(text.slice(at, m.index));\n      const mk = h('mark', (m.length ? 'm' + (i % 2) : 'z') + (i === cur ? ' cur' : ''), text.slice(m.index, m.index + m.length));\n      mk.dataset.i = i; frag.append(mk); at = m.index + m.length;\n    });\n    frag.append(text.slice(at) + '\\n ');\n    hl.textContent = ''; hl.append(frag);\n    syncScroll();\n  }\n  function syncScroll() { hl.scrollTop = ta.scrollTop; hl.scrollLeft = ta.scrollLeft; }\n  ta.addEventListener('scroll', syncScroll);\n\n  /* ---------- the Matches list ---------- */\n  function drawList() {\n    mList.textContent = ''; mList.removeAttribute('aria-activedescendant');\n    if (!res || !res.matches.length) { mList.append(h('div', 'none muted', !patEl.value ? 'Matches will be listed here.' : res ? 'No match in the test text.' : '')); return; }\n    const frag = document.createDocumentFragment();\n    res.matches.forEach((m, i) => {\n      const row = h('div', 'mrow' + (i === cur ? ' on' : '')); row.id = 'm-' + i; row.dataset.i = i; row.setAttribute('role', 'option'); row.setAttribute('aria-selected', String(i === cur));\n      const top = h('div', 'mtop');\n      top.append(h('b', null, '#' + (i + 1)), h('span', 'muted', ' at ' + num(m.index) + ', length ' + num(m.length)));\n      row.append(top, h('div', 'mval mono', m.length ? visible(m.text) : '(empty match)'));\n      for (const g of m.groups) {\n        const gl = h('div', 'grp mono');\n        gl.append(h('span', 'gn', (g.name ? g.name + ' ($' + g.n + ')' : '$' + g.n) + ': '), g.value === undefined ? h('span', 'muted', 'did not take part') : h('span', null, '\"' + visible(g.value) + '\"'));\n        row.append(gl);\n      }\n      frag.append(row);\n    });\n    mList.append(frag);\n  }\n  function choose(i, focusText) {\n    if (!res || !res.matches[i]) return;\n    cur = i;\n    for (const el of mList.querySelectorAll('.mrow.on')) { el.classList.remove('on'); el.setAttribute('aria-selected', 'false'); }\n    const row = $('m-' + i); row.classList.add('on'); row.setAttribute('aria-selected', 'true'); row.scrollIntoView({ block: 'nearest' });\n    mList.setAttribute('aria-activedescendant', row.id);\n    for (const el of hl.querySelectorAll('mark.cur')) el.classList.remove('cur');\n    const mk = hl.querySelector('mark[data-i=\"' + i + '\"]'); if (mk) mk.classList.add('cur');\n    const m = res.matches[i];\n    if (focusText) { ta.focus(); ta.setSelectionRange(m.index, m.index + m.length); }\n    else { const keep = document.activeElement; ta.setSelectionRange(m.index, m.index + m.length); if (keep && keep !== ta) keep.focus(); }\n    revealInText(m.index);\n  }\n  /* scrolls the text so a position is in view: measured on the highlight copy, which has the same layout */\n  function revealInText(index) {\n    const mk = hl.querySelector('mark.cur'); if (!mk) return;\n    const top = mk.offsetTop, left = mk.offsetLeft;\n    if (top < ta.scrollTop || top > ta.scrollTop + ta.clientHeight - 24) ta.scrollTop = Math.max(0, top - ta.clientHeight / 3);\n    if (left < ta.scrollLeft || left > ta.scrollLeft + ta.clientWidth - 40) ta.scrollLeft = Math.max(0, left - 40);\n    syncScroll();\n  }\n  mList.addEventListener('click', e => { const r = e.target.closest('.mrow'); if (r) choose(+r.dataset.i, false); });\n  mList.addEventListener('dblclick', e => { const r = e.target.closest('.mrow'); if (r) choose(+r.dataset.i, true); });\n  mList.addEventListener('keydown', e => {\n    if (!res || !res.matches.length) return;\n    const n = res.matches.length, to = { ArrowDown: cur + 1, ArrowUp: cur < 0 ? 0 : cur - 1, Home: 0, End: n - 1, PageDown: cur + 8, PageUp: cur - 8 }[e.key];\n    if (to !== undefined) { e.preventDefault(); choose(Math.max(0, Math.min(n - 1, to)), false); }\n    else if (e.key === 'Enter' && cur >= 0) { e.preventDefault(); choose(cur, true); }\n  });\n  mList.addEventListener('focus', () => { if (cur < 0 && res && res.matches.length) choose(0, false); });\n\n  /* ---------- Replace ---------- */\n  function drawReplace() {\n    const out = $('rOut'), info = $('rInfo');\n    if (!res) { out.textContent = ''; info.textContent = patEl.value ? 'Run the pattern to see the result.' : 'Type a pattern and a replacement.'; return; }\n    if (res.stopped) { out.textContent = ''; info.textContent = 'Not shown: matching was stopped because it took too long.'; return; }\n    try {\n      const r = Rx.replace(res.re, ta.value, $('repl').value);\n      out.textContent = r;\n      info.textContent = res.count ? (flags.includes('g') ? 'Every match replaced (' + num(res.count) + ').' : 'The first match replaced. Turn on g to replace them all.') : 'No match, so nothing changed.';\n    } catch (e) { out.textContent = ''; info.textContent = 'Could not replace: ' + e.message; }\n  }\n  $('repl').addEventListener('input', () => { drawReplace(); saveSession(); });\n  $('copyBtn').onclick = async () => {\n    const t = $('rOut').textContent;\n    if (!res || res.stopped) { toast('There is no result to copy yet.'); return; }\n    if (await Host.copy(t)) toast('Copied the result (' + plural(t.length, 'character') + ')');\n    else { $('copyText').value = t; const p = dialog('copyDlg', '#copyText'); $('copyText').select(); await p; }\n  };\n\n  /* ---------- tabs ---------- */\n  const TABS = ['matches', 'replace', 'cheat'];\n  function setTab(t, focus) {\n    tab = TABS.includes(t) ? t : 'matches';\n    for (const x of TABS) { const b = $('tab-' + x), on = x === tab; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; $('p-' + x).hidden = !on; }\n    if (focus) $('tab-' + tab).focus();\n    saveSession();\n  }\n  for (const x of TABS) $('tab-' + x).onclick = () => setTab(x);\n  document.querySelector('.tabs').addEventListener('keydown', e => {\n    const i = TABS.indexOf(tab), to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: TABS.length - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); setTab(TABS[(to + TABS.length) % TABS.length], true);\n  });\n\n  /* ---------- pattern, flags, text ---------- */\n  function drawFlags() {\n    for (const b of document.querySelectorAll('.flag')) b.setAttribute('aria-pressed', String(flags.includes(b.dataset.f)));\n    $('flagText').textContent = flags;\n  }\n  for (const b of document.querySelectorAll('.flag')) b.onclick = () => {\n    const f = b.dataset.f;\n    flags = (flags.includes(f) ? flags.replace(f, '') : flags + f).split('').sort((a, c) => Rx.FLAGS.indexOf(a) - Rx.FLAGS.indexOf(c)).join('');\n    drawFlags(); saveSession(); schedule();\n  };\n  patEl.addEventListener('input', () => { saveSession(); schedule(); });\n  patEl.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.ctrlKey) { e.preventDefault(); run(true); } });\n  function textInfo() { const t = ta.value; $('textInfo').textContent = plural(t.length, 'character') + ' · ' + plural(t ? t.split('\\n').length : 0, 'line'); }\n  function textChanged() { textInfo(); saveSession(); if (res) { res = null; drawMarks(); } schedule(); }\n  ta.addEventListener('input', textChanged);\n\n  function setLive(on) {\n    settings.live = on; Host.saveSettings(settings);\n    $('liveBtn').setAttribute('aria-pressed', String(on));\n    $('liveBtn').title = on ? 'Live: matching as you type (click to turn off)' : 'Live is off: press Run after changes (click to turn on)';\n  }\n  $('liveBtn').onclick = () => { setLive(!settings.live); toast(settings.live ? 'Live is on' : 'Live is off: press Run after changes'); if (settings.live) run(false); };\n  $('runBtn').onclick = () => run(true);\n\n  /* ---------- opening a file ---------- */\n  function takeFile(f) {\n    if (f.text.length > TEXT_MAX) { toast('\"' + f.name + '\" is too big: the test text can be up to 5 MB.', 5000); return; }\n    setText(f.text.replace(/^﻿/, ''));\n    Host.setTitle(f.name + ' - Regex Tester');\n    toast('Opened ' + f.name + '. Ctrl+Z in the text brings back the earlier text.', 3500);\n  }\n  async function openFile() {\n    try { const f = await Host.openFile({ title: 'Open a text file', types: ['.txt', '.log'] }); if (f) takeFile(f); }\n    catch (e) { toast('Could not open the file: ' + e.message, 5000); }\n  }\n  async function openGiven(o) {\n    try { takeFile(await Host.readPath(o.path, o.name)); }\n    catch (e) { toast('Could not open \"' + o.name + '\": ' + e.message, 5000); }\n  }\n  $('openBtn').onclick = openFile;\n\n  /* ---------- saved patterns ---------- */\n  const writeSaved = () => Host.saveData('saved.json', JSON.stringify({ v: 1, patterns: saved }, null, 1));\n  async function savePattern() {\n    if (!patEl.value) { toast('Type a pattern first.'); patEl.focus(); return; }\n    const name = $('saveName'), ok = $('saveOk'), warn = $('saveWarn');\n    name.value = name.value || patEl.value.slice(0, 40);\n    warn.hidden = true; ok.textContent = 'Save';\n    let armed = false;\n    ok.onclick = () => {\n      const n = name.value.trim();\n      if (!n) { name.focus(); return; }\n      const i = saved.findIndex(s => s.name.toLowerCase() === n.toLowerCase());\n      if (i >= 0 && !armed) { armed = true; warn.hidden = false; warn.textContent = 'A saved pattern is already called \"' + saved[i].name + '\". Press Replace it to overwrite it, or change the name.'; ok.textContent = 'Replace it'; return; }\n      const entry = Rx.cleanSaved({ patterns: [{ name: n, pattern: patEl.value, flags, text: ta.value.slice(0, 100000), replacement: $('repl').value, saved: Date.now() }] })[0];\n      if (i >= 0) saved[i] = entry; else saved.push(entry);\n      saved.sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));\n      writeSaved(); $('saveDlg').done('saved');\n      toast('Saved \"' + n + '\"');\n    };\n    name.oninput = () => { armed = false; warn.hidden = true; ok.textContent = 'Save'; };\n    name.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); ok.click(); } };\n    const p = dialog('saveDlg', '#saveName'); name.select(); await p;\n  }\n  function drawSaved() {\n    const box = $('savedList'); box.textContent = '';\n    if (!saved.length) { box.append(h('p', 'muted', 'Nothing saved yet. Use Save pattern… to keep a pattern with its flags and text.')); return; }\n    saved.forEach((s, i) => {\n      const row = h('div', 'srow');\n      const info = h('div', 'sinfo'); info.append(h('b', null, s.name), h('div', 'mono small muted', '/' + s.pattern + '/' + s.flags));\n      const load = h('button', 'btn primary', 'Load'); load.setAttribute('aria-label', 'Load ' + s.name);\n      const del = h('button', 'btn danger', 'Delete'); del.setAttribute('aria-label', 'Delete ' + s.name);\n      load.onclick = () => { $('savedDlg').done('loaded'); loadSaved(s); };\n      let t = 0;\n      del.onclick = () => {\n        if (!t) { del.textContent = 'Click again to delete'; t = setTimeout(() => { t = 0; del.textContent = 'Delete'; }, 3000); return; }\n        clearTimeout(t); saved.splice(i, 1); writeSaved(); drawSaved(); toast('Deleted \"' + s.name + '\"');\n        const first = $('savedList').querySelector('button') || $('savedDlg').querySelector('[data-act]'); first.focus();\n      };\n      row.append(info, load, del); box.append(row);\n    });\n  }\n  function loadSaved(s) {\n    patEl.value = s.pattern; flags = s.flags; drawFlags(); $('repl').value = s.replacement;\n    if (s.text !== ta.value) setText(s.text);\n    patEl.focus();\n    saveSession(); run(false);\n    toast('Loaded \"' + s.name + '\"' + (s.text ? '. Ctrl+Z in the text brings back the earlier text.' : ''), 3500);\n  }\n  $('saveBtn').onclick = savePattern;\n  $('savedBtn').onclick = () => { drawSaved(); dialog('savedDlg', '#savedList button'); };\n\n  /* ---------- theme ---------- */\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- keys ---------- */\n  document.addEventListener('keydown', e => {\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    let go = null;\n    if (ctrl && !e.altKey && !e.shiftKey) go = { enter: () => run(true), o: openFile, s: savePattern }[k];\n    else if (e.altKey && !ctrl) go = { 1: () => setTab('matches', true), 2: () => setTab('replace', true), 3: () => setTab('cheat', true), p: () => $('savedBtn').click() }[k];\n    else if (e.key === 'F1') go = () => setTab('cheat', true);\n    if (go) { e.preventDefault(); go(); }\n  });\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    settings.live = settings.live !== false;\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme); setLive(settings.live);\n    try { saved = Rx.cleanSaved(JSON.parse(await Host.loadData('saved.json') || '{}')); } catch (e) { saved = []; }\n    let s = null;\n    try { s = JSON.parse(await Host.loadData('session.json') || 'null'); } catch (e) { s = null; }\n    if (s && typeof s === 'object') {\n      patEl.value = typeof s.pattern === 'string' ? s.pattern : '';\n      flags = Rx.cleanSaved({ patterns: [{ flags: s.flags }] })[0].flags;\n      ta.value = typeof s.text === 'string' ? s.text : '';\n      $('repl').value = typeof s.replacement === 'string' ? s.replacement : '';\n      if (s.textTooBig) toast('The last test text was over 1 MB, so it was not kept.', 4000);\n      setTab(s.tab);\n    } else {\n      patEl.value = '(?<year>\\\\d{4})-(?<month>\\\\d\\\\d)-(\\\\d\\\\d)';\n      ta.value = 'Backups ran on 2026-11-02 and 2026-11-09.\\nThe next one is due 2026-11-16.';\n      $('repl').value = '$3/$<month>/$<year>';\n    }\n    drawFlags(); textInfo();\n    Host.setTitle('Regex Tester');\n    run(false);\n    const start = Host.startFile();\n    if (start) await openGiven(start);\n    patEl.focus();\n    window.__rx = { get res() { return res; }, get flags() { return flags; }, get cur() { return cur; }, get settings() { return settings; }, get saved() { return saved; }, writeSession, ready: true };\n  })();\n})();\n"
  },
  "js/engine.js": {
   "enc": "text",
   "d": "/* Regex Tester: the matching. Building the pattern, spotting risky shapes, finding matches within limits,\n   and the replace preview. No drawing here; app.js draws. Everything hangs off window.Rx. */\n(function () {\n  'use strict';\n  const Rx = window.Rx = {};\n  Rx.FLAGS = ['g', 'i', 'm', 's', 'u', 'y'];\n  Rx.LIMIT = { shown: 1000, ms: 500, slow: 200 };\n\n  /* the pattern as a RegExp, or { error } in plain words */\n  Rx.build = function (pattern, flags) {\n    if (!pattern) return { error: '' };\n    try { return { re: new RegExp(pattern, flags + 'd') }; }   // d: also report where each group matched\n    catch (e) {\n      let m = String(e.message || e).replace(/^Invalid regular expression: \\/.*\\/[a-z]*: /s, '').replace(/^Invalid regular expression: /, '');\n      return { error: m.charAt(0).toUpperCase() + m.slice(1) + '.' };\n    }\n  };\n\n  /* walks the pattern; calls fn(kind, i, token) for '(' ')' '|', quantifiers ('q') and atoms ('a': a character, an escape,\n     a [class] or '.'). The (?: (?= (?! (?<= (?<! (?<name> openings are skipped as one '(' */\n  function walk(p, fn) {\n    for (let i = 0; i < p.length; i++) {\n      const c = p[i];\n      if (c === '\\\\') { fn('a', i, p.slice(i, i + 2)); i++; continue; }\n      if (c === '[') { const a = i; i++; if (p[i] === '^') i++; if (p[i] === ']') i++; while (i < p.length && p[i] !== ']') { if (p[i] === '\\\\') i++; i++; } fn('a', a, '['); continue; }\n      if (c === '(') { fn('(', i); if (p[i + 1] === '?') { const m = /^\\(\\?(?::|=|!|<=|<!|<[A-Za-z_$][\\w$]*>)/.exec(p.slice(i)); if (m) i += m[0].length - 1; } }\n      else if (c === ')') fn(')', i);\n      else if (c === '|') fn('|', i);\n      else if (c === '*' || c === '+' || c === '?' || c === '{') fn('q', i);\n      else if (c !== '^' && c !== '$') fn('a', i, c);\n    }\n  }\n  /* the quantifier starting at i: { unbounded, variable } (unbounded: * + {n,} or a large {n,m}; variable: the count can vary) */\n  function quant(p, i) {\n    const c = p[i];\n    if (c === '*' || c === '+') return { unbounded: true, variable: true };\n    if (c === '?') return { unbounded: false, variable: true };\n    const m = /^\\{(\\d+)(,(\\d*))?\\}/.exec(p.slice(i));\n    if (!m) return null;\n    return { unbounded: m[2] !== undefined && (m[3] === '' || +m[3] > 16), variable: m[2] !== undefined && m[3] !== m[1] };\n  }\n\n  /* Risky shapes: a repeated group that holds a repeat or an alternative, such as (a+)+, (\\w*)* or (a|ab)+.\n     They can take so long on text that almost matches that the window stops responding. Returns a reason or ''. */\n  const GENERAL = /^(\\[|\\.|\\\\[wWdDsSbBpP])$/;   // tokens that can match many different characters\n  Rx.risky = function (p) {\n    const group = () => ({ rep: false, alt: false, firsts: [], want: true });\n    const stack = [group()];\n    let why = '', lastClose = -1, closed = null;\n    /* alternatives can overlap when two start the same way, one starts with a class, or one is empty */\n    const overlap = g => g.alt && (g.want || g.firsts.some((t, n) => GENERAL.test(t) || g.firsts.indexOf(t) !== n));\n    walk(p, (k, i, tok) => {\n      if (why) return;\n      const top = stack[stack.length - 1];\n      if (k === 'a') { if (top.want) { top.firsts.push(tok.length === 1 && /[a-z]/i.test(tok) && /i/.test(Rx._flags || '') ? tok.toLowerCase() : tok); top.want = false; } closed = null; }\n      else if (k === '(') { if (top.want) { top.firsts.push('['); top.want = false; } stack.push(group()); closed = null; }\n      else if (k === '|') { top.alt = true; if (top.want) top.firsts.push(''); top.want = true; }\n      else if (k === ')') { if (stack.length > 1) { closed = stack.pop(); closed.ovl = overlap(closed); lastClose = i; } }\n      else if (k === 'q') {\n        const q = quant(p, i);\n        if (!q) return;\n        if (closed && lastClose === i - 1) {\n          if (q.unbounded && (closed.rep || closed.ovl)) why = closed.rep ? 'a repeated group that holds another repeat' : 'a repeated group of choices that can match the same text';\n          if (q.variable || closed.rep) top.rep = true;\n        } else if (q.variable) top.rep = true;\n        closed = null;\n      }\n    });\n    return why;\n  };\n\n  /* the names of the groups, in order (index 1 first); unnamed groups are '' */\n  Rx.groupNames = function (p) {\n    const names = [];\n    walk(p, (k, i) => {\n      if (k !== '(') return;\n      if (p[i + 1] !== '?') { names.push(''); return; }\n      const m = /^\\(\\?<([A-Za-z_$][\\w$]*)>/.exec(p.slice(i));\n      if (m) names.push(m[1]);\n    });\n    return names;\n  };\n\n  /* finds matches: at most LIMIT.shown kept, counting on until LIMIT.ms is used up.\n     Returns { matches: [{ index, length, text, groups: [{ n, name, value, index }] }], count, stopped: '' | 'time', ms } */\n  Rx.run = function (re, text, names) {\n    const t0 = performance.now(), out = [], global = re.global;\n    re.lastIndex = 0;\n    let count = 0, stopped = '';\n    for (;;) {\n      const m = re.exec(text);\n      if (!m) break;\n      count++;\n      if (out.length < Rx.LIMIT.shown) {\n        const groups = [];\n        for (let g = 1; g < m.length; g++) groups.push({ n: g, name: names[g - 1] || '', value: m[g], index: m.indices && m.indices[g] ? m.indices[g][0] : -1 });\n        out.push({ index: m.index, length: m[0].length, text: m[0], groups });\n      }\n      if (!global) break;\n      if (m[0].length === 0) re.lastIndex = m.index + ((re.unicode || re.unicodeSets) && text.codePointAt(m.index) > 0xffff ? 2 : 1);\n      if (performance.now() - t0 > Rx.LIMIT.ms) { stopped = 'time'; break; }\n    }\n    re.lastIndex = 0;\n    return { matches: out, count, stopped, ms: performance.now() - t0 };\n  };\n\n  /* the replace preview: the browser's own replace, so $1, $<name>, $&, $` , $' and $$ work exactly as in JavaScript */\n  Rx.replace = function (re, text, replacement) {\n    const plain = new RegExp(re.source, re.flags.replace('d', ''));\n    return text.replace(plain, replacement);\n  };\n\n  /* for the saved file: { v: 1, patterns: [...] } with each entry cleaned */\n  Rx.cleanSaved = function (o) {\n    const list = o && Array.isArray(o.patterns) ? o.patterns : [];\n    const s = (v, n) => (typeof v === 'string' ? v : '').slice(0, n);\n    return list.slice(0, 500).map(x => ({\n      name: s(x && x.name, 80).trim() || 'Untitled',\n      pattern: s(x && x.pattern, 5000),\n      flags: s(x && x.flags, 8).split('').filter((f, i, a) => Rx.FLAGS.includes(f) && a.indexOf(f) === i).join(''),\n      text: s(x && x.text, 100000),\n      replacement: s(x && x.replacement, 5000),\n      saved: x && typeof x.saved === 'number' ? x.saved : 0\n    }));\n  };\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Regex Tester */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #5b34b0; --onaccent: #ffffff; --sel: #e6defa;\n  --m0: #ffe680; --m1: #b9e6ff; --mcur: #ff9d4d; --zero: #d1361b;\n  --ok: #1e6b37; --okbg: #e3f4e8; --err: #b42318; --errbg: #fde8e8; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00; --danger: #b42318; --dangerbg: #fde8e8;\n  --mono: ui-monospace, \"Cascadia Mono\", Consolas, \"Courier New\", monospace;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #b69cff; --onaccent: #160c2e; --sel: #3a2f5c;\n  --m0: #6b5a12; --m1: #1c4f6b; --mcur: #a3501a; --zero: #ff8a75;\n  --ok: #8fe0a8; --okbg: #183524; --err: #ff9b94; --errbg: #4a2a2e; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00; --danger: #ff9b94; --dangerbg: #4a2a2e;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .mono { font-family: var(--mono); }\n.grow { flex: 1; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.danger { color: var(--danger); border-color: var(--danger); }\n.btn.danger:hover { background: var(--dangerbg); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n#liveBtn[aria-pressed=\"true\"] { background: var(--sel); border-color: var(--accent); }\n#liveBtn[aria-pressed=\"true\"]::before { content: \"● \"; color: var(--ok); }\n#liveBtn[aria-pressed=\"false\"]::before { content: \"○ \"; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.pat { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 10px 4px; }\n.plabel { font-weight: 600; }\n.pbox { flex: 1; min-width: 260px; display: flex; align-items: center; border: 1px solid var(--edge); border-radius: 6px; background: var(--bg); padding: 0 8px; }\n.pbox:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }\n.slash, .ftext { font: 15px var(--mono); color: var(--muted); }\n.ftext { min-width: 1ch; margin-left: 2px; color: var(--accent); }\n.pin { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: 15px/1.5 var(--mono); padding: 5px 4px; }\n.pin.bad { text-decoration: wavy underline var(--err); }\n.flags { display: flex; gap: 3px; }\n.flag { font: 600 13px var(--mono); width: 30px; height: 30px; border-radius: 6px; border: 1px solid var(--edge); background: var(--bg); color: var(--muted); cursor: pointer; }\n.flag[aria-pressed=\"true\"] { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } .flag { width: 40px; height: 40px; } }\n.status { margin: 0 10px 6px; padding: 4px 10px; border-radius: 6px; min-height: 26px; font-size: 12.5px; border: 1px solid transparent; }\n.status.ok { background: var(--okbg); color: var(--ok); }\n.status.err { background: var(--errbg); color: var(--err); border-color: var(--err); }\n.status.warn { background: var(--warnbg); color: var(--warnfg); border-color: var(--warnedge); }\n\n.main { flex: 1; display: flex; min-height: 0; border-top: 1px solid var(--line); }\n.left { flex: 1.3; min-width: 0; display: flex; flex-direction: column; }\n.lhead { display: flex; align-items: baseline; gap: 10px; padding: 6px 10px 4px; }\n.ltitle { font-weight: 600; }\n.tbox { position: relative; flex: 1; min-height: 0; margin: 0 10px 10px; border: 1px solid var(--edge); border-radius: 6px; background: var(--bg); overflow: hidden; }\n.tbox:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }\n.hl, .ta { position: absolute; inset: 0; margin: 0; padding: 8px 10px; font: 13px/20px var(--mono); tab-size: 4; white-space: pre; overflow-wrap: normal; letter-spacing: 0; border: 0; }\n.hl { overflow: hidden; color: transparent; pointer-events: none; }\n.ta { width: 100%; height: 100%; resize: none; outline: 0; background: transparent; color: var(--text); overflow: auto; }\n.hl mark { color: transparent; border-radius: 2px; }\n.hl mark.m0 { background: var(--m0); }\n.hl mark.m1 { background: var(--m1); }\n.hl mark.z { display: inline-block; width: 0; height: 20px; vertical-align: top; border-left: 2px solid var(--zero); margin-right: -2px; background: none; }\n.hl mark.cur { background: var(--mcur); box-shadow: 0 0 0 1px var(--mcur); }\n.hl mark.z.cur { border-left-width: 3px; }\n\n.right { flex: 1; min-width: 260px; display: flex; flex-direction: column; border-left: 1px solid var(--line); background: var(--panel); }\n.tabs { display: flex; gap: 2px; padding: 6px 8px 0; border-bottom: 1px solid var(--line); }\n.tab { font: inherit; color: var(--text); background: transparent; border: 1px solid transparent; border-bottom: 0; border-radius: 6px 6px 0 0; padding: 5px 12px; cursor: pointer; margin-bottom: -1px; }\n.tab.on { background: var(--bg); border-color: var(--line); font-weight: 600; }\n@media (pointer: coarse) { .tab { padding: 10px 14px; } }\n.pill { font-size: 11px; background: var(--sel); border-radius: 9px; padding: 0 6px; font-weight: 400; }\n.pill:empty { display: none; }\n.panel { flex: 1; min-height: 0; overflow: auto; background: var(--bg); display: flex; flex-direction: column; }\n.mlist { flex: 1; overflow: auto; outline-offset: -2px; }\n.none { padding: 12px; }\n.mrow { padding: 6px 10px; border-bottom: 1px solid var(--line); cursor: pointer; }\n.mrow:hover { background: color-mix(in srgb, var(--sel) 50%, transparent); }\n.mrow.on { background: var(--sel); box-shadow: inset 3px 0 0 var(--accent); }\n.mval { font-size: 12.5px; white-space: pre-wrap; overflow-wrap: anywhere; margin: 2px 0; }\n.grp { font-size: 12px; padding-left: 12px; white-space: pre-wrap; overflow-wrap: anywhere; }\n.gn { color: var(--accent); }\n.rl { display: flex; flex-direction: column; gap: 3px; font-weight: 600; font-size: 12px; padding: 10px 10px 0; }\n.rl .field { font-weight: 400; font-size: 13px; }\n.rhead { display: flex; align-items: center; gap: 8px; padding: 8px 10px; }\n.rout { flex: 1; margin: 0 10px 10px; padding: 8px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow: auto; white-space: pre; font-size: 12.5px; min-height: 60px; }\n.cheat { padding: 6px 10px; display: block; }\n.cheat table { border-collapse: collapse; width: 100%; font-size: 12.5px; }\n.cheat th { text-align: left; padding: 10px 0 3px; color: var(--accent); }\n.cheat td { padding: 2px 8px 2px 0; vertical-align: top; border-bottom: 1px solid var(--line); }\n.cheat td:first-child { font-family: var(--mono); white-space: nowrap; font-weight: 600; }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg.wide { width: 560px; }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg .rl { padding: 0; }\n.dlg textarea { width: 100%; font: 12px var(--mono); background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; padding: 6px; }\n.dacts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.warn { margin-top: 8px; padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.slist { display: flex; flex-direction: column; gap: 6px; max-height: 50vh; overflow: auto; }\n.srow { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; }\n.sinfo { flex: 1; min-width: 0; }\n.sinfo div { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (max-width: 760px) { .main { flex-direction: column; } .right { border-left: 0; border-top: 1px solid var(--line); } }\n@media (forced-colors: active) { .hl mark { forced-color-adjust: none; } .mrow.on { outline: 2px solid Highlight; } }\n"
  }
 }
}