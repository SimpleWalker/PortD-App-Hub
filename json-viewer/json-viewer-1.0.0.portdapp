{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "json-viewer",
 "name": "JSON Viewer",
 "version": "1.0.0",
 "description": "Explore JSON files as a tree: search with paths, copy values and paths, raw text, and errors shown where they are.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 820,
 "height": 560,
 "singleInstance": false,
 "fileTypes": [
  {
   "ext": ".json",
   "name": "JSON file",
   "icon": "glyph:code"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect x=\"3\" y=\"4\" width=\"26\" height=\"24\" rx=\"4\" fill=\"#7a3fb8\"/><path d=\"M12 9c-2.2 0-3 1-3 3v1.8c0 1-.6 1.7-1.6 2.2 1 .5 1.6 1.2 1.6 2.2V20c0 2 .8 3 3 3M20 9c2.2 0 3 1 3 3v1.8c0 1 .6 1.7 1.6 2.2-1 .5-1.6 1.2-1.6 2.2V20c0 2-.8 3-3 3\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"13.5\" cy=\"16\" r=\"1.4\" fill=\"#ffd36b\"/><circle cx=\"18.5\" cy=\"16\" r=\"1.4\" fill=\"#ffd36b\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"json-viewer\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>JSON Viewer</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"JSON Viewer\">\n    <button id=\"openBtn\" class=\"btn\" title=\"Open a file (Ctrl+O)\">Open…</button>\n    <button id=\"pasteBtn\" class=\"btn\" title=\"Paste JSON text to view it\">Paste…</button>\n    <span class=\"seg\" role=\"group\" aria-label=\"View\">\n      <button id=\"treeBtn\" class=\"btn\" aria-pressed=\"true\" disabled>Tree</button><button id=\"rawBtn\" class=\"btn\" aria-pressed=\"false\" disabled title=\"Raw text (R in the tree)\">Raw</button>\n    </span>\n    <button id=\"expandBtn\" class=\"btn\" disabled title=\"Expand everything (or as much as is sensible)\">Expand all</button>\n    <button id=\"collapseBtn\" class=\"btn\" disabled>Collapse all</button>\n    <span class=\"sep\"></span>\n    <input id=\"search\" class=\"field grow\" type=\"search\" placeholder=\"Search\" title=\"Search keys and values (Ctrl+F)\" aria-label=\"Search keys and values\" disabled>\n    <button id=\"prevBtn\" class=\"btn icon\" title=\"Previous match (Shift+F3)\" aria-label=\"Previous match\" disabled>↑</button>\n    <button id=\"nextBtn\" class=\"btn icon\" title=\"Next match (F3)\" aria-label=\"Next match\" disabled>↓</button>\n    <span id=\"hits\" class=\"muted hits\" aria-live=\"polite\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Keyboard shortcuts (F1)\" aria-label=\"Help\">?</button>\n  </div>\n  <div id=\"warn\" class=\"warn\" role=\"status\" hidden></div>\n  <div id=\"main\" class=\"main\">\n    <div id=\"tree\" class=\"tree\" tabindex=\"0\" role=\"tree\" aria-label=\"JSON\" hidden><div id=\"rows\" class=\"rows\"></div></div>\n    <div id=\"results\" class=\"results\" hidden>\n      <div class=\"rhead\"><span id=\"rcount\"></span><button id=\"rclose\" class=\"btn icon\" aria-label=\"Close the list of matches\" title=\"Close the list\">×</button></div>\n      <div id=\"rlist\" class=\"rlist\" role=\"listbox\" aria-label=\"Matches\" tabindex=\"0\"></div>\n    </div>\n    <div id=\"raw\" class=\"raw\" hidden>\n      <div class=\"rawbar\"><span class=\"seg\" role=\"group\" aria-label=\"Raw text\">\n        <button id=\"asFile\" class=\"btn\" aria-pressed=\"true\">As in the file</button><button id=\"asPretty\" class=\"btn\" aria-pressed=\"false\">Formatted</button></span>\n        <button id=\"copyRaw\" class=\"btn\">Copy all</button>\n        <span id=\"rawInfo\" class=\"muted\"></span></div>\n      <div class=\"rawwrap\"><div id=\"gutter\" class=\"gutter\" aria-hidden=\"true\"></div><textarea id=\"rawText\" readonly spellcheck=\"false\" wrap=\"off\" aria-label=\"Raw text\"></textarea></div>\n    </div>\n    <div id=\"error\" class=\"error\" hidden>\n      <h2>This is not valid JSON</h2>\n      <p id=\"errMsg\" class=\"errmsg\"></p>\n      <pre id=\"errCtx\" class=\"ctx\"></pre>\n      <button id=\"errRaw\" class=\"btn primary\">Show it in the raw text</button>\n    </div>\n    <div id=\"empty\" class=\"empty\">\n      <div>\n        <img src=\"icon.svg\" alt=\"\" width=\"64\" height=\"64\">\n        <h1>JSON Viewer</h1>\n        <p>Open a JSON file to explore it as a tree.</p>\n        <button id=\"openBig\" class=\"btn primary\">Open a file…</button> <button id=\"pasteBig\" class=\"btn\">Paste JSON…</button>\n        <p class=\"muted small\">You can also drop a file on this window.</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"status\" aria-live=\"polite\"><span id=\"stFile\"></span><span id=\"stInfo\"></span><span id=\"stPath\" class=\"pathinfo\"></span></div>\n</div>\n\n<div id=\"menu\" class=\"menu\" role=\"menu\" hidden>\n  <button role=\"menuitem\" data-cmd=\"value\">Copy value</button>\n  <button role=\"menuitem\" data-cmd=\"path\">Copy path</button>\n  <button role=\"menuitem\" data-cmd=\"pointer\">Copy JSON Pointer</button>\n  <button role=\"menuitem\" data-cmd=\"key\">Copy key</button>\n  <hr>\n  <button role=\"menuitem\" data-cmd=\"expand\">Expand all below</button>\n  <button role=\"menuitem\" data-cmd=\"collapse\">Collapse all below</button>\n</div>\n\n<div id=\"pasteDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"pasteTitle\">\n    <h2 id=\"pasteTitle\">Paste JSON</h2>\n    <p class=\"muted\">Paste or type JSON text, then press View.</p>\n    <textarea id=\"pasteText\" rows=\"12\" spellcheck=\"false\" aria-label=\"JSON text\"></textarea>\n    <div class=\"acts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button class=\"btn primary\" data-act=\"ok\">View</button></div>\n  </div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Keyboard shortcuts</h2>\n    <table class=\"keys\">\n      <tr><td>Ctrl+O</td><td>Open a file</td></tr>\n      <tr><td>Ctrl+F</td><td>Search keys and values</td></tr>\n      <tr><td>Enter, F3</td><td>Next match (Shift for the previous one)</td></tr>\n      <tr><td>Up / Down</td><td>Move through the tree</td></tr>\n      <tr><td>Right / Left</td><td>Open / close an item, or go to its first child / its parent</td></tr>\n      <tr><td>Enter, Space</td><td>Open or close an item</td></tr>\n      <tr><td>*</td><td>Open everything below the item</td></tr>\n      <tr><td>Home / End, Page Up / Down</td><td>First / last item, a page at a time</td></tr>\n      <tr><td>Ctrl+C</td><td>Copy the item's value</td></tr>\n      <tr><td>Ctrl+Shift+C</td><td>Copy the item's path</td></tr>\n      <tr><td>Shift+F10, Menu key</td><td>More copy choices</td></tr>\n      <tr><td>R</td><td>Raw text; Esc goes back to the tree</td></tr>\n      <tr><td>F1</td><td>This list</td></tr>\n    </table>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/json.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* JSON Viewer: the window. A tree that is opened as you go and drawn only where it can be seen, search with paths,\n   copying values and paths, the raw text, and parse errors shown where they are. */\n(function () {\n  'use strict';\n  const J = window.JSONV, $ = id => document.getElementById(id);\n  const tree = $('tree'), rowsEl = $('rows');\n  const fmt = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => fmt(n) + ' ' + (n === 1 ? w : ws || w + 's');\n  const size = n => n < 1024 ? n + ' bytes' : n < 1048576 ? (n / 1024).toFixed(1) + ' KB' : (n / 1048576).toFixed(1) + ' MB';\n  const GROUP = 100, EXPAND_ALL_MAX = 50000;\n\n  let settings = { theme: 'auto' };\n  let doc = null;              // { name, path, text, root, count, error }\n  let open = new WeakSet();    // containers shown open\n  let groupsOpen = new WeakMap(); // container -> Set of group starts shown open\n  let flat = [];               // the rows that can be seen, in order\n  let cur = 0, RH = 24;\n  let search = { q: '', hits: [], set: new Set(), at: -1, total: 0 };\n  let rawMode = 'file';\n\n  /* ---------- helpers ---------- */\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2200); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea, select')].filter(e => !e.disabled && e.offsetParent);\n    (first ? ov.querySelector(first) : focusables()[0]).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); else if (e.target === ov) done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        else if (e.key === 'Enter' && e.ctrlKey && ov.querySelector('[data-act=ok]')) { e.preventDefault(); done('ok'); }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n    });\n  }\n  async function copyText(text, what) {\n    if (await Host.copy(text)) toast('Copied ' + what);\n    else { $('copyText').value = text; const p = dialog('copyDlg', '#copyText'); $('copyText').select(); await p; }\n  }\n  const isBox = n => n.t === 'o' || n.t === 'a';\n  const kids = n => n.t === 'o' ? n.keys.length : n.t === 'a' ? n.vals.length : 0;\n  function preview(n, max) {\n    switch (n.t) {\n      case 's': return JSON.stringify(n.v.length > max ? n.v.slice(0, max) + '…' : n.v);\n      case 'n': return n.v;\n      case 'b': return String(n.v);\n      case 'z': return 'null';\n      case 'a': return '[ ' + plural(n.vals.length, 'item') + ' ]';\n      case 'o': return '{ ' + plural(n.keys.length, 'key') + ' }';\n    }\n  }\n\n  /* ---------- loading ---------- */\n  function load(file) {\n    const text = file.text;\n    doc = { name: file.name, path: file.path, text, root: null, count: 0, error: null };\n    open = new WeakSet(); groupsOpen = new WeakMap(); cur = 0;\n    clearSearch(false);\n    try {\n      const r = J.parse(text);\n      doc.root = r.root; doc.count = r.count;\n    } catch (e) {\n      if (!(e instanceof J.ParseError)) throw e;\n      doc.error = { msg: e.message, pos: e.pos, at: J.where(text, e.pos) };\n    }\n    rawMode = 'file';\n    for (const id of ['treeBtn', 'rawBtn']) $(id).disabled = false;\n    for (const id of ['expandBtn', 'collapseBtn', 'search', 'prevBtn', 'nextBtn']) $(id).disabled = !doc.root;\n    $('empty').hidden = true;\n    Host.setTitle(doc.name + ' - JSON Viewer');\n    if (doc.error) { showError(); return; }\n    open.add(doc.root);\n    if (doc.count < 2000 && isBox(doc.root)) (doc.root.vals).forEach(v => { if (isBox(v) && kids(v) <= 50) open.add(v); });\n    dupWarning();\n    showTree();\n  }\n  function dupWarning() {\n    let n = 0;\n    walk(doc.root, (node) => { if (node.dup) n += node.dup.size; });\n    $('warn').hidden = !n;\n    $('warn').textContent = n ? '⚠ ' + plural(n, 'key appears', 'keys appear') + ' twice in the same object. Both are shown, marked \"duplicate\"; most programs keep only the last one.' : '';\n  }\n  /* every node, depth first, without recursion: fn(node, parentInfo) */\n  function walk(root, fn) {\n    const st = [root];\n    while (st.length) { const n = st.pop(); fn(n); if (isBox(n)) for (let i = n.vals.length - 1; i >= 0; i--) st.push(n.vals[i]); }\n  }\n\n  /* ---------- views ---------- */\n  function setView(v) {\n    $('treeBtn').setAttribute('aria-pressed', String(v === 'tree')); $('rawBtn').setAttribute('aria-pressed', String(v === 'raw'));\n    tree.hidden = v !== 'tree'; $('raw').hidden = v !== 'raw'; $('error').hidden = v !== 'error';\n    $('results').hidden = v !== 'tree' || !search.q;\n    if (v === 'raw') showRaw();\n    status();\n  }\n  function showTree() { setView('tree'); build(); render(); tree.focus({ preventScroll: true }); }\n  function showError() {\n    const e = doc.error, lines = doc.text.split('\\n'), from = Math.max(0, e.at.line - 4), to = Math.min(lines.length, e.at.line + 2);\n    $('errMsg').textContent = 'Line ' + fmt(e.at.line) + ', column ' + fmt(e.at.col) + ': ' + e.msg;\n    const ctx = $('errCtx'); ctx.textContent = '';\n    const w = String(to).length;\n    for (let i = from; i < to; i++) {\n      let line = lines[i].replace(/\\r$/, ''), col0 = 0;\n      if (line.length > 140) { col0 = i + 1 === e.at.line ? Math.max(0, e.at.col - 70) : 0; line = (col0 ? '…' : '') + line.slice(col0, col0 + 140) + '…'; }\n      const span = h('span', i + 1 === e.at.line ? 'bad' : '', String(i + 1).padStart(w) + ' │ ' + line);\n      ctx.append(span, '\\n');\n      if (i + 1 === e.at.line) ctx.append(h('span', null, ' '.repeat(w) + ' │ ' + ' '.repeat(e.at.col - 1 - col0 + (col0 ? 1 : 0)) + '^ here'), '\\n');\n    }\n    $('warn').hidden = true;\n    setView('error');\n    $('errRaw').focus();\n  }\n\n  /* ---------- the tree: which rows can be seen ---------- */\n  function build() {\n    flat = [];\n    const st = [{ node: doc.root, key: null, arr: false, depth: 0, path: '$', ptr: '' }];\n    while (st.length) {\n      const r = st.pop();\n      flat.push(r);\n      if (r.group) {\n        if (!(groupsOpen.get(r.node) || new Set()).has(r.group[0])) continue;\n        for (let i = r.group[1]; i >= r.group[0]; i--) st.push(child(r.node, i, r.depth + 1, r.path, r.ptr));\n        continue;\n      }\n      if (!isBox(r.node) || !open.has(r.node)) continue;\n      const n = kids(r.node);\n      if (n > GROUP) {\n        for (let g = Math.floor((n - 1) / GROUP) * GROUP; g >= 0; g -= GROUP) st.push({ node: r.node, group: [g, Math.min(n, g + GROUP) - 1], depth: r.depth + 1, path: r.path, ptr: r.ptr });\n      } else for (let i = n - 1; i >= 0; i--) st.push(child(r.node, i, r.depth + 1, r.path, r.ptr));\n    }\n    rowsEl.style.height = flat.length * RH + 'px';\n    cur = Math.min(cur, flat.length - 1);\n  }\n  function child(node, i, depth, path, ptr) {\n    const arr = node.t === 'a', key = arr ? i : node.keys[i];\n    return { node: node.vals[i], key, idx: i, arr, depth, parent: node, path: path + J.step(String(key), arr), ptr: ptr + J.pointerStep(key), dup: !arr && node.dup && node.dup.has(i) };\n  }\n  const isOpen = r => r.group ? (groupsOpen.get(r.node) || new Set()).has(r.group[0]) : isBox(r.node) && kids(r.node) > 0 && open.has(r.node);\n  function toggle(r, want) {\n    if (r.group) {\n      const s = groupsOpen.get(r.node) || new Set(); groupsOpen.set(r.node, s);\n      if (want === undefined ? !s.has(r.group[0]) : want) s.add(r.group[0]); else s.delete(r.group[0]);\n    } else if (isBox(r.node)) { if (want === undefined ? !open.has(r.node) : want) open.add(r.node); else open.delete(r.node); }\n    else return;\n    build(); render();\n  }\n  /* opens everything below a node, up to a limit; returns false when it stopped at the limit */\n  function openAll(node, on) {\n    let n = 0;\n    const st = [node];\n    while (st.length) {\n      const x = st.pop();\n      if (!isBox(x)) continue;\n      if (on) { open.add(x); n += kids(x); if (kids(x) > GROUP) { const s = new Set(); for (let g = 0; g < kids(x); g += GROUP) s.add(g); groupsOpen.set(x, s); } }\n      else { open.delete(x); groupsOpen.delete(x); }\n      if (on && n > EXPAND_ALL_MAX) return false;\n      for (const v of x.vals) if (isBox(v)) st.push(v);\n    }\n    return true;\n  }\n\n  /* ---------- drawing ---------- */\n  let raf = 0;\n  function schedule() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; render(); }); }\n  function marked(text, q, cls) {\n    const span = h('span', cls);\n    if (!q) { span.textContent = text; return span; }\n    const low = text.toLowerCase(); let i = 0, j;\n    while ((j = low.indexOf(q, i)) >= 0) { span.append(text.slice(i, j), h('mark', null, text.slice(j, j + q.length))); i = j + q.length; }\n    span.append(text.slice(i));\n    return span;\n  }\n  function render() {\n    if (!doc || !doc.root || tree.hidden) return;\n    const top = tree.scrollTop, height = tree.clientHeight;\n    const r0 = Math.max(0, Math.floor(top / RH) - 5), r1 = Math.min(flat.length - 1, Math.ceil((top + height) / RH) + 5);\n    const frag = document.createDocumentFragment(), q = search.q.toLowerCase(), curHit = search.hits[search.at];\n    for (let i = r0; i <= r1; i++) {\n      const r = flat[i], el = h('div', 'trow' + (i === cur ? ' cur' : ''));\n      el.style.top = i * RH + 'px'; el.style.paddingLeft = (4 + r.depth * 16) + 'px';\n      el.dataset.i = i; el.id = 'row-' + i;\n      el.setAttribute('role', 'treeitem'); el.setAttribute('aria-level', String(r.depth + 1));\n      if (i === cur) el.setAttribute('aria-selected', 'true');\n      const box = r.group || (isBox(r.node) && kids(r.node) > 0);\n      if (box) el.setAttribute('aria-expanded', String(isOpen(r)));\n      el.append(h('span', 'tog', box ? (isOpen(r) ? '▾' : '▸') : ''));\n      if (r.group) {\n        el.append(h('span', 'grp', '[' + fmt(r.group[0]) + ' … ' + fmt(r.group[1]) + ']'));\n      } else {\n        if (r.key !== null) { el.append(r.arr ? h('span', 'muted', String(r.key)) : marked(r.key, q, 'k')); el.append(h('span', 'muted', ': ')); }\n        else el.append(h('span', 'muted', doc.name + '  '));\n        const n = r.node;\n        if (isBox(n)) el.append(h('span', 'sum', !kids(n) ? (n.t === 'a' ? '[]' : '{}') : open.has(n) ? (n.t === 'a' ? '[' + kids(n) + ']' : '{' + kids(n) + '}') : preview(n)));\n        else el.append(marked(preview(n, 300), q, n.t));\n        if (n.t === 'n' && J.inexact(n.v)) el.append(h('span', 'flag', 'too large to be exact in most programs'));\n        if (r.dup) el.append(h('span', 'flag', 'duplicate'));\n        if (search.set.has(n) && curHit && curHit.node === n) el.classList.add('hitcur');\n        if (n.t === 's' && n.v.length > 60) el.title = n.v.length > 2000 ? n.v.slice(0, 2000) + '…' : n.v;\n      }\n      frag.append(el);\n    }\n    rowsEl.textContent = ''; rowsEl.append(frag);\n    tree.setAttribute('aria-activedescendant', 'row-' + cur);\n    status();\n  }\n  tree.addEventListener('scroll', schedule, { passive: true });\n  new ResizeObserver(() => schedule()).observe(tree);\n\n  function status() {\n    if (!doc) return;\n    $('stFile').textContent = doc.name;\n    $('stInfo').textContent = size(doc.text.length) + (doc.root ? ' · ' + plural(doc.count, 'value') : doc.error ? ' · not valid JSON' : '');\n    const r = flat[cur];\n    $('stPath').textContent = !tree.hidden && r ? (r.group ? r.path + '[' + r.group[0] + '…' + r.group[1] + ']' : r.path) : '';\n  }\n\n  /* ---------- moving ---------- */\n  function go(i, keepView) {\n    if (!flat.length) return;\n    cur = Math.max(0, Math.min(flat.length - 1, i));\n    if (!keepView) {\n      const y = cur * RH, top = tree.scrollTop, vis = tree.clientHeight;\n      if (y < top) tree.scrollTop = y; else if (y + RH > top + vis) tree.scrollTop = y + RH - vis;\n    }\n    render();\n  }\n  function parentRow(i) { const d = flat[i].depth; for (let k = i - 1; k >= 0; k--) if (flat[k].depth < d) return k; return i; }\n  rowsEl.addEventListener('pointerdown', e => {\n    const el = e.target.closest('.trow'); if (!el) return;\n    const i = +el.dataset.i;\n    go(i, true); tree.focus({ preventScroll: true });\n    if (e.button !== 0) return;\n    /* rows are redrawn on every click, so a double-click is noticed here rather than by the dblclick event */\n    const now = Date.now(), dbl = lastDown.i === i && now - lastDown.t < 450;\n    lastDown = dbl ? { i: -1, t: 0 } : { i, t: now };\n    if (e.target.classList.contains('tog') || dbl) toggle(flat[i]);\n  });\n  let lastDown = { i: -1, t: 0 };\n  rowsEl.addEventListener('contextmenu', e => { const el = e.target.closest('.trow'); if (!el) return; e.preventDefault(); go(+el.dataset.i, true); showMenu(e.clientX, e.clientY); });\n\n  tree.addEventListener('keydown', e => {\n    if (!flat.length) return;\n    const r = flat[cur], page = Math.max(1, Math.floor(tree.clientHeight / RH) - 1), ctrl = e.ctrlKey || e.metaKey;\n    let done = true;\n    if (e.key === 'ArrowDown') go(cur + 1);\n    else if (e.key === 'ArrowUp') go(cur - 1);\n    else if (e.key === 'PageDown') go(cur + page);\n    else if (e.key === 'PageUp') go(cur - page);\n    else if (e.key === 'Home') go(0);\n    else if (e.key === 'End') go(flat.length - 1);\n    else if (e.key === 'ArrowRight') { if ((r.group || isBox(r.node)) && !isOpen(r)) toggle(r, true); else if (isOpen(r)) go(cur + 1); }\n    else if (e.key === 'ArrowLeft') { if (isOpen(r)) toggle(r, false); else go(parentRow(cur)); }\n    else if ((e.key === 'Enter' || e.key === ' ') && !ctrl) toggle(r);\n    else if (e.key === '*') { if (!r.group && !openAll(r.node, true)) toast('Opened the first ' + fmt(EXPAND_ALL_MAX) + ' values'); build(); render(); }\n    else if (ctrl && e.shiftKey && e.key.toLowerCase() === 'c') cmd('path');\n    else if (ctrl && !e.shiftKey && e.key.toLowerCase() === 'c' && !window.getSelection().toString()) cmd('value');\n    else if (e.key === 'ContextMenu' || (e.shiftKey && e.key === 'F10')) { const el = document.getElementById('row-' + cur), b = el ? el.getBoundingClientRect() : tree.getBoundingClientRect(); showMenu(b.left + 40, b.bottom); }\n    else if (!ctrl && !e.altKey && e.key.toLowerCase() === 'r') setView('raw');\n    else done = false;\n    if (done) e.preventDefault();\n  });\n\n  /* ---------- copying, and the menu ---------- */\n  function valueText(r) {\n    try {\n      if (r.group) return J.stringify({ t: 'a', vals: r.node.t === 'a' ? r.node.vals.slice(r.group[0], r.group[1] + 1) : [] }, 2);\n      return r.node.t === 's' ? r.node.v : J.stringify(r.node, 2);\n    } catch (e) { toast('This value is nested too deeply to copy as text.', 3500); return null; }\n  }\n  function cmd(c) {\n    const r = flat[cur]; if (!r) return;\n    if (c === 'value') { const t = valueText(r); if (t !== null) copyText(t, r.node.t === 's' ? 'the text' : 'the value'); }\n    else if (c === 'path') copyText(r.path, 'the path ' + (r.path.length > 60 ? r.path.slice(0, 60) + '…' : r.path));\n    else if (c === 'pointer') copyText(r.ptr || '', 'the JSON Pointer ' + (r.ptr || '(the whole document)'));\n    else if (c === 'key') { if (r.key === null || r.group) toast('This item has no key'); else copyText(String(r.key), 'the key'); }\n    else if (c === 'expand') { if (!r.group && !openAll(r.node, true)) toast('Opened the first ' + fmt(EXPAND_ALL_MAX) + ' values'); else if (r.group) toggle(r, true); build(); render(); }\n    else if (c === 'collapse') { if (!r.group) openAll(r.node, false); else toggle(r, false); build(); render(); }\n  }\n  const menu = $('menu');\n  function showMenu(x, y) {\n    menu.hidden = false;\n    const w = menu.offsetWidth, hh = menu.offsetHeight;\n    menu.style.left = Math.max(4, Math.min(x, innerWidth - w - 4)) + 'px'; menu.style.top = Math.max(4, Math.min(y, innerHeight - hh - 4)) + 'px';\n    menu.querySelector('button').focus();\n  }\n  function hideMenu(back) { if (menu.hidden) return; menu.hidden = true; if (back) tree.focus({ preventScroll: true }); }\n  menu.addEventListener('click', e => { const b = e.target.closest('[data-cmd]'); if (!b) return; hideMenu(true); cmd(b.dataset.cmd); });\n  menu.addEventListener('keydown', e => {\n    const items = [...menu.querySelectorAll('button')], i = items.indexOf(document.activeElement);\n    if (e.key === 'ArrowDown') items[(i + 1) % items.length].focus();\n    else if (e.key === 'ArrowUp') items[(i - 1 + items.length) % items.length].focus();\n    else if (e.key === 'Home') items[0].focus();\n    else if (e.key === 'End') items[items.length - 1].focus();\n    else if (e.key === 'Escape' || e.key === 'Tab') hideMenu(true);\n    else return;\n    e.preventDefault(); e.stopPropagation();\n  });\n  document.addEventListener('pointerdown', e => { if (!menu.contains(e.target)) hideMenu(false); });\n\n  /* ---------- search ---------- */\n  function runSearch(q) {\n    search = { q, hits: [], set: new Set(), at: -1, total: 0 };\n    if (!q || !doc || !doc.root) { showResults(); render(); return; }\n    const low = q.toLowerCase(), MAX = 5000;\n    /* walk the whole document, keeping the chain of parents so a match can be revealed */\n    const st = [{ node: doc.root, path: '$', up: null }];\n    const chain = x => { const c = []; for (let e = x; e.up; e = e.up) c.unshift([e.up.node, e.idx]); return c; };\n    while (st.length) {\n      const x = st.pop(), n = x.node;\n      const hit = (typeof x.key === 'string' && x.key.toLowerCase().includes(low)) || (n.t === 's' ? n.v.toLowerCase().includes(low) : !isBox(n) && preview(n).toLowerCase().includes(low));\n      if (hit) {\n        search.total++;\n        if (search.hits.length < MAX) { search.hits.push({ node: n, path: x.path, chain: chain(x), key: x.key }); search.set.add(n); }\n      }\n      if (isBox(n)) for (let i = n.vals.length - 1; i >= 0; i--) {\n        const arr = n.t === 'a', key = arr ? i : n.keys[i];\n        st.push({ node: n.vals[i], key, idx: i, up: x, path: x.path + J.step(String(key), arr) });\n      }\n    }\n    showResults();\n    if (search.hits.length) gotoHit(0); else render();\n  }\n  function showResults() {\n    const list = $('rlist'); list.textContent = '';\n    $('results').hidden = !search.q || tree.hidden;\n    $('hits').textContent = !search.q ? '' : search.total ? (search.at + 1) + ' of ' + fmt(search.total) : 'No matches';\n    $('rcount').textContent = !search.q ? '' : plural(search.total, 'match', 'matches') + (search.total > search.hits.length ? ' (first ' + fmt(search.hits.length) + ' listed)' : '');\n    const q = search.q.toLowerCase(), frag = document.createDocumentFragment();\n    search.hits.slice(0, 1000).forEach((hit, k) => {\n      const it = h('div', 'ritem'); it.dataset.k = k; it.setAttribute('role', 'option'); it.id = 'hit-' + k;\n      it.append(marked(hit.path, q, 'rp'), marked(isBox(hit.node) ? preview(hit.node) : preview(hit.node, 120), q, 'rv'));\n      frag.append(it);\n    });\n    if (search.hits.length > 1000) frag.append(h('div', 'ritem muted', 'Use ↑ and ↓ to step through the rest.'));\n    list.append(frag);\n  }\n  function gotoHit(k) {\n    if (!search.hits.length) return;\n    search.at = (k + search.hits.length) % search.hits.length;\n    const hit = search.hits[search.at];\n    for (const [p, i] of hit.chain) {                 /* open each parent, and the group holding the child */\n      open.add(p);\n      if (kids(p) > GROUP) { const s = groupsOpen.get(p) || new Set(); s.add(Math.floor(i / GROUP) * GROUP); groupsOpen.set(p, s); }\n    }\n    build();\n    const i = flat.findIndex(r => !r.group && r.node === hit.node && r.path === hit.path);\n    if (i >= 0) { cur = i; tree.scrollTop = Math.max(0, i * RH - tree.clientHeight / 2); }\n    render();\n    $('hits').textContent = (search.at + 1) + ' of ' + fmt(search.total);\n    for (const el of $('rlist').querySelectorAll('.ritem.on')) el.classList.remove('on');\n    const it = document.getElementById('hit-' + search.at);\n    if (it) { it.classList.add('on'); it.scrollIntoView({ block: 'nearest' }); $('rlist').setAttribute('aria-activedescendant', it.id); }\n  }\n  function clearSearch(redraw) { search = { q: '', hits: [], set: new Set(), at: -1, total: 0 }; $('search').value = ''; $('hits').textContent = ''; $('results').hidden = true; if (redraw) render(); }\n  let st = 0;\n  $('search').addEventListener('input', () => { clearTimeout(st); st = setTimeout(() => runSearch($('search').value.trim()), 200); });\n  $('search').addEventListener('keydown', e => {\n    if (e.key === 'Enter') { e.preventDefault(); clearTimeout(st); if ($('search').value.trim() !== search.q) runSearch($('search').value.trim()); else gotoHit(search.at + (e.shiftKey ? -1 : 1)); }\n    else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); if ($('search').value) clearSearch(true); else tree.focus(); }\n    else if (e.key === 'ArrowDown') { e.preventDefault(); tree.focus(); }\n  });\n  $('prevBtn').onclick = () => gotoHit(search.at - 1);\n  $('nextBtn').onclick = () => gotoHit(search.at + 1);\n  $('rlist').addEventListener('click', e => { const it = e.target.closest('[data-k]'); if (it) { gotoHit(+it.dataset.k); tree.focus({ preventScroll: true }); } });\n  $('rlist').addEventListener('keydown', e => {\n    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); gotoHit(search.at + (e.key === 'ArrowDown' ? 1 : -1)); }\n    else if (e.key === 'Enter') { e.preventDefault(); tree.focus(); }\n  });\n  $('rclose').onclick = () => { clearSearch(true); tree.focus(); };\n\n  /* ---------- raw text ---------- */\n  const raw = $('rawText'), gutter = $('gutter'), LH = 18;\n  function showRaw() {\n    let text = doc.text;\n    if (rawMode === 'pretty' && doc.root) { try { text = J.stringify(doc.root, 2); } catch (e) { toast('Too deeply nested to format; showing it as in the file.', 3500); rawMode = 'file'; } }\n    $('asFile').setAttribute('aria-pressed', String(rawMode === 'file')); $('asPretty').setAttribute('aria-pressed', String(rawMode === 'pretty'));\n    $('asPretty').disabled = !doc.root;\n    if (raw.value !== text) raw.value = text;\n    raw.lines = 1; for (let i = 0; i < text.length; i++) if (text.charCodeAt(i) === 10) raw.lines++;\n    $('rawInfo').textContent = plural(raw.lines, 'line') + ' · ' + size(text.length);\n    numbers();\n  }\n  function numbers() {\n    const first = Math.floor(raw.scrollTop / LH), count = Math.ceil(raw.clientHeight / LH) + 1, out = [];\n    for (let k = first + 1; k <= Math.min(raw.lines, first + count); k++) out.push(k);\n    gutter.textContent = out.join('\\n'); gutter.style.paddingTop = (6 - raw.scrollTop % LH) + 'px';\n  }\n  raw.addEventListener('scroll', numbers, { passive: true });\n  new ResizeObserver(() => { if (!$('raw').hidden) numbers(); }).observe(raw);\n  raw.addEventListener('keydown', e => { if (e.key === 'Escape' && doc.root) { e.preventDefault(); showTree(); } });\n  /* shows a character position in the raw text: scrolled to, and selected */\n  function revealRaw(pos) {\n    rawMode = 'file'; setView('raw');\n    const at = J.where(doc.text, pos);\n    raw.focus(); raw.setSelectionRange(pos, Math.min(doc.text.length, pos + 1));\n    raw.scrollTop = Math.max(0, (at.line - 4) * LH);\n    raw.scrollLeft = Math.max(0, (at.col - 40) * 7.2);\n    numbers();\n  }\n  $('asFile').onclick = () => { rawMode = 'file'; showRaw(); };\n  $('asPretty').onclick = () => { rawMode = 'pretty'; showRaw(); raw.scrollTop = 0; numbers(); };\n  $('copyRaw').onclick = () => copyText(raw.value, plural(raw.lines, 'line'));\n  $('errRaw').onclick = () => revealRaw(doc.error.pos);\n\n  /* ---------- toolbar and keys ---------- */\n  async function openDialog() {\n    try { const f = await Host.openFile({ title: 'Open JSON', types: ['.json'] }); if (f) load(f); }\n    catch (e) { toast(e.message, 4000); }\n  }\n  async function pasteDialog() {\n    $('pasteText').value = '';\n    if (await dialog('pasteDlg', '#pasteText') === 'ok' && $('pasteText').value.trim()) load({ name: 'Pasted text', path: null, text: $('pasteText').value });\n  }\n  $('openBtn').onclick = $('openBig').onclick = openDialog;\n  $('pasteBtn').onclick = $('pasteBig').onclick = pasteDialog;\n  $('treeBtn').onclick = () => { if (doc.root) showTree(); else showError(); };\n  $('rawBtn').onclick = () => { setView('raw'); raw.focus(); };\n  $('expandBtn').onclick = () => { if (!openAll(doc.root, true)) toast('Opened the first ' + fmt(EXPAND_ALL_MAX) + ' values: the file is large'); showTree(); };\n  $('collapseBtn').onclick = () => { openAll(doc.root, false); open.add(doc.root); cur = 0; tree.scrollTop = 0; showTree(); };\n  $('helpBtn').onclick = () => dialog('helpDlg');\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => {\n    settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto';\n    Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]);\n  };\n  document.addEventListener('keydown', e => {\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    if (ctrl && !e.shiftKey && k === 'o') { e.preventDefault(); openDialog(); }\n    else if (ctrl && !e.shiftKey && k === 'f' && doc && doc.root) { e.preventDefault(); if (tree.hidden) showTree(); $('search').focus(); $('search').select(); }\n    else if (e.key === 'F3' && search.q) { e.preventDefault(); gotoHit(search.at + (e.shiftKey ? -1 : 1)); }\n    else if (e.key === 'F1') { e.preventDefault(); dialog('helpDlg'); }\n  });\n  const app = $('app');\n  app.addEventListener('dragover', e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) { e.preventDefault(); $('main').classList.add('drop'); } });\n  app.addEventListener('dragleave', e => { if (!app.contains(e.relatedTarget)) $('main').classList.remove('drop'); });\n  app.addEventListener('drop', async e => { $('main').classList.remove('drop'); const f = e.dataTransfer && e.dataTransfer.files[0]; if (!f) return; e.preventDefault(); load(await Host.readDropped(f)); });\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    RH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rh')) || 24;\n    const start = Host.startFile();\n    if (start) { try { load(await Host.readPath(start.path, start.name)); } catch (e) { toast('Could not open \"' + start.name + '\": ' + e.message, 5000); } }\n    else $('openBig').focus();\n    window.__jv = { get doc() { return doc; }, get flat() { return flat; }, get cur() { return cur; }, get search() { return search; } };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/json.js": {
   "enc": "text",
   "d": "/* JSON Viewer: a JSON reader that says where a mistake is, keeps keys in file order (and duplicates), and keeps\n   numbers exactly as written. Iterative, so deep nesting cannot overflow the stack. No DOM code here.\n   Nodes: { t: 'o', keys: [], vals: [], dup: Set|null } object, { t: 'a', vals: [] } array,\n          { t: 's', v } string, { t: 'n', v: 'as written' } number, { t: 'b', v: true|false }, { t: 'z' } null. */\n(function () {\n  'use strict';\n  const J = window.JSONV = {};\n\n  class ParseError extends Error { constructor(msg, pos) { super(msg); this.pos = pos; } }\n  J.ParseError = ParseError;\n\n  /* line and column (both from 1) of a character position */\n  J.where = function (text, pos) {\n    let line = 1, last = -1;\n    for (let i = 0; i < pos && i < text.length; i++) if (text.charCodeAt(i) === 10) { line++; last = i; }\n    return { line, col: pos - last };\n  };\n\n  const describe = ch => ch === undefined ? 'the end of the file' : ch === '\\n' ? 'a line break' : /\\s/.test(ch) ? 'a space' : '\"' + ch + '\"';\n  const NUM = /-?(0|[1-9]\\d*)(\\.\\d+)?([eE][-+]?\\d+)?/y;\n\n  J.parse = function (text) {\n    let i = 0;\n    const n = text.length, stack = [];\n    let root = null, count = 0;\n    const ws = () => { while (i < n) { const c = text.charCodeAt(i); if (c === 32 || c === 10 || c === 13 || c === 9) i++; else break; } };\n    const err = (msg, at) => { throw new ParseError(msg, at === undefined ? i : at); };\n\n    function str() {\n      const start = i; i++;\n      let out = '', from = i;\n      for (;;) {\n        if (i >= n) err('This string is never closed: the closing \" is missing.', start);\n        const c = text.charCodeAt(i);\n        if (c === 34) { out += text.slice(from, i); i++; return out; }\n        if (c === 92) {\n          out += text.slice(from, i);\n          const e = text[i + 1];\n          if (e === 'u') {\n            const hex = text.slice(i + 2, i + 6);\n            if (!/^[0-9a-fA-F]{4}$/.test(hex)) err('\"\\\\u\" must be followed by four hexadecimal digits.', i);\n            out += String.fromCharCode(parseInt(hex, 16)); i += 6;\n          } else {\n            const map = { '\"': '\"', '\\\\': '\\\\', '/': '/', b: '\\b', f: '\\f', n: '\\n', r: '\\r', t: '\\t' };\n            if (!(e in map)) err('\"\\\\' + (e === undefined ? '' : e) + '\" is not a valid escape in a string.', i);\n            out += map[e]; i += 2;\n          }\n          from = i; continue;\n        }\n        if (c < 32) err(c === 10 ? 'A string cannot run onto the next line: the closing \" is missing.' : 'A control character must be written as an escape inside a string.', i);\n        i++;\n      }\n    }\n    /* reads one value; containers are pushed and filled by the loop below */\n    function value() {\n      ws();\n      const c = text[i];\n      count++;\n      if (c === '{') { i++; return { t: 'o', keys: [], vals: [], dup: null, open: true }; }\n      if (c === '[') { i++; return { t: 'a', vals: [], open: true }; }\n      if (c === '\"') return { t: 's', v: str() };\n      if (c === 't' && text.startsWith('true', i)) { i += 4; return { t: 'b', v: true }; }\n      if (c === 'f' && text.startsWith('false', i)) { i += 5; return { t: 'b', v: false }; }\n      if (c === 'n' && text.startsWith('null', i)) { i += 4; return { t: 'z' }; }\n      if (c === '-' || (c >= '0' && c <= '9')) {\n        NUM.lastIndex = i; const m = NUM.exec(text);\n        if (!m || m[0] === '-') err('This is not a valid number.', i);\n        i += m[0].length;\n        if (/[0-9.eE+\\-]/.test(text[i] || '')) err('This is not a valid number' + (m[0] === '0' || m[0] === '-0' ? ': a number cannot start with 0.' : '.'), i);\n        return { t: 'n', v: m[0] };\n      }\n      if (c === \"'\") err('Strings must use double quotes (\"), not single quotes.');\n      if (c === '}' || c === ']') err('A value is missing before ' + describe(c) + (stack.length ? ' (a comma too many?)' : '') + '.');\n      if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) err('Comments are not allowed in JSON.');\n      if (c === undefined) err(stack.length ? 'The file ends before the ' + (stack[stack.length - 1].t === 'o' ? 'object' : 'array') + ' is closed.' : 'The file is empty.');\n      if (/[A-Za-z_]/.test(c)) { const w = /^[A-Za-z_$][\\w$]*/.exec(text.slice(i, i + 40))[0]; err('\"' + w + '\" is not a JSON value. Text must be in double quotes; the only words allowed are true, false and null.'); }\n      err('Unexpected ' + describe(c) + ': a value was expected here.');\n    }\n\n    ws();\n    let v = value();\n    for (;;) {\n      if (v && v.open) {             /* a container just opened: is it empty? */\n        delete v.open;\n        ws();\n        const close = v.t === 'o' ? '}' : ']';\n        if (text[i] === close) { i++; }\n        else {\n          stack.push(v);\n          if (v.t === 'o') {\n            v.seen = new Set();\n            if (text[i] !== '\"') err(text[i] === undefined ? 'The file ends before the object is closed.' : 'Expected a key in double quotes, but found ' + describe(text[i]) + '.');\n            v.pending = str(); ws();\n            if (text[i] !== ':') err('Expected \":\" after the key \"' + v.pending.slice(0, 40) + '\", but found ' + describe(text[i]) + '.');\n            i++;\n          }\n          v = value(); continue;\n        }\n      }\n      /* v is complete: attach it to its parent */\n      if (!stack.length) { root = v; break; }\n      const p = stack[stack.length - 1];\n      if (p.t === 'o') { if (p.seen.has(p.pending)) (p.dup || (p.dup = new Set())).add(p.keys.length); else p.seen.add(p.pending); p.keys.push(p.pending); p.vals.push(v); delete p.pending; }\n      else p.vals.push(v);\n      ws();\n      const c = text[i];\n      if (c === ',') {\n        i++; ws();\n        if (p.t === 'o') {\n          if (text[i] === '}') err('There is a comma after the last item: remove it.', i);\n          if (text[i] !== '\"') err('Expected a key in double quotes, but found ' + describe(text[i]) + '.');\n          p.pending = str(); ws();\n          if (text[i] !== ':') err('Expected \":\" after the key \"' + p.pending.slice(0, 40) + '\", but found ' + describe(text[i]) + '.');\n          i++;\n        } else if (text[i] === ']') err('There is a comma after the last item: remove it.', i);\n        v = value(); continue;\n      }\n      if ((p.t === 'o' && c === '}') || (p.t === 'a' && c === ']')) { i++; v = stack.pop(); delete v.seen; continue; }\n      if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) err('Comments are not allowed in JSON.');\n      if (c === undefined) err('The file ends before the ' + (p.t === 'o' ? 'object' : 'array') + ' is closed: a \"' + (p.t === 'o' ? '}' : ']') + '\" is missing.');\n      err('Expected \",\" or \"' + (p.t === 'o' ? '}' : ']') + '\" after a value in ' + (p.t === 'o' ? 'an object' : 'an array') + ', but found ' + describe(c) + '.');\n    }\n    ws();\n    if (i < n) err('There is more after the end of the JSON value. A JSON file holds one value; is a comma or a [ ] around them missing?');\n    return { root, count };\n  };\n\n  /* a JavaScript-style path: $.store.book[0][\"first name\"] */\n  const IDENT = /^[A-Za-z_$][\\w$]*$/;\n  J.step = (key, inArray) => inArray ? '[' + key + ']' : IDENT.test(key) ? '.' + key : '[' + JSON.stringify(key) + ']';\n  /* a JSON Pointer (RFC 6901): /store/book/0/first name */\n  J.pointerStep = key => '/' + String(key).replace(/~/g, '~0').replace(/\\//g, '~1');\n\n  /* a node as JSON text; numbers keep how they were written */\n  J.stringify = function (node, indent) {\n    const out = [], pad = d => indent ? '\\n' + ' '.repeat(indent * d) : '';\n    (function w(x, d) {\n      switch (x.t) {\n        case 's': out.push(JSON.stringify(x.v)); break;\n        case 'n': out.push(x.v); break;\n        case 'b': out.push(String(x.v)); break;\n        case 'z': out.push('null'); break;\n        case 'a':\n          if (!x.vals.length) { out.push('[]'); break; }\n          out.push('['); x.vals.forEach((c, k) => { if (k) out.push(','); out.push(pad(d + 1)); w(c, d + 1); }); out.push(pad(d) + ']'); break;\n        case 'o':\n          if (!x.keys.length) { out.push('{}'); break; }\n          out.push('{'); x.keys.forEach((k, j) => { if (j) out.push(','); out.push(pad(d + 1) + JSON.stringify(k) + (indent ? ': ' : ':')); w(x.vals[j], d + 1); }); out.push(pad(d) + '}'); break;\n      }\n    })(node, 0);\n    return out.join('');\n  };\n  /* a number that JavaScript cannot hold exactly */\n  J.inexact = v => { const x = Number(v); return !Number.isFinite(x) || (/^-?\\d+$/.test(v) && !Number.isSafeInteger(x)) || String(x) !== v && /^-?\\d+(\\.\\d+)?$/.test(v) && v.replace(/^-?0*|\\.?0*$/g, '').replace('.', '').length > 15; };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* JSON Viewer */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2563c9; --onaccent: #ffffff; --sel: #d6e4fb; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00;\n  --key: #7a2f8f; --str: #1f6f3a; --num: #1d4fb0; --lit: #9a3a00; --hit: #ffe680; --hitcur: #ffb84d; --errbg: #fde8e8; --errfg: #8a1c1c;\n  --rh: 24px; color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #7aa7ff; --onaccent: #0b1220; --sel: #2c3f63; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00;\n  --key: #e3a6f5; --str: #8fdba5; --num: #9cc2ff; --lit: #ffb98a; --hit: #6b5a12; --hitcur: #9a6316; --errbg: #4a2a2e; --errfg: #ffc9c9;\n  color-scheme: dark;\n}\n@media (pointer: coarse) { :root { --rh: 36px; } }\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; }\n.mono, .rows, textarea, .ctx { font-family: ui-monospace, \"Cascadia Mono\", Consolas, monospace; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled, .field:disabled { opacity: .55; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.btn[aria-pressed=\"true\"] { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.seg { display: inline-flex; }\n.seg .btn:first-child { border-radius: 6px 0 0 6px; }\n.seg .btn:last-child { border-radius: 0 6px 6px 0; margin-left: -1px; }\n.field.grow { flex: 1 1 140px; min-width: 100px; }\n.hits { min-width: 4em; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.warn { padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border-bottom: 1px solid var(--warnedge); }\n.main { flex: 1; display: flex; min-height: 0; position: relative; }\n\n/* the tree: only the rows in sight are in the page */\n.tree { flex: 1; overflow: auto; position: relative; outline-offset: -2px; }\n.rows { position: relative; min-width: 100%; }\n.trow { position: absolute; left: 0; right: 0; height: var(--rh); line-height: var(--rh); white-space: nowrap; padding-right: 12px; cursor: default; }\n.trow.cur { background: var(--sel); }\n.tree:focus .trow.cur { box-shadow: inset 2px 0 0 var(--accent); }\n.trow .tog { display: inline-block; width: 16px; text-align: center; color: var(--muted); cursor: pointer; }\n.trow .k { color: var(--key); }\n.trow .s { color: var(--str); }\n.trow .n { color: var(--num); }\n.trow .b, .trow .z { color: var(--lit); font-weight: 600; }\n.trow .sum { color: var(--muted); }\n.trow .grp { color: var(--muted); font-style: italic; }\n.trow .flag { color: var(--warnfg); background: var(--warnbg); border: 1px solid var(--warnedge); border-radius: 4px; padding: 0 4px; margin-left: 6px; font: 11px \"Segoe UI\", system-ui, sans-serif; }\n.trow mark, .rlist mark { background: var(--hit); color: inherit; border-radius: 2px; }\n.trow.hitcur mark { background: var(--hitcur); }\n\n.results { width: 34%; min-width: 220px; max-width: 460px; border-left: 1px solid var(--line); display: flex; flex-direction: column; background: var(--panel); }\n.rhead { display: flex; align-items: center; justify-content: space-between; padding: 4px 6px 4px 10px; border-bottom: 1px solid var(--line); color: var(--muted); }\n.rlist { flex: 1; overflow: auto; }\n.rlist .ritem { padding: 4px 10px; border-bottom: 1px solid var(--line); cursor: pointer; }\n.rlist .ritem.on { background: var(--sel); }\n.rlist .rp, .rlist .rv { display: block; }\n.rlist .rp { font: 12px ui-monospace, Consolas, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.rlist .rv { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }\n\n.raw { flex: 1; display: flex; flex-direction: column; min-width: 0; }\n.rawbar { display: flex; gap: 8px; align-items: center; padding: 6px 8px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }\n.rawwrap { flex: 1; display: flex; min-height: 0; }\n.gutter { width: 56px; overflow: hidden; background: var(--panel); color: var(--muted); text-align: right; padding: 6px 6px 0 0; font: 12px/18px ui-monospace, Consolas, monospace; white-space: pre; border-right: 1px solid var(--line); }\n.raw textarea { flex: 1; border: 0; resize: none; padding: 6px 8px; font-size: 12px; line-height: 18px; background: var(--bg); color: var(--text); outline-offset: -2px; tab-size: 4; }\n\n.error { flex: 1; overflow: auto; padding: 16px 20px; }\n.error h2 { margin: 0 0 8px; font-size: 17px; color: var(--errfg); }\n.errmsg { font-size: 14px; }\n.ctx { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; overflow: auto; font-size: 12px; line-height: 18px; }\n.ctx .bad { background: var(--errbg); color: var(--errfg); display: inline-block; min-width: 100%; }\n\n.empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; }\n.empty h1 { font-size: 20px; margin: 8px 0 4px; }\n.empty p { margin: 6px 0; }\n.drop { outline: 3px dashed var(--accent); outline-offset: -6px; }\n\n.status { display: flex; gap: 14px; padding: 3px 10px; border-top: 1px solid var(--line); background: var(--panel); color: var(--muted); white-space: nowrap; overflow: hidden; min-height: 24px; }\n.status .pathinfo { flex: 1; overflow: hidden; text-overflow: ellipsis; color: var(--text); font-family: ui-monospace, Consolas, monospace; font-size: 12px; }\n\n.menu { position: fixed; z-index: 30; background: var(--bg); border: 1px solid var(--edge); border-radius: 8px; padding: 4px; box-shadow: 0 8px 24px rgba(0,0,0,.25); min-width: 190px; }\n.menu button { display: block; width: 100%; text-align: left; font: inherit; color: var(--text); background: none; border: 0; padding: 6px 10px; border-radius: 4px; cursor: pointer; }\n.menu button:hover, .menu button:focus { background: var(--sel); outline: none; }\n.menu hr { border: 0; border-top: 1px solid var(--line); margin: 4px 0; }\n@media (pointer: coarse) { .menu button { padding: 10px 12px; } }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 280px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg.wide { width: 640px; max-width: 100%; }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg textarea { width: 100%; font-size: 12px; background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; padding: 6px; }\n.dlg .acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.keys { border-collapse: collapse; }\n.keys td { padding: 3px 8px 3px 0; vertical-align: top; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n\n.toast { position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (forced-colors: active) { .trow.cur { outline: 2px solid Highlight; } .trow mark { background: Mark; color: MarkText; } }\n"
  }
 }
}