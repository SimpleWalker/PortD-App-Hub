{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "markdown-editor",
 "name": "Markdown Editor",
 "version": "1.0.0",
 "description": "Write Markdown with a live preview: toolbar and shortcuts, pictures from the drive, safe links, and Export as HTML.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 960,
 "height": 600,
 "singleInstance": false,
 "fileTypes": [
  {
   "ext": ".md",
   "name": "Markdown document",
   "icon": "glyph:notepad"
  },
  {
   "ext": ".markdown",
   "name": "Markdown document",
   "icon": "glyph:notepad"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect x=\"2\" y=\"6\" width=\"28\" height=\"20\" rx=\"3.5\" fill=\"#2b4fa8\"/><path d=\"M6.5 21V11h2.6l3 3.8 3-3.8h2.6v10h-2.6v-6.2l-3 3.8-3-3.8V21z\" fill=\"#fff\"/><path d=\"M23 11v6h-2.6l3.9 4.6 3.9-4.6h-2.6v-6z\" fill=\"#ffd36b\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"markdown-editor\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Markdown Editor</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"File and view\">\n    <button id=\"newBtn\" class=\"btn\" title=\"New document\">New</button>\n    <button id=\"openBtn\" class=\"btn\" title=\"Open (Ctrl+O)\">Open…</button>\n    <button id=\"saveBtn\" class=\"btn\" title=\"Save (Ctrl+S)\">Save</button>\n    <button id=\"saveAsBtn\" class=\"btn\" title=\"Save as (Ctrl+Shift+S)\">Save as…</button>\n    <button id=\"exportBtn\" class=\"btn\" title=\"Save the preview as a web page\">Export as HTML…</button>\n    <span class=\"grow\"></span>\n    <span class=\"seg\" role=\"group\" aria-label=\"View (Ctrl+Shift+E)\">\n      <button class=\"btn\" data-view=\"source\" aria-pressed=\"false\" title=\"Source only\">Source</button><button class=\"btn\" data-view=\"split\" aria-pressed=\"true\" title=\"Source and preview side by side\">Split</button><button class=\"btn\" data-view=\"preview\" aria-pressed=\"false\" title=\"Preview only\">Preview</button>\n    </span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Help and shortcuts (F1)\" aria-label=\"Help\">?</button>\n  </div>\n  <div class=\"bar fmt\" id=\"fmtBar\" role=\"toolbar\" aria-label=\"Formatting\">\n    <button class=\"btn icon\" data-cmd=\"bold\" title=\"Bold (Ctrl+B)\" aria-label=\"Bold\"><b>B</b></button>\n    <button class=\"btn icon\" data-cmd=\"italic\" title=\"Italic (Ctrl+I)\" aria-label=\"Italic\"><i>I</i></button>\n    <button class=\"btn icon\" data-cmd=\"strike\" title=\"Strikethrough\" aria-label=\"Strikethrough\"><s>S</s></button>\n    <button class=\"btn icon\" data-cmd=\"heading\" title=\"Heading: # → ## → ### → none (Ctrl+Shift+H)\" aria-label=\"Heading\">H</button>\n    <button class=\"btn icon\" data-cmd=\"code\" title=\"Code (Ctrl+E)\" aria-label=\"Code\"><span class=\"mono\">&lt;/&gt;</span></button>\n    <span class=\"sep\"></span>\n    <button class=\"btn icon\" data-cmd=\"ul\" title=\"Bulleted list (Ctrl+Shift+8)\" aria-label=\"Bulleted list\">•≡</button>\n    <button class=\"btn icon\" data-cmd=\"ol\" title=\"Numbered list (Ctrl+Shift+7)\" aria-label=\"Numbered list\">1≡</button>\n    <button class=\"btn icon\" data-cmd=\"task\" title=\"Checklist (Ctrl+Shift+9)\" aria-label=\"Checklist\">☑</button>\n    <button class=\"btn icon\" data-cmd=\"quote\" title=\"Quote\" aria-label=\"Quote\">❝</button>\n    <span class=\"sep\"></span>\n    <button class=\"btn\" data-cmd=\"link\" title=\"Link (Ctrl+K)\">Link</button>\n    <button class=\"btn\" data-cmd=\"picture\" title=\"Insert a picture from the drive\">Picture…</button>\n    <button class=\"btn\" data-cmd=\"table\" title=\"Insert a table\">Table</button>\n    <button class=\"btn\" data-cmd=\"codeblock\" title=\"Insert a code block\">Code block</button>\n    <button class=\"btn icon\" data-cmd=\"hr\" title=\"Horizontal line\" aria-label=\"Horizontal line\">―</button>\n  </div>\n  <div id=\"banner\" class=\"banner\" role=\"alert\" hidden></div>\n  <div id=\"panes\" class=\"panes split\">\n    <textarea id=\"src\" spellcheck=\"true\" aria-label=\"Markdown source\" placeholder=\"Write here. # Heading, **bold**, *italic*, - list, [link](https://…)\"></textarea>\n    <div id=\"prev\" class=\"preview\" tabindex=\"0\" role=\"document\" aria-label=\"Preview\"></div>\n  </div>\n  <div class=\"status\" aria-live=\"polite\"><span id=\"stFile\"></span><span id=\"stState\"></span><span id=\"stPos\"></span><span id=\"stWords\"></span></div>\n</div>\n\n<div id=\"askDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"alertdialog\" aria-modal=\"true\" aria-labelledby=\"askTitle\" aria-describedby=\"askMsg\">\n    <h2 id=\"askTitle\"></h2>\n    <p id=\"askMsg\"></p>\n    <div class=\"acts\" id=\"askActs\"></div>\n  </div>\n</div>\n\n<div id=\"linkDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"linkTitle\">\n    <h2 id=\"linkTitle\">Link</h2>\n    <label class=\"frow\">Text <input id=\"linkText\" class=\"field\"></label>\n    <label class=\"frow\">Address <input id=\"linkUrl\" class=\"field\" placeholder=\"https://… , mailto:… or #heading\"></label>\n    <p id=\"linkErr\" class=\"err\" role=\"alert\"></p>\n    <div class=\"acts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button class=\"btn primary\" data-act=\"ok\">Insert</button></div>\n  </div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\"><h2>Copy</h2><textarea id=\"copyText\" readonly rows=\"6\"></textarea><div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div></div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Markdown Editor</h2>\n    <div class=\"cols\">\n      <table class=\"keys\">\n        <tr><th colspan=\"2\">Keys</th></tr>\n        <tr><td>Ctrl+O / Ctrl+S</td><td>Open / Save</td></tr>\n        <tr><td>Ctrl+Shift+S</td><td>Save as</td></tr>\n        <tr><td>Ctrl+B / Ctrl+I</td><td>Bold / italic</td></tr>\n        <tr><td>Ctrl+K</td><td>Link</td></tr>\n        <tr><td>Ctrl+E</td><td>Code</td></tr>\n        <tr><td>Ctrl+Shift+H</td><td>Heading level</td></tr>\n        <tr><td>Ctrl+Shift+7 / 8 / 9</td><td>Numbered list / bullets / checklist</td></tr>\n        <tr><td>Enter in a list</td><td>Next item (twice ends the list)</td></tr>\n        <tr><td>Tab / Shift+Tab in a list</td><td>Indent / outdent the item</td></tr>\n        <tr><td>Esc, then Tab</td><td>Leave the text box</td></tr>\n        <tr><td>Ctrl+Shift+E</td><td>Source → Split → Preview</td></tr>\n        <tr><td>F1</td><td>This help</td></tr>\n      </table>\n      <table class=\"keys\">\n        <tr><th colspan=\"2\">Markdown</th></tr>\n        <tr><td># Title, ## Part</td><td>Headings</td></tr>\n        <tr><td>**bold** *italic*</td><td>Emphasis</td></tr>\n        <tr><td>~~gone~~ `code`</td><td>Struck out, code</td></tr>\n        <tr><td>- item, 1. item</td><td>Lists</td></tr>\n        <tr><td>- [ ] task</td><td>Checklist</td></tr>\n        <tr><td>&gt; quoted</td><td>Quote</td></tr>\n        <tr><td>[text](https://…)</td><td>Link</td></tr>\n        <tr><td>![text](picture.png)</td><td>Picture</td></tr>\n        <tr><td>| a | b |</td><td>Table</td></tr>\n        <tr><td>``` … ```</td><td>Code block</td></tr>\n        <tr><td>---</td><td>Line</td></tr>\n      </table>\n    </div>\n    <p class=\"muted small\">HTML written in the text is shown as text, never run. Only web and email links can be followed.</p>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/markdown.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Markdown Editor: the window. Source, split and preview views; a formatting toolbar and shortcuts; pictures from the\n   drive; links that can only open the web or email; Export as HTML; and drafts that survive a closed window. */\n(function () {\n  'use strict';\n  const $ = id => document.getElementById(id);\n  const src = $('src'), prev = $('prev'), panes = $('panes');\n  const P = window.PortD && typeof window.PortD === 'object' ? window.PortD : null;\n  const IMG = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', svg: 'image/svg+xml', bmp: 'image/bmp' };\n  const PIC_TYPES = Object.keys(IMG).map(x => '.' + x);\n  const WIN = Math.random().toString(36).slice(2, 10);          /* this window's draft name */\n\n  let settings = { theme: 'auto', view: 'split' };\n  /* the document: path is null for a new one; granted is whether this window may write to path */\n  let file = { name: 'Untitled.md', path: null, granted: false, eol: '\\n' }, saved = '', dirty = false;\n\n  /* ---------- small helpers ---------- */\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2400); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  const extOf = n => { const m = /\\.([^.\\\\/]+)$/.exec(n || ''); return m ? m[1].toLowerCase() : ''; };\n  const base = p => String(p).split(/[\\\\/]/).pop();\n  const stem = n => n.replace(/\\.[^.]+$/, '');\n  /* drive paths */\n  const Path = {\n    norm(p) { const parts = []; for (const s of String(p).replace(/\\//g, '\\\\').split('\\\\')) { if (!s || s === '.') continue; if (s === '..') { if (parts.length > 1) parts.pop(); } else parts.push(s); } return parts.join('\\\\'); },\n    dir(p) { return p.slice(0, p.lastIndexOf('\\\\')); },\n    abs(ref, from) { return /^[a-z]:[\\\\/]/i.test(ref) ? Path.norm(ref) : from ? Path.norm(Path.dir(from) + '\\\\' + ref) : null; },\n    rel(target, from) {\n      const a = Path.dir(from).split('\\\\'), b = target.split('\\\\');\n      if (a[0].toLowerCase() !== b[0].toLowerCase()) return target.replace(/\\\\/g, '/');\n      let k = 0; while (k < a.length && k < b.length - 1 && a[k].toLowerCase() === b[k].toLowerCase()) k++;\n      return '../'.repeat(a.length - k) + b.slice(k).join('/');\n    }\n  };\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea, select')].filter(e => !e.disabled && e.offsetParent);\n    (first ? ov.querySelector(first) : focusables()[0]).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        else if (e.key === 'Enter' && e.target.tagName === 'INPUT' && ov.querySelector('[data-act=ok]')) { e.preventDefault(); done('ok'); }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n    });\n  }\n  /* an in-app question: buttons [{ label, act, primary, danger }]; resolves the act, or 'cancel' */\n  function ask(title, msg, buttons) {\n    $('askTitle').textContent = title; $('askMsg').textContent = msg;\n    const acts = $('askActs'); acts.textContent = '';\n    for (const b of buttons) { const el = h('button', 'btn' + (b.primary ? ' primary' : '') + (b.danger ? ' danger' : ''), b.label); el.dataset.act = b.act; acts.append(el); }\n    return dialog('askDlg', '#askActs .primary');\n  }\n\n  /* ---------- the document ---------- */\n  const text = () => src.value;\n  function setDoc(t, f, isDirty) {\n    file = Object.assign({ name: 'Untitled.md', path: null, granted: false, eol: '\\n' }, f);\n    file.eol = /\\r\\n/.test(t) ? '\\r\\n' : '\\n';\n    src.value = t.replace(/\\r\\n/g, '\\n');\n    saved = isDirty ? null : src.value; dirty = !!isDirty;\n    src.setSelectionRange(0, 0); src.scrollTop = 0; prev.scrollTop = 0;\n    changed(true);\n  }\n  function changed(now) {\n    dirty = saved === null || src.value !== saved;\n    const title = (dirty ? '*' : '') + file.name + ' - Markdown Editor';\n    if (document.title !== title) Host.setTitle(title);\n    $('stFile').textContent = file.path || file.name;\n    $('stState').textContent = dirty ? 'Unsaved changes' : file.path ? 'Saved' : '';\n    $('stState').classList.toggle('dirty', dirty);\n    clearTimeout(changed.t);\n    if (now) render(); else changed.t = setTimeout(render, 150);\n    draftSoon();\n    pos();\n  }\n  function pos() {\n    const before = src.value.slice(0, src.selectionStart), line = before.split('\\n').length, col = before.length - before.lastIndexOf('\\n');\n    $('stPos').textContent = 'Line ' + line + ', column ' + col;\n    const words = (src.value.match(/[\\p{L}\\p{N}][\\p{L}\\p{N}'’_-]*/gu) || []).length;\n    $('stWords').textContent = words.toLocaleString('en-GB') + ' word' + (words === 1 ? '' : 's');\n  }\n  src.addEventListener('input', () => changed());\n  src.addEventListener('keyup', pos); src.addEventListener('click', pos);\n\n  async function confirmLeave(what) {\n    if (!dirty) return true;\n    const a = await ask('Save changes?', 'Save the changes to ' + file.name + ' before ' + what + '?', [{ label: 'Cancel', act: 'cancel' }, { label: \"Don't save\", act: 'discard', danger: true }, { label: 'Save', act: 'save', primary: true }]);\n    if (a === 'save') return save();\n    if (a === 'discard') { await Host.removeData('drafts/' + WIN + '.json'); return true; }\n    return false;\n  }\n  async function newDoc() { if (await confirmLeave('starting a new document')) { setDoc('', {}); src.focus(); } }\n  async function openDoc() {\n    if (!await confirmLeave('opening another file')) return;\n    try { const f = await Host.openFile({ title: 'Open', types: ['.md', '.markdown', '.txt'] }); if (f) { setDoc(f.text, { name: f.name, path: f.path, granted: !!f.path }); src.focus(); } }\n    catch (e) { toast(e.message, 4000); }\n  }\n  const out = () => file.eol === '\\r\\n' ? src.value.replace(/\\n/g, '\\r\\n') : src.value;\n  async function save() {\n    if (!file.path || !file.granted) return saveAs();\n    try { await Host.writePath(file.path, out()); return didSave(); }\n    catch (e) { toast('Could not save: ' + e.message, 5000); return false; }\n  }\n  async function saveAs() {\n    try {\n      const f = await Host.saveFile({ title: 'Save as', name: file.path ? file.name : (firstHeading() || 'Untitled') + '.md', types: ['.md', '.markdown'], text: out(), mime: 'text/markdown' });\n      if (!f) return false;\n      file.name = f.name; file.path = f.path; file.granted = !!f.path;\n      return didSave();\n    } catch (e) { toast('Could not save: ' + e.message, 5000); return false; }\n  }\n  async function didSave() {\n    saved = src.value; changed(true); src.focus({ preventScroll: true });\n    await Host.removeData('drafts/' + WIN + '.json');\n    toast('Saved ' + file.name);\n    return true;\n  }\n  const firstHeading = () => { const m = /^#{1,6}[ \\t]+(.+?)[ \\t#]*$/m.exec(src.value); return m ? m[1].replace(/[\\\\/:*?\"<>|]/g, '').trim().slice(0, 60) : ''; };\n\n  /* ---------- drafts: unsaved work kept in the data folder, because a window can be closed without asking ---------- */\n  let draftT = 0;\n  function draftSoon() { clearTimeout(draftT); draftT = setTimeout(writeDraft, 800); }\n  async function writeDraft() {\n    if (!dirty) { await Host.removeData('drafts/' + WIN + '.json'); return; }\n    await Host.saveData('drafts/' + WIN + '.json', JSON.stringify({ win: WIN, name: file.name, path: file.path, text: src.value, eol: file.eol, time: Date.now(), alive: Date.now() }));\n  }\n  setInterval(() => { if (dirty) writeDraft(); }, 5000);         /* the heartbeat: a draft whose window is gone stops being refreshed */\n  addEventListener('pagehide', () => { if (dirty) writeDraft(); });\n  async function orphanDrafts() {\n    const list = [];\n    for (const n of await Host.listData('drafts')) {\n      if (!/\\.json$/.test(n) || n === WIN + '.json') continue;\n      try { const d = JSON.parse(await Host.loadData('drafts/' + n)); if (d && typeof d.text === 'string' && Date.now() - d.alive > 15000) list.push(Object.assign(d, { file: n })); } catch (e) { /* unreadable: leave it */ }\n    }\n    return list.sort((a, b) => b.time - a.time);\n  }\n  async function offerRecovery(prefer) {\n    const list = await orphanDrafts();\n    if (!list.length) return;\n    const d = list.find(x => prefer && x.path && x.path.toLowerCase() === prefer.toLowerCase()) || list[0];\n    const b = $('banner'); b.textContent = '';\n    const when = new Date(d.time).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });\n    b.append(h('span', 'msg', 'Unsaved changes to ' + (d.path || d.name) + ' from ' + when + ' were kept when its window closed.' + (list.length > 1 ? ' (' + (list.length - 1) + ' more after this one.)' : '')));\n    const rec = h('button', 'btn primary', 'Recover'), dis = h('button', 'btn', 'Discard');\n    rec.onclick = async () => {\n      if (dirty && !await confirmLeave('recovering the other changes')) return;\n      const same = file.path && d.path && file.path.toLowerCase() === d.path.toLowerCase() && file.granted;\n      setDoc(d.text, { name: d.name, path: d.path, granted: same }, true);\n      file.eol = d.eol || '\\n';\n      await Host.removeData('drafts/' + d.file); b.hidden = true;\n      toast(same || !d.path ? 'Recovered. Save to keep it.' : 'Recovered. Save will ask where, as this window was not given ' + d.name + '.', 4500);\n      writeDraft(); offerRecovery();\n    };\n    dis.onclick = async () => { await Host.removeData('drafts/' + d.file); b.hidden = true; toast('Discarded'); offerRecovery(); };\n    b.append(rec, dis); b.hidden = false;\n  }\n\n  /* ---------- pictures ----------\n     The editor may read only files it is given. A picture chosen in its Open dialog (or saved by it) is kept in its\n     data folder, under the path the text names, so it shows again next time and goes into exported HTML. */\n  const pics = new Map();       /* lower-case drive path -> data URL, or 'none' when not kept */\n  const hash = s => { let x = 0x811c9dc5; for (let i = 0; i < s.length; i++) { x ^= s.charCodeAt(i); x = Math.imul(x, 0x01000193); } return (x >>> 0).toString(16).padStart(8, '0'); };\n  const picKey = p => 'pictures/' + hash(p.toLowerCase()) + '.json';\n  function toDataUrl(d, name) { return /^data:/.test(d) ? d : 'data:' + (IMG[extOf(name)] || 'image/svg+xml') + ';base64,' + btoa(unescape(encodeURIComponent(d))); }\n  async function keepPicture(path, url) { pics.set(path.toLowerCase(), url); if (url.length < 6 * 1048576) await Host.saveData(picKey(path), JSON.stringify({ path, url })); }\n  async function loadKept(path) {\n    const k = path.toLowerCase();\n    if (pics.has(k)) return pics.get(k);\n    pics.set(k, 'loading');\n    let url = 'none';\n    try { const d = await Host.loadData(picKey(path)); if (d) { const j = JSON.parse(d); if (j.path.toLowerCase() === k) url = j.url; } } catch (e) { url = 'none'; }\n    pics.set(k, url);\n    return url;\n  }\n  function picRef(s) { let r = s; try { r = decodeURI(s); } catch (e) { /* keep as written */ } return r; }\n  /* the element the preview shows for ![alt](src) */\n  function image(srcRef, alt, title) {\n    const ref = picRef(srcRef);\n    if (/^data:image\\//i.test(ref)) { const i = h('img'); i.src = ref; i.alt = alt; return i; }\n    const box = h('span', 'pic');\n    if (/^(https?:)?\\/\\//i.test(ref)) { box.append('🖼 ' + (alt || 'Picture') + ': pictures from the web cannot be shown, because PortD programs have no network.'); return box; }\n    const path = P ? Path.abs(ref, file.path) : null;\n    if (!P) { box.append('🖼 ' + (alt || ref) + ': pictures on the PortD drive show only inside PortD.'); return box; }\n    if (!path) { box.append('🖼 ' + (alt || ref) + ': save the document first, so the picture\\'s place can be worked out.'); return box; }\n    const k = path.toLowerCase(), url = pics.get(k);\n    if (url && url !== 'none' && url !== 'loading') { const i = h('img'); i.src = url; i.alt = alt; if (title) i.title = title; return i; }\n    if (url === undefined) loadKept(path).then(() => render());\n    box.append('🖼 ' + base(path) + (url === 'none' ? ' has not been shared with the editor.' : ''));\n    if (url === 'none') {\n      const b = h('button', 'btn', 'Show picture…');\n      b.onclick = async () => {\n        try {\n          const f = await P.ui.openFile({ title: 'Find ' + base(path), types: PIC_TYPES });\n          if (!f) return;\n          await keepPicture(path, toDataUrl(await P.fs.read(f.path), f.name)); render();\n          if (f.path.toLowerCase() !== k) toast('Showing ' + f.name + ' for ' + base(path));\n        } catch (e) { toast(e.message, 4000); }\n      };\n      box.append(b);\n    }\n    return box;\n  }\n  function refFor(path) { const r = file.path ? Path.rel(path, file.path) : path.replace(/\\\\/g, '/'); return /[\\s()<>]/.test(r) ? '<' + r + '>' : r; }\n  async function insertPicture() {\n    if (!P) { toast('Inside PortD this picks a picture from the drive. Here, drop a picture on the text instead.', 4000); return; }\n    try {\n      const a = src.selectionStart, b = src.selectionEnd;\n      const f = await P.ui.openFile({ title: 'Insert a picture', types: PIC_TYPES });\n      if (!f) return;\n      await keepPicture(f.path, toDataUrl(await P.fs.read(f.path), f.name));\n      src.focus(); src.setSelectionRange(a, b);\n      insert('![' + stem(f.name) + '](' + refFor(f.path) + ')');\n      src.focus();\n    } catch (e) { toast(e.message, 4000); }\n  }\n  /* a picture dropped or pasted from the computer: saved on the drive (asking where), then linked */\n  async function pictureFromComputer(blob, name) {\n    const url = await new Promise(res => { const r = new FileReader(); r.onload = () => res(r.result); r.readAsDataURL(blob); });\n    if (!P) { insert('![' + stem(name) + '](' + url + ')'); toast('Outside PortD the picture is put into the text itself.'); return; }\n    const a = src.selectionStart, b = src.selectionEnd;\n    const f = await P.ui.saveFile({ title: 'Save the picture on the drive', name, types: ['.' + (extOf(name) || 'png')] });\n    if (!f) return;\n    await P.fs.write(f.path, url, 'dataurl');\n    await keepPicture(f.path, url);\n    src.focus(); src.setSelectionRange(a, b);\n    insert('![' + stem(f.name) + '](' + refFor(f.path) + ')');\n  }\n  src.addEventListener('paste', e => {\n    const it = [...(e.clipboardData ? e.clipboardData.items : [])].find(x => x.kind === 'file' && /^image\\//.test(x.type));\n    if (!it) return;\n    e.preventDefault();\n    pictureFromComputer(it.getAsFile(), 'pasted picture.' + (it.type.split('/')[1] || 'png').replace('jpeg', 'jpg').replace('svg+xml', 'svg'));\n  });\n  $('app').addEventListener('dragover', e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) e.preventDefault(); });\n  $('app').addEventListener('drop', async e => {\n    const f = e.dataTransfer && e.dataTransfer.files[0];\n    if (!f) return;\n    e.preventDefault();\n    if (/^image\\//.test(f.type) || IMG[extOf(f.name)]) { src.focus(); pictureFromComputer(f, f.name); return; }\n    if (await confirmLeave('opening ' + f.name)) { const d = await Host.readDropped(f); setDoc(d.text, { name: d.name }); }\n  });\n\n  /* ---------- the preview ---------- */\n  let tree = [];\n  function render() {\n    tree = MD.parse(src.value);\n    const frag = MD.toDOM(tree, document, { image });\n    prev.textContent = '';\n    if (!src.value.trim()) prev.append(h('p', 'empty', 'The preview shows here as you write.'));\n    prev.append(frag);\n  }\n  prev.addEventListener('click', e => {\n    const a = e.target.closest('a'); if (!a) return;\n    e.preventDefault();\n    const kind = a.dataset.kind, href = a.dataset.href;\n    if (kind === 'web') Host.openUrl(href).catch(err => toast(err.message, 4000));\n    else if (kind === 'anchor') { const t = prev.querySelector('[id=\"' + CSS.escape(decodeURIComponent(href.slice(1))) + '\"]'); if (t) t.scrollIntoView({ block: 'start' }); else toast('There is no heading \"' + href.slice(1) + '\" in this document'); }\n    else if (kind === 'file') toast('This links to a file on the drive (' + href + '). Open it from Files.', 4000);\n  });\n  /* the preview follows the source's scrolling */\n  src.addEventListener('scroll', () => { if (settings.view !== 'split') return; const r = src.scrollTop / Math.max(1, src.scrollHeight - src.clientHeight); prev.scrollTop = r * (prev.scrollHeight - prev.clientHeight); }, { passive: true });\n\n  /* ---------- export ---------- */\n  async function exportHtml() {\n    const refs = [];\n    (function walk(nodes) { for (const n of nodes) { if (n.t === 'img') refs.push(n.src); for (const k of ['c', 'items', 'head', 'rows']) if (Array.isArray(n[k])) walk(n[k].flat ? n[k].flat(2) : n[k]); } })(tree);\n    if (P) for (const r of refs) { const p = Path.abs(picRef(r), file.path); if (p) await loadKept(p); }\n    let missing = 0;\n    const body = MD.toHTML(tree, { image: r => {\n      const ref = picRef(r);\n      if (/^data:image\\//i.test(ref)) return ref;\n      const p = P ? Path.abs(ref, file.path) : null, u = p && pics.get(p.toLowerCase());\n      if (u && u !== 'none' && u !== 'loading') return u;\n      missing++; return null;\n    } });\n    const title = MD.title(tree) || stem(file.name);\n    const html = '<!DOCTYPE html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\\n<title>' + MD.escape(title) + '</title>\\n<style>\\n' + EXPORT_CSS + '</style>\\n</head>\\n<body>\\n<article>\\n' + body + '</article>\\n</body>\\n</html>\\n';\n    try {\n      const f = await Host.saveFile({ title: 'Export as HTML', name: stem(file.name) + '.html', types: ['.html'], text: html, mime: 'text/html' });\n      if (f) toast('Exported ' + f.name + (missing ? '. ' + missing + ' picture' + (missing > 1 ? 's were' : ' was') + ' not shared with the editor and left out.' : ''), missing ? 5000 : 2500);\n    } catch (e) { toast('Could not export: ' + e.message, 5000); }\n  }\n  const EXPORT_CSS = 'body{margin:0;background:#fff;color:#1d2330;font:16px/1.6 \"Segoe UI\",system-ui,sans-serif}\\narticle{max-width:46em;margin:0 auto;padding:24px 20px 48px}\\nh1,h2{border-bottom:1px solid #d5dae2;padding-bottom:.2em}\\ncode{font:.88em ui-monospace,Consolas,monospace;background:#eef1f5;padding:.1em .35em;border-radius:4px}\\npre{background:#eef1f5;padding:10px 12px;border-radius:6px;overflow:auto}\\npre code{background:none;padding:0}\\nblockquote{margin:.8em 0;padding:0 1em;border-left:4px solid #c3cad6;color:#535c6c}\\nimg{max-width:100%}\\ntable{border-collapse:collapse}\\nth,td{border:1px solid #d5dae2;padding:4px 10px}\\nth{background:#f3f5f8}\\nli.task{list-style:none;margin-left:-1.3em}\\n.missing{color:#8a1c1c;font-style:italic}\\n@media (prefers-color-scheme:dark){body{background:#1a1e26;color:#e6e9ef}code,pre{background:#262c38}th{background:#232833}a{color:#8fb6ff}}\\n';\n\n  /* ---------- editing commands ---------- */\n  /* replaces the selection, keeping the browser's own undo */\n  function insert(t, selFrom, selTo) {\n    src.focus();\n    const start = src.selectionStart;\n    if (!document.execCommand('insertText', false, t)) src.setRangeText(t, src.selectionStart, src.selectionEnd, 'end');\n    if (selFrom !== undefined) src.setSelectionRange(start + selFrom, start + (selTo === undefined ? selFrom : selTo));\n    changed();\n  }\n  function wrap(mark, placeholder) {\n    const a = src.selectionStart, b = src.selectionEnd, v = src.value, sel = v.slice(a, b);\n    if (sel && sel.startsWith(mark) && sel.endsWith(mark) && sel.length >= mark.length * 2) { insert(sel.slice(mark.length, -mark.length), 0, sel.length - 2 * mark.length); return; }\n    if (v.slice(a - mark.length, a) === mark && v.slice(b, b + mark.length) === mark) { src.setSelectionRange(a - mark.length, b + mark.length); insert(sel, 0, sel.length); return; }\n    const body = sel || placeholder;\n    insert(mark + body + mark, mark.length, mark.length + body.length);\n  }\n  /* applies a change to each whole line in the selection */\n  function lines(fn) {\n    const v = src.value, a = v.lastIndexOf('\\n', src.selectionStart - 1) + 1;\n    let b = v.indexOf('\\n', Math.max(src.selectionEnd - (src.selectionEnd > src.selectionStart && v[src.selectionEnd - 1] === '\\n' ? 1 : 0), src.selectionStart)); if (b < 0) b = v.length;\n    const ls = v.slice(a, b).split('\\n'), next = fn(ls);\n    src.setSelectionRange(a, b);\n    const t = next.join('\\n');\n    insert(t, 0, t.length);\n  }\n  const LIST = /^(\\s*)([-*+]|\\d+[.)])(\\s+\\[[ xX]\\])?\\s+/;\n  function prefix(kind) {\n    lines(ls => {\n      const has = l => kind === 'quote' ? /^\\s*>\\s?/.test(l) : kind === 'ul' ? /^\\s*[-*+]\\s+(?!\\[[ xX]\\])/.test(l) : kind === 'ol' ? /^\\s*\\d+[.)]\\s+/.test(l) : /^\\s*[-*+]\\s+\\[[ xX]\\]\\s+/.test(l);\n      const all = ls.filter(l => l.trim()).every(has);\n      let n = 0;\n      return ls.map(l => {\n        if (!l.trim() && ls.length > 1) return l;\n        if (all) return kind === 'quote' ? l.replace(/^(\\s*)>\\s?/, '$1') : l.replace(LIST, '$1');\n        const ind = /^\\s*/.exec(l)[0], body = kind === 'quote' ? l.replace(/^\\s*/, '') : l.replace(LIST, '').replace(/^\\s*/, '');\n        if (kind === 'quote') return ind + '> ' + body;\n        return ind + (kind === 'ul' ? '- ' : kind === 'ol' ? (++n) + '. ' : '- [ ] ') + body;\n      });\n    });\n  }\n  function heading() {\n    lines(ls => ls.map(l => { const m = /^(#{1,6})\\s+/.exec(l), n = m ? m[1].length : 0, body = l.replace(/^#{1,6}\\s+/, ''); return n >= 3 ? body : '#'.repeat(n + 1) + ' ' + body; }));\n  }\n  async function link() {\n    const a = src.selectionStart, b = src.selectionEnd, sel = src.value.slice(a, b), isUrl = /^(https?:\\/\\/|mailto:|www\\.)/i.test(sel);\n    $('linkText').value = isUrl ? '' : sel; $('linkUrl').value = isUrl ? sel : ''; $('linkErr').textContent = '';\n    for (;;) {\n      if (await dialog('linkDlg', isUrl || !sel ? (isUrl ? '#linkText' : '#linkText') : '#linkUrl') !== 'ok') { src.focus(); return; }\n      let url = $('linkUrl').value.trim(); const label = $('linkText').value.trim() || url;\n      if (/^www\\./i.test(url)) url = 'https://' + url;\n      if (!url) { $('linkErr').textContent = 'Enter an address.'; continue; }\n      if (MD.safeUrl(url).kind === 'blocked') { $('linkErr').textContent = 'Only web (https://…), email (mailto:…) and #heading links can be followed in the preview.'; continue; }\n      src.setSelectionRange(a, b);\n      insert('[' + label.replace(/[[\\]]/g, '\\\\$&') + '](' + (/[\\s()]/.test(url) ? '<' + url + '>' : url) + ')');\n      return;\n    }\n  }\n  const CMDS = {\n    bold: () => wrap('**', 'bold text'), italic: () => wrap('*', 'italic text'), strike: () => wrap('~~', 'struck text'), code: () => wrap('`', 'code'),\n    heading, ul: () => prefix('ul'), ol: () => prefix('ol'), task: () => prefix('task'), quote: () => prefix('quote'), link, picture: insertPicture,\n    table: () => { const lead = src.selectionStart && src.value[src.selectionStart - 1] !== '\\n' ? '\\n\\n' : ''; insert(lead + '| Column 1 | Column 2 |\\n| --- | --- |\\n| Text | Text |\\n', lead.length + 2, lead.length + 10); },\n    codeblock: () => { const sel = src.value.slice(src.selectionStart, src.selectionEnd), lead = src.selectionStart && src.value[src.selectionStart - 1] !== '\\n' ? '\\n' : ''; insert(lead + '```\\n' + (sel || 'code') + '\\n```\\n', lead.length + 4, lead.length + 4 + (sel || 'code').length); },\n    hr: () => { const lead = src.selectionStart && src.value[src.selectionStart - 1] !== '\\n' ? '\\n' : ''; insert(lead + '\\n---\\n\\n'); }\n  };\n  $('fmtBar').addEventListener('click', e => { const b = e.target.closest('[data-cmd]'); if (b) CMDS[b.dataset.cmd](); });\n\n  /* keys inside the text: lists continue on Enter, Tab indents list items, Esc lets Tab leave */\n  let escaped = false;\n  src.addEventListener('keydown', e => {\n    if (e.key === 'Escape') { escaped = true; return; }\n    if (e.key === 'Tab' && escaped) { escaped = false; return; }\n    escaped = false;\n    const v = src.value, a = src.selectionStart, ls = v.lastIndexOf('\\n', a - 1) + 1, line = v.slice(ls, v.indexOf('\\n', a) < 0 ? v.length : v.indexOf('\\n', a));\n    if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.altKey && src.selectionStart === src.selectionEnd) {\n      const m = /^(\\s*)([-*+]|(\\d+)([.)]))(\\s+\\[[ xX]\\])?(\\s+)/.exec(line) || /^(\\s*)(>)()()()(\\s?)/.exec(line);\n      if (!m) return;\n      e.preventDefault();\n      if (line.slice(m[0].length).trim() === '' && a === ls + line.length) { src.setSelectionRange(ls, a); if (!document.execCommand('delete')) src.setRangeText('', ls, a, 'end'); src.setSelectionRange(ls, ls); changed(); return; }        /* an empty item ends the list */\n      const marker = m[2] === '>' ? '> ' : m[1] + (m[3] ? (+m[3] + 1) + m[4] : m[2]) + (m[5] ? ' [ ]' : '') + m[6];\n      insert('\\n' + marker);\n      return;\n    }\n    if (e.key === 'Tab' && LIST.test(line)) {\n      e.preventDefault();\n      lines(l => l.map(x => !LIST.test(x) ? x : e.shiftKey ? x.replace(/^ {1,2}|^\\t/, '') : '  ' + x));\n    }\n  });\n\n  /* ---------- views, theme, keys ---------- */\n  function setView(v) {\n    settings.view = v; panes.className = 'panes ' + v;\n    for (const b of document.querySelectorAll('[data-view]')) b.setAttribute('aria-pressed', String(b.dataset.view === v));\n    Host.saveSettings(settings);\n    (v === 'preview' ? prev : src).focus({ preventScroll: true });\n  }\n  for (const b of document.querySelectorAll('[data-view]')) b.onclick = () => setView(b.dataset.view);\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n  $('newBtn').onclick = newDoc; $('openBtn').onclick = openDoc; $('saveBtn').onclick = save; $('saveAsBtn').onclick = saveAs; $('exportBtn').onclick = exportHtml;\n  $('helpBtn').onclick = () => dialog('helpDlg');\n  document.addEventListener('keydown', e => {\n    if (document.querySelector('.ov:not([hidden])')) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase(), digit = /^Digit(\\d)$/.exec(e.code || '');\n    let run = null;\n    if (ctrl && !e.shiftKey && !e.altKey) run = { o: openDoc, s: save, b: CMDS.bold, i: CMDS.italic, k: CMDS.link, e: CMDS.code }[k];\n    else if (ctrl && e.shiftKey && !e.altKey) run = k === 's' ? saveAs : k === 'h' ? CMDS.heading : k === 'e' ? () => setView({ source: 'split', split: 'preview', preview: 'source' }[settings.view]) : digit ? { 7: CMDS.ol, 8: CMDS.ul, 9: CMDS.task }[digit[1]] : null;\n    else if (e.key === 'F1') run = () => dialog('helpDlg');\n    if (!run) return;\n    e.preventDefault();\n    if (/^(bold|italic|link|code|heading)$/.test(run.name) || [CMDS.bold, CMDS.italic, CMDS.code, CMDS.heading, CMDS.ol, CMDS.ul, CMDS.task, CMDS.link].includes(run)) { if (settings.view === 'preview') setView('split'); }\n    run();\n  });\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    setView(settings.view in { source: 1, split: 1, preview: 1 } ? settings.view : 'split');\n    const start = Host.startFile();\n    if (start) {\n      try { const f = await Host.readPath(start.path, start.name); setDoc(f.text, { name: f.name, path: f.path, granted: true }); }\n      catch (e) { setDoc('', {}); toast('Could not open \"' + start.name + '\": ' + e.message, 5000); }\n    } else setDoc('', {});\n    src.focus();\n    offerRecovery(start && start.path);\n    window.__md = { get file() { return file; }, get dirty() { return dirty; }, get pics() { return pics; }, WIN, writeDraft };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/markdown.js": {
   "enc": "text",
   "d": "/* Markdown Editor: a Markdown reader (CommonMark core plus GitHub tables, task lists, strikethrough and bare links).\n   It turns text into a tree, which is drawn element by element (toDOM) or written out as escaped HTML (toHTML).\n   Raw HTML in the text is never passed on as HTML: it is shown as the text it is. No DOM code in parse(). */\n(function () {\n  'use strict';\n  const MD = window.MD = {};\n\n  /* ---------- links: only these can ever become a link ---------- */\n  MD.safeUrl = function (u) {\n    u = String(u || '').trim();\n    if (/^(https?:|mailto:)/i.test(u)) return { kind: 'web', href: u };\n    if (/^#/.test(u)) return { kind: 'anchor', href: u };\n    if (/^[a-z][a-z0-9+.-]*:/i.test(u) && !/^[a-z]:[\\\\/]/i.test(u)) return { kind: 'blocked', href: u };      /* javascript:, data:, file:, … */\n    return { kind: 'file', href: u };          /* a path: a file on the drive */\n  };\n  MD.slug = s => s.toLowerCase().trim().replace(/[^\\p{L}\\p{N}\\s-]/gu, '').replace(/\\s+/g, '-');\n\n  /* ---------- blocks ---------- */\n  const RE = {\n    blank: /^\\s*$/,\n    atx: /^ {0,3}(#{1,6})(?:[ \\t]+(.*?))?(?:[ \\t]+#+)?[ \\t]*$/,\n    hr: /^ {0,3}([-*_])(?:[ \\t]*\\1){2,}[ \\t]*$/,\n    fence: /^( {0,3})(`{3,}|~{3,})\\s*([^`\\s]*)[^`]*$/,\n    quote: /^ {0,3}> ?/,\n    item: /^( {0,3})([-+*]|\\d{1,9}[.)])(?=[ \\t]|$)([ \\t]*)/,\n    setext: /^ {0,3}(=+|-+)[ \\t]*$/,\n    tdelim: /^ {0,3}\\|?\\s*:?-+:?\\s*(\\|\\s*:?-+:?\\s*)*\\|?\\s*$/,\n    ref: /^ {0,3}\\[([^\\]]+)\\]:[ \\t]*<?([^\\s>]+)>?(?:[ \\t]+(?:\"([^\"]*)\"|'([^']*)'|\\(([^)]*)\\)))?[ \\t]*$/\n  };\n  const expandTabs = l => l.indexOf('\\t') < 0 ? l : l.replace(/^[ \\t]+/, m => { let c = 0; for (const ch of m) c = ch === '\\t' ? c + 4 - c % 4 : c + 1; return ' '.repeat(c); });\n  const indentOf = l => l.length - l.trimStart().length;\n  const splitRow = l => { let s = l.trim(); if (s.startsWith('|')) s = s.slice(1); if (s.endsWith('|') && !s.endsWith('\\\\|')) s = s.slice(0, -1); const out = []; let cur = '', code = false; for (let i = 0; i < s.length; i++) { const c = s[i]; if (c === '\\\\' && s[i + 1] === '|') { cur += '|'; i++; } else if (c === '`') { code = !code; cur += c; } else if (c === '|' && !code) { out.push(cur.trim()); cur = ''; } else cur += c; } out.push(cur.trim()); return out; };\n  const startsBlock = l => RE.atx.test(l) || RE.hr.test(l) || RE.fence.test(l) || RE.quote.test(l) || (RE.item.test(l) && !RE.blank.test(l.replace(RE.item, '')) && (/^ {0,3}[-+*]/.test(l) || /^ {0,3}1[.)]/.test(l)));\n\n  function blocks(lines, refs) {\n    const out = [];\n    let i = 0;\n    while (i < lines.length) {\n      const line = lines[i];\n      if (RE.blank.test(line)) { i++; continue; }\n      let m;\n      if ((m = RE.fence.exec(line))) {\n        const ind = m[1].length, mark = m[2], body = [];\n        i++;\n        while (i < lines.length && !new RegExp('^ {0,3}' + mark[0] + '{' + mark.length + ',}\\\\s*$').test(lines[i])) { body.push(lines[i].replace(new RegExp('^ {0,' + ind + '}'), '')); i++; }\n        i++;\n        out.push({ t: 'pre', lang: m[3] || '', v: body.join('\\n') });\n        continue;\n      }\n      if (indentOf(line) >= 4) {\n        const body = [];\n        while (i < lines.length && (indentOf(lines[i]) >= 4 || RE.blank.test(lines[i]))) { body.push(lines[i].slice(4)); i++; }\n        while (body.length && RE.blank.test(body[body.length - 1])) body.pop();\n        out.push({ t: 'pre', lang: '', v: body.join('\\n') });\n        continue;\n      }\n      if ((m = RE.atx.exec(line))) { out.push({ t: 'h', level: m[1].length, src: (m[2] || '').trim() }); i++; continue; }\n      if (RE.hr.test(line)) { out.push({ t: 'hr' }); i++; continue; }\n      if (RE.quote.test(line)) {\n        const body = [];\n        while (i < lines.length && !RE.blank.test(lines[i]) && (RE.quote.test(lines[i]) || !startsBlock(lines[i]))) { body.push(lines[i].replace(RE.quote, '')); i++; }\n        out.push({ t: 'quote', c: blocks(body, refs) });\n        continue;\n      }\n      if ((m = RE.item.exec(line))) {\n        const ordered = /\\d/.test(m[2]), kind = ordered ? m[2].slice(-1) : m[2], list = { t: ordered ? 'ol' : 'ul', start: ordered ? parseInt(m[2], 10) : 1, items: [], loose: false };\n        let gap = false;                    /* a blank line between items, or between blocks inside one, makes the list loose */\n        while (i < lines.length && (m = RE.item.exec(lines[i])) && (ordered ? /\\d/.test(m[2]) && m[2].slice(-1) === kind : m[2] === kind)) {\n          if (gap) list.loose = true;\n          const rest = lines[i].slice(m[0].length), wide = m[3].length > 4 && rest.trim();\n          const pad = wide ? m[1].length + m[2].length + 1 : m[0].length + (rest.trim() ? 0 : 1);\n          const body = [wide ? lines[i].slice(pad) : rest];\n          i++; gap = false;\n          while (i < lines.length) {\n            const l = lines[i];\n            if (RE.blank.test(l)) { body.push(''); gap = true; i++; continue; }\n            if (indentOf(l) >= pad) { if (gap) list.loose = true; body.push(l.slice(pad)); gap = false; i++; continue; }\n            if (!gap && !startsBlock(l) && !RE.item.test(l)) { body.push(l); i++; continue; }      /* lazy continuation */\n            break;\n          }\n          while (body.length && body[body.length - 1] === '') body.pop();\n          let task = null, t;\n          if ((t = /^\\[([ xX])\\](?:[ \\t]+|$)/.exec(body[0] || ''))) { task = t[1] !== ' '; body[0] = body[0].slice(t[0].length); }\n          list.items.push({ task, c: blocks(body, refs) });\n        }\n        out.push(list);\n        continue;\n      }\n      if (line.includes('|') && i + 1 < lines.length && RE.tdelim.test(lines[i + 1]) && lines[i + 1].includes('-')) {\n        const head = splitRow(line), align = splitRow(lines[i + 1]).map(c => /^:-+:$/.test(c) ? 'center' : /^-+:$/.test(c) ? 'right' : /^:-+$/.test(c) ? 'left' : null);\n        if (align.length === head.length) {\n          const rows = [];\n          i += 2;\n          while (i < lines.length && !RE.blank.test(lines[i]) && lines[i].includes('|') && !startsBlock(lines[i])) { const r = splitRow(lines[i]); rows.push(head.map((_, k) => r[k] || '')); i++; }\n          out.push({ t: 'table', align, head, rows });\n          continue;\n        }\n      }\n      /* paragraph, perhaps with reference definitions in front, perhaps a setext heading */\n      const para = [];\n      while (i < lines.length && !RE.blank.test(lines[i])) {\n        if (para.length && startsBlock(lines[i])) break;\n        if (para.length && RE.setext.test(lines[i])) { out.push({ t: 'h', level: lines[i].trim()[0] === '=' ? 1 : 2, src: para.join('\\n').trim() }); para.length = 0; i++; break; }\n        if (!para.length && (m = RE.ref.exec(lines[i]))) { const k = m[1].toLowerCase().replace(/\\s+/g, ' '); if (!refs[k]) refs[k] = { href: m[2], title: m[3] || m[4] || m[5] || '' }; i++; continue; }\n        para.push(lines[i].replace(/^ {0,3}/, '')); i++;\n      }\n      if (para.length) out.push({ t: 'p', src: para.join('\\n') });\n    }\n    return out;\n  }\n\n  /* ---------- inline ---------- */\n  const PUNCT = /^[!\"#$%&'()*+,\\-./:;<=>?@[\\\\\\]^_`{|}~]$/;\n  function inline(s, refs) {\n    const out = [];\n    let text = '', i = 0;\n    const flush = () => { if (text) { out.push({ t: 'text', v: text }); text = ''; } };\n    while (i < s.length) {\n      const c = s[i];\n      if (c === '\\\\' && i + 1 < s.length) {\n        if (s[i + 1] === '\\n') { flush(); out.push({ t: 'br' }); i += 2; continue; }\n        if (PUNCT.test(s[i + 1])) { text += s[i + 1]; i += 2; continue; }\n      }\n      if (c === '\\n') { const hard = / {2,}$/.test(text); text = text.replace(/ +$/, ''); flush(); out.push(hard ? { t: 'br' } : { t: 'text', v: '\\n' }); i++; continue; }\n      if (c === '`') {\n        const run = /^`+/.exec(s.slice(i))[0], j = s.indexOf(run, i + run.length);\n        let k = j;\n        while (k >= 0 && s[k + run.length] === '`') k = s.indexOf(run, k + run.length + 1);\n        if (k >= 0) { flush(); let v = s.slice(i + run.length, k).replace(/\\n/g, ' '); if (/^ .*[^ ].* $/.test(v)) v = v.slice(1, -1); out.push({ t: 'code', v }); i = k + run.length; continue; }\n        text += run; i += run.length; continue;\n      }\n      if (c === '<') {\n        const m = /^<((?:https?:\\/\\/|mailto:)[^\\s<>]+|[^\\s<>@]+@[^\\s<>@]+\\.[^\\s<>@]+)>/.exec(s.slice(i));\n        if (m) { flush(); const href = /^(https?:|mailto:)/i.test(m[1]) ? m[1] : 'mailto:' + m[1]; out.push({ t: 'link', href, title: '', c: [{ t: 'text', v: m[1] }] }); i += m[0].length; continue; }\n        text += c; i++; continue;              /* any other < is text: raw HTML is never passed on */\n      }\n      if (c === '[' || (c === '!' && s[i + 1] === '[')) {\n        const img = c === '!', l = linkAt(s, img ? i + 1 : i, refs);\n        if (l) {\n          flush();\n          if (img) out.push({ t: 'img', src: l.href, title: l.title, alt: plain(inline(l.label, refs)) });\n          else out.push({ t: 'link', href: l.href, title: l.title, c: inline(l.label, refs) });\n          i = l.end; continue;\n        }\n        text += c; i++; continue;\n      }\n      if (c === '*' || c === '_' || (c === '~' && s[i + 1] === '~')) {\n        const e = emphAt(s, i, refs);\n        if (e) { flush(); out.push(e.node); i = e.end; continue; }\n        const run = /^(\\*+|_+|~+)/.exec(s.slice(i))[0]; text += run; i += run.length; continue;\n      }\n      if ((c === 'h' || c === 'w') && !/[\\w]$/.test(text)) {\n        const m = /^(?:https?:\\/\\/|www\\.)[^\\s<]*[^\\s<.,:;\"')\\]*_~?!]/.exec(s.slice(i));\n        if (m) { flush(); out.push({ t: 'link', href: m[0].startsWith('www.') ? 'https://' + m[0] : m[0], title: '', c: [{ t: 'text', v: m[0] }] }); i += m[0].length; continue; }\n      }\n      text += c; i++;\n    }\n    flush();\n    return out;\n  }\n  /* [label](dest \"title\"), [label][ref], [label][] or [label] at position i (which holds the \"[\") */\n  function linkAt(s, i, refs) {\n    let depth = 0, j = i;\n    for (; j < s.length; j++) {\n      const c = s[j];\n      if (c === '\\\\') { j++; continue; }\n      if (c === '`') { const run = /^`+/.exec(s.slice(j))[0], k = s.indexOf(run, j + run.length); if (k > 0) { j = k + run.length - 1; continue; } }\n      if (c === '[') depth++;\n      else if (c === ']' && --depth === 0) break;\n    }\n    if (j >= s.length) return null;\n    const label = s.slice(i + 1, j);\n    let m = /^\\(\\s*(?:<([^<>\\n]*)>|((?:[^\\s()\\\\]|\\\\.|\\((?:[^\\s()\\\\]|\\\\.)*\\))*))(?:\\s+(?:\"((?:[^\"\\\\]|\\\\.)*)\"|'((?:[^'\\\\]|\\\\.)*)'|\\(([^)]*)\\)))?\\s*\\)/.exec(s.slice(j + 1));\n    if (m) return { label, href: (m[1] !== undefined ? m[1] : m[2]).replace(/\\\\(.)/g, '$1'), title: (m[3] || m[4] || m[5] || '').replace(/\\\\(.)/g, '$1'), end: j + 1 + m[0].length };\n    const key = k => refs[k.toLowerCase().replace(/\\s+/g, ' ').trim()];\n    m = /^\\[([^\\]]*)\\]/.exec(s.slice(j + 1));\n    if (m) { const r = key(m[1] || label); if (r) return { label, href: r.href, title: r.title, end: j + 1 + m[0].length }; }\n    const r = key(label);\n    if (r) return { label, href: r.href, title: r.title, end: j + 1 };\n    return null;\n  }\n  /* *em*, **strong**, ***both***, _em_, __strong__, ~~strike~~ */\n  function emphAt(s, i, refs) {\n    const ch = s[i], run = new RegExp('^\\\\' + ch + '+').exec(s.slice(i))[0];\n    const n = ch === '~' ? 2 : Math.min(run.length, 3);\n    if (ch === '~' && run.length !== 2) return null;\n    const after = s[i + run.length];\n    if (!after || /\\s/.test(after)) return null;\n    if (ch === '_' && i > 0 && /[\\p{L}\\p{N}]/u.test(s[i - 1])) return null;\n    const mark = ch.repeat(n);\n    let k = i + n;\n    while ((k = s.indexOf(mark, k)) >= 0) {\n      const ok = /\\S/.test(s[k - 1]) && s[k - 1] !== ch && s[k + n] !== ch && s.slice(i + n, k).trim() && (ch !== '_' || !/[\\p{L}\\p{N}]/u.test(s[k + n] || ''));\n      if (ok) {\n        const inner = inline(s.slice(i + n, k), refs);\n        const node = ch === '~' ? { t: 'del', c: inner } : n === 1 ? { t: 'em', c: inner } : n === 2 ? { t: 'strong', c: inner } : { t: 'em', c: [{ t: 'strong', c: inner }] };\n        return { node, end: k + n };\n      }\n      k += 1;\n    }\n    return null;\n  }\n  const plain = nodes => nodes.map(n => n.t === 'text' || n.t === 'code' ? n.v : n.t === 'img' ? n.alt : n.c ? plain(n.c) : n.t === 'br' ? ' ' : '').join('');\n\n  /* ---------- the whole document ---------- */\n  MD.parse = function (text) {\n    const lines = String(text).replace(/\\r\\n?/g, '\\n').split('\\n').map(expandTabs), refs = {};\n    const tree = blocks(lines, refs), ids = {};\n    (function fill(bs) {\n      for (const b of bs) {\n        if (b.t === 'p' || b.t === 'h') { b.c = inline(b.src, refs); delete b.src; }\n        if (b.t === 'h') { let id = MD.slug(plain(b.c)) || 'section'; if (ids[id] !== undefined) id += '-' + ++ids[id]; else ids[id] = 0; b.id = id; }\n        if (b.t === 'table') { b.head = b.head.map(c => inline(c, refs)); b.rows = b.rows.map(r => r.map(c => inline(c, refs))); }\n        if (b.t === 'quote') fill(b.c);\n        if (b.t === 'ul' || b.t === 'ol') b.items.forEach(it => fill(it.c));\n      }\n    })(tree);\n    return tree;\n  };\n  MD.plain = plain;\n  MD.title = function (tree) { const h = tree.find(b => b.t === 'h' && b.level === 1) || tree.find(b => b.t === 'h'); return h ? plain(h.c) : ''; };\n\n  /* ---------- drawing into the page ----------\n     o.image(src, alt, title) returns an element to show for a picture; o.link(href, kind) is called on click */\n  MD.toDOM = function (tree, doc, o) {\n    const el = (tag, cls) => { const e = doc.createElement(tag); if (cls) e.className = cls; return e; };\n    const frag = doc.createDocumentFragment();\n    function inl(nodes, parent, tight) {\n      for (const n of nodes) {\n        let e;\n        switch (n.t) {\n          case 'text': parent.append(n.v); continue;\n          case 'br': parent.append(el('br')); continue;\n          case 'code': e = el('code'); e.textContent = n.v; break;\n          case 'em': e = el('em'); inl(n.c, e); break;\n          case 'strong': e = el('strong'); inl(n.c, e); break;\n          case 'del': e = el('del'); inl(n.c, e); break;\n          case 'img': e = o.image(n.src, n.alt, n.title); break;\n          case 'link': {\n            const u = MD.safeUrl(n.href);\n            if (u.kind === 'blocked') { e = el('span', 'badlink'); e.title = 'This link was not made clickable: only web (http, https) and email links are allowed. It points to: ' + n.href; inl(n.c, e); break; }\n            e = el('a'); e.href = u.kind === 'web' ? u.href : '#'; e.dataset.href = u.href; e.dataset.kind = u.kind;\n            e.title = (n.title ? n.title + '\\n' : '') + (u.kind === 'file' ? 'A file on the drive: ' + u.href + ' (open it from Files)' : u.href);\n            if (u.kind === 'file') e.className = 'filelink';\n            inl(n.c, e);\n            break;\n          }\n        }\n        if (n.title && e && n.t !== 'link') e.title = n.title;\n        parent.append(e);\n      }\n    }\n    function blk(bs, parent, tight) {\n      for (const b of bs) {\n        let e;\n        switch (b.t) {\n          case 'p': if (tight) { inl(b.c, parent); continue; } e = el('p'); inl(b.c, e); break;\n          case 'h': e = el('h' + b.level); e.id = b.id; inl(b.c, e); break;\n          case 'hr': e = el('hr'); break;\n          case 'pre': { e = el('pre'); const c = el('code'); if (b.lang) c.dataset.lang = b.lang; c.textContent = b.v; e.append(c); break; }\n          case 'quote': e = el('blockquote'); blk(b.c, e); break;\n          case 'table': {\n            e = el('table'); const th = el('thead'), tr = el('tr'), tb = el('tbody');\n            b.head.forEach((c, k) => { const x = el('th'); if (b.align[k]) x.style.textAlign = b.align[k]; inl(c, x); tr.append(x); });\n            th.append(tr); e.append(th);\n            for (const r of b.rows) { const row = el('tr'); r.forEach((c, k) => { const x = el('td'); if (b.align[k]) x.style.textAlign = b.align[k]; inl(c, x); row.append(x); }); tb.append(row); }\n            if (b.rows.length) e.append(tb);\n            const wrap = el('div', 'tablewrap'); wrap.append(e); e = wrap;\n            break;\n          }\n          case 'ul': case 'ol': {\n            e = el(b.t); if (b.t === 'ol' && b.start !== 1) e.start = b.start;\n            for (const it of b.items) {\n              const li = el('li');\n              if (it.task !== null) { li.className = 'task'; const box = el('input'); box.type = 'checkbox'; box.checked = it.task; box.disabled = true; box.setAttribute('aria-label', it.task ? 'done' : 'not done'); li.append(box, ' '); }\n              blk(it.c, li, !b.loose);\n              e.append(li);\n            }\n            break;\n          }\n        }\n        parent.append(e);\n      }\n    }\n    blk(tree, frag);\n    return frag;\n  };\n\n  /* ---------- writing HTML text, for Export as HTML ----------\n     o.image(src) returns a data URL for a picture, or null */\n  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n  MD.toHTML = function (tree, o) {\n    function inl(nodes) {\n      return nodes.map(n => {\n        switch (n.t) {\n          case 'text': return esc(n.v);\n          case 'br': return '<br>\\n';\n          case 'code': return '<code>' + esc(n.v) + '</code>';\n          case 'em': return '<em>' + inl(n.c) + '</em>';\n          case 'strong': return '<strong>' + inl(n.c) + '</strong>';\n          case 'del': return '<del>' + inl(n.c) + '</del>';\n          case 'img': { const u = o.image(n.src); return u ? '<img src=\"' + esc(u) + '\" alt=\"' + esc(n.alt) + '\"' + (n.title ? ' title=\"' + esc(n.title) + '\"' : '') + '>' : '<span class=\"missing\">[picture: ' + esc(n.alt || n.src) + ']</span>'; }\n          case 'link': {\n            const u = MD.safeUrl(n.href);\n            if (u.kind === 'web') return '<a href=\"' + esc(u.href) + '\" rel=\"noopener noreferrer\" target=\"_blank\"' + (n.title ? ' title=\"' + esc(n.title) + '\"' : '') + '>' + inl(n.c) + '</a>';\n            if (u.kind === 'anchor') return '<a href=\"' + esc(u.href) + '\">' + inl(n.c) + '</a>';\n            return '<span>' + inl(n.c) + '</span>';\n          }\n        }\n        return '';\n      }).join('');\n    }\n    function blk(bs, tight) {\n      return bs.map(b => {\n        switch (b.t) {\n          case 'p': return tight ? inl(b.c) : '<p>' + inl(b.c) + '</p>\\n';\n          case 'h': return '<h' + b.level + ' id=\"' + esc(b.id) + '\">' + inl(b.c) + '</h' + b.level + '>\\n';\n          case 'hr': return '<hr>\\n';\n          case 'pre': return '<pre><code' + (b.lang ? ' class=\"language-' + esc(b.lang) + '\"' : '') + '>' + esc(b.v) + '</code></pre>\\n';\n          case 'quote': return '<blockquote>\\n' + blk(b.c) + '</blockquote>\\n';\n          case 'table': {\n            const a = k => b.align[k] ? ' style=\"text-align:' + b.align[k] + '\"' : '';\n            return '<table>\\n<thead><tr>' + b.head.map((c, k) => '<th' + a(k) + '>' + inl(c) + '</th>').join('') + '</tr></thead>\\n' +\n              (b.rows.length ? '<tbody>\\n' + b.rows.map(r => '<tr>' + r.map((c, k) => '<td' + a(k) + '>' + inl(c) + '</td>').join('') + '</tr>\\n').join('') + '</tbody>\\n' : '') + '</table>\\n';\n          }\n          case 'ul': case 'ol':\n            return '<' + b.t + (b.t === 'ol' && b.start !== 1 ? ' start=\"' + b.start + '\"' : '') + '>\\n' + b.items.map(it => '<li' + (it.task !== null ? ' class=\"task\"><input type=\"checkbox\" disabled' + (it.task ? ' checked' : '') + '> ' : '>') + blk(it.c, !b.loose) + '</li>\\n').join('') + '</' + b.t + '>\\n';\n        }\n        return '';\n      }).join('');\n    }\n    return blk(tree);\n  };\n  MD.escape = esc;\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Markdown Editor */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2563c9; --onaccent: #ffffff; --sel: #d6e4fb; --code: #eef1f5; --link: #1f56b3; --quote: #c3cad6;\n  --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00; --bad: #8a1c1c;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #7aa7ff; --onaccent: #0b1220; --sel: #2c3f63; --code: #262c38; --link: #8fb6ff; --quote: #4a5263;\n  --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00; --bad: #ffb3b3;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; }\n.mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding: 5px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.bar.fmt { padding-top: 0; }\n.grow { flex: 1; }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 3px 9px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .55; cursor: default; }\n.btn.primary, .btn[aria-pressed=\"true\"] { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.danger { color: var(--bad); }\n.btn.icon { min-width: 30px; padding: 3px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.seg { display: inline-flex; }\n.seg .btn { border-radius: 0; margin-left: -1px; }\n.seg .btn:first-child { border-radius: 6px 0 0 6px; margin-left: 0; }\n.seg .btn:last-child { border-radius: 0 6px 6px 0; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; min-width: 40px; } }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.banner { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border-bottom: 1px solid var(--warnedge); }\n.banner .msg { flex: 1 1 260px; }\n\n.panes { flex: 1; display: flex; min-height: 0; }\n#src { flex: 1; min-width: 0; border: 0; resize: none; padding: 12px 14px; font: 14px/1.55 ui-monospace, \"Cascadia Mono\", Consolas, monospace; background: var(--bg); color: var(--text); outline-offset: -2px; tab-size: 4; }\n.preview { flex: 1; min-width: 0; overflow: auto; padding: 8px 22px 30px; outline-offset: -2px; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }\n.panes.split #src { border-right: 1px solid var(--line); }\n.panes.source .preview, .panes.preview #src { display: none; }\n@media (max-width: 620px) { .panes.split { flex-direction: column; } .panes.split #src { border-right: 0; border-bottom: 1px solid var(--line); } }\n\n/* the preview */\n.preview h1, .preview h2 { border-bottom: 1px solid var(--line); padding-bottom: .2em; }\n.preview h1 { font-size: 1.8em; margin: .6em 0 .4em; } .preview h2 { font-size: 1.45em; margin: .9em 0 .4em; } .preview h3 { font-size: 1.2em; }\n.preview code { font: .88em ui-monospace, Consolas, monospace; background: var(--code); padding: .1em .35em; border-radius: 4px; }\n.preview pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow: auto; line-height: 1.45; }\n.preview pre code { background: none; padding: 0; }\n.preview blockquote { margin: .8em 0; padding: 0 1em; border-left: 4px solid var(--quote); color: var(--muted); }\n.preview a { color: var(--link); }\n.preview .filelink { text-decoration-style: dashed; }\n.preview .badlink { text-decoration: line-through; color: var(--muted); cursor: help; }\n.preview img { max-width: 100%; }\n.preview hr { border: 0; border-top: 2px solid var(--line); margin: 1.4em 0; }\n.preview .tablewrap { overflow-x: auto; }\n.preview table { border-collapse: collapse; margin: .8em 0; }\n.preview th, .preview td { border: 1px solid var(--line); padding: 4px 10px; }\n.preview th { background: var(--panel); }\n.preview li.task { list-style: none; margin-left: -1.3em; }\n.preview .pic { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; border: 1px dashed var(--edge); border-radius: 6px; padding: 6px 10px; font-size: 13px; color: var(--muted); }\n.preview .empty { color: var(--muted); font-style: italic; }\n\n.status { display: flex; gap: 16px; padding: 3px 10px; border-top: 1px solid var(--line); background: var(--panel); color: var(--muted); white-space: nowrap; overflow: hidden; min-height: 24px; }\n.status #stState.dirty { color: var(--text); font-weight: 600; }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg.wide { max-width: 880px; }\n.dlg.wide .keys { font-size: 12px; }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg .frow { display: flex; flex-direction: column; gap: 3px; margin-bottom: 8px; }\n.dlg .err { color: var(--bad); min-height: 1em; margin: 0; }\n.dlg textarea { width: 100%; background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; }\n.dlg .acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; flex-wrap: wrap; }\n.cols { display: flex; gap: 20px; flex-wrap: wrap; }\n.keys { border-collapse: collapse; }\n.keys th { text-align: left; padding-bottom: 4px; }\n.keys td { padding: 2px 10px 2px 0; vertical-align: top; }\n.keys td:first-child { white-space: nowrap; font-family: ui-monospace, Consolas, monospace; font-size: 12px; }\n.toast { position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n"
  }
 }
}