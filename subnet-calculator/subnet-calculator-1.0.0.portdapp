{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "subnet-calculator",
 "name": "Subnet Calculator",
 "version": "1.0.0",
 "description": "IPv4 and IPv6 subnets: network, hosts, masks and binary, splitting, range checks and summarising.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 940,
 "height": 640,
 "singleInstance": false,
 "fileTypes": [],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"4\" y=\"6\" width=\"56\" height=\"52\" rx=\"7\" fill=\"#1f5fa8\"/><rect x=\"11\" y=\"14\" width=\"42\" height=\"9\" rx=\"2\" fill=\"#fff\"/><rect x=\"11\" y=\"27\" width=\"20\" height=\"9\" rx=\"2\" fill=\"#9cc3ef\"/><rect x=\"33\" y=\"27\" width=\"20\" height=\"9\" rx=\"2\" fill=\"#9cc3ef\"/><rect x=\"11\" y=\"40\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#ffd34d\"/><rect x=\"22\" y=\"40\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#ffd34d\"/><rect x=\"33\" y=\"40\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#ffd34d\"/><rect x=\"44\" y=\"40\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#ffd34d\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"subnet-calculator\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Subnet Calculator</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\">\n    <div id=\"tabs\" class=\"tabs\" role=\"tablist\" aria-label=\"Tools\"></div>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n  </div>\n  <div id=\"panels\" class=\"panels\"></div>\n  <div class=\"foot muted\">Alt+1 to Alt+5 switch tools · Alt+C copies the result</div>\n</div>\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"close\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n<script src=\"js/host.js\"></script>\n<script src=\"js/ip.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Subnet Calculator: the window. Five tools on tabs, each worked out as you type. Each tool's last input is kept. */\n(function () {\n  'use strict';\n  const $ = id => document.getElementById(id), f4 = IP.fmt4;\n  const num = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => num(n) + ' ' + (n === 1 ? w : ws || w + 's');\n  const SHOW_ROWS = 1024;\n  let settings = { theme: 'auto', tab: 'v4', v4: '192.168.10.37/26', split: { net: '10.20.0.0/22', by: 'count', count: 6, prefix: 26 },\n    contains: { ip: '10.20.3.15', ranges: '10.20.0.0/22\\n10.20.4.0/24\\n192.168.0.0/16\\n10.20.3.1 - 10.20.3.9' },\n    sum: '10.1.0.0/24\\n10.1.1.0/24\\n10.1.2.0/23\\n10.1.4.0/24\\n10.1.4.128/25\\n172.16.5.10', v6: '2001:db8:abcd:12::1/64' };\n  const tools = {}, order = [];\n\n  /* ---------- helpers ---------- */\n  function h(tag, attrs, ...kids) {\n    const e = document.createElement(tag);\n    for (const k in attrs || {}) { const v = attrs[k]; if (v == null || v === false) continue; if (k === 'class') e.className = v; else if (k === 'text') e.textContent = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v === true ? '' : v); }\n    for (const k of kids.flat()) if (k != null) e.append(k);\n    return e;\n  }\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2200); }\n  let saveT = 0;\n  const saveSoon = () => { clearTimeout(saveT); saveT = setTimeout(() => Host.saveSettings(settings), 400); };\n  addEventListener('pagehide', () => { clearTimeout(saveT); Host.saveSettings(settings); });\n  async function copy(text, what) {\n    if (!text) { toast('There is nothing to copy yet.'); return; }\n    if (await Host.copy(text)) { toast('Copied ' + what); return; }\n    const ov = $('copyDlg'), back = document.activeElement;\n    $('copyText').value = text; ov.hidden = false; $('copyText').focus(); $('copyText').select();\n    const close = () => { ov.hidden = true; ov.removeEventListener('keydown', key); if (back) back.focus(); };\n    const key = e => { if (e.key === 'Escape') { e.preventDefault(); close(); } else if (e.key === 'Tab') { e.preventDefault(); (document.activeElement === $('copyText') ? ov.querySelector('[data-act]') : $('copyText')).focus(); } e.stopPropagation(); };\n    ov.querySelector('[data-act]').onclick = close; ov.addEventListener('keydown', key);\n  }\n  const field = (id, label, value, ph) => h('input', { id, class: 'field mono big', value, placeholder: ph, spellcheck: 'false', autocomplete: 'off', 'aria-label': label });\n  const msg = id => h('div', { id, class: 'msg', role: 'status' });\n  function say(el, text, kind) { el.textContent = text || ''; el.className = 'msg' + (kind ? ' ' + kind : ''); }\n  /* a table of label / value rows; values can be selected and copied */\n  function facts(rows) {\n    const t = h('table', { class: 'facts' });\n    for (const [k, v, cls] of rows) t.append(h('tr', { class: cls || null }, h('th', { scope: 'row' }, k), h('td', { class: 'mono' }, v)));\n    return t;\n  }\n  const asText = rows => rows.map(([k, v]) => k + ': ' + v).join('\\n');\n  function seg(label, value, choices, onPick) {\n    const box = h('div', { class: 'seg', role: 'group', 'aria-label': label });\n    for (const [v, text] of choices) box.append(h('button', { class: 'sbtn', 'data-v': v, 'aria-pressed': String(v === value), onclick: () => { for (const b of box.children) b.setAttribute('aria-pressed', String(b.dataset.v === v)); onPick(v); } }, text));\n    return box;\n  }\n  function panel(id, ...kids) { return h('section', { class: 'panel', id: 'p-' + id, role: 'tabpanel', 'aria-labelledby': 't-' + id }, ...kids); }\n  const live = (el, fn) => { let t = 0; el.addEventListener('input', () => { clearTimeout(t); t = setTimeout(fn, 120); }); };\n\n  /* the tools are made once the saved inputs are read */\n  function make() {\n  /* ---------- IPv4 ---------- */\n  tools.v4 = (function () {\n    const input = field('v4-in', 'IPv4 address with prefix or mask', settings.v4, 'for example: 10.1.2.3/22 or 10.1.2.3 255.255.252.0');\n    const m = msg('v4-msg'), out = h('div', { id: 'v4-out', class: 'out' });\n    const copyBtn = h('button', { class: 'btn primary', onclick: () => copy(text, 'the details') }, 'Copy all');\n    let text = '';\n    function bitsRow(name, n, prefix) {\n      const b = IP.bits4(n), cells = [];\n      for (let o = 0; o < 4; o++) {\n        const oct = h('span', { class: 'oct' });\n        for (let i = o * 8; i < o * 8 + 8; i++) oct.append(h('span', { class: i < prefix ? 'nb' : 'hb' }, b[i]));\n        cells.push(oct); if (o < 3) cells.push(h('span', { class: 'dot' }, '.'));\n      }\n      return h('tr', null, h('th', { scope: 'row' }, name), h('td', { class: 'bits mono', 'aria-label': name + ' in binary: ' + b.match(/.{8}/g).join(' ') }, cells), h('td', { class: 'mono' }, f4(n)));\n    }\n    function update() {\n      settings.v4 = input.value; saveSoon();\n      out.textContent = ''; text = '';\n      let c;\n      try { c = IP.parseCidr4(input.value); } catch (e) { say(m, e.message, 'err'); input.setAttribute('aria-invalid', 'true'); return; }\n      input.removeAttribute('aria-invalid');\n      const i = IP.info4(c.addr, c.prefix);\n      const notes = [];\n      if (c.assumed) notes.push('No prefix or mask was given, so this is a single address (/32).');\n      if (c.addr !== i.net && c.addr !== i.bc && c.prefix < 31) notes.push(f4(c.addr) + ' is host ' + num(c.addr - i.net) + ' of this network.');\n      else if (c.prefix < 31 && c.addr === i.net) notes.push('This is the network address itself.');\n      else if (c.prefix < 31 && c.addr === i.bc) notes.push('This is the broadcast address of the network.');\n      say(m, notes.join(' ') || f4(i.net) + '/' + i.prefix, notes.length ? 'note' : 'ok');\n      const hosts = i.prefix === 31 ? '2 (a point-to-point link, RFC 3021)' : i.prefix === 32 ? '1 (a single address)' : num(i.usable);\n      const rows = [['Address', f4(c.addr)], ['Network', f4(i.net) + '/' + i.prefix], ['Broadcast', i.prefix >= 31 ? '(none for /' + i.prefix + ')' : f4(i.bc)],\n        ['First host', f4(i.first)], ['Last host', f4(i.last)], ['Usable hosts', hosts], ['Addresses in all', num(i.size)],\n        ['Subnet mask', f4(i.mask) + ' (/' + i.prefix + ')'], ['Wildcard mask', f4(i.wildcard)], ['Class', i.cls],\n        ['Type', i.kind], ['As a number', num(c.addr) + ' (hex ' + c.addr.toString(16).toUpperCase().padStart(8, '0') + ')']];\n      if (i.netKind !== i.kind) rows.splice(11, 0, ['Network type', i.netKind]);\n      text = asText(rows);\n      const bt = h('table', { class: 'bintab' }, h('caption', null, 'In binary: network bits are highlighted'),\n        bitsRow('Address', c.addr, c.prefix), bitsRow('Mask', i.mask, c.prefix), bitsRow('Network', i.net, c.prefix), bitsRow('Broadcast', i.bc, c.prefix));\n      out.append(facts(rows), bt);\n    }\n    live(input, update); input.addEventListener('keydown', e => { if (e.key === 'Enter') update(); });\n    const p = panel('v4', h('div', { class: 'ctrl' }, h('label', { for: 'v4-in', class: 'lbl' }, 'Address'), input, copyBtn), m, out);\n    update();\n    return { panel: p, name: 'IPv4', focus: () => input.focus(), copyOut: () => copy(text, 'the details'), input, update };\n  })();\n\n  /* ---------- Split ---------- */\n  tools.split = (function () {\n    const o = settings.split;\n    const net = field('split-in', 'Network to split', o.net, 'for example: 10.20.0.0/22');\n    const n = h('input', { id: 'split-n', type: 'number', class: 'field num', min: 1, max: 65536, value: o.by === 'count' ? o.count : o.prefix, 'aria-label': o.by === 'count' ? 'How many subnets' : 'New prefix length' });\n    const nl = h('label', { for: 'split-n', class: 'lbl' }, o.by === 'count' ? 'Subnets' : 'New prefix /');\n    const by = seg('Split by', o.by, [['count', 'By count'], ['prefix', 'By prefix']], v => {\n      o.by = v; n.value = v === 'count' ? o.count : o.prefix; nl.textContent = v === 'count' ? 'Subnets' : 'New prefix /';\n      n.setAttribute('aria-label', v === 'count' ? 'How many subnets' : 'New prefix length'); update();\n    });\n    const m = msg('split-msg'), out = h('div', { id: 'split-out', class: 'out tableout' });\n    let res = null;\n    const header = ['#', 'Network', 'First host', 'Last host', 'Broadcast', 'Usable hosts'];\n    const row = (x, i) => [String(i + 1), f4(x.net) + '/' + x.prefix, f4(x.first), f4(x.last), x.prefix >= 31 ? '-' : f4(x.bc), String(x.usable)];\n    const asLines = () => res.list.map(x => f4(x.net) + '/' + x.prefix).join('\\n');\n    const asTable = () => [header].concat(res.list.map(row)).map(r => r.join('\\t')).join('\\n');\n    const copyText = h('button', { class: 'btn primary', onclick: () => res && copy(asLines(), plural(res.list.length, 'subnet') + ' as text') }, 'Copy as text');\n    const copyTable = h('button', { class: 'btn', title: 'Tab-separated, with headings: pastes into Excel as a table', onclick: () => res && copy(asTable(), 'the table') }, 'Copy as table');\n    function update() {\n      const v = parseInt(n.value, 10);\n      if (o.by === 'count') o.count = v || 1; else o.prefix = isNaN(v) ? o.prefix : v;\n      o.net = net.value; saveSoon();\n      out.textContent = ''; res = null;\n      let c;\n      try { c = IP.parseCidr4(net.value); res = IP.split4(IP.info4(c.addr, c.prefix).net, c.prefix, { by: o.by, count: v, prefix: v }); }\n      catch (e) { say(m, e.message, 'err'); return; }\n      const first = res.list[0], note = [];\n      note.push(plural(res.list.length, 'subnet') + ' of /' + res.prefix + ' (' + plural(first.usable, 'usable host') + ' each).');\n      if (o.by === 'count' && v !== res.list.length) note.push('You asked for ' + v + '; subnets come in powers of two, so you get ' + res.list.length + '.');\n      if (c.addr !== IP.info4(c.addr, c.prefix).net) note.push('Started from the network ' + f4(IP.info4(c.addr, c.prefix).net) + '/' + c.prefix + '.');\n      say(m, note.join(' '), 'ok');\n      const t = h('table', { class: 'grid' }, h('thead', null, h('tr', null, header.map(x => h('th', { scope: 'col' }, x)))));\n      const tb = h('tbody');\n      res.list.slice(0, SHOW_ROWS).forEach((x, i) => tb.append(h('tr', null, row(x, i).map((v, j) => h('td', { class: j ? 'mono' : 'num' }, v)))));\n      t.append(tb); out.append(t);\n      if (res.list.length > SHOW_ROWS) out.append(h('p', { class: 'muted' }, 'The first ' + num(SHOW_ROWS) + ' are shown here; Copy copies all ' + num(res.list.length) + '.'));\n    }\n    live(net, update); n.addEventListener('input', update);\n    const p = panel('split', h('div', { class: 'ctrl' }, h('label', { for: 'split-in', class: 'lbl' }, 'Network'), net, by, nl, n, h('span', { class: 'grow' }), copyText, copyTable), m, out);\n    update();\n    return { panel: p, name: 'Split', focus: () => net.focus(), copyOut: () => res && copy(asLines(), plural(res.list.length, 'subnet') + ' as text'), update };\n  })();\n\n  /* ---------- In range? ---------- */\n  tools.contains = (function () {\n    const o = settings.contains;\n    const ip = field('in-ip', 'Address to check', o.ip, 'for example: 10.20.3.15');\n    const list = h('textarea', { id: 'in-list', class: 'ta mono', spellcheck: 'false', 'aria-label': 'Ranges, one per line', placeholder: 'One per line: 10.0.0.0/8, 10.0.0.0 255.0.0.0, 10.0.0.1 - 10.0.0.9, or one address' }, o.ranges);\n    const m = msg('in-msg'), out = h('div', { id: 'in-out', class: 'out' });\n    let text = '';\n    function update() {\n      o.ip = ip.value; o.ranges = list.value; saveSoon();\n      out.textContent = ''; text = '';\n      let a;\n      try { a = IP.parse4(ip.value); } catch (e) { say(m, e.message, 'err'); return; }\n      const r = IP.readList(list.value, IP.range4);\n      if (!r.ok.length && !r.bad.length) { say(m, 'Type one or more ranges, one per line.'); return; }\n      const ul = h('ul', { class: 'hits' }), lines = [];\n      let hits = 0;\n      for (const x of r.ok) {\n        const yes = a >= x.start && a <= x.end; if (yes) hits++;\n        const extra = x.cidr ? ' (' + f4(x.start) + ' – ' + f4(x.end) + ')' : '';\n        ul.append(h('li', { class: yes ? 'yes' : 'no' }, h('span', { class: 'mark', 'aria-hidden': 'true' }, yes ? '✓' : '✗'), h('span', { class: 'mono' }, x.text), h('span', { class: 'muted' }, extra), h('span', { class: 'sr' }, yes ? ': in this range' : ': not in this range')));\n        lines.push((yes ? 'IN      ' : 'NOT IN  ') + x.text);\n      }\n      for (const b of r.bad) ul.append(h('li', { class: 'bad' }, h('span', { class: 'mark', 'aria-hidden': 'true' }, '!'), h('span', { class: 'mono' }, b.text), h('span', null, ' ' + b.error)));\n      out.append(ul);\n      say(m, f4(a) + (hits ? ' is in ' + hits + ' of the ' + plural(r.ok.length, 'range') + '.' : ' is in none of the ' + plural(r.ok.length, 'range') + '.') + (r.bad.length ? ' ' + plural(r.bad.length, 'line') + ' could not be read.' : ''), hits ? 'ok' : 'note');\n      text = f4(a) + '\\n' + lines.join('\\n');\n    }\n    live(ip, update); live(list, update);\n    const p = panel('contains', h('div', { class: 'ctrl' }, h('label', { for: 'in-ip', class: 'lbl' }, 'Address'), ip, h('span', { class: 'grow' }), h('button', { class: 'btn primary', onclick: () => copy(text, 'the answer') }, 'Copy')), m,\n      h('div', { class: 'cols' }, h('div', { class: 'col' }, h('label', { for: 'in-list', class: 'colhead' }, 'Ranges'), list), h('div', { class: 'col' }, h('div', { class: 'colhead' }, 'Is it in them?'), out)));\n    update();\n    return { panel: p, name: 'In range?', focus: () => ip.focus(), copyOut: () => copy(text, 'the answer'), update };\n  })();\n\n  /* ---------- Summarise ---------- */\n  tools.sum = (function () {\n    const list = h('textarea', { id: 'sum-in', class: 'ta mono', spellcheck: 'false', 'aria-label': 'Ranges to summarise', placeholder: 'Paste CIDRs, ranges or addresses: one per line, or separated by commas' }, settings.sum);\n    const res = h('textarea', { id: 'sum-out', class: 'ta mono out', readonly: true, 'aria-label': 'Summarised ranges' });\n    const m = msg('sum-msg'), bad = h('ul', { class: 'hits' });\n    function update() {\n      settings.sum = list.value; saveSoon();\n      bad.textContent = ''; res.value = '';\n      const r = IP.readList(list.value, IP.range4);\n      for (const b of r.bad) bad.append(h('li', { class: 'bad' }, h('span', { class: 'mark', 'aria-hidden': 'true' }, '!'), h('span', { class: 'mono' }, b.text), h('span', null, ' ' + b.error)));\n      if (!r.ok.length) { say(m, r.bad.length ? 'None of the lines could be read.' : 'Paste a list of ranges to summarise.', r.bad.length ? 'err' : ''); return; }\n      const s = IP.summarise4(r.ok);\n      res.value = s.blocks.map(b => f4(b.net) + '/' + b.prefix).join('\\n');\n      const notAligned = r.ok.filter(x => x.cidr && !x.aligned).length;\n      say(m, plural(r.ok.length, 'range') + ' in, ' + plural(s.blocks.length, 'CIDR block') + ' out.' + (notAligned ? ' ' + plural(notAligned, 'entry was', 'entries were') + ' not on a network boundary and were read as their whole network.' : '') + (r.bad.length ? ' ' + plural(r.bad.length, 'line') + ' could not be read.' : ''), r.bad.length ? 'note' : 'ok');\n    }\n    live(list, update);\n    const p = panel('sum', h('div', { class: 'ctrl' }, h('span', { class: 'muted' }, 'Merges overlapping and neighbouring ranges into the fewest CIDR blocks (IPv4).'), h('span', { class: 'grow' }), h('button', { class: 'btn primary', onclick: () => copy(res.value, 'the summary') }, 'Copy')), m,\n      h('div', { class: 'cols' }, h('div', { class: 'col' }, h('label', { for: 'sum-in', class: 'colhead' }, 'Ranges'), list), h('div', { class: 'col' }, h('label', { for: 'sum-out', class: 'colhead' }, 'Summarised'), res, bad)));\n    update();\n    return { panel: p, name: 'Summarise', focus: () => list.focus(), copyOut: () => copy(res.value, 'the summary'), update };\n  })();\n\n  /* ---------- IPv6 ---------- */\n  tools.v6 = (function () {\n    const input = field('v6-in', 'IPv6 address with prefix', settings.v6, 'for example: 2001:db8::1/64');\n    const m = msg('v6-msg'), out = h('div', { id: 'v6-out', class: 'out' });\n    let text = '';\n    const show = (n, kind) => kind === 'IPv4-mapped' ? '::ffff:' + f4(Number(n & 0xffffffffn)) : IP.compress6(n);\n    function nibbles(n, prefix) {\n      const ex = IP.expand6(n), box = h('span', { class: 'bits mono' });\n      let bit = 0;\n      for (const ch of ex) { if (ch === ':') { box.append(h('span', { class: 'dot' }, ':')); continue; } box.append(h('span', { class: bit < prefix ? 'nb' : 'hb' }, ch)); bit += 4; }\n      return box;\n    }\n    function update() {\n      settings.v6 = input.value; saveSoon();\n      out.textContent = ''; text = '';\n      let c;\n      try { c = IP.parseCidr6(input.value); } catch (e) { say(m, e.message, 'err'); input.setAttribute('aria-invalid', 'true'); return; }\n      input.removeAttribute('aria-invalid');\n      const i = IP.info6(c.n, c.prefix);\n      say(m, (c.assumed ? 'No prefix was given, so this is a single address (/128). ' : '') + (c.zone ? 'The zone \"%' + c.zone + '\" names a network adapter on one computer; it is not part of the address.' : '') || show(c.n, i.kind) + '/' + c.prefix, c.assumed || c.zone ? 'note' : 'ok');\n      const rows = [['Compressed', show(c.n, i.kind)], ['Expanded', IP.expand6(c.n)], ['Prefix', '/' + c.prefix],\n        ['Network', IP.compress6(i.net) + '/' + c.prefix], ['First address', IP.expand6(i.net)], ['Last address', IP.expand6(i.last)],\n        ['Addresses', IP.size6(i.size, c.prefix)], ['Type', i.kind]];\n      if (c.prefix <= 64 && c.prefix % 4 === 0 && c.prefix > 0) rows.push(['/64 networks inside', IP.size6(1n << BigInt(64 - c.prefix), 128 - (64 - c.prefix))]);\n      text = asText(rows);\n      out.append(facts(rows), h('table', { class: 'bintab' }, h('caption', null, 'The prefix part is highlighted'),\n        h('tr', null, h('th', { scope: 'row' }, 'Address'), h('td', null, nibbles(c.n, c.prefix))),\n        h('tr', null, h('th', { scope: 'row' }, 'Network'), h('td', null, nibbles(i.net, c.prefix)))));\n    }\n    live(input, update); input.addEventListener('keydown', e => { if (e.key === 'Enter') update(); });\n    const p = panel('v6', h('div', { class: 'ctrl' }, h('label', { for: 'v6-in', class: 'lbl' }, 'Address'), input, h('button', { class: 'btn primary', onclick: () => copy(text, 'the details') }, 'Copy all')), m, out);\n    update();\n    return { panel: p, name: 'IPv6', focus: () => input.focus(), copyOut: () => copy(text, 'the details'), update };\n  })();\n\n  }\n\n  /* ---------- tabs ---------- */\n  const TABS = [['v4', 'IPv4'], ['split', 'Split'], ['contains', 'In range?'], ['sum', 'Summarise'], ['v6', 'IPv6']];\n  function drawTabs() {\n    TABS.forEach(([id, name], i) => {\n      order.push(id);\n      $('tabs').append(h('button', { class: 'tab', id: 't-' + id, role: 'tab', 'aria-controls': 'p-' + id, title: name + ' (Alt+' + (i + 1) + ')', onclick: () => setTab(id) }, name));\n      $('panels').append(tools[id].panel);\n    });\n  }\n  function setTab(id, focusTab) {\n    if (!tools[id]) id = 'v4';\n    settings.tab = id;\n    for (const t of order) { const on = t === id, b = $('t-' + t); b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; tools[t].panel.hidden = !on; }\n    if (focusTab) $('t-' + id).focus();\n    saveSoon();\n  }\n  $('tabs').addEventListener('keydown', e => {\n    const i = order.indexOf(settings.tab), to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: order.length - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); setTab(order[(to + order.length) % order.length], true);\n  });\n  document.addEventListener('keydown', e => {\n    if (!$('copyDlg').hidden || !e.altKey || e.ctrlKey || e.metaKey) return;\n    const k = e.key.toLowerCase();\n    if (/^[1-5]$/.test(k)) { e.preventDefault(); const id = order[+k - 1]; setTab(id); tools[id].focus(); }\n    else if (k === 'c') { e.preventDefault(); tools[settings.tab].copyOut(); }\n  });\n\n  /* ---------- theme ---------- */\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); saveSoon(); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- start: the saved inputs are read before the tools are drawn ---------- */\n  (async () => {\n    const s = await Host.loadSettings({});\n    const str = v => typeof v === 'string';\n    if (s && typeof s === 'object') {\n      if (['auto', 'light', 'dark'].includes(s.theme)) settings.theme = s.theme;\n      for (const k of ['tab', 'v4', 'sum', 'v6']) if (str(s[k])) settings[k] = s[k];\n      if (s.split && typeof s.split === 'object') { if (str(s.split.net)) settings.split.net = s.split.net; if (s.split.by === 'prefix' || s.split.by === 'count') settings.split.by = s.split.by; if (s.split.count > 0) settings.split.count = s.split.count | 0; if (s.split.prefix >= 0) settings.split.prefix = s.split.prefix | 0; }\n      if (s.contains && typeof s.contains === 'object') { if (str(s.contains.ip)) settings.contains.ip = s.contains.ip; if (str(s.contains.ranges)) settings.contains.ranges = s.contains.ranges; }\n    }\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    Host.setTitle('Subnet Calculator');\n    make();\n    drawTabs(); setTab(settings.tab); tools[settings.tab].focus();\n    window.__sc4 = { tools, get settings() { return settings; }, ready: true };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/ip.js": {
   "enc": "text",
   "d": "/* Subnet Calculator: the arithmetic. IPv4 addresses are unsigned 32-bit numbers; IPv6 addresses are BigInts.\n   No drawing here; app.js draws. Everything hangs off window.IP. Functions throw an Error with a plain message. */\n(function () {\n  'use strict';\n  const IP = window.IP = {};\n  const u32 = n => n >>> 0;\n\n  /* ---------- IPv4 ---------- */\n  IP.parse4 = function (s, what) {\n    const t = String(s).trim(), name = what || 'address';\n    if (!t) throw new Error('Type an ' + name + '.');\n    const parts = t.split('.');\n    if (parts.length !== 4) throw new Error('\"' + t + '\" is not an IPv4 ' + name + ': it needs 4 numbers separated by dots, like 192.168.1.10.');\n    let n = 0;\n    for (let i = 0; i < 4; i++) {\n      const p = parts[i];\n      if (!/^\\d+$/.test(p)) throw new Error('\"' + t + '\" is not an IPv4 ' + name + ': \"' + p + '\" is not a number.');\n      if (p.length > 1 && p[0] === '0') throw new Error('\"' + t + '\": \"' + p + '\" starts with 0. Leave out leading zeros (some systems read them as octal).');\n      const v = +p;\n      if (v > 255) throw new Error('\"' + t + '\": ' + v + ' is too big; each of the 4 numbers is 0 to 255.');\n      n = n * 256 + v;\n    }\n    return n;\n  };\n  IP.fmt4 = n => [n >>> 24, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');\n  IP.maskOf = p => p === 0 ? 0 : u32(0xffffffff << (32 - p));\n  /* a dotted mask to its prefix; explains wildcard masks and masks with gaps */\n  IP.prefixOfMask = function (m, text) {\n    for (let p = 0; p <= 32; p++) if (IP.maskOf(p) === m) return p;\n    const inv = u32(~m);\n    for (let p = 0; p <= 32; p++) if (IP.maskOf(p) === inv) throw new Error('\"' + text + '\" looks like a wildcard mask. The subnet mask for it is ' + IP.fmt4(inv) + ' (/' + p + ').');\n    throw new Error('\"' + text + '\" is not a valid subnet mask: its 1s must all come first, with no gaps (like 255.255.252.0).');\n  };\n  /* \"10.1.2.3/22\", \"10.1.2.3 255.255.252.0\", \"10.1.2.3/255.255.252.0\" or \"10.1.2.3\" → { addr, prefix, assumed } */\n  IP.parseCidr4 = function (s) {\n    const t = String(s).trim().replace(/\\s*\\/\\s*/, '/');\n    if (!t) throw new Error('Type an address with its prefix, like 10.1.2.3/22.');\n    let a, b;\n    if (t.includes('/')) [a, b] = t.split('/', 2);\n    else { const sp = t.split(/\\s+/); if (sp.length > 2) { IP.parse4(sp[0]); throw new Error('\"' + t + '\": type one address and one mask, like 10.1.2.3 255.255.252.0.'); } [a, b] = sp; }\n    const addr = IP.parse4(a);\n    if (b === undefined) return { addr, prefix: 32, assumed: true };\n    if (/^\\d+$/.test(b)) {\n      const p = +b;\n      if (p > 32) throw new Error('/' + b + ' is too big: an IPv4 prefix is 0 to 32.');\n      return { addr, prefix: p };\n    }\n    return { addr, prefix: IP.prefixOfMask(IP.parse4(b, 'mask'), b) };\n  };\n\n  const RANGES = [\n    ['0.0.0.0', 8, 'This network (not usable as an address)'],\n    ['10.0.0.0', 8, 'Private (RFC 1918)'], ['172.16.0.0', 12, 'Private (RFC 1918)'], ['192.168.0.0', 16, 'Private (RFC 1918)'],\n    ['100.64.0.0', 10, 'Shared address space (carrier-grade NAT)'], ['127.0.0.0', 8, 'Loopback'], ['169.254.0.0', 16, 'Link-local (APIPA)'],\n    ['192.0.0.0', 24, 'IETF protocol assignments'], ['192.0.2.0', 24, 'Documentation (TEST-NET-1)'], ['198.51.100.0', 24, 'Documentation (TEST-NET-2)'],\n    ['203.0.113.0', 24, 'Documentation (TEST-NET-3)'], ['198.18.0.0', 15, 'Benchmark testing'], ['224.0.0.0', 4, 'Multicast'],\n    ['255.255.255.255', 32, 'Limited broadcast'], ['240.0.0.0', 4, 'Reserved']\n  ].map(([a, p, name]) => ({ net: IP.parse4(a), prefix: p, name }));\n  /* the most specific special range the address is in, or Public */\n  IP.kind4 = function (a) {\n    let best = null;\n    for (const r of RANGES) if (u32(a & IP.maskOf(r.prefix)) === r.net && (!best || r.prefix > best.prefix)) best = r;\n    return best ? best.name : 'Public';\n  };\n  IP.class4 = a => { const o = a >>> 24; return o < 128 ? 'A' : o < 192 ? 'B' : o < 224 ? 'C' : o < 240 ? 'D (multicast)' : 'E (reserved)'; };\n\n  /* everything about one network */\n  IP.info4 = function (addr, prefix) {\n    const mask = IP.maskOf(prefix), net = u32(addr & mask), bc = u32(net | ~mask), size = 2 ** (32 - prefix);\n    let first, last, usable;\n    if (prefix === 32) { first = last = net; usable = 1; }\n    else if (prefix === 31) { first = net; last = bc; usable = 2; }\n    else { first = net + 1; last = bc - 1; usable = size - 2; }\n    return { addr, prefix, mask, wildcard: u32(~mask), net, bc, size, first, last, usable, cls: IP.class4(addr), kind: IP.kind4(addr), netKind: IP.kind4(net) };\n  };\n  IP.bits4 = n => n.toString(2).padStart(32, '0');\n\n  /* equal subnets: by a new prefix, or by a count (rounded up to a power of two) */\n  IP.split4 = function (net, prefix, o) {\n    let np;\n    if (o.by === 'count') {\n      const c = Math.floor(o.count);\n      if (!(c >= 1)) throw new Error('Type how many subnets you need (1 or more).');\n      np = prefix + Math.ceil(Math.log2(c));\n      if (np > 32) throw new Error('/' + prefix + ' can be split into at most ' + (2 ** (32 - prefix)).toLocaleString('en-GB') + ' subnets.');\n    } else {\n      np = Math.floor(o.prefix);\n      if (!(np >= 0 && np <= 32)) throw new Error('The new prefix must be 0 to 32.');\n      if (np < prefix) throw new Error('The new prefix (/' + np + ') must be the same as or longer than the network\\'s (/' + prefix + ').');\n    }\n    const n = 2 ** (np - prefix);\n    if (n > 65536) throw new Error('That makes ' + n.toLocaleString('en-GB') + ' subnets; up to 65,536 can be listed.');\n    const step = 2 ** (32 - np), list = [];\n    for (let i = 0; i < n; i++) list.push(IP.info4(u32(net + i * step), np));\n    return { prefix: np, list };\n  };\n\n  /* a line of a range list: \"10.0.0.0/8\", \"10.0.0.0 255.0.0.0\", \"10.0.0.1-10.0.0.9\", or a single address → { start, end, text } */\n  IP.range4 = function (line) {\n    const t = line.trim();\n    const m = /^([\\d.]+)\\s*(?:-|–|to)\\s*([\\d.]+)$/i.exec(t);\n    if (m) {\n      const a = IP.parse4(m[1]), b = IP.parse4(m[2]);\n      if (b < a) throw new Error('\"' + t + '\": the range ends before it starts.');\n      return { start: a, end: b, text: t };\n    }\n    const c = IP.parseCidr4(t), i = IP.info4(c.addr, c.prefix);\n    return { start: i.net, end: i.bc, text: t, cidr: true, aligned: i.net === c.addr };\n  };\n  /* reads a list (lines, commas or semicolons); returns { ok: [...], bad: [{ text, error }] } */\n  IP.readList = function (text, read) {\n    const ok = [], bad = [];\n    for (const raw of text.split(/[\\n,;]+/)) {\n      const t = raw.replace(/#.*$/, '').trim();\n      if (!t) continue;\n      try { ok.push(read(t)); } catch (e) { bad.push({ text: t, error: e.message }); }\n    }\n    return { ok, bad };\n  };\n  /* the fewest CIDR blocks that cover exactly the given ranges */\n  IP.summarise4 = function (ranges) {\n    const sorted = ranges.map(r => [r.start, r.end]).sort((a, b) => a[0] - b[0] || a[1] - b[1]), merged = [];\n    for (const [s, e] of sorted) {\n      const last = merged[merged.length - 1];\n      if (last && s <= last[1] + 1) last[1] = Math.max(last[1], e); else merged.push([s, e]);\n    }\n    const out = [];\n    for (let [s, e] of merged) {\n      while (s <= e) {\n        let p = 32;\n        while (p > 0) { const q = p - 1, size = 2 ** (32 - q); if (s % size !== 0 || s + size - 1 > e) break; p = q; }\n        out.push({ net: s, prefix: p });\n        s += 2 ** (32 - p);\n      }\n    }\n    return { blocks: out, merged: merged.length };\n  };\n\n  /* ---------- IPv6 (BigInt) ---------- */\n  const B = BigInt, ALL = (1n << 128n) - 1n;\n  IP.parse6 = function (s) {\n    let t = String(s).trim(), zone = '';\n    if (!t) throw new Error('Type an IPv6 address, like 2001:db8::1/64.');\n    t = t.replace(/^\\[|\\]$/g, '');\n    const zi = t.indexOf('%');\n    if (zi >= 0) { zone = t.slice(zi + 1); t = t.slice(0, zi); }\n    if (/[^0-9a-fA-F:.]/.test(t)) throw new Error('\"' + s.trim() + '\" is not an IPv6 address: only 0-9, a-f, colons (and dots for an IPv4 ending) are allowed.');\n    let tail = [];\n    const v4 = /(\\d+\\.\\d+\\.\\d+\\.\\d+)$/.exec(t);\n    if (v4) { const n = IP.parse4(v4[1]); tail = [(n >>> 16).toString(16), (n & 0xffff).toString(16)]; t = t.slice(0, -v4[1].length) + (t.endsWith(':' + v4[1]) ? '' : ''); if (t.endsWith(':') && !t.endsWith('::')) t = t.slice(0, -1); }\n    const dbl = t.split('::');\n    if (dbl.length > 2) throw new Error('\"' + s.trim() + '\" has \"::\" more than once; it may appear only once.');\n    const side = x => x === '' ? [] : x.split(':');\n    let head = side(dbl[0]), rest = dbl.length === 2 ? side(dbl[1]) : [];\n    if (dbl.length === 1) { head = head.concat(tail); } else rest = rest.concat(tail);\n    for (const g of head.concat(rest)) {\n      if (g === '') throw new Error('\"' + s.trim() + '\" has an empty group (two colons in a row are only allowed once, as \"::\").');\n      if (g.length > 4) throw new Error('\"' + s.trim() + '\": the group \"' + g + '\" has more than 4 hex digits.');\n    }\n    const count = head.length + rest.length;\n    if (dbl.length === 1 && count !== 8) throw new Error('\"' + s.trim() + '\" has ' + count + ' groups; a full IPv6 address has 8 (or use \"::\" for a run of zeros).');\n    if (dbl.length === 2 && count > 7) throw new Error('\"' + s.trim() + '\" has too many groups for \"::\" to stand for any.');\n    const groups = dbl.length === 2 ? head.concat(Array(8 - count).fill('0'), rest) : head;\n    let n = 0n;\n    for (const g of groups) n = (n << 16n) | B(parseInt(g, 16));\n    return { n, zone };\n  };\n  IP.parseCidr6 = function (s) {\n    const t = String(s).trim();\n    const i = t.lastIndexOf('/');\n    if (i < 0) { const a = IP.parse6(t); return { n: a.n, zone: a.zone, prefix: 128, assumed: true }; }\n    const ps = t.slice(i + 1).trim();\n    if (!/^\\d+$/.test(ps) || +ps > 128) throw new Error('/' + ps + ' is not a valid IPv6 prefix: it is 0 to 128.');\n    const a = IP.parse6(t.slice(0, i));\n    return { n: a.n, zone: a.zone, prefix: +ps };\n  };\n  IP.groups6 = n => { const g = []; for (let i = 7; i >= 0; i--) g.push(Number((n >> B(i * 16)) & 0xffffn)); return g; };\n  IP.expand6 = n => IP.groups6(n).map(x => x.toString(16).padStart(4, '0')).join(':');\n  /* RFC 5952: lower case, no leading zeros, the longest run of two or more zero groups as \"::\" (the first if tied) */\n  IP.compress6 = function (n) {\n    const g = IP.groups6(n).map(x => x.toString(16));\n    let bs = -1, bl = 0;\n    for (let i = 0; i < 8;) { if (g[i] !== '0') { i++; continue; } let j = i; while (j < 8 && g[j] === '0') j++; if (j - i > bl) { bs = i; bl = j - i; } i = j; }\n    if (bl < 2) return g.join(':');\n    return g.slice(0, bs).join(':') + '::' + g.slice(bs + bl).join(':');\n  };\n  IP.mask6 = p => p === 0 ? 0n : (ALL << B(128 - p)) & ALL;\n  const R6 = [['::', 128, 'Unspecified'], ['::1', 128, 'Loopback'], ['::ffff:0:0', 96, 'IPv4-mapped'], ['64:ff9b::', 96, 'IPv4/IPv6 translation'],\n    ['100::', 64, 'Discard only'], ['2001:db8::', 32, 'Documentation'], ['2001::', 32, 'Teredo'], ['2002::', 16, '6to4'], ['fc00::', 7, 'Unique local (private)'],\n    ['fe80::', 10, 'Link-local'], ['ff00::', 8, 'Multicast'], ['2000::', 3, 'Global unicast (public)']].map(([a, p, name]) => ({ n: IP.parse6(a).n, prefix: p, name }));\n  IP.kind6 = function (n) {\n    let best = null;\n    for (const r of R6) if ((n & IP.mask6(r.prefix)) === r.n && (!best || r.prefix > best.prefix)) best = r;\n    return best ? best.name : 'Reserved';\n  };\n  IP.info6 = function (n, prefix) {\n    const mask = IP.mask6(prefix), net = n & mask, last = net | (~mask & ALL);\n    return { n, prefix, net, last, size: 1n << B(128 - prefix), kind: IP.kind6(n) };\n  };\n  /* 2^k addresses in words: exact up to 2^53, otherwise as a power of two with an approximate number */\n  IP.size6 = function (size, prefix) {\n    const k = 128 - prefix;\n    if (k <= 53) return size.toLocaleString('en-GB');\n    return '2^' + k + ' (about ' + Number(size).toExponential(2).replace('e+', ' × 10^') + ')';\n  };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Subnet Calculator */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #1f5fa8; --onaccent: #ffffff; --sel: #dbe7f7; --net: #cfe0fb; --netfg: #123c73;\n  --ok: #1e6b37; --okbg: #e3f4e8; --err: #b42318; --errbg: #fde8e8; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00;\n  --mono: ui-monospace, \"Cascadia Mono\", Consolas, \"Courier New\", monospace;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #8ab8ff; --onaccent: #0b1a33; --sel: #233a5c; --net: #2b4a78; --netfg: #dce9ff;\n  --ok: #8fe0a8; --okbg: #183524; --err: #ff9b94; --errbg: #4a2a2e; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .mono { font-family: var(--mono); }\n.grow { flex: 1; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.bar { display: flex; align-items: flex-end; gap: 6px; padding: 6px 8px 0; background: var(--panel); border-bottom: 1px solid var(--line); }\n.bar .btn.icon { margin-bottom: 5px; }\n.tabs { display: flex; flex-wrap: wrap; gap: 2px; }\n.tab { font: inherit; color: var(--text); background: transparent; border: 1px solid transparent; border-bottom: 0; border-radius: 6px 6px 0 0; padding: 6px 12px; cursor: pointer; margin-bottom: -1px; }\n.tab:hover { background: var(--sel); }\n.tab.on { background: var(--bg); border-color: var(--line); font-weight: 600; }\n@media (pointer: coarse) { .tab { padding: 10px 14px; } }\n\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover { background: var(--sel); }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.small { min-height: 24px; padding: 2px 8px; font-size: 12px; }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.field.num { width: 76px; }\n@media (pointer: coarse) { .btn, .field, .sbtn { min-height: 40px; } .btn.small { min-height: 36px; } }\n\n.panels { flex: 1; min-height: 0; display: flex; }\n.panel { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 8px 10px; border-bottom: 1px solid var(--line); }\n.opts, .gopts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }\n.gopts { flex-direction: column; align-items: flex-start; }\n.seg { display: inline-flex; border: 1px solid var(--edge); border-radius: 6px; overflow: hidden; }\n.sbtn { font: inherit; color: var(--text); background: var(--bg); border: 0; border-right: 1px solid var(--edge); padding: 4px 12px; min-height: 28px; cursor: pointer; }\n.sbtn:last-child { border-right: 0; }\n.sbtn[aria-pressed=\"true\"] { background: var(--accent); color: var(--onaccent); }\n.chk, .sel { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n.chk input { width: 16px; height: 16px; accent-color: var(--accent); }\n@media (pointer: coarse) { .chk input { width: 22px; height: 22px; } }\n\n.cols { flex: 1; min-height: 0; display: flex; gap: 10px; padding: 8px 10px 10px; }\n.col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }\n.col.narrow { flex: 0 0 280px; }\n.colhead { font-weight: 600; font-size: 12px; margin-top: 2px; }\n.ta { flex: 1; min-height: 80px; resize: none; padding: 8px 10px; font: 13px/1.5 var(--mono); color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; overflow-wrap: anywhere; }\n.ta.out { background: var(--panel); }\n.acts { display: flex; align-items: center; gap: 8px; min-height: 30px; }\n.msg { font-size: 12px; color: var(--muted); }\n.msg.err { color: var(--err); }\n.msg.ok { color: var(--ok); }\n.msg.note { color: var(--warnfg); }\n.acts .msg { flex: 1 1 auto; min-width: 0; }\n\n.warnline { padding: 4px 10px; background: var(--warnbg); color: var(--warnfg); border: 1px solid var(--warnedge); border-radius: 6px; }\n.jwtout { flex: 1; min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 8px; }\n.chips { display: flex; flex-wrap: wrap; gap: 6px; }\n.chip { font-size: 12px; padding: 2px 10px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); }\n.chip.ok { background: var(--okbg); color: var(--ok); border-color: var(--ok); }\n.chip.bad { background: var(--errbg); color: var(--err); border-color: var(--err); font-weight: 600; }\n.times { border-collapse: collapse; font-size: 12.5px; }\n.times th { text-align: left; font-weight: 600; color: var(--muted); padding: 2px 10px 2px 0; }\n.times td { padding: 3px 10px 3px 0; border-top: 1px solid var(--line); white-space: nowrap; }\n.times tr.expired td { color: var(--err); }\n.jblock { border: 1px solid var(--line); border-radius: 6px; }\n.jhead { display: flex; align-items: center; padding: 4px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.jblock pre { margin: 0; padding: 8px 10px; font-size: 12.5px; white-space: pre-wrap; overflow-wrap: anywhere; }\n\n.filebox { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px; border: 1px dashed var(--edge); border-radius: 6px; background: var(--panel); }\n.hrows { display: flex; flex-direction: column; gap: 6px; }\n.hrow { display: grid; grid-template-columns: 92px 1fr auto; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; }\n.hrow.match { border-color: var(--ok); background: var(--okbg); }\n.hname { font-weight: 600; font-size: 12px; display: flex; flex-direction: column; }\n.hname .tag { font-weight: 400; font-size: 11px; color: var(--err); }\n.hval { font-size: 12px; overflow-wrap: anywhere; user-select: all; }\n#hash-expect { margin-bottom: 2px; }\n\n.foot { padding: 3px 10px; font-size: 11.5px; border-top: 1px solid var(--line); background: var(--panel); }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg textarea { width: 100%; font: 12px var(--mono); background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; padding: 6px; }\n.dacts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.toast { position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 40; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (max-width: 720px) { .cols { flex-direction: column; } .col.narrow { flex: none; } }\n@media (forced-colors: active) { .sbtn[aria-pressed=\"true\"], .tab.on { outline: 2px solid Highlight; } }\n\n/* Subnet Calculator additions */\n.lbl { font-weight: 600; }\n.field.big { font-size: 15px; padding: 6px 10px; min-width: 300px; flex: 1; max-width: 460px; }\n.field[aria-invalid=\"true\"] { border-color: var(--err); }\n.panel > .msg { margin: 8px 10px 0; padding: 5px 10px; border-radius: 6px; font-size: 12.5px; min-height: 28px; }\n.panel > .msg.ok { background: var(--okbg); }\n.panel > .msg.err { background: var(--errbg); border: 1px solid var(--err); }\n.panel > .msg.note { background: var(--warnbg); border: 1px solid var(--warnedge); }\n.out { flex: 1; min-height: 0; overflow: auto; padding: 8px 10px 10px; display: flex; flex-wrap: wrap; gap: 16px; align-content: flex-start; }\n.facts { border-collapse: collapse; font-size: 13px; }\n.facts th { text-align: left; font-weight: 600; color: var(--muted); padding: 3px 14px 3px 0; white-space: nowrap; }\n.facts td { padding: 3px 0; user-select: text; }\n.facts tr + tr th, .facts tr + tr td { border-top: 1px solid var(--line); }\n.bintab { border-collapse: collapse; font-size: 13px; align-self: flex-start; }\n.bintab caption { text-align: left; font-weight: 600; font-size: 12px; padding-bottom: 4px; color: var(--muted); }\n.bintab th { text-align: left; font-weight: 600; color: var(--muted); padding: 3px 12px 3px 0; }\n.bintab td { padding: 3px 12px 3px 0; white-space: nowrap; }\n.bits .nb { background: var(--net); color: var(--netfg); font-weight: 600; }\n.bits .hb { color: var(--muted); }\n.bits .dot { padding: 0 2px; color: var(--muted); }\n.tableout { display: block; }\n.grid { border-collapse: collapse; font-size: 12.5px; }\n.grid th { position: sticky; top: 0; background: var(--panel); text-align: left; padding: 4px 12px 4px 6px; border-bottom: 1px solid var(--edge); }\n.grid td { padding: 3px 12px 3px 6px; border-bottom: 1px solid var(--line); white-space: nowrap; }\n.grid td.num { color: var(--muted); text-align: right; }\n.grid tbody tr:hover td { background: var(--sel); }\n.hits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; width: 100%; }\n.hits li { display: flex; gap: 8px; align-items: baseline; padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px; flex-wrap: wrap; }\n.hits .mark { font-weight: 700; width: 1em; }\n.hits li.yes { border-color: var(--ok); background: var(--okbg); }\n.hits li.yes .mark { color: var(--ok); }\n.hits li.no .mark { color: var(--muted); }\n.hits li.bad { border-color: var(--err); color: var(--err); }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n.cols .out { padding: 0; }\n"
  }
 }
}