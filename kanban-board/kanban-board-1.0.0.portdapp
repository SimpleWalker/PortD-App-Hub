{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "kanban-board",
 "name": "Kanban Board",
 "version": "1.0.0",
 "description": "Boards of columns and cards: due dates, colour labels, checklists, drag and drop, archive and export.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 1040,
 "height": 660,
 "singleInstance": true,
 "fileTypes": [
  {
   "ext": ".json",
   "name": "Kanban board",
   "icon": "glyph:code"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"4\" y=\"6\" width=\"56\" height=\"52\" rx=\"7\" fill=\"#3b4a63\"/><rect x=\"9\" y=\"12\" width=\"14\" height=\"40\" rx=\"3\" fill=\"#e8edf5\"/><rect x=\"25\" y=\"12\" width=\"14\" height=\"40\" rx=\"3\" fill=\"#e8edf5\"/><rect x=\"41\" y=\"12\" width=\"14\" height=\"40\" rx=\"3\" fill=\"#e8edf5\"/><rect x=\"11\" y=\"15\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#ef6c57\"/><rect x=\"11\" y=\"26\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#f2b33d\"/><rect x=\"27\" y=\"15\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#4c8be8\"/><rect x=\"43\" y=\"15\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#3fb37a\"/><rect x=\"43\" y=\"26\" width=\"10\" height=\"8\" rx=\"2\" fill=\"#3fb37a\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"kanban-board\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Kanban Board</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Board\">\n    <select id=\"boardSel\" class=\"field\" aria-label=\"Board\" title=\"Choose a board\"></select>\n    <button id=\"boardMenuBtn\" class=\"btn\" aria-haspopup=\"menu\" aria-expanded=\"false\" title=\"New, rename, export, import or delete boards\">Board ▾</button>\n    <button id=\"addColBtn\" class=\"btn\" title=\"Add a column\">+ Column</button>\n    <button id=\"archBtn\" class=\"btn\" title=\"Archived cards: restore or delete them (Alt+A)\">Archive</button>\n    <span class=\"sep\"></span>\n    <input id=\"search\" class=\"field\" type=\"search\" placeholder=\"Search cards\" aria-label=\"Search cards\" title=\"Search titles, notes and checklists (Ctrl+F)\" autocomplete=\"off\">\n    <select id=\"labelSel\" class=\"field\" aria-label=\"Show label\"><option value=\"\">All labels</option></select>\n    <select id=\"dueSel\" class=\"field\" aria-label=\"Show due dates\">\n      <option value=\"\">Any date</option><option value=\"overdue\">Overdue</option><option value=\"today\">Due today</option><option value=\"week\">Due within a week</option><option value=\"none\">No due date</option>\n    </select>\n    <span class=\"grow\"></span>\n    <button id=\"themeBtn\" class=\"btn icon\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" aria-label=\"Help\" title=\"Keyboard shortcuts (F1)\">?</button>\n  </div>\n  <div id=\"filterNote\" class=\"fnote\" hidden></div>\n  <div id=\"board\" class=\"board\" aria-label=\"Columns\"></div>\n</div>\n\n<div id=\"menu\" class=\"menu\" role=\"menu\" hidden></div>\n<div id=\"dropLine\" class=\"dropline\" hidden></div>\n<div id=\"say\" class=\"sr\" aria-live=\"polite\"></div>\n\n<div id=\"cardDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cTitleLbl\">\n    <label id=\"cTitleLbl\" class=\"lbl\">Title <input id=\"cTitle\" class=\"field big\" maxlength=\"300\" autocomplete=\"off\"></label>\n    <div class=\"row\">\n      <div role=\"radiogroup\" aria-label=\"Colour label\" id=\"cLabels\" class=\"swatches\"></div>\n      <label class=\"lbl inline\">Due <input id=\"cDue\" class=\"field\" type=\"date\"></label>\n      <button id=\"cDueClear\" class=\"btn small\" title=\"Remove the due date\">No date</button>\n      <span id=\"cDueNote\" class=\"chip\"></span>\n    </div>\n    <label class=\"lbl\">Notes <textarea id=\"cNotes\" class=\"field ta\" rows=\"5\"></textarea></label>\n    <div class=\"lbl\">Checklist <span id=\"cProg\" class=\"muted\"></span></div>\n    <ul id=\"cList\" class=\"clist\"></ul>\n    <div class=\"row\"><input id=\"cNewItem\" class=\"field grow\" placeholder=\"Add an item and press Enter\" aria-label=\"New checklist item\" autocomplete=\"off\"><button id=\"cAddItem\" class=\"btn\">Add</button></div>\n    <div class=\"dacts\">\n      <label class=\"lbl inline\">Move to <select id=\"cMove\" class=\"field\"></select></label>\n      <button id=\"cArchive\" class=\"btn\" title=\"Put it in the archive (it can be restored)\">Archive</button>\n      <span class=\"grow\"></span>\n      <span class=\"muted small\">Saved as you type</span>\n      <button class=\"btn primary\" data-act=\"close\">Done</button>\n    </div>\n  </div>\n</div>\n\n<div id=\"nameDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"nameTitle\">\n    <h2 id=\"nameTitle\"></h2>\n    <input id=\"nameIn\" class=\"field big\" maxlength=\"80\" autocomplete=\"off\" aria-labelledby=\"nameTitle\">\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button id=\"nameOk\" class=\"btn primary\" data-act=\"ok\">OK</button></div>\n  </div>\n</div>\n\n<div id=\"confirmDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"confTitle\" aria-describedby=\"confMsg\">\n    <h2 id=\"confTitle\"></h2>\n    <p id=\"confMsg\"></p>\n    <div class=\"dacts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button id=\"confOk\" class=\"btn danger\" data-act=\"ok\">OK</button></div>\n  </div>\n</div>\n\n<div id=\"archDlg\" class=\"ov\" hidden>\n  <div class=\"dlg wide\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"archTitle\">\n    <h2 id=\"archTitle\">Archived cards</h2>\n    <div id=\"archList\" class=\"alist\"></div>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"close\">Close</button></div>\n  </div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Keyboard shortcuts</h2>\n    <table class=\"keys\">\n      <tr><td>Tab</td><td>Move between columns, cards and buttons</td></tr>\n      <tr><td>↑ ↓ ← →</td><td>Go to the next card up, down, or in the next column</td></tr>\n      <tr><td>Ctrl+↑ Ctrl+↓</td><td>Move the card up or down in its column</td></tr>\n      <tr><td>Ctrl+← Ctrl+→</td><td>Move the card to the next column</td></tr>\n      <tr><td>Enter or Space</td><td>Open the card</td></tr>\n      <tr><td>M or Shift+F10</td><td>Card menu: Move to, top, bottom, archive</td></tr>\n      <tr><td>Delete</td><td>Archive the card (restore it from Archive)</td></tr>\n      <tr><td>Alt+N</td><td>New card (in the column you are in)</td></tr>\n      <tr><td>Ctrl+F</td><td>Search</td></tr>\n      <tr><td>Alt+A</td><td>Archived cards</td></tr>\n      <tr><td>Esc</td><td>Close a dialog or menu, or stop a drag</td></tr>\n    </table>\n    <div class=\"dacts\"><button class=\"btn primary\" data-act=\"close\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/model.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Kanban Board: the window. Boards, columns and cards; drag and drop with pointer events (mouse, pen, touch),\n   keyboard moves and a Move to menu; the card dialog that saves as you type; archive, import and export.\n   Each board is saved on its own (boards/<id>.json) soon after every change. */\n(function () {\n  'use strict';\n  const K = window.Kanban, $ = id => document.getElementById(id);\n  const boardEl = $('board');\n  const num = n => n.toLocaleString('en-GB');\n  const plural = (n, w, ws) => num(n) + ' ' + (n === 1 ? w : ws || w + 's');\n\n  let settings = { theme: 'auto', current: '' };\n  let index = [];          // [{ id, name }]\n  let B = null;            // the open board\n  const filter = { q: '', label: '', due: '' };\n\n  /* ---------- helpers ---------- */\n  function h(tag, attrs, ...kids) {\n    const e = document.createElement(tag);\n    for (const k in attrs || {}) { const v = attrs[k]; if (v == null || v === false) continue; if (k === 'class') e.className = v; else if (k === 'text') e.textContent = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v === true ? '' : v); }\n    for (const k of kids.flat()) if (k != null) e.append(k);\n    return e;\n  }\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2400); }\n  const say = t => { $('say').textContent = ''; setTimeout(() => { $('say').textContent = t; }, 30); };\n  const labelName = k => (K.LABELS.find(l => l[0] === k) || [, ''])[1];\n  const short = t => '\"' + (t.length > 40 ? t.slice(0, 40) + '…' : t) + '\"';\n  const fmtDay = d => new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: new Date(d).getFullYear() === new Date().getFullYear() ? undefined : 'numeric' });\n  const DUE = { overdue: 'Overdue', today: 'Due today', soon: 'Due soon', later: 'Due' };\n\n  /* dialogs: focus moves in, Tab stays inside, Esc closes, focus goes back */\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea, select, [tabindex=\"0\"]')].filter(e => !e.disabled && e.offsetParent);\n    const f = first ? ov.querySelector(first) : focusables()[0]; if (f) f.focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); const to = (ov.onclose && ov.onclose()) || back; if (to && to.focus && document.contains(to)) to.focus(); else focusBoard(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b && ov.contains(b)) done(b.dataset.act); else if (e.target === ov) done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n      ov.done = done;\n    });\n  }\n  async function askName(title, value, okLabel) {\n    $('nameTitle').textContent = title; $('nameIn').value = value || ''; $('nameOk').textContent = okLabel || 'OK';\n    $('nameIn').onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); $('nameDlg').done('ok'); } };\n    const p = dialog('nameDlg', '#nameIn'); $('nameIn').select();\n    return (await p) === 'ok' ? $('nameIn').value.trim() : null;\n  }\n  async function confirmIt(title, msg, okLabel) {\n    $('confTitle').textContent = title; $('confMsg').textContent = msg; $('confOk').textContent = okLabel;\n    return (await dialog('confirmDlg', '[data-act=cancel]')) === 'ok';\n  }\n\n  /* ---------- a small pop-up menu: arrow keys, Enter, Esc ---------- */\n  const menuEl = $('menu');\n  let menuBack = null, menuAnchor = null;\n  /* anchor: what the menu opens beside; back: what gets the keyboard when it closes (the anchor if not given) */\n  function openMenu(anchor, items, back) {\n    menuEl.textContent = ''; menuAnchor = anchor; menuBack = back || anchor;\n    for (const it of items) {\n      if (it === '-') { menuEl.append(h('div', { class: 'msep', role: 'separator' })); continue; }\n      const b = h('button', { class: 'mi' + (it.danger ? ' danger' : ''), role: 'menuitem', tabindex: '-1', disabled: it.disabled || null }, it.label);\n      b.onclick = () => { closeMenu(); it.run(); };\n      menuEl.append(b);\n    }\n    menuEl.hidden = false;\n    const r = anchor.getBoundingClientRect(), mw = menuEl.offsetWidth, mh = menuEl.offsetHeight;\n    menuEl.style.left = Math.max(4, Math.min(innerWidth - mw - 4, r.left)) + 'px';\n    menuEl.style.top = (r.bottom + mh + 4 > innerHeight ? Math.max(4, r.top - mh - 2) : r.bottom + 2) + 'px';\n    anchor.setAttribute('aria-expanded', 'true');\n    const first = menuEl.querySelector('.mi:not(:disabled)'); if (first) first.focus();\n  }\n  function closeMenu(keepFocus) {\n    if (menuEl.hidden) return;\n    menuEl.hidden = true;\n    if (menuAnchor) menuAnchor.setAttribute('aria-expanded', 'false');\n    if (menuBack && !keepFocus && document.contains(menuBack)) menuBack.focus();\n  }\n  menuEl.addEventListener('keydown', e => {\n    const items = [...menuEl.querySelectorAll('.mi:not(:disabled)')], i = items.indexOf(document.activeElement);\n    const to = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: items.length - 1 }[e.key];\n    if (to !== undefined) { e.preventDefault(); items[(to + items.length) % items.length].focus(); }\n    else if (e.key === 'Escape' || e.key === 'Tab') { e.preventDefault(); closeMenu(); }\n    e.stopPropagation();\n  });\n  document.addEventListener('pointerdown', e => { if (!menuEl.hidden && !menuEl.contains(e.target)) closeMenu(true); }, true);\n\n  /* ---------- saving: each board to its own file, soon after every change ---------- */\n  let saveT = 0, pending = false;\n  function changed() { pending = true; clearTimeout(saveT); saveT = setTimeout(saveNow, 400); }\n  async function saveNow() {\n    clearTimeout(saveT); if (!pending || !B) return;\n    pending = false;\n    if (!await Host.saveData('boards/' + B.id + '.json', JSON.stringify(B, null, 1))) toast('Could not save the board.', 4000);\n  }\n  const saveIndex = () => Host.saveData('boards.json', JSON.stringify({ v: 1, boards: index }, null, 1));\n  addEventListener('pagehide', () => { if (pending) saveNow(); });\n  addEventListener('visibilitychange', () => { if (document.hidden && pending) saveNow(); });\n\n  /* ---------- drawing the board ---------- */\n  const filtering = () => !!(filter.q || filter.label || filter.due);\n  function cardEl(c, col) {\n    const p = K.progress(c), due = K.dueState(c, today);\n    const bits = [c.title];\n    if (c.label) bits.push(labelName(c.label) + ' label');\n    if (c.due) bits.push((DUE[due] || 'Due') + ' ' + fmtDay(c.due));\n    if (p.all) bits.push(p.done + ' of ' + p.all + ' checklist items done');\n    if (c.notes) bits.push('has notes');\n    const el = h('div', { class: 'card' + (c.label ? ' l-' + c.label : ''), tabindex: '0', role: 'listitem', 'data-id': c.id, 'aria-label': bits.join(', ') },\n      h('div', { class: 'ctitle' }, c.title),\n      (c.due || p.all || c.notes) ? h('div', { class: 'cmeta' },\n        c.due ? h('span', { class: 'due ' + due }, (due === 'overdue' ? '⚠ ' : '') + fmtDay(c.due)) : null,\n        p.all ? h('span', { class: 'prog' + (p.done === p.all ? ' full' : '') }, '☑ ' + p.done + '/' + p.all) : null,\n        c.notes ? h('span', { class: 'notes', title: 'Has notes' }, '≡') : null) : null,\n      h('button', { class: 'cmenu', 'aria-label': 'Actions for ' + c.title, 'aria-haspopup': 'menu', 'aria-expanded': 'false', tabindex: '-1', onclick: e => { e.stopPropagation(); cardMenu(c.id, e.currentTarget); } }, '⋯'));\n    return el;\n  }\n  let today = K.today();\n  function draw(focusId) {\n    today = K.today();\n    const keep = focusId || (document.activeElement && document.activeElement.closest && document.activeElement.closest('.card') ? document.activeElement.closest('.card').dataset.id : null);\n    const sx = boardEl.scrollLeft;\n    boardEl.textContent = '';\n    if (!B) return;\n    let shownCount = 0, total = 0;\n    B.columns.forEach((col, ci) => {\n      const visible = col.cards.filter(c => K.matches(c, filter, today));\n      shownCount += visible.length; total += col.cards.length;\n      const list = h('div', { class: 'cards', role: 'list', 'aria-label': col.name, 'data-col': col.id });\n      for (const c of visible) list.append(cardEl(c, col));\n      if (!col.cards.length) list.append(h('div', { class: 'empty muted' }, 'No cards yet'));\n      else if (!visible.length) list.append(h('div', { class: 'empty muted' }, 'None match the search or filters'));\n      const head = h('div', { class: 'chead' },\n        h('h2', { class: 'cname', title: 'Double-click to rename', ondblclick: () => renameColumn(col.id) }, col.name),\n        h('span', { class: 'ccount', 'aria-label': plural(col.cards.length, 'card') }, filtering() ? visible.length + '/' + col.cards.length : String(col.cards.length)),\n        h('button', { class: 'btn icon small', 'aria-label': 'Column actions for ' + col.name, 'aria-haspopup': 'menu', 'aria-expanded': 'false', onclick: e => colMenu(col.id, e.currentTarget) }, '⋯'));\n      const add = h('button', { class: 'addcard', 'data-col': col.id, onclick: () => addCard(col.id) }, '+ Add card');\n      boardEl.append(h('section', { class: 'col', 'data-col': col.id, 'aria-label': 'Column ' + (ci + 1) + ' of ' + B.columns.length + ': ' + col.name }, head, list, add));\n    });\n    boardEl.append(h('button', { class: 'addcol', onclick: addColumn }, '+ Add column'));\n    boardEl.scrollLeft = sx;\n    $('archBtn').textContent = 'Archive' + (B.archive.length ? ' (' + B.archive.length + ')' : '');\n    const fn = $('filterNote');\n    fn.hidden = !filtering();\n    if (filtering()) { fn.textContent = 'Showing ' + shownCount + ' of ' + plural(total, 'card') + '. '; fn.append(h('button', { class: 'linkbtn', onclick: () => clearFilters() }, 'Show all')); }\n    if (keep) { const el = boardEl.querySelector('.card[data-id=\"' + keep + '\"]'); if (el) el.focus({ preventScroll: false }); }\n  }\n  function drawBoards() {\n    const s = $('boardSel'); s.textContent = '';\n    for (const b of index) s.append(new Option(b.name, b.id));\n    if (B) s.value = B.id;\n    Host.setTitle(B ? B.name + ' - Kanban Board' : 'Kanban Board');\n  }\n  function focusBoard() { const c = boardEl.querySelector('.card') || boardEl.querySelector('.addcard'); if (c) c.focus(); }\n  const focusCard = id => { const el = boardEl.querySelector('.card[data-id=\"' + id + '\"]'); if (el) { el.focus(); el.scrollIntoView({ block: 'nearest', inline: 'nearest' }); } };\n\n  /* ---------- boards ---------- */\n  async function openBoard(id) {\n    if (pending) await saveNow();\n    let b = null;\n    const t = await Host.loadData('boards/' + id + '.json');\n    if (t !== null) { try { b = K.cleanBoard(JSON.parse(t)); } catch (e) { b = null; } }\n    if (!b) {\n      if (t !== null) { await Host.saveData('boards/' + id + '-unreadable-' + Date.now() + '.json', t); toast('That board\\'s file could not be read. It was kept under another name and an empty board started.', 7000); }\n      const entry = index.find(x => x.id === id);\n      b = K.newBoard(entry ? entry.name : 'My board'); b.id = id;\n    }\n    B = b; B.id = id;\n    settings.current = id; Host.saveSettings(settings);\n    clearFilters(true); drawBoards(); draw(); drawLabelFilter();\n  }\n  async function newBoard() {\n    const name = await askName('New board', '', 'Make board');\n    if (!name) return;\n    const b = K.newBoard(name);\n    index.push({ id: b.id, name: b.name }); await saveIndex();\n    await Host.saveData('boards/' + b.id + '.json', JSON.stringify(b, null, 1));\n    await openBoard(b.id); toast('Made the board \"' + b.name + '\"');\n  }\n  async function renameBoard() {\n    const name = await askName('Rename board', B.name, 'Rename');\n    if (!name || name === B.name) return;\n    B.name = name.slice(0, 80); index.find(x => x.id === B.id).name = B.name;\n    changed(); saveIndex(); drawBoards();\n  }\n  async function deleteBoard() {\n    const n = K.cardCount(B) + B.archive.length;\n    if (!await confirmIt('Delete board', 'Delete \"' + B.name + '\" and its ' + plural(n, 'card') + ' (archived ones too)? This cannot be undone. Use Export board first if you may want it back.', 'Delete board')) return;\n    const gone = B;\n    clearTimeout(saveT); pending = false;\n    await Host.removeData('boards/' + gone.id + '.json');\n    index = index.filter(x => x.id !== gone.id);\n    if (!index.length) { const b = K.newBoard('My board'); index.push({ id: b.id, name: b.name }); await Host.saveData('boards/' + b.id + '.json', JSON.stringify(b, null, 1)); }\n    await saveIndex();\n    await openBoard(index[0].id);\n    toast('Deleted the board \"' + gone.name + '\"');\n  }\n  async function exportBoard() {\n    await saveNow();\n    try {\n      const f = await Host.saveFile({ title: 'Export board', name: B.name.replace(/[\\\\/:*?\"<>|]/g, '_') + '.json', types: ['.json'], text: K.exportText(B), mime: 'application/json' });\n      if (f) toast('Exported \"' + B.name + '\" to ' + f.name, 3000);\n    } catch (e) { toast('Could not export: ' + e.message, 5000); }\n  }\n  async function offerImport(name, text) {\n    let b;\n    try { b = K.readExport(text); } catch (e) { toast(name + ': ' + e.message, 6000); return; }\n    if (!await confirmIt('Open board', name + ' holds the board \"' + b.name + '\" with ' + plural(K.cardCount(b), 'card') + '. Add it as a new board? Your other boards stay as they are.', 'Add board')) return;\n    b.id = K.newId();\n    let nm = b.name, n = 2;\n    while (index.some(x => x.name === nm)) nm = b.name + ' (' + n++ + ')';\n    b.name = nm;\n    index.push({ id: b.id, name: b.name }); await saveIndex();\n    await Host.saveData('boards/' + b.id + '.json', JSON.stringify(b, null, 1));\n    await openBoard(b.id); toast('Added the board \"' + b.name + '\"');\n  }\n  async function importBoard() {\n    try { const f = await Host.openFile({ title: 'Import board', types: ['.json'] }); if (f) await offerImport(f.name, f.text); }\n    catch (e) { toast(e.message, 4000); }\n  }\n  async function openGiven(o) {\n    try { const f = await Host.readPath(o.path, o.name); await offerImport(f.name, f.text); }\n    catch (e) { toast('Could not open \"' + o.name + '\": ' + e.message, 5000); }\n  }\n  $('boardSel').onchange = () => openBoard($('boardSel').value);\n  $('boardMenuBtn').onclick = e => openMenu(e.currentTarget, [\n    { label: 'New board…', run: newBoard }, { label: 'Rename board…', run: renameBoard }, '-',\n    { label: 'Export board…', run: exportBoard }, { label: 'Import board…', run: importBoard }, '-',\n    { label: 'Delete board…', danger: true, run: deleteBoard }]);\n\n  /* ---------- columns ---------- */\n  async function addColumn() {\n    const name = await askName('New column', '', 'Add column');\n    if (!name) return;\n    const c = K.column({ name }); B.columns.push(c); changed(); draw();\n    const el = boardEl.querySelector('.col[data-col=\"' + c.id + '\"] .addcard'); if (el) { el.focus(); el.scrollIntoView({ inline: 'nearest' }); }\n  }\n  async function renameColumn(id) {\n    const col = B.columns.find(c => c.id === id); if (!col) return;\n    const name = await askName('Rename column', col.name, 'Rename');\n    if (!name || name === col.name) return;\n    col.name = name.slice(0, 80); changed(); draw();\n  }\n  function moveColumn(id, by) {\n    const i = B.columns.findIndex(c => c.id === id), j = i + by;\n    if (j < 0 || j >= B.columns.length) return;\n    [B.columns[i], B.columns[j]] = [B.columns[j], B.columns[i]]; changed(); draw();\n    const btn = boardEl.querySelector('.col[data-col=\"' + id + '\"] .chead .btn'); if (btn) btn.focus();\n    say(B.columns[j].name + ' is now column ' + (j + 1) + ' of ' + B.columns.length);\n  }\n  async function deleteColumn(id) {\n    const col = B.columns.find(c => c.id === id); if (!col) return;\n    const n = col.cards.length;\n    if (!await confirmIt('Delete column', 'Delete the column \"' + col.name + '\"?' + (n ? ' Its ' + plural(n, 'card') + ' will go to the archive, where you can restore them.' : ''), 'Delete column')) return;\n    for (const c of col.cards.slice()) K.archive(B, c.id);\n    B.columns = B.columns.filter(c => c !== col); changed(); draw(); focusBoard();\n    toast('Deleted the column \"' + col.name + '\"' + (n ? '; ' + plural(n, 'card') + ' archived' : ''), 3500);\n  }\n  function colMenu(id, anchor) {\n    const i = B.columns.findIndex(c => c.id === id);\n    openMenu(anchor, [{ label: 'Rename…', run: () => renameColumn(id) }, { label: 'Move left', disabled: i === 0, run: () => moveColumn(id, -1) }, { label: 'Move right', disabled: i === B.columns.length - 1, run: () => moveColumn(id, 1) }, '-', { label: 'Delete column…', danger: true, run: () => deleteColumn(id) }]);\n  }\n  $('addColBtn').onclick = addColumn;\n\n  /* ---------- cards: adding, moving, archiving ---------- */\n  async function addCard(colId) {\n    const col = B.columns.find(c => c.id === colId) || B.columns[0];\n    if (!col) { toast('Add a column first.'); return; }\n    const title = await askName('New card in ' + col.name, '', 'Add card');\n    if (!title) return;\n    const c = K.card({ title }); col.cards.push(c); changed();\n    if (filtering() && !K.matches(c, filter, today)) clearFilters(true);\n    draw(c.id); say('Added ' + c.title + ' to ' + col.name);\n  }\n  function placeText(id) { const at = K.find(B, id); return at ? at.col.name + ', position ' + (at.i + 1) + ' of ' + at.col.cards.length : ''; }\n  function moveCard(id, colId, index) {\n    if (!K.move(B, id, colId, index)) return false;\n    changed(); draw(id); focusCard(id);\n    say('Moved ' + K.find(B, id).card.title + ' to ' + placeText(id));\n    return true;\n  }\n  /* the index in the whole column for \"before the visible card v\", or the end of the visible cards */\n  function indexBefore(col, visibleAfterId) {\n    if (visibleAfterId) return col.cards.findIndex(c => c.id === visibleAfterId);\n    const vis = col.cards.filter(c => K.matches(c, filter, today));\n    return vis.length ? col.cards.indexOf(vis[vis.length - 1]) + 1 : col.cards.length;\n  }\n  function archiveCard(id) {\n    const at = K.archive(B, id); if (!at) return;\n    const sib = at.col.cards[at.i] || at.col.cards[at.i - 1];\n    changed(); draw(sib ? sib.id : null);\n    if (sib) focusCard(sib.id); else { const a = boardEl.querySelector('.addcard[data-col=\"' + at.col.id + '\"]'); if (a) a.focus(); }\n    toast('Archived ' + short(at.card.title) + '. Restore it from Archive.', 3000);\n  }\n  function cardMenu(id, anchor) {\n    const at = K.find(B, id); if (!at) return;\n    const items = [{ label: 'Open', run: () => openCard(id) }, '-'];\n    for (const col of B.columns) if (col !== at.col) items.push({ label: 'Move to ' + col.name, run: () => moveCard(id, col.id, col.cards.length) });\n    items.push({ label: 'Move to top', disabled: at.i === 0, run: () => moveCard(id, at.col.id, 0) }, { label: 'Move to bottom', disabled: at.i === at.col.cards.length - 1, run: () => moveCard(id, at.col.id, at.col.cards.length) }, '-', { label: 'Archive', run: () => archiveCard(id) });\n    openMenu(anchor, items, boardEl.querySelector('.card[data-id=\"' + id + '\"]'));\n  }\n\n  /* ---------- the card dialog: everything is saved as you type ---------- */\n  let cardId = null;\n  const cur = () => cardId && K.find(B, cardId);\n  function touch() { const at = cur(); if (at) at.card.updated = Date.now(); changed(); }\n  function drawLabels() {\n    const box = $('cLabels'), c = cur().card; box.textContent = '';\n    for (const [k, name] of [['', 'None']].concat(K.LABELS)) {\n      const on = c.label === k;\n      const b = h('button', { class: 'sw' + (k ? ' l-' + k : ' none'), role: 'radio', 'aria-checked': String(on), 'aria-label': name, title: name, tabindex: on ? '0' : '-1', 'data-k': k }, k ? '' : '∅');\n      b.onclick = () => { c.label = k; touch(); drawLabels(); box.querySelector('[data-k=\"' + k + '\"]').focus(); };\n      box.append(b);\n    }\n  }\n  $('cLabels').addEventListener('keydown', e => {\n    const all = [...$('cLabels').children], i = all.indexOf(document.activeElement);\n    const to = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1 }[e.key];\n    if (to === undefined) return;\n    e.preventDefault(); all[(to + all.length) % all.length].click();\n  });\n  function drawDue() {\n    const c = cur().card, s = K.dueState(c, K.today()), n = $('cDueNote');\n    $('cDue').value = c.due; n.textContent = c.due ? (s === 'overdue' ? 'Overdue' : s === 'today' ? 'Due today' : fmtDay(c.due)) : '';\n    n.className = 'chip ' + s;\n  }\n  function drawList() {\n    const c = cur().card, ul = $('cList'), p = K.progress(c);\n    ul.textContent = '';\n    $('cProg').textContent = p.all ? p.done + ' of ' + p.all + ' done' : '';\n    c.checklist.forEach((it, i) => {\n      const box = h('input', { type: 'checkbox', 'aria-label': 'Done: ' + (it.text || 'item ' + (i + 1)) }); box.checked = it.done;\n      box.onchange = () => { it.done = box.checked; touch(); $('cProg').textContent = K.progress(c).done + ' of ' + c.checklist.length + ' done'; };\n      const txt = h('input', { class: 'field grow', value: it.text, 'aria-label': 'Checklist item ' + (i + 1), autocomplete: 'off' });\n      txt.oninput = () => { it.text = txt.value.slice(0, 500); touch(); };\n      const del = h('button', { class: 'btn icon small', 'aria-label': 'Remove item ' + (it.text || i + 1), title: 'Remove this item' }, '×');\n      del.onclick = () => { c.checklist.splice(i, 1); touch(); drawList(); const nx = ul.querySelectorAll('.field')[Math.min(i, c.checklist.length - 1)]; (nx || $('cNewItem')).focus(); };\n      ul.append(h('li', { class: it.done ? 'done' : null }, box, txt, del));\n    });\n  }\n  function drawMoveSel() {\n    const at = cur(), s = $('cMove'); s.textContent = '';\n    for (const col of B.columns) s.append(new Option(col.name, col.id));\n    s.value = at.col.id;\n  }\n  async function openCard(id) {\n    const at = K.find(B, id); if (!at) return;\n    cardId = id;\n    $('cTitle').value = at.card.title; $('cNotes').value = at.card.notes; $('cNewItem').value = '';\n    drawLabels(); drawDue(); drawList(); drawMoveSel();\n    $('cardDlg').onclose = () => { const a = cur(); if (a && !a.card.title.trim()) a.card.title = 'Untitled card'; cardId = null; draw(id); return boardEl.querySelector('.card[data-id=\"' + id + '\"]'); };\n    await dialog('cardDlg', '#cTitle');\n  }\n  $('cTitle').oninput = () => { const at = cur(); if (!at) return; at.card.title = $('cTitle').value.slice(0, 300); touch(); };\n  $('cNotes').oninput = () => { const at = cur(); if (!at) return; at.card.notes = $('cNotes').value.slice(0, 20000); touch(); };\n  $('cDue').onchange = $('cDue').oninput = () => { const at = cur(); if (!at) return; const v = $('cDue').value; at.card.due = /^\\d{4}-\\d\\d-\\d\\d$/.test(v) ? v : ''; touch(); drawDue(); };\n  $('cDueClear').onclick = () => { const at = cur(); if (!at) return; at.card.due = ''; touch(); drawDue(); $('cDue').focus(); };\n  function addItem() {\n    const at = cur(), t = $('cNewItem').value.trim(); if (!at || !t) return;\n    at.card.checklist.push({ id: K.newId(), text: t.slice(0, 500), done: false }); $('cNewItem').value = '';\n    touch(); drawList(); $('cNewItem').focus();\n  }\n  $('cNewItem').onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); addItem(); } };\n  $('cAddItem').onclick = addItem;\n  $('cMove').onchange = () => { const at = cur(); if (!at) return; const col = B.columns.find(c => c.id === $('cMove').value); if (col && col !== at.col) { K.move(B, at.card.id, col.id, col.cards.length); changed(); say('Moved to ' + col.name); toast('Moved to ' + col.name); } };\n  $('cArchive').onclick = () => { const id = cardId; $('cardDlg').done('archived'); archiveCard(id); };\n\n  /* ---------- the archive ---------- */\n  function drawArchive() {\n    const box = $('archList'); box.textContent = '';\n    if (!B.archive.length) { box.append(h('p', { class: 'muted' }, 'Nothing is archived. Archived cards are kept here until you restore or delete them.')); return; }\n    for (const a of B.archive) {\n      const del = h('button', { class: 'btn danger small', 'aria-label': 'Delete forever: ' + a.title }, 'Delete forever');\n      let t = 0;\n      del.onclick = () => {\n        if (!t) { del.textContent = 'Click again to delete'; t = setTimeout(() => { t = 0; del.textContent = 'Delete forever'; }, 3000); return; }\n        clearTimeout(t); B.archive = B.archive.filter(x => x !== a); changed(); drawArchive(); draw();\n        toast('Deleted ' + short(a.title) + ' for good'); const f = box.querySelector('button'); (f || $('archDlg').querySelector('[data-act]')).focus();\n      };\n      const res = h('button', { class: 'btn small primary', 'aria-label': 'Restore ' + a.title }, 'Restore');\n      res.onclick = () => { const col = K.restore(B, a.id); changed(); drawArchive(); draw(); toast('Restored ' + short(a.title) + ' to ' + col.name); const f = box.querySelector('button'); (f || $('archDlg').querySelector('[data-act]')).focus(); };\n      box.append(h('div', { class: 'arow' }, h('div', { class: 'ainfo' }, h('b', null, a.title), h('div', { class: 'muted small' }, 'From ' + (a.from || '?') + ' · archived ' + new Date(a.archived).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }))), res, del));\n    }\n  }\n  $('archBtn').onclick = () => { drawArchive(); dialog('archDlg', '#archList button'); };\n  $('helpBtn').onclick = () => dialog('helpDlg');\n\n  /* ---------- search and filters ---------- */\n  function drawLabelFilter() {\n    const s = $('labelSel'), v = filter.label; s.textContent = '';\n    s.append(new Option('All labels', ''));\n    for (const [k, name] of K.LABELS) s.append(new Option(name, k));\n    s.value = v;\n  }\n  function clearFilters(quiet) { filter.q = filter.label = filter.due = ''; $('search').value = ''; $('labelSel').value = ''; $('dueSel').value = ''; if (!quiet) { draw(); focusBoard(); } }\n  let st = 0;\n  $('search').addEventListener('input', () => { clearTimeout(st); st = setTimeout(() => { filter.q = $('search').value.trim(); draw(); }, 120); });\n  $('search').addEventListener('keydown', e => { if (e.key === 'Escape' && $('search').value) { e.preventDefault(); e.stopPropagation(); $('search').value = ''; filter.q = ''; draw(); } });\n  $('labelSel').onchange = () => { filter.label = $('labelSel').value; draw(); };\n  $('dueSel').onchange = () => { filter.due = $('dueSel').value; draw(); };\n\n  /* ---------- keyboard on cards ---------- */\n  boardEl.addEventListener('keydown', e => {\n    const el = e.target.closest && e.target.closest('.card');\n    if (!el || e.target !== el) return;\n    const id = el.dataset.id, at = K.find(B, id); if (!at) return;\n    const colEls = [...boardEl.querySelectorAll('.col')], ci = colEls.indexOf(el.closest('.col'));\n    const vis = [...el.parentNode.querySelectorAll('.card')], vi = vis.indexOf(el);\n    const k = e.key, ctrl = e.ctrlKey || e.metaKey;\n    if (k === 'Enter' || (k === ' ' && !ctrl)) { e.preventDefault(); openCard(id); }\n    else if (k === 'Delete') { e.preventDefault(); archiveCard(id); }\n    else if ((k === 'm' || k === 'M') && !ctrl && !e.altKey || (k === 'F10' && e.shiftKey) || k === 'ContextMenu') { e.preventDefault(); cardMenu(id, el.querySelector('.cmenu')); }\n    else if (!ctrl && (k === 'ArrowDown' || k === 'ArrowUp')) { e.preventDefault(); const n = vis[vi + (k === 'ArrowDown' ? 1 : -1)]; if (n) n.focus(); }\n    else if (!ctrl && (k === 'ArrowLeft' || k === 'ArrowRight')) {\n      e.preventDefault();\n      for (let j = ci + (k === 'ArrowRight' ? 1 : -1); j >= 0 && j < colEls.length; j += k === 'ArrowRight' ? 1 : -1) { const cs = colEls[j].querySelectorAll('.card'); if (cs.length) { cs[Math.min(vi, cs.length - 1)].focus(); break; } }\n    }\n    else if (ctrl && (k === 'ArrowUp' || k === 'ArrowDown')) {\n      e.preventDefault();\n      const other = vis[vi + (k === 'ArrowDown' ? 1 : -1)];\n      if (!other) { say(k === 'ArrowUp' ? 'Already at the top' : 'Already at the bottom'); return; }\n      const oi = at.col.cards.findIndex(c => c.id === other.dataset.id);\n      moveCard(id, at.col.id, k === 'ArrowDown' ? oi + 1 : oi);\n    }\n    else if (ctrl && (k === 'ArrowLeft' || k === 'ArrowRight')) {\n      e.preventDefault();\n      const to = B.columns[B.columns.indexOf(at.col) + (k === 'ArrowRight' ? 1 : -1)];\n      if (!to) { say('No column that way'); return; }\n      const tv = to.cards.filter(c => K.matches(c, filter, today));\n      moveCard(id, to.id, indexBefore(to, tv[vi] ? tv[vi].id : null));\n    }\n  });\n  boardEl.addEventListener('click', e => { const el = e.target.closest('.card'); if (el && !e.target.closest('.cmenu') && !dragJustEnded) openCard(el.dataset.id); });\n\n  /* ---------- drag and drop: pointer events, so mouse, pen and touch all work ---------- */\n  let drag = null, dragJustEnded = false;\n  const line = $('dropLine');\n  boardEl.addEventListener('pointerdown', e => {\n    const el = e.target.closest('.card');\n    if (!el || e.button !== 0 || e.target.closest('.cmenu')) return;\n    drag = { id: el.dataset.id, el, x: e.clientX, y: e.clientY, pid: e.pointerId, on: false, target: null };\n  });\n  addEventListener('pointermove', e => {\n    if (!drag || e.pointerId !== drag.pid) return;\n    if (!drag.on) {\n      if (Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) < 6) return;\n      drag.on = true;\n      const r = drag.el.getBoundingClientRect();\n      drag.dx = e.clientX - r.left; drag.dy = e.clientY - r.top;\n      drag.ghost = drag.el.cloneNode(true); drag.ghost.className += ' ghost'; drag.ghost.removeAttribute('tabindex'); drag.ghost.setAttribute('aria-hidden', 'true');\n      drag.ghost.style.width = r.width + 'px'; document.body.append(drag.ghost);\n      drag.el.classList.add('dragging'); document.body.classList.add('dragmode');\n      try { drag.el.setPointerCapture(e.pointerId); } catch (x) {}\n    }\n    e.preventDefault();\n    drag.ghost.style.left = (e.clientX - drag.dx) + 'px'; drag.ghost.style.top = (e.clientY - drag.dy) + 'px';\n    /* scroll the board or the column when near an edge */\n    const br = boardEl.getBoundingClientRect();\n    if (e.clientX < br.left + 40) boardEl.scrollLeft -= 12; else if (e.clientX > br.right - 40) boardEl.scrollLeft += 12;\n    /* where it would land */\n    drag.ghost.style.display = 'none';\n    const under = document.elementFromPoint(e.clientX, e.clientY);\n    drag.ghost.style.display = '';\n    const colEl = under && under.closest('.col');\n    if (!colEl) { drag.target = null; line.hidden = true; return; }\n    const list = colEl.querySelector('.cards'), lr = list.getBoundingClientRect();\n    if (e.clientY < lr.top + 30) list.scrollTop -= 10; else if (e.clientY > lr.bottom - 30) list.scrollTop += 10;\n    const cards = [...list.querySelectorAll('.card:not(.dragging)')];\n    let before = null;\n    for (const c of cards) { const r = c.getBoundingClientRect(); if (e.clientY < r.top + r.height / 2) { before = c; break; } }\n    drag.target = { col: colEl.dataset.col, before: before ? before.dataset.id : null };\n    const ref = before ? before.getBoundingClientRect() : cards.length ? cards[cards.length - 1].getBoundingClientRect() : null;\n    line.hidden = false;\n    line.style.left = (lr.left + 6) + 'px'; line.style.width = (lr.width - 12) + 'px';\n    line.style.top = (ref ? (before ? ref.top - 4 : ref.bottom + 2) : lr.top + 6) + 'px';\n  });\n  function endDrag(drop) {\n    if (!drag) return;\n    const d = drag; drag = null;\n    line.hidden = true; document.body.classList.remove('dragmode');\n    if (!d.on) return;\n    d.ghost.remove(); d.el.classList.remove('dragging');\n    dragJustEnded = true; setTimeout(() => { dragJustEnded = false; }, 50);\n    if (drop && d.target) {\n      const col = B.columns.find(c => c.id === d.target.col);\n      if (col && !moveCard(d.id, col.id, indexBefore(col, d.target.before))) draw(d.id);\n    } else draw(d.id);\n  }\n  addEventListener('pointerup', e => { if (drag && e.pointerId === drag.pid) endDrag(true); });\n  addEventListener('pointercancel', e => { if (drag && e.pointerId === drag.pid) endDrag(false); });\n  addEventListener('keydown', e => { if (drag && drag.on && e.key === 'Escape') { e.preventDefault(); endDrag(false); say('Move cancelled'); } }, true);\n\n  /* ---------- global keys ---------- */\n  document.addEventListener('keydown', e => {\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])') || !menuEl.hidden) return;\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    let go = null;\n    if (ctrl && !e.altKey && !e.shiftKey && k === 'f') go = () => { $('search').focus(); $('search').select(); };\n    else if (e.altKey && !ctrl && k === 'n') go = () => { const c = document.activeElement && document.activeElement.closest && document.activeElement.closest('.col'); addCard(c ? c.dataset.col : (B.columns[0] || {}).id); };\n    else if (e.altKey && !ctrl && k === 'a') go = () => $('archBtn').click();\n    else if (e.key === 'F1') go = () => $('helpBtn').click();\n    if (go) { e.preventDefault(); go(); }\n  });\n\n  /* ---------- theme ---------- */\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); toast(THEMES[settings.theme][1]); };\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    try { const o = JSON.parse(await Host.loadData('boards.json') || 'null'); index = o && Array.isArray(o.boards) ? o.boards.filter(b => b && typeof b.id === 'string' && /^[a-z0-9]{1,40}$/.test(b.id)).map(b => ({ id: b.id, name: String(b.name || 'My board').slice(0, 80) })) : []; } catch (e) { index = []; }\n    if (!index.length) {\n      const b = K.newBoard('My board');\n      const c = (t, o) => K.card(Object.assign({ title: t }, o));\n      b.columns[0].cards.push(c('Try dragging this card to Doing', { notes: 'Or select it and press Ctrl+→. Each card can have notes like these, a due date, a colour label and a checklist.', label: 'blue' }),\n        c('A card with a checklist', { checklist: [{ text: 'Open the card (click or Enter)', done: true }, { text: 'Tick an item', done: false }, { text: 'Add your own', done: false }] }),\n        c('Due soon', { due: K.addDays(K.today(), 2), label: 'orange' }));\n      b.columns[2].cards.push(c('Archive me when you are done', { notes: 'Archived cards can be restored from Archive.', label: 'green' }));\n      index = [{ id: b.id, name: b.name }];\n      await Host.saveData('boards/' + b.id + '.json', JSON.stringify(b, null, 1)); await saveIndex();\n    }\n    await openBoard(index.some(b => b.id === settings.current) ? settings.current : index[0].id);\n    focusBoard();\n    Host.onOpenFile(openGiven);\n    const start = Host.startFile();\n    if (start) openGiven(start);\n    window.__kb = { get B() { return B; }, get index() { return index; }, saveNow, filter, ready: true };\n  })();\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/model.js": {
   "enc": "text",
   "d": "/* Kanban Board: the boards themselves. Making, cleaning up what is loaded, moving, archiving, filtering and the\n   export file. No drawing here; app.js draws. Everything hangs off window.Kanban. */\n(function () {\n  'use strict';\n  const K = window.Kanban = {};\n  K.LABELS = [['red', 'Red'], ['orange', 'Orange'], ['yellow', 'Yellow'], ['green', 'Green'], ['blue', 'Blue'], ['purple', 'Purple']];\n  const LABEL_KEYS = K.LABELS.map(l => l[0]);\n  K.newId = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\n  const str = (v, n) => (typeof v === 'string' ? v : '').slice(0, n);\n  const time = v => (typeof v === 'number' && isFinite(v) && v > 0 ? Math.round(v) : 0);\n  const isDate = v => typeof v === 'string' && /^\\d{4}-\\d\\d-\\d\\d$/.test(v) && !isNaN(new Date(v + 'T00:00:00'));\n\n  /* ---------- making and cleaning ---------- */\n  K.card = function (o, now) {\n    o = o && typeof o === 'object' ? o : {};\n    now = now || Date.now();\n    return {\n      id: str(o.id, 40) || K.newId(),\n      title: str(o.title, 300).trim() || 'Untitled card',\n      notes: str(o.notes, 20000),\n      due: isDate(o.due) ? o.due : '',\n      label: LABEL_KEYS.includes(o.label) ? o.label : '',\n      checklist: (Array.isArray(o.checklist) ? o.checklist : []).slice(0, 200).map(i => ({ id: str(i && i.id, 40) || K.newId(), text: str(i && i.text, 500), done: !!(i && i.done) })),\n      created: time(o.created) || now,\n      updated: time(o.updated) || time(o.created) || now\n    };\n  };\n  K.column = (o) => ({ id: str(o && o.id, 40) || K.newId(), name: str(o && o.name, 80).trim() || 'Untitled', cards: (o && Array.isArray(o.cards) ? o.cards : []).slice(0, 2000).map(c => K.card(c)) });\n  K.newBoard = name => ({ v: 1, id: K.newId(), name: str(name, 80).trim() || 'My board', columns: ['To do', 'Doing', 'Done'].map(n => K.column({ name: n })), archive: [] });\n  /* a board as loaded from a file: anything missing or wrong is filled in, ids are made unique */\n  K.cleanBoard = function (o) {\n    o = o && typeof o === 'object' ? o : {};\n    const b = { v: 1, id: str(o.id, 40) || K.newId(), name: str(o.name, 80).trim() || 'My board', columns: (Array.isArray(o.columns) ? o.columns : []).slice(0, 50).map(K.column), archive: [] };\n    b.archive = (Array.isArray(o.archive) ? o.archive : []).slice(0, 5000).map(a => Object.assign(K.card(a), { from: str(a && a.from, 80), archived: time(a && a.archived) || Date.now() }));\n    const ids = new Set();\n    const uniq = x => { while (ids.has(x.id)) x.id = K.newId(); ids.add(x.id); };\n    for (const c of b.columns) { uniq(c); c.cards.forEach(uniq); }\n    b.archive.forEach(uniq);\n    return b;\n  };\n\n  /* ---------- finding and moving ---------- */\n  K.find = function (b, cardId) {\n    for (const col of b.columns) { const i = col.cards.findIndex(c => c.id === cardId); if (i >= 0) return { col, i, card: col.cards[i] }; }\n    return null;\n  };\n  /* moves a card to a column at an index (the index counts the cards there before the move); returns true if it moved */\n  K.move = function (b, cardId, colId, index) {\n    const at = K.find(b, cardId), to = b.columns.find(c => c.id === colId);\n    if (!at || !to) return false;\n    let i = Math.max(0, Math.min(index, to.cards.length));\n    if (at.col === to && (i === at.i || i === at.i + 1)) return false;\n    at.col.cards.splice(at.i, 1);\n    if (at.col === to && i > at.i) i--;\n    to.cards.splice(i, 0, at.card);\n    at.card.updated = Date.now();\n    return true;\n  };\n  K.archive = function (b, cardId) {\n    const at = K.find(b, cardId); if (!at) return null;\n    at.col.cards.splice(at.i, 1);\n    b.archive.unshift(Object.assign(at.card, { from: at.col.name, archived: Date.now() }));\n    return at;\n  };\n  /* back to the column it came from (by name), or the first column; returns the column */\n  K.restore = function (b, cardId) {\n    const i = b.archive.findIndex(c => c.id === cardId); if (i < 0) return null;\n    const a = b.archive.splice(i, 1)[0];\n    let col = b.columns.find(c => c.name === a.from) || b.columns[0];\n    if (!col) { col = K.column({ name: 'To do' }); b.columns.push(col); }\n    delete a.from; delete a.archived; a.updated = Date.now();\n    col.cards.push(a);\n    return col;\n  };\n\n  /* ---------- dates and filters ---------- */\n  K.today = () => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };\n  K.addDays = (day, n) => { const d = new Date(day + 'T12:00:00'); d.setDate(d.getDate() + n); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };\n  /* 'overdue', 'today', 'soon' (within 7 days), 'later' or '' */\n  K.dueState = function (c, today) {\n    if (!c.due) return '';\n    today = today || K.today();\n    return c.due < today ? 'overdue' : c.due === today ? 'today' : c.due <= K.addDays(today, 7) ? 'soon' : 'later';\n  };\n  K.matches = function (c, f, today) {\n    if (f.label && c.label !== f.label) return false;\n    if (f.due) {\n      const s = K.dueState(c, today);\n      if (f.due === 'overdue' && s !== 'overdue') return false;\n      if (f.due === 'today' && s !== 'today') return false;\n      if (f.due === 'week' && !(s === 'today' || s === 'soon' || s === 'overdue')) return false;\n      if (f.due === 'none' && c.due) return false;\n    }\n    if (f.q) {\n      const hay = (c.title + '\\n' + c.notes + '\\n' + c.checklist.map(i => i.text).join('\\n')).toLowerCase();\n      if (!f.q.toLowerCase().split(/\\s+/).filter(Boolean).every(w => hay.includes(w))) return false;\n    }\n    return true;\n  };\n  K.progress = c => ({ done: c.checklist.filter(i => i.done).length, all: c.checklist.length });\n\n  /* ---------- the export file ---------- */\n  K.exportText = b => JSON.stringify({ format: 'portd-kanban', v: 1, exported: new Date().toISOString(), board: b }, null, 2);\n  K.readExport = function (text) {\n    let o;\n    try { o = JSON.parse(text); } catch (e) { throw new Error('This file is not valid JSON, so it is not a Kanban board.'); }\n    if (!o || o.format !== 'portd-kanban' || !o.board || typeof o.board !== 'object') throw new Error('This JSON file is not a Kanban board. Only files made with Export board can be opened.');\n    if (typeof o.v === 'number' && o.v > 1) throw new Error('This board was made by a newer version of Kanban Board.');\n    return K.cleanBoard(o.board);\n  };\n  K.cardCount = b => b.columns.reduce((n, c) => n + c.cards.length, 0);\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Kanban Board */\n:root {\n  --bg: #ffffff; --boardbg: #eef1f6; --colbg: #e2e7ef; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2f5fb3; --onaccent: #ffffff; --sel: #dbe5f7; --card: #ffffff;\n  --ok: #1e6b37; --okbg: #e3f4e8; --err: #b42318; --errbg: #fde8e8; --warn: #8a5a00; --warnbg: #fff1cc; --danger: #b42318; --dangerbg: #fde8e8;\n  --l-red: #d64541; --l-orange: #e07b17; --l-yellow: #d4a900; --l-green: #2f9e5b; --l-blue: #3474d6; --l-purple: #8a4fd0;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --boardbg: #151920; --colbg: #232833; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #86b0ff; --onaccent: #0b1a33; --sel: #2c3f63; --card: #2c3240;\n  --ok: #8fe0a8; --okbg: #183524; --err: #ff9b94; --errbg: #4a2a2e; --warn: #ffd27a; --warnbg: #3a3018; --danger: #ff9b94; --dangerbg: #4a2a2e;\n  --l-red: #f0706b; --l-orange: #f5a04f; --l-yellow: #f2d04a; --l-green: #5fcf8d; --l-blue: #6fa4f5; --l-purple: #b88cf0;\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; } .grow { flex: 1; }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled { opacity: .5; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.danger { color: var(--danger); border-color: var(--danger); }\n.btn.danger:hover { background: var(--dangerbg); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.btn.small { min-height: 24px; padding: 2px 8px; font-size: 12px; }\n#search { width: 170px; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } .btn.small { min-height: 36px; } }\n.fnote { padding: 4px 10px; background: var(--warnbg); color: var(--warn); border-bottom: 1px solid var(--line); font-size: 12.5px; }\n.linkbtn { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }\n\n.board { flex: 1; min-height: 0; display: flex; align-items: flex-start; gap: 10px; padding: 10px; overflow: auto; background: var(--boardbg); }\n.col { flex: 0 0 260px; max-height: 100%; display: flex; flex-direction: column; background: var(--colbg); border-radius: 8px; border: 1px solid var(--line); }\n.chead { display: flex; align-items: center; gap: 6px; padding: 6px 6px 4px 10px; }\n.cname { flex: 1; font-size: 13.5px; margin: 0; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: default; }\n.ccount { font-size: 11.5px; color: var(--muted); background: var(--bg); border-radius: 9px; padding: 0 7px; }\n.cards { flex: 1; min-height: 40px; overflow-y: auto; padding: 4px 6px; display: flex; flex-direction: column; gap: 6px; }\n.empty { padding: 8px 4px; font-size: 12px; text-align: center; }\n.card { position: relative; background: var(--card); border: 1px solid var(--line); border-left: 5px solid var(--line); border-radius: 6px; padding: 6px 28px 6px 8px; cursor: grab; box-shadow: 0 1px 1px rgba(0,0,0,.06); touch-action: none; user-select: none; }\n.card:hover { border-color: var(--edge); }\n.card:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n.card.l-red { border-left-color: var(--l-red); } .card.l-orange { border-left-color: var(--l-orange); } .card.l-yellow { border-left-color: var(--l-yellow); }\n.card.l-green { border-left-color: var(--l-green); } .card.l-blue { border-left-color: var(--l-blue); } .card.l-purple { border-left-color: var(--l-purple); }\n.ctitle { overflow-wrap: anywhere; }\n.cmeta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; font-size: 11.5px; color: var(--muted); }\n.due { border-radius: 4px; padding: 0 5px; }\n.due.overdue { background: var(--errbg); color: var(--err); font-weight: 600; }\n.due.today { background: var(--warnbg); color: var(--warn); font-weight: 600; }\n.prog.full { color: var(--ok); }\n.cmenu { position: absolute; top: 3px; right: 3px; width: 22px; height: 22px; border: 0; border-radius: 4px; background: transparent; color: var(--muted); cursor: pointer; font-size: 14px; line-height: 1; }\n.cmenu:hover, .card:focus-within .cmenu { background: var(--sel); color: var(--text); }\n@media (pointer: coarse) { .card { padding: 10px 40px 10px 10px; } .cmenu { width: 34px; height: 34px; } }\n.addcard { margin: 2px 6px 6px; text-align: left; font: inherit; color: var(--muted); background: transparent; border: 1px dashed transparent; border-radius: 6px; padding: 5px 8px; cursor: pointer; }\n.addcard:hover, .addcard:focus-visible { color: var(--text); background: var(--bg); border-color: var(--edge); }\n.addcol { flex: 0 0 160px; font: inherit; color: var(--muted); background: transparent; border: 2px dashed var(--line); border-radius: 8px; padding: 10px; cursor: pointer; }\n.addcol:hover { color: var(--text); border-color: var(--edge); }\n.card.dragging { opacity: .35; }\n.card.ghost { position: fixed; z-index: 50; pointer-events: none; box-shadow: 0 10px 24px rgba(0,0,0,.3); transform: rotate(2deg); opacity: .95; }\nbody.dragmode, body.dragmode * { cursor: grabbing !important; }\n.dropline { position: fixed; height: 3px; background: var(--accent); border-radius: 2px; z-index: 49; pointer-events: none; }\n\n.menu { position: fixed; z-index: 60; min-width: 180px; max-height: 70vh; overflow: auto; background: var(--bg); border: 1px solid var(--edge); border-radius: 8px; padding: 4px; box-shadow: 0 8px 24px rgba(0,0,0,.25); display: flex; flex-direction: column; }\n.mi { font: inherit; text-align: left; color: var(--text); background: transparent; border: 0; border-radius: 5px; padding: 6px 10px; cursor: pointer; }\n.mi:hover:not(:disabled), .mi:focus { background: var(--sel); outline: none; }\n.mi:disabled { color: var(--muted); opacity: .6; cursor: default; }\n.mi.danger { color: var(--danger); }\n.msep { height: 1px; background: var(--line); margin: 3px 4px; }\n@media (pointer: coarse) { .mi { padding: 11px 12px; } }\n\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 70; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 300px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); display: flex; flex-direction: column; gap: 8px; }\n.dlg.wide { width: 600px; max-width: 100%; }\n.dlg h2 { margin: 0 0 4px; font-size: 16px; }\n.dlg p { margin: 0; }\n.lbl { display: flex; flex-direction: column; gap: 3px; font-weight: 600; font-size: 12px; }\n.lbl.inline { flex-direction: row; align-items: center; gap: 6px; }\n.lbl .field { font-weight: 400; font-size: 13px; }\n.field.big { font-size: 15px; padding: 6px 10px; }\n.field.ta { resize: vertical; min-height: 70px; }\n.row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n.swatches { display: flex; gap: 4px; }\n.sw { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--edge); cursor: pointer; padding: 0; font-size: 12px; color: var(--muted); background: var(--panel); }\n.sw[aria-checked=\"true\"] { box-shadow: 0 0 0 2px var(--text); }\n.sw.l-red { background: var(--l-red); } .sw.l-orange { background: var(--l-orange); } .sw.l-yellow { background: var(--l-yellow); }\n.sw.l-green { background: var(--l-green); } .sw.l-blue { background: var(--l-blue); } .sw.l-purple { background: var(--l-purple); }\n@media (pointer: coarse) { .sw { width: 36px; height: 36px; } }\n.chip { font-size: 12px; border-radius: 9px; padding: 0 8px; }\n.chip:empty { display: none; }\n.chip.overdue { background: var(--errbg); color: var(--err); font-weight: 600; }\n.chip.today { background: var(--warnbg); color: var(--warn); font-weight: 600; }\n.clist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; max-height: 180px; overflow: auto; }\n.clist li { display: flex; align-items: center; gap: 6px; }\n.clist li input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); flex: none; }\n.clist li.done .field { text-decoration: line-through; color: var(--muted); }\n.dacts { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 8px; margin-top: 6px; }\n.alist { display: flex; flex-direction: column; gap: 6px; max-height: 55vh; overflow: auto; }\n.arow { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; }\n.ainfo { flex: 1; min-width: 0; }\n.keys { border-collapse: collapse; }\n.keys td { padding: 3px 10px 3px 0; vertical-align: top; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n\n.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 80; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } .card.ghost { transform: none; } }\n@media (forced-colors: active) { .card { border-left-width: 5px; } .sw[aria-checked=\"true\"] { outline: 3px solid Highlight; } }\n"
  }
 }
}