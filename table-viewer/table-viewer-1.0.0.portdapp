{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "table-viewer",
 "name": "Table Viewer",
 "version": "1.0.0",
 "description": "View CSV and TSV files as a table: sort, filter, copy as TSV and save.",
 "icon": "icon.svg",
 "entry": "index.html",
 "width": 900,
 "height": 520,
 "singleInstance": false,
 "fileTypes": [
  {
   "ext": ".csv",
   "name": "CSV table",
   "icon": "glyph:table"
  },
  {
   "ext": ".tsv",
   "name": "TSV table",
   "icon": "glyph:table"
  }
 ],
 "files": {
  "icon.svg": {
   "enc": "text",
   "d": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect x=\"3\" y=\"5\" width=\"26\" height=\"22\" rx=\"3\" fill=\"#2f9e6a\"/><rect x=\"5\" y=\"11\" width=\"22\" height=\"14\" rx=\"1\" fill=\"#ffffff\"/><path d=\"M5 16.5h22M5 21h22M12 11v14M20 11v14\" stroke=\"#2f9e6a\" stroke-width=\"1.4\"/><rect x=\"5\" y=\"7\" width=\"22\" height=\"3\" rx=\"1\" fill=\"#bfe8d2\"/></svg>\n"
  },
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"table-viewer\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Table Viewer</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\" role=\"toolbar\" aria-label=\"Table Viewer\">\n    <button id=\"openBtn\" class=\"btn\" title=\"Open a file (Ctrl+O)\">Open…</button>\n    <button id=\"saveBtn\" class=\"btn\" title=\"Save as (Ctrl+S)\" disabled>Save as…</button>\n    <button id=\"copyBtn\" class=\"btn\" title=\"Copy the selected rows, or all shown rows, as TSV (Ctrl+C)\" disabled>Copy as TSV</button>\n    <span class=\"sep\"></span>\n    <label class=\"lbl\" for=\"delim\">Delimiter</label>\n    <select id=\"delim\" class=\"field\" disabled>\n      <option value=\"auto\">Auto</option>\n      <option value=\",\">Comma</option>\n      <option value=\";\">Semicolon</option>\n      <option value=\"&#9;\">Tab</option>\n      <option value=\"|\">Pipe</option>\n    </select>\n    <label class=\"chk\"><input type=\"checkbox\" id=\"header\" checked disabled> Header row</label>\n    <span class=\"sep\"></span>\n    <input id=\"filter\" class=\"field grow\" type=\"search\" placeholder=\"Filter rows\" title=\"Filter rows (Ctrl+F)\" aria-label=\"Filter rows\" disabled>\n    <select id=\"filterCol\" class=\"field\" aria-label=\"Filter in\" disabled><option value=\"-1\">All columns</option></select>\n    <button id=\"themeBtn\" class=\"btn icon\" title=\"Theme: follows the system\" aria-label=\"Theme\"></button>\n    <button id=\"helpBtn\" class=\"btn icon\" title=\"Keyboard shortcuts (F1)\" aria-label=\"Help\">?</button>\n  </div>\n  <div id=\"warn\" class=\"warn\" role=\"status\" hidden></div>\n  <div id=\"grid\" class=\"grid\" tabindex=\"0\" role=\"grid\" aria-label=\"Table\" hidden>\n    <div id=\"head\" class=\"row head\" role=\"row\"></div>\n    <div id=\"body\" class=\"body\"></div>\n  </div>\n  <div id=\"empty\" class=\"empty\">\n    <div class=\"emptyIn\">\n      <img src=\"icon.svg\" alt=\"\" width=\"64\" height=\"64\">\n      <h1>Table Viewer</h1>\n      <p>Open a CSV or TSV file to see it as a table.</p>\n      <button id=\"openBig\" class=\"btn primary\">Open a file…</button>\n      <p class=\"muted small\">You can also drop a file on this window.</p>\n    </div>\n  </div>\n  <div id=\"status\" class=\"status\" aria-live=\"polite\"><span id=\"stFile\"></span><span id=\"stInfo\"></span><span id=\"stCell\" class=\"cellinfo\"></span></div>\n</div>\n\n<div id=\"saveDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"saveTitle\">\n    <h2 id=\"saveTitle\">Save as</h2>\n    <fieldset><legend>Format</legend>\n      <label><input type=\"radio\" name=\"fmt\" value=\",\" checked> CSV, comma separated (.csv)</label>\n      <label><input type=\"radio\" name=\"fmt\" value=\";\"> CSV, semicolon separated (.csv)</label>\n      <label><input type=\"radio\" name=\"fmt\" value=\"&#9;\"> TSV, tab separated (.tsv)</label>\n    </fieldset>\n    <fieldset id=\"rowsSet\"><legend>Rows</legend>\n      <label><input type=\"radio\" name=\"rows\" value=\"all\" checked> <span id=\"rowsAll\">All rows</span></label>\n      <label><input type=\"radio\" name=\"rows\" value=\"shown\"> <span id=\"rowsShown\">Only the rows shown</span></label>\n    </fieldset>\n    <div class=\"acts\"><button class=\"btn\" data-act=\"cancel\">Cancel</button><button class=\"btn primary\" data-act=\"ok\">Save…</button></div>\n  </div>\n</div>\n\n<div id=\"copyDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"copyTitle\">\n    <h2 id=\"copyTitle\">Copy</h2>\n    <p>This window is not allowed to use the clipboard. The text is selected below: press Ctrl+C to copy it.</p>\n    <textarea id=\"copyText\" readonly rows=\"8\"></textarea>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n\n<div id=\"helpDlg\" class=\"ov\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n    <h2 id=\"helpTitle\">Keyboard shortcuts</h2>\n    <table class=\"keys\">\n      <tr><td>Ctrl+O</td><td>Open a file</td></tr>\n      <tr><td>Ctrl+S</td><td>Save as</td></tr>\n      <tr><td>Ctrl+F</td><td>Filter rows</td></tr>\n      <tr><td>Esc</td><td>Clear the filter, or close a dialog</td></tr>\n      <tr><td>Arrow keys</td><td>Move around the table</td></tr>\n      <tr><td>Page Up / Down, Home / End</td><td>Move a page, or to the first or last column (with Ctrl: first or last row)</td></tr>\n      <tr><td>Shift + Up / Down, Shift+click</td><td>Select several rows</td></tr>\n      <tr><td>Ctrl+click</td><td>Add or remove one row</td></tr>\n      <tr><td>Ctrl+A</td><td>Select all shown rows</td></tr>\n      <tr><td>Ctrl+C</td><td>Copy the selected rows (or all shown rows) as TSV</td></tr>\n      <tr><td>S</td><td>Sort by the current column: up, down, off</td></tr>\n      <tr><td>F1</td><td>This list</td></tr>\n    </table>\n    <p class=\"muted small\">Click a column heading to sort by it. Drag the edge of a heading to change the column's width.</p>\n    <div class=\"acts\"><button class=\"btn primary\" data-act=\"cancel\">Close</button></div>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/csv.js\"></script>\n<script src=\"js/app.js\"></script>\n</body>\n</html>\n"
  },
  "js/app.js": {
   "enc": "text",
   "d": "/* Table Viewer: the window. Reads a delimited file, shows it as a table drawn only where it can be seen, and lets the\n   user sort, filter, select, copy and save it. */\n(function () {\n  'use strict';\n  const $ = id => document.getElementById(id);\n  const grid = $('grid'), head = $('head'), body = $('body');\n  const fmt = n => n.toLocaleString('en-GB');\n  const plural = (n, w) => fmt(n) + ' ' + w + (n === 1 ? '' : 's');\n  const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });\n\n  let settings = { theme: 'auto' };\n  let doc = null;           // the open file, see build()\n  let view = [];            // indices into doc.data, in the order shown\n  let sort = null;          // { col, dir: 1 | -1 }\n  let filter = { q: '', col: -1, bad: false };\n  let sel = new Set(), anchor = 0, cur = { r: 0, c: 0 };\n  let RH = 28, NW = 50, colX = [0], totalW = 0;\n\n  /* ---------- small helpers ---------- */\n  function toast(t, ms) { const el = $('toast'); el.textContent = t; el.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => el.classList.remove('show'), ms || 2200); }\n  function h(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }\n  const extOf = name => { const m = /\\.([^.\\\\/]+)$/.exec(name || ''); return m ? m[1].toLowerCase() : ''; };\n  const stem = name => (name || 'table').replace(/\\.[^.]+$/, '');\n  const delimName = ch => (CSV.DELIMS.find(d => d.ch === ch) || { name: 'Custom' }).name;\n\n  /* a dialog: resolves the data-act of the button pressed, 'cancel' on Esc; keeps Tab inside; gives focus back */\n  function dialog(id, first) {\n    const ov = $(id), back = document.activeElement;\n    ov.hidden = false;\n    const focusables = () => [...ov.querySelectorAll('button, input, textarea, select')].filter(e => !e.disabled && e.offsetParent);\n    (first ? ov.querySelector(first) : focusables()[0]).focus();\n    return new Promise(resolve => {\n      const done = act => { ov.hidden = true; ov.removeEventListener('click', onClick); ov.removeEventListener('keydown', onKey); if (back && back.focus) back.focus(); resolve(act); };\n      const onClick = e => { const b = e.target.closest('[data-act]'); if (b) done(b.dataset.act); else if (e.target === ov) done('cancel'); };\n      const onKey = e => {\n        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); done('cancel'); }\n        else if (e.key === 'Tab') { const f = focusables(), i = f.indexOf(document.activeElement); if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); } else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); } }\n        else if (e.key === 'Enter' && e.target.tagName === 'INPUT') { e.preventDefault(); const ok = ov.querySelector('[data-act=ok]'); if (ok) done('ok'); }\n        e.stopPropagation();\n      };\n      ov.addEventListener('click', onClick); ov.addEventListener('keydown', onKey);\n    });\n  }\n\n  /* ---------- reading a file into a table ---------- */\n  function build(file, delimChoice, header) {\n    const text = file.text, ext = extOf(file.name);\n    const delim = delimChoice === 'auto' ? CSV.sniff(text, ext) : delimChoice;\n    const p = CSV.parse(text, delim);\n    let rows = p.rows, lines = p.lines, names = null;\n    if (header && rows.length) { names = rows[0]; rows = rows.slice(1); lines = lines.slice(1); }\n    let expected = names ? names.length : 0;\n    if (!names) { const counts = {}; rows.forEach(r => { counts[r.length] = (counts[r.length] || 0) + 1; }); expected = +(Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0] || 0); }\n    const bad = [];\n    let ncols = expected;\n    rows.forEach((r, i) => { if (r.length !== expected) bad.push(i); if (r.length > ncols) ncols = r.length; });\n    const cols = [];\n    for (let c = 0; c < ncols; c++) cols.push(names && c < names.length ? (names[c] === '' ? 'Column ' + (c + 1) : names[c]) : names ? '(extra ' + (c - names.length + 1) + ')' : 'Column ' + (c + 1));\n    /* widths from the heading and the first rows; a column counts as numbers when most of its values are */\n    const widths = [], numeric = [];\n    for (let c = 0; c < ncols; c++) {\n      let w = cols[c].length + 2, nums = 0, vals = 0;\n      for (let i = 0; i < Math.min(rows.length, 400); i++) {\n        const v = rows[i][c];\n        if (v == null || v === '') continue;\n        vals++; if (CSV.num(v) !== null) nums++;\n        if (v.length > w) w = v.length;\n      }\n      widths.push(Math.max(56, Math.min(340, Math.round(w * 7.6 + 26))));\n      numeric.push(vals > 0 && nums / vals >= 0.8);\n    }\n    return { name: file.name, path: file.path, text, ext, delim, auto: delimChoice === 'auto', header: !!names, names, cols, data: rows, lines, bad: new Set(bad), badList: bad,\n      expected, unterminated: p.unterminated, eol: CSV.eol(text), widths, numeric };\n  }\n\n  async function open(file) {\n    try {\n      doc = build(file, 'auto', true);\n    } catch (e) { toast('Could not read \"' + file.name + '\": ' + e.message, 4000); return; }\n    $('delim').value = 'auto'; $('header').checked = true;\n    sort = null; filter = { q: '', col: -1, bad: false }; $('filter').value = '';\n    afterBuild(true);\n    Host.setTitle(doc.name + ' - Table Viewer');\n  }\n  function rebuild() {\n    if (!doc) return;\n    const file = { name: doc.name, path: doc.path, text: doc.text };\n    doc = build(file, $('delim').value, $('header').checked);\n    sort = sort && sort.col < doc.cols.length ? sort : null;\n    afterBuild(false);\n  }\n  function afterBuild(fresh) {\n    for (const id of ['saveBtn', 'copyBtn', 'delim', 'header', 'filter', 'filterCol']) $(id).disabled = false;\n    $('empty').hidden = true; grid.hidden = false;\n    const fc = $('filterCol'), keep = filter.col;\n    fc.textContent = ''; fc.append(new Option('All columns', '-1'));\n    doc.cols.forEach((n, i) => fc.append(new Option(n, String(i))));\n    filter.col = keep < doc.cols.length ? keep : -1; fc.value = String(filter.col);\n    sel.clear(); anchor = 0; cur = { r: 0, c: 0 };\n    if (fresh) { grid.scrollTop = 0; grid.scrollLeft = 0; }\n    measure(); showWarnings(); applyView(); grid.focus({ preventScroll: true });\n  }\n\n  /* ---------- warnings about the file ---------- */\n  function showWarnings() {\n    const w = $('warn'); w.textContent = ''; w.hidden = true;\n    const parts = [];\n    if (doc.unterminated) parts.push('The file ends inside a quoted value that starts on line ' + fmt(doc.unterminated) + ', so the last row may be wrong.');\n    if (doc.badList.length) {\n      const n = doc.badList.length, list = doc.badList.slice(0, 8).map(i => fmt(i + 1)).join(', ') + (n > 8 ? ' …' : '');\n      parts.push(plural(n, 'row') + ' ' + (n === 1 ? 'has' : 'have') + ' a different number of values from the ' + (doc.header ? 'header' : 'other rows') + ' (' + doc.expected + '): row' + (n === 1 ? ' ' : 's ') + list + '. Missing values are shown empty and extra ones in extra columns.');\n    }\n    if (!doc.data.length) parts.push(doc.text.trim() ? 'There are no rows below the header.' : 'This file is empty.');\n    if (!parts.length) return;\n    const msg = h('span', 'msg', '⚠ ' + parts.join(' '));\n    w.append(msg);\n    if (doc.badList.length) {\n      const b = h('button', 'btn', filter.bad ? 'Show all rows' : 'Show only these rows');\n      b.onclick = () => { filter.bad = !filter.bad; showWarnings(); applyView(); };\n      w.append(b);\n    }\n    const x = h('button', 'btn', 'Dismiss'); x.onclick = () => { w.hidden = true; if (filter.bad) { filter.bad = false; applyView(); } grid.focus(); };\n    w.append(x);\n    w.hidden = false;\n  }\n\n  /* ---------- filter and sort ---------- */\n  function applyView() {\n    const q = filter.q.toLowerCase(), col = filter.col, data = doc.data;\n    view = [];\n    for (let i = 0; i < data.length; i++) {\n      if (filter.bad && !doc.bad.has(i)) continue;\n      if (q) {\n        const r = data[i];\n        let hit = false;\n        if (col >= 0) hit = (r[col] || '').toLowerCase().includes(q);\n        else for (let c = 0; c < r.length && !hit; c++) hit = r[c].toLowerCase().includes(q);\n        if (!hit) continue;\n      }\n      view.push(i);\n    }\n    if (sort) {\n      const c = sort.col, d = sort.dir, num = doc.numeric[c];\n      const key = new Map();\n      for (const i of view) { const v = data[i][c]; key.set(i, v == null || v === '' ? null : num ? CSV.num(v) : v); }\n      view.sort((a, b) => {\n        const x = key.get(a), y = key.get(b);\n        if (x === null || y === null) return x === y ? a - b : x === null ? 1 : -1;      /* empty values last, either way */\n        return (num ? x - y : collator.compare(x, y)) * d || a - b;\n      });\n    }\n    cur.r = Math.min(cur.r, Math.max(0, view.length - 1));\n    body.style.height = view.length * RH + 'px';\n    grid.setAttribute('aria-rowcount', String(view.length + 1));\n    drawHead(); render(); status();\n  }\n  function setSort(c) {\n    if (!sort || sort.col !== c) sort = { col: c, dir: 1 };\n    else if (sort.dir === 1) sort.dir = -1;\n    else sort = null;\n    applyView();\n    toast(sort ? 'Sorted by ' + doc.cols[c] + (sort.dir === 1 ? ', up' : ', down') : 'Original order');\n  }\n\n  /* ---------- drawing: only the rows and columns in sight ---------- */\n  function measure() {\n    RH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rh')) || 28;\n    NW = Math.max(44, String(doc.data.length).length * 8 + 22);\n    colX = [0];\n    for (const w of doc.widths) colX.push(colX[colX.length - 1] + w);\n    totalW = NW + colX[colX.length - 1];\n    head.style.width = body.style.width = totalW + 'px';\n    grid.setAttribute('aria-colcount', String(doc.cols.length + 1));\n  }\n  function visibleCols() {\n    const left = grid.scrollLeft, right = left + grid.clientWidth - NW;\n    let c0 = 0; while (c0 < doc.cols.length - 1 && colX[c0 + 1] < left) c0++;\n    let c1 = c0; while (c1 < doc.cols.length - 1 && colX[c1 + 1] < right) c1++;\n    return [Math.max(0, c0 - 1), Math.min(doc.cols.length - 1, c1 + 1)];\n  }\n  function drawHead() {\n    head.textContent = '';\n    head.setAttribute('aria-rowindex', '1');\n    const n = h('div', 'c n', '#'); n.style.width = NW + 'px'; n.setAttribute('role', 'columnheader'); head.append(n);\n    doc.cols.forEach((name, c) => {\n      const cell = h('div', 'c' + (doc.numeric[c] ? ' num' : ''));\n      cell.style.width = doc.widths[c] + 'px';\n      cell.setAttribute('role', 'columnheader'); cell.setAttribute('aria-colindex', String(c + 2));\n      cell.setAttribute('aria-sort', sort && sort.col === c ? (sort.dir === 1 ? 'ascending' : 'descending') : 'none');\n      cell.title = name + ' (click to sort)';\n      cell.dataset.c = c;\n      cell.append(document.createTextNode(name));\n      if (sort && sort.col === c) cell.append(h('span', 'arrow', sort.dir === 1 ? '▲' : '▼'));\n      const grip = h('span', 'grip'); grip.dataset.grip = c; cell.append(grip);\n      head.append(cell);\n    });\n  }\n  let raf = 0;\n  function schedule() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; render(); }); }\n  function render() {\n    if (!doc) return;\n    const top = grid.scrollTop, hh = head.offsetHeight, height = grid.clientHeight - hh;\n    const r0 = Math.max(0, Math.floor(top / RH) - 5), r1 = Math.min(view.length - 1, Math.ceil((top + height) / RH) + 5);\n    const [c0, c1] = doc.cols.length ? visibleCols() : [0, -1];\n    const frag = document.createDocumentFragment(), data = doc.data;\n    for (let r = r0; r <= r1; r++) {\n      const i = view[r], row = data[i];\n      const el = h('div', 'row' + (r % 2 ? ' alt' : '') + (sel.has(i) ? ' sel' : '') + (doc.bad.has(i) ? ' bad' : ''));\n      el.style.top = r * RH + 'px'; el.style.width = totalW + 'px';\n      el.dataset.r = r; el.setAttribute('role', 'row'); el.setAttribute('aria-rowindex', String(r + 2));\n      if (sel.has(i)) el.setAttribute('aria-selected', 'true');\n      const n = h('div', 'c n', fmt(i + 1)); n.style.width = NW + 'px'; n.setAttribute('role', 'rowheader');\n      n.title = 'Row ' + fmt(i + 1) + ', line ' + fmt(doc.lines[i]) + ' of the file' + (doc.bad.has(i) ? ': ' + row.length + ' values, ' + doc.expected + ' expected' : '');\n      el.append(n);\n      if (c0 > 0) { const sp = h('div', 'spacer'); sp.style.width = colX[c0] + 'px'; el.append(sp); }\n      for (let c = c0; c <= c1; c++) {\n        const v = row[c], cell = h('div', 'c' + (doc.numeric[c] ? ' num' : '') + (c >= doc.expected && doc.header ? ' x' : ''), v == null ? '' : v);\n        cell.style.width = doc.widths[c] + 'px';\n        cell.dataset.c = c; cell.id = 'cell-' + r + '-' + c;\n        cell.setAttribute('role', 'gridcell'); cell.setAttribute('aria-colindex', String(c + 2));\n        if (v && v.length > 12) cell.title = v.length > 600 ? v.slice(0, 600) + '…' : v;\n        if (r === cur.r && c === cur.c) cell.classList.add('cur');\n        el.append(cell);\n      }\n      frag.append(el);\n    }\n    body.textContent = ''; body.append(frag);\n    const active = document.getElementById('cell-' + cur.r + '-' + cur.c);\n    if (active) grid.setAttribute('aria-activedescendant', active.id); else grid.removeAttribute('aria-activedescendant');\n  }\n  grid.addEventListener('scroll', schedule, { passive: true });\n  new ResizeObserver(() => { if (doc) schedule(); }).observe(grid);\n\n  function status() {\n    if (!doc) { $('stFile').textContent = ''; $('stInfo').textContent = ''; $('stCell').textContent = ''; return; }\n    $('stFile').textContent = doc.name;\n    $('stInfo').textContent = delimName(doc.delim) + (doc.auto ? ' (found)' : '') + ' · ' + plural(doc.data.length, 'row') + ' × ' + plural(doc.cols.length, 'column') +\n      (view.length !== doc.data.length ? ' · showing ' + fmt(view.length) : '') + (sel.size ? ' · ' + fmt(sel.size) + ' selected' : '');\n    const i = view[cur.r];\n    $('stCell').textContent = i == null || !doc.cols.length ? '' : 'Row ' + fmt(i + 1) + ', ' + doc.cols[cur.c] + ': ' + ((doc.data[i][cur.c] || '').slice(0, 300) || '(empty)');\n  }\n\n  /* ---------- moving, selecting ---------- */\n  function scrollToCur() {\n    const hh = head.offsetHeight, y = cur.r * RH, top = grid.scrollTop, vis = grid.clientHeight - hh;\n    if (y < top) grid.scrollTop = y; else if (y + RH > top + vis) grid.scrollTop = y + RH - vis;\n    const x = colX[cur.c], w = doc.widths[cur.c] || 0, left = grid.scrollLeft, visW = grid.clientWidth - NW;\n    if (x < left) grid.scrollLeft = x; else if (x + w > left + visW) grid.scrollLeft = Math.min(x, x + w - visW);\n  }\n  function moveTo(r, c, extend) {\n    if (!view.length) return;\n    cur.r = Math.max(0, Math.min(view.length - 1, r)); cur.c = Math.max(0, Math.min(doc.cols.length - 1, c));\n    if (extend) selectRange(anchor, cur.r); else anchor = cur.r;\n    scrollToCur(); render(); status();\n  }\n  function selectRange(a, b) { sel.clear(); for (let r = Math.min(a, b); r <= Math.max(a, b); r++) sel.add(view[r]); }\n  function selectedRows() { return sel.size ? view.filter(i => sel.has(i)) : view.slice(); }\n\n  body.addEventListener('pointerdown', e => {\n    const rowEl = e.target.closest('.row'); if (!rowEl) return;\n    const r = +rowEl.dataset.r, cellEl = e.target.closest('[data-c]'), i = view[r];\n    if (cellEl) cur.c = +cellEl.dataset.c;\n    cur.r = r;\n    if (e.shiftKey) selectRange(anchor, r);\n    else if (e.ctrlKey || e.metaKey) { if (sel.has(i)) sel.delete(i); else sel.add(i); anchor = r; }\n    else { sel.clear(); sel.add(i); anchor = r; }\n    grid.focus({ preventScroll: true });\n    render(); status();\n  });\n\n  /* headings: click to sort, drag the edge to resize */\n  let resizing = null;\n  head.addEventListener('pointerdown', e => {\n    const g = e.target.closest('[data-grip]');\n    if (!g) return;\n    e.preventDefault(); e.stopPropagation();\n    const c = +g.dataset.grip;\n    resizing = { c, x: e.clientX, w: doc.widths[c], moved: false };\n    g.setPointerCapture(e.pointerId);\n    g.onpointermove = ev => { resizing.moved = true; doc.widths[c] = Math.max(40, Math.min(1200, resizing.w + ev.clientX - resizing.x)); measure(); drawHead(); render(); };\n    g.onpointerup = g.onpointercancel = () => { g.onpointermove = g.onpointerup = g.onpointercancel = null; setTimeout(() => { resizing = null; }, 0); };\n  });\n  head.addEventListener('click', e => {\n    if (resizing || e.target.closest('[data-grip]')) return;\n    const cell = e.target.closest('[data-c]'); if (!cell) return;\n    cur.c = +cell.dataset.c; setSort(+cell.dataset.c); grid.focus({ preventScroll: true });\n  });\n\n  grid.addEventListener('keydown', e => {\n    if (!doc || !view.length && !/^(Escape)$/.test(e.key)) return;\n    const page = Math.max(1, Math.floor((grid.clientHeight - head.offsetHeight) / RH) - 1), ctrl = e.ctrlKey || e.metaKey;\n    let handled = true;\n    switch (e.key) {\n      case 'ArrowDown': moveTo(cur.r + 1, cur.c, e.shiftKey); break;\n      case 'ArrowUp': moveTo(cur.r - 1, cur.c, e.shiftKey); break;\n      case 'ArrowRight': moveTo(cur.r, cur.c + 1); break;\n      case 'ArrowLeft': moveTo(cur.r, cur.c - 1); break;\n      case 'PageDown': moveTo(cur.r + page, cur.c, e.shiftKey); break;\n      case 'PageUp': moveTo(cur.r - page, cur.c, e.shiftKey); break;\n      case 'Home': ctrl ? moveTo(0, cur.c, e.shiftKey) : moveTo(cur.r, 0); break;\n      case 'End': ctrl ? moveTo(view.length - 1, cur.c, e.shiftKey) : moveTo(cur.r, doc.cols.length - 1); break;\n      case ' ': { const i = view[cur.r]; if (sel.has(i)) sel.delete(i); else sel.add(i); anchor = cur.r; render(); status(); break; }\n      case 'Escape': if (sel.size) { sel.clear(); render(); status(); } else if (filter.q) { $('filter').value = ''; filter.q = ''; applyView(); } else handled = false; break;\n      default:\n        if (ctrl && e.key.toLowerCase() === 'a') { sel = new Set(view); render(); status(); }\n        else if (ctrl && e.key.toLowerCase() === 'c' && !window.getSelection().toString()) copy();\n        else if (!ctrl && !e.altKey && e.key.toLowerCase() === 's') setSort(cur.c);\n        else handled = false;\n    }\n    if (handled) e.preventDefault();\n  });\n\n  /* ---------- copy, save, open ---------- */\n  async function copy() {\n    if (!doc) return;\n    const rows = selectedRows().map(i => doc.data[i]), out = (doc.header ? [doc.names] : []).concat(rows);\n    const text = CSV.write(out, '\\t', '\\r\\n');\n    if (await Host.copy(text)) toast('Copied ' + plural(rows.length, 'row') + ' as TSV');\n    else { $('copyText').value = text; const p = dialog('copyDlg', '#copyText'); $('copyText').select(); await p; }\n  }\n  async function saveAs() {\n    if (!doc) return;\n    const shown = view.length !== doc.data.length;\n    $('rowsAll').textContent = 'All ' + plural(doc.data.length, 'row') + (sort ? ', in the sorted order' : '');\n    $('rowsShown').textContent = 'Only the ' + plural(view.length, 'row') + ' shown';\n    $('rowsSet').querySelector('[value=shown]').disabled = !shown;\n    $('rowsSet').querySelector(shown ? '[value=shown]' : '[value=all]').checked = true;\n    const def = doc.delim === '\\t' ? '\\t' : doc.delim === ';' ? ';' : ',';\n    document.querySelector('#saveDlg [name=fmt][value=\"' + def + '\"]').checked = true;\n    if (await dialog('saveDlg', 'input[name=fmt]:checked') !== 'ok') return;\n    const d = document.querySelector('#saveDlg [name=fmt]:checked').value, onlyShown = document.querySelector('#saveDlg [name=rows]:checked').value === 'shown';\n    let order = view.slice();\n    if (!onlyShown && shown) {           /* all rows, but keep the sort */\n      const saved = filter; filter = { q: '', col: -1, bad: false }; applyView(); order = view.slice(); filter = saved; applyView();\n    }\n    const ext = d === '\\t' ? '.tsv' : '.csv';\n    const text = CSV.write((doc.header ? [doc.names] : []).concat(order.map(i => doc.data[i])), d, doc.eol);\n    try {\n      const f = await Host.saveFile({ title: 'Save as', name: stem(doc.name) + ext, types: [ext], text, mime: d === '\\t' ? 'text/tab-separated-values' : 'text/csv' });\n      if (f) { toast('Saved ' + f.name + ' (' + plural(order.length, 'row') + ')'); Host.notify('Saved ' + f.name); }\n    } catch (e) { toast('Could not save: ' + e.message, 4000); }\n  }\n  async function openDialog() {\n    try { const f = await Host.openFile({ title: 'Open a table', types: ['.csv', '.tsv', '.txt'] }); if (f) await open(f); }\n    catch (e) { toast(e.message, 4000); }\n  }\n\n  /* ---------- toolbar ---------- */\n  $('openBtn').onclick = $('openBig').onclick = openDialog;\n  $('saveBtn').onclick = saveAs;\n  $('copyBtn').onclick = copy;\n  $('delim').onchange = rebuild;\n  $('header').onchange = rebuild;\n  let ft = 0;\n  $('filter').addEventListener('input', () => { clearTimeout(ft); ft = setTimeout(() => { filter.q = $('filter').value; cur.r = 0; grid.scrollTop = 0; applyView(); }, 120); });\n  $('filter').addEventListener('keydown', e => {\n    if (e.key === 'Escape' && $('filter').value) { e.preventDefault(); e.stopPropagation(); $('filter').value = ''; filter.q = ''; applyView(); }\n    else if (e.key === 'Enter' || e.key === 'ArrowDown') { e.preventDefault(); clearTimeout(ft); filter.q = $('filter').value; applyView(); grid.focus(); }\n  });\n  $('filterCol').onchange = () => { filter.col = +$('filterCol').value; applyView(); };\n  $('helpBtn').onclick = () => dialog('helpDlg');\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => {\n    settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto';\n    Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings);\n    toast(THEMES[settings.theme][1]);\n  };\n\n  document.addEventListener('keydown', e => {\n    const ctrl = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();\n    if (e.defaultPrevented || document.querySelector('.ov:not([hidden])')) return;\n    if (ctrl && !e.shiftKey && k === 'o') { e.preventDefault(); openDialog(); }\n    else if (ctrl && !e.shiftKey && k === 's') { e.preventDefault(); saveAs(); }\n    else if (ctrl && !e.shiftKey && k === 'f' && doc) { e.preventDefault(); $('filter').focus(); $('filter').select(); }\n    else if (e.key === 'F1') { e.preventDefault(); dialog('helpDlg'); }\n  });\n\n  /* dropping a file on the window opens it */\n  const app = $('app');\n  app.addEventListener('dragover', e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) { e.preventDefault(); (doc ? grid : $('empty')).classList.add('drop'); } });\n  app.addEventListener('dragleave', e => { if (!app.contains(e.relatedTarget)) { grid.classList.remove('drop'); $('empty').classList.remove('drop'); } });\n  app.addEventListener('drop', async e => {\n    grid.classList.remove('drop'); $('empty').classList.remove('drop');\n    const f = e.dataTransfer && e.dataTransfer.files[0]; if (!f) return;\n    e.preventDefault(); open(await Host.readDropped(f));\n  });\n\n  /* ---------- start ---------- */\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    const start = Host.startFile();\n    if (start) { try { await open(await Host.readPath(start.path, start.name)); } catch (e) { toast('Could not open \"' + start.name + '\": ' + e.message, 5000); } }\n    else $('openBig').focus();\n    Host.onOpenFile(async f => { try { await open(await Host.readPath(f.path, f.name)); } catch (e) { toast(e.message, 4000); } });\n    window.__tv = { get doc() { return doc; }, get view() { return view; }, get sel() { return sel; }, get cur() { return cur; }, get sort() { return sort; } };\n  })();\n})();\n"
  },
  "js/csv.js": {
   "enc": "text",
   "d": "/* Table Viewer: reading and writing delimited text. No DOM code here. */\n(function () {\n  'use strict';\n  const CSV = window.CSV = {};\n  CSV.DELIMS = [{ ch: ',', name: 'Comma' }, { ch: ';', name: 'Semicolon' }, { ch: '\\t', name: 'Tab' }, { ch: '|', name: 'Pipe' }];\n  const lineBreaks = s => { let n = 0; for (let i = 0; i < s.length; i++) { const c = s.charCodeAt(i); if (c === 10 || (c === 13 && s.charCodeAt(i + 1) !== 10)) n++; } return n; };\n\n  /* Splits text into records. Quotes follow RFC 4180: a quoted value may hold the delimiter, line breaks and \"\" for a\n     quote. Returns { rows, lines, unterminated }: lines[i] is the line row i starts on; unterminated is the line of a\n     quote that never closes, or null. Blank lines are left out. limit stops after that many characters (for sniffing). */\n  CSV.parse = function (text, d, limit) {\n    const rows = [], lines = [], n = limit ? Math.min(limit, text.length) : text.length;\n    let i = 0, line = 1, row = [], rowLine = 1, unterminated = null;\n    if (!n) return { rows, lines, unterminated };\n    const end = () => { if (!(row.length === 1 && row[0] === '')) { rows.push(row); lines.push(rowLine); } };\n    for (;;) {\n      let field;\n      if (text.charCodeAt(i) === 34) {\n        const qLine = line; let s = '';\n        i++;\n        for (;;) {\n          const j = text.indexOf('\"', i);\n          if (j < 0 || j >= n) { const rest = text.slice(i, n); s += rest; line += lineBreaks(rest); i = n; unterminated = qLine; break; }\n          const part = text.slice(i, j); s += part; line += lineBreaks(part);\n          if (text.charCodeAt(j + 1) === 34 && j + 1 < n) { s += '\"'; i = j + 2; continue; }\n          i = j + 1; break;\n        }\n        let k = i; while (k < n) { const c = text[k]; if (c === d || c === '\\n' || c === '\\r') break; k++; }\n        if (k > i) s += text.slice(i, k);\n        i = k; field = s;\n      } else {\n        let k = i; while (k < n) { const c = text[k]; if (c === d || c === '\\n' || c === '\\r') break; k++; }\n        field = text.slice(i, k); i = k;\n      }\n      row.push(field);\n      if (i >= n) { end(); break; }\n      if (text[i] === d) { i++; if (i >= n) { row.push(''); end(); break; } continue; }\n      i += text[i] === '\\r' && text[i + 1] === '\\n' ? 2 : 1;\n      line++;\n      end(); row = []; rowLine = line;\n      if (i >= n) break;\n    }\n    return { rows, lines, unterminated };\n  };\n\n  /* The delimiter that splits the start of the file most consistently into more than one column.\n     ext ('csv', 'tsv', …) breaks a tie or decides when nothing splits. */\n  CSV.sniff = function (text, ext) {\n    const sample = text.length > 65536 ? text.slice(0, text.lastIndexOf('\\n', 65536) + 1 || 65536) : text;\n    let best = null;\n    for (const { ch } of CSV.DELIMS) {\n      const rows = CSV.parse(sample, ch).rows.slice(0, 50);\n      if (!rows.length) continue;\n      const counts = {}; rows.forEach(r => { counts[r.length] = (counts[r.length] || 0) + 1; });\n      const mode = +Object.keys(counts).sort((a, b) => counts[b] - counts[a] || b - a)[0];\n      if (mode < 2) continue;\n      const score = counts[mode] / rows.length * 1000 + Math.min(mode, 50) + (ext === 'tsv' && ch === '\\t' ? 5 : 0) + (ext === 'csv' && ch === ',' ? 5 : 0);\n      if (!best || score > best.score) best = { ch, score };\n    }\n    return best ? best.ch : ext === 'tsv' ? '\\t' : ',';\n  };\n\n  /* line ending the file mostly uses */\n  CSV.eol = text => { const i = text.indexOf('\\n'); return i > 0 && text[i - 1] === '\\r' ? '\\r\\n' : '\\n'; };\n\n  /* one value written out, quoted only when it has to be */\n  CSV.cell = function (v, d) {\n    v = v == null ? '' : String(v);\n    return v.includes(d) || v.includes('\"') || v.includes('\\n') || v.includes('\\r') || /^\\s|\\s$/.test(v) ? '\"' + v.replace(/\"/g, '\"\"') + '\"' : v;\n  };\n  CSV.write = function (rows, d, eol) { return rows.map(r => r.map(v => CSV.cell(v, d)).join(d)).join(eol || '\\r\\n') + (eol || '\\r\\n'); };\n\n  /* numbers as people write them in tables: 12, -3.5, 1,234.5, 1e6, 12%; null when the text is not one */\n  const NUM = /^[-+]?(\\d{1,3}(,\\d{3})+|\\d+)?(\\.\\d+)?([eE][-+]?\\d+)?%?$/;\n  CSV.num = function (s) {\n    s = String(s).trim();\n    if (!s || !/\\d/.test(s) || !NUM.test(s)) return null;\n    const v = parseFloat(s.replace(/,/g, '').replace(/%$/, ''));\n    return Number.isFinite(v) ? v : null;\n  };\n})();\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Table Viewer */\n:root {\n  --bg: #ffffff; --panel: #f3f5f8; --text: #1d2330; --muted: #535c6c; --line: #d5dae2; --edge: #7b8495;\n  --accent: #2563c9; --onaccent: #ffffff; --sel: #d6e4fb; --cur: #2563c9; --warnbg: #fff4d6; --warnfg: #5c4300; --warnedge: #b58a00;\n  --bad: #fde8e8; --stripe: #f8f9fb; --rh: 28px;\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: #1a1e26; --panel: #232833; --text: #e6e9ef; --muted: #a9b1bf; --line: #353c4a; --edge: #7d8698;\n  --accent: #7aa7ff; --onaccent: #0b1220; --sel: #2c3f63; --cur: #7aa7ff; --warnbg: #3a3018; --warnfg: #ffe3a1; --warnedge: #b58a00;\n  --bad: #4a2a2e; --stripe: #1e232c;\n  color-scheme: dark;\n}\n@media (pointer: coarse) { :root { --rh: 38px; } }\n* { box-sizing: border-box; }\nhtml, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.4 \"Segoe UI\", system-ui, sans-serif; }\n#app { display: flex; flex-direction: column; height: 100%; }\n[hidden] { display: none !important; }\n.muted { color: var(--muted); } .small { font-size: 12px; }\n\n/* toolbar */\n.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 8px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }\n.btn, .field { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 4px 10px; min-height: 28px; }\n.btn { cursor: pointer; }\n.btn:hover:not(:disabled) { background: var(--sel); }\n.btn:disabled, .field:disabled { opacity: .55; cursor: default; }\n.btn.primary { background: var(--accent); color: var(--onaccent); border-color: var(--accent); }\n.btn.icon { min-width: 30px; padding: 4px 6px; display: inline-flex; align-items: center; justify-content: center; }\n.field.grow { flex: 1 1 120px; min-width: 90px; }\n.lbl { color: var(--muted); }\n.chk { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n@media (pointer: coarse) { .btn, .field { min-height: 40px; } }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n\n/* warning bar */\n.warn { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 10px; background: var(--warnbg); color: var(--warnfg); border-bottom: 1px solid var(--warnedge); }\n.warn .msg { flex: 1 1 200px; }\n.warn .btn { padding: 2px 8px; min-height: 24px; }\n\n/* the table */\n.grid { flex: 1; position: relative; overflow: auto; outline-offset: -2px; background: var(--bg); }\n.row { position: absolute; left: 0; height: var(--rh); display: flex; }\n.row.head { position: sticky; top: 0; z-index: 3; background: var(--panel); font-weight: 600; border-bottom: 1px solid var(--edge); }\n.body { position: relative; }\n.c { flex: none; height: var(--rh); line-height: var(--rh); padding: 0 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n.c.num { text-align: right; font-variant-numeric: tabular-nums; }\n.c.n { position: sticky; left: 0; z-index: 2; background: var(--panel); color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }\n.head .c.n { z-index: 4; }\n.row.alt .c:not(.n) { background: var(--stripe); }\n.row.sel .c:not(.n) { background: var(--sel); }\n.row.bad .c.n { background: var(--bad); color: var(--text); }\n.row.extra .c.x { color: var(--muted); font-style: italic; }\n.c.cur { box-shadow: inset 0 0 0 2px var(--cur); }\n.grid:not(:focus) .c.cur { box-shadow: inset 0 0 0 1px var(--edge); }\n.head .c { position: relative; cursor: pointer; user-select: none; }\n.head .c:hover { background: var(--sel); }\n.head .c .arrow { margin-left: 4px; color: var(--accent); }\n.head .grip { position: absolute; top: 0; right: -4px; width: 9px; height: 100%; cursor: col-resize; z-index: 1; touch-action: none; }\n.spacer { flex: none; }\n\n/* empty state */\n.empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; }\n.empty h1 { font-size: 20px; margin: 8px 0 4px; }\n.empty p { margin: 6px 0; }\n.empty.drop, .grid.drop { outline: 3px dashed var(--accent); outline-offset: -6px; }\n\n/* status bar */\n.status { display: flex; gap: 14px; padding: 3px 10px; border-top: 1px solid var(--line); background: var(--panel); color: var(--muted); white-space: nowrap; overflow: hidden; min-height: 24px; }\n.status .cellinfo { flex: 1; overflow: hidden; text-overflow: ellipsis; color: var(--text); }\n\n/* dialogs */\n.ov { position: fixed; inset: 0; background: rgba(10, 14, 22, .45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 12px; }\n.dlg { background: var(--bg); color: var(--text); border: 1px solid var(--edge); border-radius: 10px; padding: 16px 18px; min-width: 280px; max-width: 520px; max-height: 100%; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.3); }\n.dlg h2 { margin: 0 0 10px; font-size: 16px; }\n.dlg fieldset { border: 1px solid var(--line); border-radius: 6px; margin: 0 0 10px; padding: 6px 10px; }\n.dlg legend { color: var(--muted); padding: 0 4px; }\n.dlg fieldset label { display: block; padding: 3px 0; }\n.dlg textarea { width: 100%; font: 12px ui-monospace, Consolas, monospace; background: var(--panel); color: var(--text); border: 1px solid var(--edge); border-radius: 6px; }\n.dlg .acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.keys { border-collapse: collapse; }\n.keys td { padding: 3px 8px 3px 0; vertical-align: top; }\n.keys td:first-child { white-space: nowrap; font-weight: 600; }\n\n.toast { position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 7px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 20; max-width: 90%; text-align: center; }\n.toast.show { opacity: 1; }\n@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }\n@media (forced-colors: active) { .row.sel .c:not(.n) { background: Highlight; color: HighlightText; } .c.cur { outline: 2px solid CanvasText; } }\n"
  }
 }
}