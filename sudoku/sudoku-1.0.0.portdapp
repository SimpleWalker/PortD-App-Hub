{
 "format": "portd-app",
 "formatVersion": 3,
 "id": "sudoku",
 "name": "Sudoku",
 "version": "1.0.0",
 "description": "Sudoku with four difficulties, pencil notes, hints, undo and auto-save",
 "icon": "emoji:🔢",
 "entry": "index.html",
 "width": 480,
 "height": 660,
 "singleInstance": false,
 "fileTypes": [],
 "files": {
  "index.html": {
   "enc": "text",
   "d": "<!DOCTYPE html>\n<html lang=\"en\" data-app=\"sudoku\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sudoku</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"bar\">\n    <select id=\"diff\" title=\"Difficulty\" aria-label=\"Difficulty\">\n      <option value=\"easy\">Easy</option>\n      <option value=\"medium\">Medium</option>\n      <option value=\"hard\">Hard</option>\n      <option value=\"expert\">Expert</option>\n    </select>\n    <button id=\"newBtn\">New game</button>\n    <span class=\"spacer\"></span>\n    <span id=\"mistakes\" title=\"Mistakes\"></span>\n    <span id=\"time\" aria-label=\"Time\">00:00</span>\n    <button id=\"pauseBtn\" title=\"Pause (Space)\" aria-label=\"Pause\">⏸</button>\n    <button id=\"themeBtn\" class=\"icon\" aria-label=\"Theme\"></button>\n    <button id=\"menuBtn\" title=\"Stats and help (F1)\" aria-label=\"Stats and help\">⋯</button>\n  </div>\n  <div id=\"wrap\"><div id=\"gridBox\"><div id=\"grid\" role=\"grid\" tabindex=\"0\" aria-label=\"Sudoku grid. Arrow keys move, 1 to 9 enter, Delete erases, N notes.\"></div><div id=\"paused\">Paused – click to continue</div></div></div>\n  <div class=\"tools\">\n    <button id=\"undoBtn\" title=\"Undo (Ctrl+Z)\">↶ Undo</button>\n    <button id=\"eraseBtn\" title=\"Erase (Delete)\">⌫ Erase</button>\n    <button id=\"notesBtn\" title=\"Pencil notes (N)\" aria-pressed=\"false\">✎ Notes</button>\n    <button id=\"hintBtn\" title=\"Fill one cell (H)\">💡 Hint</button>\n    <button id=\"checkBtn\" title=\"Highlight mistakes as you go\" aria-pressed=\"true\">✓ Auto-check</button>\n  </div>\n  <div class=\"pad\" id=\"pad\" aria-label=\"Numbers\"></div>\n</div>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\"></div>\n\n<div class=\"dlg\" id=\"infoDlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"statTitle\"><div>\n  <h3 id=\"statTitle\">Statistics</h3>\n  <table id=\"statTbl\"></table>\n  <h3 style=\"margin-top:14px\">How to play</h3>\n  <p style=\"margin:0\">Fill the grid so every row, column and 3×3 box contains 1–9 once.<br>\n  Click a cell, then a number. <b>Keyboard:</b> 1–9 enter, arrows move, Delete erases, <b>N</b> toggles notes, <b>H</b> gives a hint, Ctrl+Z undoes, Space pauses.<br>\n  In notes mode, numbers are pencilled in; placing a number clears it from the notes of related cells.</p>\n  <div class=\"row\"><button id=\"statReset\">Reset stats</button><button class=\"pri\" id=\"infoClose\">Close</button></div>\n</div></div>\n\n<script src=\"js/host.js\"></script>\n<script src=\"js/sudoku.js\"></script>\n</body>\n</html>\n"
  },
  "js/host.js": {
   "enc": "text",
   "d": "/* PortD App Hub: host.js, the small layer between an app and PortD.\n   Inside PortD it uses the PortD API. Opened straight from disk in a browser, it falls back to the browser's own file\n   picker, a download for saving, and localStorage for settings. Every app in the hub carries its own copy. */\n(function () {\n  'use strict';\n  const P = typeof window.PortD === 'object' && window.PortD ? window.PortD : null;\n  const Host = window.Host = { inPortD: !!P, app: P ? P.app : null };\n  const LS = 'portd-hub:' + (P ? P.app.id : (document.documentElement.dataset.app || 'app')) + ':';\n\n  /* text from what PortD.fs.read returns: files stored as binary arrive as data URLs */\n  Host.decode = function (d) {\n    if (typeof d !== 'string') return '';\n    const m = /^data:([^,]*?)(;base64)?,/.exec(d);\n    if (m && d.length < 1e9) {\n      const body = d.slice(m[0].length);\n      if (!m[2]) return decodeURIComponent(body);\n      const bin = atob(body), bytes = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new TextDecoder('utf-8').decode(bytes);\n    }\n    return d.replace(/^﻿/, '');\n  };\n\n  /* settings: settings.json in the data folder, or localStorage outside PortD */\n  Host.loadSettings = async function (defaults) {\n    let s = null;\n    try { s = P ? JSON.parse(await P.fs.read('settings.json')) : JSON.parse(localStorage.getItem(LS + 'settings') || 'null'); } catch (e) { s = null; }\n    return Object.assign({}, defaults, s && typeof s === 'object' ? s : {});\n  };\n  Host.saveSettings = async function (s) {\n    try { if (P) await P.fs.write('settings.json', JSON.stringify(s, null, 1)); else localStorage.setItem(LS + 'settings', JSON.stringify(s)); return true; } catch (e) { return false; }\n  };\n  /* any other small piece of data the app keeps for itself */\n  Host.loadData = async function (name) {\n    try { return P ? (await P.fs.exists(name) ? Host.decode(await P.fs.read(name)) : null) : localStorage.getItem(LS + name); } catch (e) { return null; }\n  };\n  Host.saveData = async function (name, text) {\n    try { if (P) await P.fs.write(name, text); else localStorage.setItem(LS + name, text); return true; } catch (e) { return false; }\n  };\n  Host.removeData = async function (name) {\n    try { if (P) { if (await P.fs.exists(name)) await P.fs.remove(name); } else localStorage.removeItem(LS + name); } catch (e) {}\n  };\n\n  /* the names of the files in a folder of the app's own data (outside PortD: the localStorage keys under that name) */\n  Host.listData = async function (dir) {\n    try {\n      if (P) return await P.fs.exists(dir) ? (await P.fs.list(dir)).filter(e => !e.dir).map(e => e.name) : [];\n      const pre = LS + dir + '/', out = [];\n      for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(pre)) out.push(k.slice(pre.length)); }\n      return out;\n    } catch (e) { return []; }\n  };\n\n  /* a file to read: { name, path, text } or null. Outside PortD, path is null. */\n  Host.readPath = async function (path, name) {\n    const d = await P.fs.read(path);\n    return { name: name || path.split('\\\\').pop(), path, text: Host.decode(d) };\n  };\n  Host.openFile = function (o) {\n    o = o || {};\n    if (P) return P.ui.openFile({ title: o.title, types: o.types }).then(f => f ? Host.readPath(f.path, f.name) : null);\n    return new Promise(resolve => {\n      const input = document.createElement('input');\n      input.type = 'file'; if (o.types) input.accept = o.types.join(','); input.style.display = 'none';\n      input.addEventListener('change', async () => { const f = input.files[0]; input.remove(); resolve(f ? { name: f.name, path: null, text: Host.decode(await f.text()) } : null); });\n      input.addEventListener('cancel', () => { input.remove(); resolve(null); });\n      document.body.append(input); input.click();\n    });\n  };\n  Host.readDropped = async function (file) { return { name: file.name, path: null, text: Host.decode(await file.text()) }; };\n  /* asks where to save, then writes. Resolves { name, path } or null when cancelled. Outside PortD it downloads. */\n  Host.saveFile = async function (o) {\n    if (P) {\n      const f = await P.ui.saveFile({ title: o.title, name: o.name, types: o.types });\n      if (!f) return null;\n      await P.fs.write(f.path, o.text);\n      return { name: f.name, path: f.path };\n    }\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([o.text], { type: o.mime || 'text/plain' }));\n    a.download = o.name; document.body.append(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 4000);\n    return { name: o.name, path: null };\n  };\n  /* writes back to a file the app was given */\n  Host.writePath = function (path, text) { return P.fs.write(path, text); };\n\n  /* clipboard: PortD's frame is not given the clipboard permission (asking only logs a policy error), so inside PortD\n     the older copy command is used; outside PortD the async API, then the copy command */\n  Host.copy = async function (text) {\n    try { if (!P && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); Host.lastCopy = 'clipboard API'; return true; } } catch (e) { /* not allowed in a frame: fall through */ }\n    const ta = document.createElement('textarea'), was = document.activeElement;\n    ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';\n    document.body.append(ta); ta.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    ta.remove(); if (was && was.focus) was.focus({ preventScroll: true });\n    Host.lastCopy = ok ? 'copy command' : 'nothing (blocked)';\n    return ok;\n  };\n\n  Host.setTitle = function (t) { document.title = t; if (P) P.setTitle(t).catch(() => {}); };\n  Host.notify = function (t) { if (P) P.notify(t).catch(() => {}); };\n  Host.openUrl = function (u) { if (P) return P.openUrl(u); window.open(u, '_blank', 'noopener'); return Promise.resolve(); };\n  Host.onOpenFile = function (cb) { if (P) P.onOpenFile(cb); };\n  /* the file the app was started with, as { path, name, ext } (ext without the dot), or null */\n  Host.startFile = function () { return P && P.app.args && P.app.args.open ? P.app.args.open : null; };\n\n  /* theme: 'auto' follows the system, or 'light' / 'dark' */\n  Host.applyTheme = function (t) {\n    const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n    document.documentElement.dataset.theme = dark ? 'dark' : 'light';\n    document.documentElement.dataset.themeChoice = t;\n  };\n  Host.watchTheme = function (get) { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => Host.applyTheme(get())); };\n})();\n"
  },
  "js/sudoku.js": {
   "enc": "text",
   "d": "/* Sudoku, ported from the 0.x package to PortD 1.0 (package format 3). The puzzles and rules are unchanged from 0.x;\n   added in the port: a theme button (the system's light or dark by default, as before), screen reader labels,\n   Reset stats asking for a second click, and saving outside PortD in localStorage (through host.js). */\n(() => {\n  const $ = id => document.getElementById(id);\n  const gridEl = $('grid'), wrap = $('wrap');\n  const TARGET = { easy:40, medium:32, hard:27, expert:24 };\n  const ROW = i => (i / 9) | 0, COL = i => i % 9, BOX = i => ((ROW(i) / 3) | 0) * 3 + ((COL(i) / 3) | 0);\n  const PEERS = Array.from({ length:81 }, (_, i) => { const s = new Set(); for (let j = 0; j < 81; j++) if (j !== i && (ROW(j) === ROW(i) || COL(j) === COL(i) || BOX(j) === BOX(i))) s.add(j); return [...s]; });\n\n  // ---------- solver / generator (bitmask backtracking)\n  function solve(g, limit = 2, randomize = false) {\n    const a = g.slice(); let count = 0, first = null;\n    const rows = new Array(9).fill(0), cols = new Array(9).fill(0), boxes = new Array(9).fill(0);\n    for (let i = 0; i < 81; i++) if (a[i]) { const b = 1 << a[i]; if ((rows[ROW(i)] | cols[COL(i)] | boxes[BOX(i)]) & b) return { count:0 }; rows[ROW(i)] |= b; cols[COL(i)] |= b; boxes[BOX(i)] |= b; }\n    function rec() {\n      let best = -1, bestMask = 0, bestN = 10;\n      for (let i = 0; i < 81; i++) if (!a[i]) {\n        const m = ~(rows[ROW(i)] | cols[COL(i)] | boxes[BOX(i)]) & 0x3FE;\n        let n = 0, x = m; while (x) { x &= x - 1; n++; }\n        if (n < bestN) { best = i; bestMask = m; bestN = n; if (n <= 1) break; }\n      }\n      if (best < 0) { count++; if (!first) first = a.slice(); return count >= limit; }\n      if (!bestN) return false;\n      const ds = []; for (let d = 1; d <= 9; d++) if (bestMask & (1 << d)) ds.push(d);\n      if (randomize) shuffle(ds);\n      const r = ROW(best), c = COL(best), bx = BOX(best);\n      for (const d of ds) {\n        const b = 1 << d; a[best] = d; rows[r] |= b; cols[c] |= b; boxes[bx] |= b;\n        if (rec()) return true;\n        rows[r] &= ~b; cols[c] &= ~b; boxes[bx] &= ~b; a[best] = 0;\n      }\n      return false;\n    }\n    rec();\n    return { count, solution:first };\n  }\n  function shuffle(x) { for (let i = x.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [x[i], x[j]] = [x[j], x[i]]; } return x; }\n\n  function generateOnce(target) {\n    const sol = solve(new Array(81).fill(0), 1, true).solution;\n    const puzzle = sol.slice();\n    let clues = 81;\n    const tryRemove = pair => {\n      if (clues <= target || pair.some(k => !puzzle[k])) return;\n      const saved = pair.map(k => puzzle[k]);\n      pair.forEach(k => puzzle[k] = 0);\n      if (solve(puzzle, 2).count !== 1) pair.forEach((k, n) => puzzle[k] = saved[n]);\n      else clues -= pair.length;\n    };\n    // symmetric pairs first (nicer looking), then single cells to get sparser\n    for (const i of shuffle([...Array(41).keys()])) tryRemove(i === 40 ? [40] : [i, 80 - i]);\n    for (const i of shuffle([...Array(81).keys()])) tryRemove([i]);\n    return { puzzle, solution:sol, clues };\n  }\n  function generate(diff) {\n    const target = TARGET[diff], t0 = performance.now();\n    let best = null;\n    do { const g = generateOnce(target); if (!best || g.clues < best.clues) best = g; }\n    while (best.clues > target && performance.now() - t0 < 1500);\n    return best;\n  }\n\n  // ---------- state\n  let S = null;            // { diff, puzzle, solution, values, notes(bitmask), mistakes, elapsed, done }\n  let sel = -1, notesMode = false, autoCheck = true, paused = false, undo = [], tick = null, lastTick = 0;\n  let stats = {}, settings = { theme: 'auto' };\n  const cells = [];\n\n  // storage: P:\\User\\Config\\sudoku\\game.json, stats.json, settings.json (localStorage outside PortD)\n  async function load(name, def) { try { const t = await Host.loadData(name); return t ? JSON.parse(t) : def; } catch { return def; } }\n  let saveH = null;\n  function save(name, obj) { Host.saveData(name, JSON.stringify(obj)); }\n  function saveGame() { clearTimeout(saveH); saveH = setTimeout(() => save('game.json', { ...S, autoCheck }), 400); }\n  function msg(t, ms = 2500) { const m = $('msg'); m.innerHTML = '<span></span>'; m.firstChild.textContent = t; clearTimeout(msg.h); msg.h = setTimeout(() => m.innerHTML = '', ms); }\n\n  function build() {\n    for (let i = 0; i < 81; i++) {\n      const d = document.createElement('div'); d.className = 'c'; d.dataset.i = i; d.id = 'c' + i; d.setAttribute('role', 'gridcell');\n      if (COL(i) === 2 || COL(i) === 5) d.classList.add('br');\n      if (ROW(i) === 2 || ROW(i) === 5) d.classList.add('bb');\n      if (ROW(i) === 8) d.classList.add('lastrow');\n      gridEl.appendChild(d); cells.push(d);\n    }\n    for (let n = 1; n <= 9; n++) { const b = document.createElement('button'); b.dataset.n = n; b.innerHTML = n + '<small></small>'; b.setAttribute('aria-label', 'Enter ' + n); $('pad').appendChild(b); }\n  }\n\n  function fit() {\n    const s = Math.floor(Math.min(wrap.clientWidth, wrap.clientHeight));\n    gridEl.style.width = gridEl.style.height = s + 'px';\n    gridEl.style.fontSize = Math.round(s / 9 * 0.55) + 'px';\n    gridEl.style.setProperty('--nf', Math.round(s / 9 * 0.24) + 'px');\n    for (const c of cells) { const n = c.querySelector('.notes'); if (n) n.style.fontSize = Math.max(8, Math.round(s / 9 * 0.24)) + 'px'; }\n  }\n  new ResizeObserver(fit).observe(wrap);\n\n  function render() {\n    const v = S.values, selVal = sel >= 0 ? v[sel] : 0;\n    const counts = new Array(10).fill(0);\n    const nf = Math.max(8, Math.round(parseInt(gridEl.style.width || 300) / 9 * 0.24)) + 'px';\n    for (let i = 0; i < 81; i++) {\n      const c = cells[i], val = v[i];\n      if (val && val === S.solution[i]) counts[val]++;\n      let cls = 'c' + (COL(i) === 2 || COL(i) === 5 ? ' br' : '') + (ROW(i) === 2 || ROW(i) === 5 ? ' bb' : '') + (ROW(i) === 8 ? ' lastrow' : '');\n      cls += S.puzzle[i] ? ' g' : (val ? ' u' : '');\n      if (sel >= 0 && i !== sel && PEERS[sel].includes(i)) cls += ' peer';\n      if (selVal && val === selVal && i !== sel) cls += ' same';\n      if (i === sel) cls += ' sel';\n      let wrong = false;\n      if (val && !S.puzzle[i]) {\n        const conflict = PEERS[i].some(j => v[j] === val);\n        if (conflict || (autoCheck && val !== S.solution[i])) { cls += ' err'; wrong = true; }\n      }\n      c.className = cls;\n      if (val) c.textContent = val;\n      else if (S.notes[i]) {\n        let h = '<div class=\"notes\" style=\"font-size:' + nf + '\">';\n        for (let n = 1; n <= 9; n++) h += `<span${S.notes[i] & (1 << n) && n === selVal ? ' class=\"hl\"' : ''}>${S.notes[i] & (1 << n) ? n : ''}</span>`;\n        c.innerHTML = h + '</div>';\n      } else c.textContent = '';\n      const notes = []; for (let n = 1; n <= 9; n++) if (S.notes[i] & (1 << n)) notes.push(n);\n      c.setAttribute('aria-label', 'Row ' + (ROW(i) + 1) + ', column ' + (COL(i) + 1) + ': ' + (val ? val + (S.puzzle[i] ? ', given' : wrong ? ', wrong' : '') : notes.length ? 'notes ' + notes.join(' ') : 'empty'));\n    }\n    if (sel >= 0) gridEl.setAttribute('aria-activedescendant', 'c' + sel); else gridEl.removeAttribute('aria-activedescendant');\n    for (const b of $('pad').children) { const n = +b.dataset.n, left = 9 - counts[n]; b.classList.toggle('done', left <= 0); b.querySelector('small').textContent = left > 0 ? left : ''; }\n    $('notesBtn').classList.toggle('on', notesMode); $('notesBtn').setAttribute('aria-pressed', String(notesMode));\n    $('checkBtn').classList.toggle('on', autoCheck); $('checkBtn').setAttribute('aria-pressed', String(autoCheck));\n    $('mistakes').textContent = autoCheck ? `Mistakes: ${S.mistakes}` : '';\n    $('time').textContent = fmt(S.elapsed);\n  }\n  const fmt = s => { s = Math.floor(s); const h = (s / 3600) | 0, m = ((s % 3600) / 60) | 0, x = s % 60; return (h ? h + ':' + String(m).padStart(2, '0') : String(m).padStart(2, '0')) + ':' + String(x).padStart(2, '0'); };\n\n  function startClock() {\n    clearInterval(tick); lastTick = Date.now();\n    tick = setInterval(() => {\n      const now = Date.now();\n      if (!paused && !S.done && document.visibilityState === 'visible') { S.elapsed += (now - lastTick) / 1000; $('time').textContent = fmt(S.elapsed); if (Math.floor(S.elapsed) % 10 === 0) saveGame(); }\n      lastTick = now;\n    }, 500);\n  }\n\n  function newGame(diff) {\n    msg('Generating puzzle…', 800);\n    setTimeout(() => {\n      const g = generate(diff);\n      S = { diff, puzzle:g.puzzle, solution:g.solution, values:g.puzzle.slice(), notes:new Array(81).fill(0), mistakes:0, elapsed:0, done:false };\n      sel = -1; undo = []; paused = false; $('paused').style.display = 'none'; $('pauseBtn').textContent = '⏸';\n      stats[diff] = stats[diff] || { played:0, won:0, best:null }; stats[diff].played++; save('stats.json', stats);\n      Host.setTitle('Sudoku – ' + diff[0].toUpperCase() + diff.slice(1));\n      render(); saveGame(); startClock();\n    }, 20);\n  }\n\n  function push() { undo.push({ values:S.values.slice(), notes:S.notes.slice(), sel }); if (undo.length > 300) undo.shift(); }\n\n  function input(n) {\n    if (sel < 0 || S.done || paused || S.puzzle[sel]) return;\n    if (notesMode) {\n      if (S.values[sel]) return;\n      push(); S.notes[sel] ^= (1 << n);\n    } else {\n      if (S.values[sel] === n) return;\n      push();\n      S.values[sel] = n; S.notes[sel] = 0;\n      PEERS[sel].forEach(j => S.notes[j] &= ~(1 << n));\n      if (n !== S.solution[sel] && autoCheck) S.mistakes++;\n    }\n    render(); saveGame(); checkWin();\n  }\n  function erase() { if (sel < 0 || S.done || S.puzzle[sel] || (!S.values[sel] && !S.notes[sel])) return; push(); S.values[sel] = 0; S.notes[sel] = 0; render(); saveGame(); }\n  function doUndo() { const u = undo.pop(); if (!u || S.done) return; S.values = u.values; S.notes = u.notes; sel = u.sel; render(); saveGame(); }\n  function hint() {\n    if (S.done || paused) return;\n    let i = sel >= 0 && S.values[sel] !== S.solution[sel] ? sel : -1;\n    if (i < 0) { const wrong = []; for (let k = 0; k < 81; k++) if (S.values[k] !== S.solution[k]) wrong.push(k); if (!wrong.length) return; i = wrong[Math.floor(Math.random() * wrong.length)]; }\n    push(); S.values[i] = S.solution[i]; S.notes[i] = 0; PEERS[i].forEach(j => S.notes[j] &= ~(1 << S.solution[i]));\n    sel = i; render(); cells[i].classList.add('hint'); saveGame(); checkWin();\n  }\n  function checkWin() {\n    for (let i = 0; i < 81; i++) if (S.values[i] !== S.solution[i]) return;\n    S.done = true; clearInterval(tick);\n    const st = stats[S.diff] = stats[S.diff] || { played:1, won:0, best:null };\n    st.won++; const t = Math.round(S.elapsed); const rec = st.best == null || t < st.best; if (rec) st.best = t;\n    save('stats.json', stats); saveGame();\n    sel = -1; render();\n    msg(`Solved in ${fmt(t)}${rec ? ' – new best!' : ''}`, 5000);\n    Host.notify(`${S.diff} solved in ${fmt(t)}`);\n  }\n\n  function setPaused(p) { if (S.done) return; paused = p; $('paused').style.display = p ? 'flex' : 'none'; $('pauseBtn').textContent = p ? '▶' : '⏸'; $('pauseBtn').setAttribute('aria-label', p ? 'Continue' : 'Pause'); }\n\n  // ---------- events\n  gridEl.addEventListener('pointerdown', e => { const c = e.target.closest('.c'); if (!c || paused) return; sel = +c.dataset.i; render(); });\n  $('pad').addEventListener('click', e => { const b = e.target.closest('button'); if (b) input(+b.dataset.n); });\n  $('eraseBtn').onclick = erase;\n  $('undoBtn').onclick = doUndo;\n  $('hintBtn').onclick = hint;\n  $('notesBtn').onclick = () => { notesMode = !notesMode; render(); };\n  $('checkBtn').onclick = () => { autoCheck = !autoCheck; render(); saveGame(); };\n  const inProgress = () => !S.done && S.values.some((v, i) => v && !S.puzzle[i]);\n  $('newBtn').onclick = () => { if (inProgress() && !confirmNew()) return; newGame($('diff').value); };\n  $('diff').onchange = () => { if (inProgress()) { msg(`Difficulty set – click New game to start a ${$('diff').value} puzzle`, 3000); return; } newGame($('diff').value); };\n  $('pauseBtn').onclick = () => setPaused(!paused);\n  $('paused').onclick = () => setPaused(false);\n  let confirmAt = 0;\n  function confirmNew() { if (Date.now() - confirmAt < 3000) return true; confirmAt = Date.now(); msg('Click New game again to abandon this puzzle', 3000); return false; }\n\n  let back = null, resetAt = 0;\n  function showInfo() {\n    const t = $('statTbl'); t.innerHTML = '<tr><td></td><td>Played</td><td>Won</td><td>Best</td></tr>';\n    for (const k of Object.keys(TARGET)) { const s = stats[k] || {}; const r = t.insertRow(); [k[0].toUpperCase() + k.slice(1), s.played || 0, s.won || 0, s.best != null ? fmt(s.best) : '—'].forEach(x => r.insertCell().textContent = x); }\n    resetAt = 0; $('statReset').textContent = 'Reset stats'; $('statReset').classList.remove('danger');\n    if (!$('infoDlg').classList.contains('show')) { back = document.activeElement; $('infoDlg').classList.add('show'); $('infoClose').focus(); }\n  }\n  function hideInfo() { $('infoDlg').classList.remove('show'); if (back && back.focus) back.focus(); }\n  $('menuBtn').onclick = showInfo;\n  $('infoClose').onclick = hideInfo;\n  /* destructive: the first click asks, a second click within 3 seconds resets */\n  $('statReset').onclick = () => {\n    if (Date.now() - resetAt > 3000) { resetAt = Date.now(); $('statReset').textContent = 'Click again to reset'; $('statReset').classList.add('danger'); return; }\n    stats = {}; save('stats.json', stats); showInfo(); msg('Statistics reset');\n  };\n  $('infoDlg').addEventListener('keydown', e => {\n    if (e.key === 'Escape') { e.preventDefault(); hideInfo(); }\n    else if (e.key === 'Tab') { e.preventDefault(); (document.activeElement === $('infoClose') ? $('statReset') : $('infoClose')).focus(); }\n    e.stopPropagation();\n  });\n\n  document.addEventListener('keydown', e => {\n    if (!S || $('infoDlg').classList.contains('show')) return;\n    const onControl = /^(BUTTON|SELECT)$/.test(e.target.tagName);\n    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); doUndo(); return; }\n    if (e.key === 'F1') { e.preventDefault(); showInfo(); return; }\n    if (e.key === ' ' && !onControl) { e.preventDefault(); setPaused(!paused); return; }\n    if (paused || e.ctrlKey || e.metaKey || e.altKey) return;\n    if (/^[1-9]$/.test(e.key)) { input(+e.key); return; }\n    if (e.key === 'Backspace' || e.key === 'Delete' || e.key === '0') { erase(); return; }\n    if (e.key.toLowerCase() === 'n') { notesMode = !notesMode; render(); return; }\n    if (e.key.toLowerCase() === 'h') { hint(); return; }\n    const mv = { ArrowUp:-9, ArrowDown:9, ArrowLeft:-1, ArrowRight:1 }[e.key];\n    if (mv && !(onControl && e.target.tagName === 'SELECT')) { e.preventDefault(); if (sel < 0) sel = 0; else { const r = ROW(sel), c = COL(sel); if (mv === -9) sel = ((r + 8) % 9) * 9 + c; else if (mv === 9) sel = ((r + 1) % 9) * 9 + c; else if (mv === -1) sel = r * 9 + (c + 8) % 9; else sel = r * 9 + (c + 1) % 9; } render(); }\n  });\n  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden' && S) saveGame(); });\n\n  // ---------- theme (added in the port; follows the system by default, as 0.x did)\n  const SVG = '<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">';\n  const THEMES = {\n    auto: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 2.5v11a5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></svg>', 'Theme: follows the system'],\n    light: [SVG + '<circle cx=\"8\" cy=\"8\" r=\"3\"/><path d=\"M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3\"/></svg>', 'Theme: light'],\n    dark: [SVG + '<path d=\"M13 10.5A5.5 5.5 0 0 1 5.5 3a5.5 5.5 0 1 0 7.5 7.5z\" fill=\"currentColor\"/></svg>', 'Theme: dark']\n  };\n  function showTheme() { const t = THEMES[settings.theme] || THEMES.auto; $('themeBtn').innerHTML = t[0]; $('themeBtn').title = t[1] + ' (click to change)'; $('themeBtn').setAttribute('aria-label', t[1]); }\n  $('themeBtn').onclick = () => { settings.theme = { auto: 'light', light: 'dark', dark: 'auto' }[settings.theme] || 'auto'; Host.applyTheme(settings.theme); showTheme(); Host.saveSettings(settings); msg(THEMES[settings.theme][1], 1500); };\n\n  window.__sd = { get S() { return S; }, solve, generate, input, select:i => { sel = i; render(); } };\n\n  build();\n  (async () => {\n    settings = await Host.loadSettings(settings);\n    Host.applyTheme(settings.theme); showTheme(); Host.watchTheme(() => settings.theme);\n    stats = await load('stats.json', {});\n    const g = await load('game.json', null);\n    if (g && Array.isArray(g.values) && g.values.length === 81 && !g.done) {\n      S = g; autoCheck = g.autoCheck !== false; delete S.autoCheck;\n      $('diff').value = S.diff; render(); startClock(); fit(); render();\n      Host.setTitle('Sudoku – ' + S.diff[0].toUpperCase() + S.diff.slice(1));\n      msg('Resumed your last game');\n    } else { fit(); newGame('easy'); }\n    gridEl.focus();\n  })();\n})();\n"
  },
  "style.css": {
   "enc": "text",
   "d": "/* Sudoku. Colours as in 0.x; the dark set now also applies when chosen with the theme button. */\n:root { --bg:#f3f5f9; --panel:#fff; --line:#2b3445; --thin:#c3cad6; --given:#1d2433; --user:#2f6fe0; --sel:#bcd4ff; --peer:#e6edf9; --same:#d3e1fb; --err:#e0383e; --errBg:#fde3e4; --note:#6b7486; --accent:#2f6fe0; color-scheme: light; }\n:root[data-theme=\"dark\"] { --bg:#1b2029; --panel:#252c38; --line:#9aa6bb; --thin:#3c4657; --given:#e7ebf2; --user:#7fb0ff; --sel:#33507f; --peer:#2c3544; --same:#324567; --errBg:#4a2629; --note:#98a2b5; color-scheme: dark; }\n* { box-sizing:border-box; }\nhtml,body { margin:0; height:100%; background:var(--bg); color:var(--given); font:14px system-ui,Segoe UI,Arial,sans-serif; user-select:none; -webkit-user-select:none; overflow:hidden; }\n#app { display:flex; flex-direction:column; height:100%; padding:8px; gap:8px; }\n.bar { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }\n.bar select, .bar button, .pad button, .tools button, .dlg button { background:var(--panel); color:var(--given); border:1px solid var(--thin); border-radius:8px; padding:5px 10px; font:inherit; cursor:pointer; }\n.bar button.icon { display:inline-flex; align-items:center; justify-content:center; padding:5px 7px; }\n.bar button:hover, .pad button:hover, .tools button:hover { border-color:var(--accent); }\n.spacer { flex:1; }\n#time { font:600 15px ui-monospace,Consolas,monospace; min-width:52px; text-align:right; }\n#wrap { flex:1; display:flex; align-items:center; justify-content:center; min-height:0; }\n#grid { display:grid; grid-template-columns:repeat(9,1fr); grid-template-rows:repeat(9,1fr); border:2px solid var(--line); background:var(--panel); aspect-ratio:1; touch-action:manipulation; outline-offset:3px; }\n.c { position:relative; display:flex; align-items:center; justify-content:center; border-right:1px solid var(--thin); border-bottom:1px solid var(--thin); cursor:pointer; font-weight:500; }\n.c:nth-child(9n) { border-right:none; }\n.c.br { border-right:2px solid var(--line); }\n.c.bb { border-bottom:2px solid var(--line); }\n.c.lastrow { border-bottom:none; }\n.c.g { color:var(--given); font-weight:700; }\n.c.u { color:var(--user); }\n.c.peer { background:var(--peer); }\n.c.same { background:var(--same); }\n.c.sel { background:var(--sel); }\n.c.err { color:var(--err); }\n.c.err.u { background:var(--errBg); }\n.c.hint { animation:flash 1s; }\n@keyframes flash { 0%{background:#ffe58a} 100%{} }\n.notes { position:absolute; inset:1px; display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(3,1fr); font-weight:500; color:var(--note); }\n.notes span { display:flex; align-items:center; justify-content:center; line-height:1; }\n.notes span.hl { color:var(--accent); font-weight:700; }\n.tools { display:flex; gap:6px; justify-content:center; flex-wrap:wrap; }\n.tools button.on { background:var(--accent); color:#fff; border-color:var(--accent); }\n.pad { display:grid; grid-template-columns:repeat(9,1fr); gap:5px; }\n.pad button { padding:6px 0; font-size:20px; font-weight:600; position:relative; }\n.pad button small { position:absolute; right:4px; bottom:1px; font-size:10px; color:var(--note); font-weight:400; }\n.pad button.done { opacity:.35; }\n#msg { position:fixed; inset:auto 0 14px 0; text-align:center; pointer-events:none; }\n#msg span { background:rgba(20,26,38,.88); color:#fff; padding:8px 14px; border-radius:8px; display:inline-block; }\n#paused { position:absolute; inset:0; background:var(--panel); display:none; align-items:center; justify-content:center; font-size:20px; cursor:pointer; }\n#gridBox { position:relative; }\n.dlg { position:fixed; inset:0; background:rgba(0,0,0,.4); display:none; align-items:center; justify-content:center; }\n.dlg.show { display:flex; }\n.dlg > div { background:var(--panel); padding:16px; border-radius:10px; max-width:340px; border:1px solid var(--thin); }\n.dlg h3 { margin:0 0 8px; }\n.dlg .row { display:flex; gap:8px; justify-content:flex-end; margin-top:12px; }\n.dlg button.pri { background:var(--accent); color:#fff; border-color:var(--accent); }\n.dlg button.danger { background:#c62828; color:#fff; border-color:#c62828; }\n.dlg table { border-collapse:collapse; width:100%; }\n.dlg td { padding:4px 6px; border-bottom:1px solid var(--thin); }\n:focus-visible { outline:2px solid var(--accent); outline-offset:1px; }\n#grid:focus-visible { outline:2px solid var(--accent); }\n@media (prefers-reduced-motion: reduce) { .c.hint { animation:none; } }\n@media (pointer: coarse) { .bar button, .bar select, .tools button, .dlg button { min-height:40px; } }\n"
  }
 }
}